import AxQM.Concrete.PauliStringCliffordCircuit

/-!
# Concrete: the Clifford-circuit inverse

This file continues the formalisation of Nielsen & Chuang **Theorem 10.6** (the converse — the
normalizer `N(Gₙ)` is generated by Hadamard/phase/CNOT gates, Exercise 10.40) by supplying the
inverse of a Clifford circuit that the multi-qubit inductive synthesis needs.

The induction of Figure 10.9 reduces an `(n+1)`-qubit normalizer `U` by left-composing it with a
Clifford circuit `B` (`M := B.toMatrix * U` fixes the first-wire generators), recurses on the last
`n` wires to obtain a Clifford circuit `B'`, and must then re-assemble `U` itself. Since
`M = phase • B'.toMatrix`, we get `U = B.toMatrixᴴ • (phase • B'.toMatrix)`, so to express `U` as a
*global phase times a Clifford circuit* we need `B.toMatrixᴴ` realised as the matrix of an actual
Clifford circuit. That is exactly what this file provides.

## The construction

Every elementary Clifford gate is invertible by a *word in the same gate set*:

* `H⁻¹ = H` and `CNOT⁻¹ = CNOT` (both are Hermitian involutions), and
* `S⁻¹ = S³` (the phase gate has order `4`, so `Sᴴ = S⁻¹ = S³`).

`CliffordGate.invList γ` records this word (`[H]`, `[CNOT]`, or `[S, S, S]`), with the defining
property `(invList γ).toMatrix = γ.toMatrixᴴ` (`toMatrix_invList`). Reversing the gate list of a
circuit and replacing each gate by its inverse word gives `CliffordCircuit.inverse`, whose matrix is
the conjugate transpose of the original (`toMatrix_inverse`): `(inverse C).toMatrix = C.toMatrixᴴ`.
Because a Clifford circuit is unitary, `inverse` is a genuine two-sided inverse
(`toMatrix_mul_inverse`, `toMatrix_inverse_mul`).
-/

namespace AxQM.Concrete

open Matrix

variable {n : ℕ}

/-! ### Two general facts about single-wire gates -/

/-- **`kronWireGate` is multiplicative on a fixed wire**: placing `G · H` on wire `j` is the same as
placing `G` and then `H` there. From the factor-by-factor product law `kronFamily_mul`, since the
per-wire families agree everywhere (`1 · 1 = 1` off wire `j`, `G · H` on it). -/
theorem kronWireGate_mul (j : Fin n) (G H : Matrix (Fin 2) (Fin 2) ℂ) :
    kronWireGate j G * kronWireGate j H = kronWireGate j (G * H) := by
  unfold kronWireGate
  rw [kronFamily_mul]
  congr 1
  funext k
  by_cases hk : k = j
  · subst hk; simp
  · simp [Function.update_of_ne hk]

/-- **The conjugate transpose passes through `kronWireGate`**: `(kronWireGate j G)ᴴ =
kronWireGate j Gᴴ`. From the entrywise `kronFamily_conjTranspose`, since `1ᴴ = 1` off wire `j`. -/
theorem kronWireGate_conjTranspose (j : Fin n) (G : Matrix (Fin 2) (Fin 2) ℂ) :
    (kronWireGate j G)ᴴ = kronWireGate j Gᴴ := by
  unfold kronWireGate
  rw [kronFamily_conjTranspose]
  congr 1
  funext k
  by_cases hk : k = j
  · subst hk; simp
  · simp [Function.update_of_ne hk]

/-- **The phase gate is a fourth root of unity, so `S³ = Sᴴ`**: `sMatrix · sMatrix · sMatrix =
sMatrixᴴ`. Both sides are `diag(1, -i)` (`S = diag(1, i)`, `i³ = -i = conj i`); a `2×2` entrywise
computation. This is what makes `[S, S, S]` an inverse word for the phase gate. -/
theorem sMatrix_mul_self_mul_self_eq_conjTranspose :
    sMatrix * sMatrix * sMatrix = sMatrixᴴ := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sMatrix, Matrix.mul_apply, Fin.sum_univ_two, Matrix.conjTranspose_apply,
      Complex.I_mul_I]

/-! ### The inverse word of a gate, and of a circuit -/

/-- The **inverse word** of an elementary Clifford gate: a Clifford circuit whose matrix is the
gate's conjugate transpose (`toMatrix_invList`). Hadamard and CNOT are Hermitian involutions, so
each is its own inverse (`[had j]`, `[cnot c t h]`); the phase gate has order `4`, so `S⁻¹ = S³`
(`[phase j, phase j, phase j]`). -/
def CliffordGate.invList : CliffordGate n → CliffordCircuit n
  | .had j => [.had j]
  | .phase j => [.phase j, .phase j, .phase j]
  | .cnot c t h => [.cnot c t h]

namespace CliffordCircuit

/-- **The inverse word realises the gate's adjoint**: `(CliffordGate.invList γ).toMatrix =
γ.toMatrixᴴ`. By cases on `γ`: `H`/`CNOT` are self-adjoint (`hadamardC_isHermitian`,
`cnotWireGate_conjTranspose`), and `[S, S, S].toMatrix = kronWireGate j (S · S · S) =
kronWireGate j Sᴴ = (kronWireGate j S)ᴴ` via `kronWireGate_mul`,
`sMatrix_mul_self_mul_self_eq_conjTranspose` and `kronWireGate_conjTranspose`. -/
theorem toMatrix_invList (γ : CliffordGate n) :
    toMatrix γ.invList = (γ.toMatrix)ᴴ := by
  cases γ with
  | had j =>
      simp only [CliffordGate.invList, toMatrix, CliffordGate.toMatrix, mul_one]
      rw [kronWireGate_conjTranspose, hadamardC_isHermitian.eq]
  | phase j =>
      simp only [CliffordGate.invList, toMatrix, CliffordGate.toMatrix, mul_one]
      rw [← Matrix.mul_assoc, kronWireGate_mul, kronWireGate_mul,
        sMatrix_mul_self_mul_self_eq_conjTranspose, kronWireGate_conjTranspose]
  | cnot c t h =>
      simp only [CliffordGate.invList, toMatrix, CliffordGate.toMatrix, mul_one]
      rw [cnotWireGate_conjTranspose c t h]

/-- The **inverse** of a Clifford circuit: reverse the gate list and replace each gate by its
inverse word (`CliffordGate.invList`). Read right-to-left, reversing the order and adjointing each
gate is precisely the conjugate transpose of the product (`toMatrix_inverse`). -/
def inverse : CliffordCircuit n → CliffordCircuit n
  | [] => []
  | γ :: U => inverse U ++ γ.invList

/-- **The inverse circuit realises the adjoint**: `(inverse C).toMatrix = C.toMatrixᴴ`. By induction
on the gate list, using `toMatrix_append`, the per-gate `toMatrix_invList`, and
`conjTranspose_mul` (which reverses the product order, matching the reversal in `inverse`). This is
the assembly keystone: it lets the Figure 10.9 induction re-express a reduced normalizer
`U = Bᴴ • (phase • B'.toMatrix)` as a global phase times the Clifford circuit `inverse B ++ B'`. -/
theorem toMatrix_inverse (C : CliffordCircuit n) :
    toMatrix (inverse C) = (toMatrix C)ᴴ := by
  induction C with
  | nil => simp [inverse, toMatrix]
  | cons γ U ih =>
      rw [inverse, toMatrix_append, ih, toMatrix_invList, toMatrix, Matrix.conjTranspose_mul]

/-- **`inverse` is a right inverse**: `C.toMatrix · (inverse C).toMatrix = 1`, since a Clifford
circuit is unitary (`mul_conjTranspose`) and `(inverse C).toMatrix = C.toMatrixᴴ`. -/
theorem toMatrix_mul_inverse (C : CliffordCircuit n) :
    toMatrix C * toMatrix (inverse C) = 1 := by
  rw [toMatrix_inverse]; exact mul_conjTranspose C

/-- **`inverse` is a left inverse**: `(inverse C).toMatrix · C.toMatrix = 1`. From the right-inverse
identity via `mul_eq_one_comm` (a right inverse of a square matrix is a two-sided inverse). -/
theorem toMatrix_inverse_mul (C : CliffordCircuit n) :
    toMatrix (inverse C) * toMatrix C = 1 := by
  rw [toMatrix_inverse]; exact mul_eq_one_comm.mp (mul_conjTranspose C)

end CliffordCircuit

end AxQM.Concrete
