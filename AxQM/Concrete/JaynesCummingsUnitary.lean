import AxQM.Concrete.QubitBasisOperators
import ToMathlib.Analysis.InnerProductSpace.TensorProduct
import ToMathlib.Analysis.InnerProductSpace.AdjointAntilinear
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic

/-!
# Concrete: the resonant Jaynes–Cummings (vacuum-Rabi) unitary on two qubits (N&C §7.5.2, Ex 8.24)

This file defines, at the level of raw operators on the tensor product `H ⊗[ℂ] H` of two abstract
qubits — the **atom** (left factor) and the single-mode **field** (right factor), each a
two-dimensional complex inner product space with a chosen computational orthonormal basis
`b : OrthonormalBasis (Fin 2) ℂ H` — the time-evolution operator generated by the resonant
Jaynes–Cummings interaction, i.e. Nielsen & Chuang eq. (7.77) with detuning `δ = 0`:

`U = |00⟩⟨00| + |11⟩⟨11| + cos(gt) (|01⟩⟨01| + |10⟩⟨10|) - i sin(gt) (|01⟩⟨10| + |10⟩⟨01|)`,

the **vacuum-Rabi** unitary. Physically `U = exp(-iHt)` for the resonant Jaynes–Cummings Hamiltonian
`H = g(a†σ₋ + aσ₊)` (N&C eq. 7.71 at `δ = 0`, dropping the constant-of-motion phase): it leaves the
joint ground `|00⟩` and doubly-excited `|11⟩` states invariant, and drives a Rabi rotation of angle
`gt` on the single-excitation subspace `span{|01⟩, |10⟩}`, coherently exchanging a quantum of energy
between atom and field. Here `|ij⟩ = |i⟩_atom ⊗ |j⟩_field`.

## Design

`U` is written in the closed form `U = I + (cos(gt) - 1) Q - i sin(gt) S`, where

* `S = σ₋ ⊗ σ₊ + σ₊ ⊗ σ₋` (`jcCoupling`) is the **excitation-exchange coupling** `|01⟩⟨10| +
  |10⟩⟨01|` — the operator content of the Jaynes–Cummings interaction `a†σ₋ + aσ₊` restricted to the
  ≤1-excitation sector; and
* `Q = P₀ ⊗ P₁ + P₁ ⊗ P₀` (`jcExchangeProj`) is the orthogonal **projector** `|01⟩⟨01| + |10⟩⟨10|`
  onto the single-excitation subspace.

This form makes unitarity a two-line algebraic computation once the four structural products
`Q† = Q`, `S† = S`, `S² = Q`, `Q S = S Q = S`, `Q² = Q` are in hand — each of which reduces, via
`TensorProduct.map_comp`, to the single matrix-unit product law
`AxQM.Concrete.qubitUnit_comp` (`|i⟩⟨j| |k⟩⟨l| = δⱼₖ |i⟩⟨l|`) on each tensor factor. Both
`Q` and `S` are assembled from the reusable computational-basis matrix units `qubitUnit`
(`AxQM.Concrete.QubitBasisOperators`); no operator is reinvented.

## Related exercises

Compare the operator-sum interactions of
Exercises 8.4 (`Concrete/ControlledFlipOperatorSum.lean`) and 8.5
(`Concrete/SpinFlipOperatorSum.lean`). It is the interaction unitary that Exercise 8.24 (spontaneous
emission is amplitude damping) traces over the field.

## Contents

* `jcCoupling b`, `jcExchangeProj b` — the coupling `S` and the exchange projector `Q`, with their
  self-adjointness (`adjoint_jcCoupling`, `adjoint_jcExchangeProj`) and structural products
  (`jcCoupling_comp_self` `S² = Q`, `jcExchangeProj_comp_self` `Q² = Q`,
  `jcExchangeProj_comp_jcCoupling` `Q S = S`, `jcCoupling_comp_jcExchangeProj` `S Q = S`).
* `jaynesCummingsZeroDetuningUnitary b g t` — the unitary `U` (eq. 7.77 at `δ = 0`), with its action
  on the computational tensor basis (`…_apply_zero_zero`, `…_apply_one_one`, `…_apply_one_zero`,
  `…_apply_zero_one`), on a general product state with the field in the vacuum
  (`…_apply_tmul_zero`), and its unitarity (`jaynesCummingsZeroDetuningUnitary_isometry`
  `U† U = I`).
-/

open scoped TensorProduct InnerProductSpace

noncomputable section

namespace AxQM.Concrete

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [FiniteDimensional ℂ H]
  [CompleteSpace H] (b : OrthonormalBasis (Fin 2) ℂ H)

/-- The **excitation-exchange coupling** `S = σ₋ ⊗ σ₊ + σ₊ ⊗ σ₋ = |01⟩⟨10| + |10⟩⟨01|` of the
resonant Jaynes–Cummings interaction: it swaps `|10⟩` (excited atom, empty field) with `|01⟩`
(ground atom, one photon), the operator content of `a†σ₋ + aσ₊` on the ≤1-excitation sector. -/
noncomputable def jcCoupling : H ⊗[ℂ] H →ₗ[ℂ] H ⊗[ℂ] H :=
  TensorProduct.map (qubitUnit b 0 1) (qubitUnit b 1 0)
    + TensorProduct.map (qubitUnit b 1 0) (qubitUnit b 0 1)

/-- The orthogonal **projector** `Q = P₀ ⊗ P₁ + P₁ ⊗ P₀ = |01⟩⟨01| + |10⟩⟨10|` onto the
single-excitation subspace `span{|01⟩, |10⟩}` on which the Rabi rotation acts. -/
noncomputable def jcExchangeProj : H ⊗[ℂ] H →ₗ[ℂ] H ⊗[ℂ] H :=
  TensorProduct.map (qubitUnit b 0 0) (qubitUnit b 1 1)
    + TensorProduct.map (qubitUnit b 1 1) (qubitUnit b 0 0)

/-- `S` is self-adjoint: `S† = S`. Each summand's adjoint is the other (`|i⟩⟨j|† = |j⟩⟨i|`). -/
theorem adjoint_jcCoupling : LinearMap.adjoint (jcCoupling b) = jcCoupling b := by
  rw [jcCoupling, map_add, TensorProduct.adjoint_map, TensorProduct.adjoint_map]
  simp only [adjoint_qubitUnit]
  abel

/-- `Q` is self-adjoint: `Q† = Q`. Each diagonal matrix unit is self-adjoint. -/
theorem adjoint_jcExchangeProj : LinearMap.adjoint (jcExchangeProj b) = jcExchangeProj b := by
  rw [jcExchangeProj, map_add, TensorProduct.adjoint_map, TensorProduct.adjoint_map]
  simp only [adjoint_qubitUnit]

omit [FiniteDimensional ℂ H] [CompleteSpace H] in
/-- `S² = Q`: squaring the coupling recovers the exchange projector. On each factor the surviving
products are `σ₋σ₊ = P₀` and `σ₊σ₋ = P₁` (the others vanish as `σ₋² = σ₊² = 0`). -/
theorem jcCoupling_comp_self : jcCoupling b ∘ₗ jcCoupling b = jcExchangeProj b := by
  rw [jcCoupling, jcExchangeProj, LinearMap.comp_add, LinearMap.add_comp, LinearMap.add_comp,
    ← TensorProduct.map_comp, ← TensorProduct.map_comp, ← TensorProduct.map_comp,
    ← TensorProduct.map_comp, qubitUnit_comp, qubitUnit_comp, qubitUnit_comp, qubitUnit_comp]
  simp only [Fin.isValue, Fin.reduceEq, ↓reduceIte, TensorProduct.map_zero_right]
  abel

omit [FiniteDimensional ℂ H] [CompleteSpace H] in
/-- `Q² = Q`: the exchange operator is idempotent (`Pᵢ² = Pᵢ`, cross terms vanish). -/
theorem jcExchangeProj_comp_self : jcExchangeProj b ∘ₗ jcExchangeProj b = jcExchangeProj b := by
  rw [jcExchangeProj, LinearMap.comp_add, LinearMap.add_comp, LinearMap.add_comp,
    ← TensorProduct.map_comp, ← TensorProduct.map_comp, ← TensorProduct.map_comp,
    ← TensorProduct.map_comp, qubitUnit_comp, qubitUnit_comp, qubitUnit_comp, qubitUnit_comp]
  simp only [Fin.isValue, Fin.reduceEq, ↓reduceIte, TensorProduct.map_zero_right]
  abel

omit [FiniteDimensional ℂ H] [CompleteSpace H] in
/-- `Q S = S`: the coupling maps into (and is fixed by projecting onto) the exchange subspace. -/
theorem jcExchangeProj_comp_jcCoupling : jcExchangeProj b ∘ₗ jcCoupling b = jcCoupling b := by
  rw [jcExchangeProj, jcCoupling, LinearMap.comp_add, LinearMap.add_comp, LinearMap.add_comp,
    ← TensorProduct.map_comp, ← TensorProduct.map_comp, ← TensorProduct.map_comp,
    ← TensorProduct.map_comp, qubitUnit_comp, qubitUnit_comp, qubitUnit_comp, qubitUnit_comp]
  simp only [Fin.isValue, Fin.reduceEq, ↓reduceIte, TensorProduct.map_zero_right]
  abel

omit [FiniteDimensional ℂ H] [CompleteSpace H] in
/-- `S Q = S`: the coupling is fixed by projecting its domain onto the exchange subspace. -/
theorem jcCoupling_comp_jcExchangeProj : jcCoupling b ∘ₗ jcExchangeProj b = jcCoupling b := by
  rw [jcExchangeProj, jcCoupling, LinearMap.comp_add, LinearMap.add_comp, LinearMap.add_comp,
    ← TensorProduct.map_comp, ← TensorProduct.map_comp, ← TensorProduct.map_comp,
    ← TensorProduct.map_comp, qubitUnit_comp, qubitUnit_comp, qubitUnit_comp, qubitUnit_comp]
  simp only [Fin.isValue, Fin.reduceEq, ↓reduceIte, TensorProduct.map_zero_right]
  abel

/-- The **resonant Jaynes–Cummings (vacuum-Rabi) unitary** `U = I + (cos(gt) - 1) Q - i sin(gt) S`
(Nielsen & Chuang eq. 7.77 with detuning `δ = 0`): identity on `span{|00⟩, |11⟩}`, and a Rabi
rotation of angle `gt` exchanging a quantum of energy on `span{|01⟩, |10⟩}`. -/
noncomputable def jaynesCummingsZeroDetuningUnitary (g t : ℝ) : H ⊗[ℂ] H →ₗ[ℂ] H ⊗[ℂ] H :=
  LinearMap.id
    + ((Real.cos (g * t) : ℂ) - 1) • jcExchangeProj b
    + (-Complex.I * (Real.sin (g * t) : ℂ)) • jcCoupling b

omit [FiniteDimensional ℂ H] [CompleteSpace H] in
/-- `U` leaves the joint ground state invariant: `U |00⟩ = |00⟩`. -/
@[simp] theorem jaynesCummingsZeroDetuningUnitary_apply_zero_zero (g t : ℝ) :
    jaynesCummingsZeroDetuningUnitary b g t (b 0 ⊗ₜ[ℂ] b 0) = b 0 ⊗ₜ[ℂ] b 0 := by
  simp only [jaynesCummingsZeroDetuningUnitary, jcExchangeProj, jcCoupling, LinearMap.add_apply,
    LinearMap.id_apply, LinearMap.smul_apply, TensorProduct.map_tmul, qubitUnit_apply,
    b.inner_eq_ite]
  simp

omit [FiniteDimensional ℂ H] [CompleteSpace H] in
/-- `U` leaves the doubly-excited state invariant: `U |11⟩ = |11⟩`. -/
@[simp] theorem jaynesCummingsZeroDetuningUnitary_apply_one_one (g t : ℝ) :
    jaynesCummingsZeroDetuningUnitary b g t (b 1 ⊗ₜ[ℂ] b 1) = b 1 ⊗ₜ[ℂ] b 1 := by
  simp only [jaynesCummingsZeroDetuningUnitary, jcExchangeProj, jcCoupling, LinearMap.add_apply,
    LinearMap.id_apply, LinearMap.smul_apply, TensorProduct.map_tmul, qubitUnit_apply,
    b.inner_eq_ite]
  simp

omit [FiniteDimensional ℂ H] [CompleteSpace H] in
/-- Rabi oscillation of the excited atom in an empty field:
`U |10⟩ = cos(gt) |10⟩ - i sin(gt) |01⟩` (the atom emits a photon with amplitude `-i sin(gt)`). -/
@[simp] theorem jaynesCummingsZeroDetuningUnitary_apply_one_zero (g t : ℝ) :
    jaynesCummingsZeroDetuningUnitary b g t (b 1 ⊗ₜ[ℂ] b 0)
      = (Real.cos (g * t) : ℂ) • (b 1 ⊗ₜ[ℂ] b 0)
        + (-Complex.I * (Real.sin (g * t) : ℂ)) • (b 0 ⊗ₜ[ℂ] b 1) := by
  simp only [jaynesCummingsZeroDetuningUnitary, jcExchangeProj, jcCoupling, LinearMap.add_apply,
    LinearMap.id_apply, LinearMap.smul_apply, TensorProduct.map_tmul, qubitUnit_apply,
    b.inner_eq_ite]
  simp only [Fin.reduceEq, ↓reduceIte, one_smul, zero_smul, TensorProduct.tmul_zero]
  module

omit [FiniteDimensional ℂ H] [CompleteSpace H] in
/-- Rabi oscillation of a photon absorbed by a ground-state atom:
`U |01⟩ = cos(gt) |01⟩ - i sin(gt) |10⟩`. -/
@[simp] theorem jaynesCummingsZeroDetuningUnitary_apply_zero_one (g t : ℝ) :
    jaynesCummingsZeroDetuningUnitary b g t (b 0 ⊗ₜ[ℂ] b 1)
      = (Real.cos (g * t) : ℂ) • (b 0 ⊗ₜ[ℂ] b 1)
        + (-Complex.I * (Real.sin (g * t) : ℂ)) • (b 1 ⊗ₜ[ℂ] b 0) := by
  simp only [jaynesCummingsZeroDetuningUnitary, jcExchangeProj, jcCoupling, LinearMap.add_apply,
    LinearMap.id_apply, LinearMap.smul_apply, TensorProduct.map_tmul, qubitUnit_apply,
    b.inner_eq_ite]
  simp only [Fin.reduceEq, ↓reduceIte, one_smul, zero_smul, TensorProduct.tmul_zero]
  module

omit [FiniteDimensional ℂ H] [CompleteSpace H] in
/-- The action of `U` on a product state with the field in the vacuum `|0⟩`, for an arbitrary atom
state `x`: `U (x ⊗ |0⟩) = ⟨0|x⟩ |00⟩ + cos(gt)⟨1|x⟩ |10⟩ - i sin(gt)⟨1|x⟩ |01⟩`. Expand
`x = ⟨0|x⟩ |0⟩ + ⟨1|x⟩ |1⟩` and apply `…_apply_zero_zero` / `…_apply_one_zero`. This is the single
tensor computation the spontaneous-emission operation elements `⟨k_field|U|0_field⟩` (Exercise 8.24)
are read off from. -/
theorem jaynesCummingsZeroDetuningUnitary_apply_tmul_zero (g t : ℝ) (x : H) :
    jaynesCummingsZeroDetuningUnitary b g t (x ⊗ₜ[ℂ] b 0)
      = (inner ℂ (b 0) x) • (b 0 ⊗ₜ[ℂ] b 0)
        + ((Real.cos (g * t) : ℂ) * inner ℂ (b 1) x) • (b 1 ⊗ₜ[ℂ] b 0)
        + ((-Complex.I * (Real.sin (g * t) : ℂ)) * inner ℂ (b 1) x) • (b 0 ⊗ₜ[ℂ] b 1) := by
  have hx : (inner ℂ (b 0) x : ℂ) • (b 0 ⊗ₜ[ℂ] b 0) + (inner ℂ (b 1) x : ℂ) • (b 1 ⊗ₜ[ℂ] b 0)
      = x ⊗ₜ[ℂ] b 0 := by
    rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul', ← TensorProduct.add_tmul]
    congr 1
    conv_rhs => rw [← b.sum_repr x, Fin.sum_univ_two]
    rw [b.repr_apply_apply, b.repr_apply_apply]
  rw [← hx, map_add, map_smul, map_smul, jaynesCummingsZeroDetuningUnitary_apply_zero_zero,
    jaynesCummingsZeroDetuningUnitary_apply_one_zero]
  module

/-- **Unitarity** (N&C eq. 7.77 is unitary): `U† U = I`. Writing `U = I + a Q + c S` with
`a = cos(gt) - 1`, `c = -i sin(gt)`, self-adjointness of `Q`, `S` gives `U† = I + a Q + c̄ S`, and
the structural products `Q² = Q`, `S² = Q`, `Q S = S Q = S` collapse `U† U` to
`I + (2a + a² + |c|²) Q + (c + c̄ + a(c + c̄)) S`; the `Q`-coefficient is `cos²(gt) + sin²(gt) - 1 =
0` and the `S`-coefficient is `a·0 = 0`. -/
theorem jaynesCummingsZeroDetuningUnitary_isometry (g t : ℝ) :
    LinearMap.adjoint (jaynesCummingsZeroDetuningUnitary b g t) ∘ₗ
      jaynesCummingsZeroDetuningUnitary b g t = LinearMap.id := by
  have hpyth : Complex.cos ((g : ℂ) * (t : ℂ)) ^ 2 + Complex.sin ((g : ℂ) * (t : ℂ)) ^ 2 = 1 :=
    Complex.cos_sq_add_sin_sq _
  rw [jaynesCummingsZeroDetuningUnitary]
  simp only [map_add, LinearMap.adjoint_id, LinearMap.adjoint_smul, adjoint_jcExchangeProj,
    adjoint_jcCoupling]
  simp only [LinearMap.add_comp, LinearMap.comp_add, LinearMap.smul_comp, LinearMap.comp_smul,
    LinearMap.id_comp, LinearMap.comp_id, jcExchangeProj_comp_self, jcCoupling_comp_self,
    jcExchangeProj_comp_jcCoupling, jcCoupling_comp_jcExchangeProj]
  simp only [star_sub, star_one, star_mul', star_neg, Complex.conj_I, RCLike.star_def,
    Complex.conj_ofReal]
  match_scalars
  · ring
  · linear_combination hpyth - Complex.sin ((g : ℂ) * (t : ℂ)) ^ 2 * Complex.I_sq
  · ring

end AxQM.Concrete

end
