import AxQM.Concrete.PauliNormalizerLayer

/-!
# Concrete: CNOT clearing — collapse an all-`X` Pauli string to a single `X` generator

This file continues the formalisation of
Nielsen & Chuang **Theorem 10.6** (the converse — the normalizer `N(Gₙ)` is generated by
Hadamard/phase/CNOT gates, Exercise 10.40) toward the multi-qubit inductive synthesis (parts 2–3).

The Gottesman tableau sweep synthesising a Clifford circuit for a normalizer's signed permutation
proceeds, on the first generator's image `U X₁ U†`, in two moves:

1. **Diagonalise to all-`X`** (`exists_singleQubitLayer_act_diagX`): a single-qubit
   layer rotates the image to a string carrying `X` on its support and `I` elsewhere.
2. **Collapse to a single generator** (*this file*): a **fan of CNOTs** from one support wire
   `c` clears the `X` off every other support wire, leaving `X` on wire `c` alone (`xGenPauli c`).

The clearing move is the *inverse reading* of the CNOT `X`-spread of Problem 10.3
(`act_cnotFan_xGenPauli`): a single `CNOT_{c→t}` with `X` on both control and target sends
`X_c X_t ↦ X_c` (the target's `X` is copied onto the — already `X` — control, cancelling `mod 2`;
`x_t += x_c`, Figure 10.7), so a fan controlled on `c` and targeting the other support wires
collapses an all-`X` string to `X_c`. We reuse the existing `cnotFan` combinator and its cons law
`act_cnotFan_cons_of_ne` rather than reconstructing the circuit.

Every statement is about raw matrix / index data (`Concrete.CliffordCircuit`,
`Concrete.pauliString` indices `Fin n → Fin 4`, `Concrete.xGenPauli`).

## What is proved

* `act_cnotFan_collapse` — **the clearing action.** For an all-`X` string `a` with pivot `c`
  (`a c = 1`) and distinct target wires `ts` (`c ∉ ts`, `ts.Nodup`) all in `a`'s support
  (`∀ t ∈ ts, a t = 1`), the fan `cnotFan c ts` sends `a` to `X` on `c`, `I` on each target, and
  `a` unchanged elsewhere
  (`act (cnotFan c ts) a k = if k = c then 1 else if k ∈ ts then 0 else a k`).
  The control wire keeps its `X` throughout (`cnotCtrlPauli 1 1 = 1`) and each target's `X` is
  cleared (`cnotTgtPauli 1 1 = 0`); an induction on `ts` on top of `act_cnotFan_cons_of_ne`.

* `sign_cnotStep_of_ne` — the `±1` phase of one CNOT step `CNOT_{c→t}` (`c ≠ t`) is
  `cnotPauliSign (g c) (g t)`.

* `sign_cnotFan_collapse` — **the clearing introduces no sign.** Under the same hypotheses,
  `sign (cnotFan c ts) a = 1`: every step conjugates an `(X_c, X_t)` pair, whose tableau sign is
  `cnotPauliSign 1 1 = 1`.

* `exists_cliffordCircuit_cnotClear_toSingleX` — **sweep step 2.** For any all-`X`
  string `a` (`∀ k, a k = 0 ∨ a k = 1`) with a pivot `c` in its support (`a c = 1`), there is a
  Clifford circuit realising `a ↦ xGenPauli c` exactly, with phase `1`. Taking the targets to be
  the support minus `c` (a `Finset.filter … |>.toList`), the fan clears every other `X`. This
  reduces a diagonalised generator image `U X₁ U†` to the standard `X₁`, the second move of the
  Exercise 10.40 inductive synthesis.
-/

open Matrix

noncomputable section

namespace AxQM.Concrete

variable {n : ℕ}

/-! ### Collapsing an all-`X` string with a CNOT fan -/

/-- **A CNOT fan collapses an all-`X` string to its pivot.** For a string `a` with `X` (letter `1`)
on wire `c` and on every wire of a distinct list `ts` (`c ∉ ts`, `ts.Nodup`, `∀ t ∈ ts, a t = 1`),
the fan `cnotFan c ts` (control `c`, targets `ts`) transforms `a` to:
`act (cnotFan c ts) a k = if k = c then 1 else if k ∈ ts then 0 else a k` — `X` kept on the control
`c`, `I` on every target, and every other wire unchanged.

This is the *inverse reading* of the `X`-spread `act_cnotFan_xGenPauli`: `CNOT_{c→t}` copies the
control's `X` onto the target (`x_t += x_c`, Figure 10.7), so a target that already carries an `X`
is cleared (`cnotTgtPauli 1 1 = 0`) while the control keeps its `X` (`cnotCtrlPauli 1 1 = 1`).
Proved by induction on `ts` via `act_cnotFan_cons_of_ne`: the tail collapses all but the head
target, whose `X` the head `CNOT_{c→t}` then clears. -/
theorem act_cnotFan_collapse (c : Fin n) :
    ∀ (ts : List (Fin n)), c ∉ ts → ts.Nodup → ∀ (a : Fin n → Fin 4), a c = 1 →
      (∀ t ∈ ts, a t = 1) → ∀ k,
      CliffordCircuit.act (cnotFan c ts) a k = if k = c then 1 else if k ∈ ts then 0 else a k
  | [], _, _, a, hac, _, k => by
      simp only [cnotFan_nil, CliffordCircuit.act, List.not_mem_nil, ite_false]
      rcases eq_or_ne k c with rfl | hk
      · rw [ite_eq_left rfl]; exact hac
      · rw [ite_eq_right hk]
  | t :: ts, hct, hnd, a, hac, hall, k => by
      rw [List.mem_cons, not_or] at hct
      obtain ⟨hct_t, hct_ts⟩ := hct
      obtain ⟨htnotin, hnd'⟩ := List.nodup_cons.mp hnd
      have hit : c ≠ t := hct_t
      have hall' : ∀ t' ∈ ts, a t' = 1 := fun t' ht' => hall t' (List.mem_cons_of_mem t ht')
      have hIH := act_cnotFan_collapse c ts hct_ts hnd' a hac hall'
      have hac' : CliffordCircuit.act (cnotFan c ts) a c = 1 := by rw [hIH c]; simp
      have hat' : CliffordCircuit.act (cnotFan c ts) a t = 1 := by
        rw [hIH t, ite_eq_right (Ne.symm hit), ite_eq_right htnotin]
        exact hall t List.mem_cons_self
      rw [act_cnotFan_cons_of_ne hit ts a]
      rcases eq_or_ne k c with rfl | hkc
      · rw [cnotPauliString_ctrl, hac', hat', ite_eq_left rfl]; decide
      · rcases eq_or_ne k t with rfl | hkt
        · rw [cnotPauliString_tgt _ hit, hac', hat', ite_eq_right hkc,
              ite_eq_left List.mem_cons_self]
          decide
        · rw [cnotPauliString_of_ne _ c t hkc hkt, hIH k]
          have hmem2 : (k ∈ t :: ts) ↔ (k ∈ ts) := by simp [List.mem_cons, hkt]
          simp only [hmem2]

/-- **The `±1` phase of a single CNOT step.** For `c ≠ t`, `sign (cnotStep c t) g` is the CNOT
tableau sign `cnotPauliSign (g c) (g t)` (`cnotStep c t = [CNOT_{c→t}]`, and a one-gate circuit's
sign is the gate's). -/
theorem sign_cnotStep_of_ne {c t : Fin n} (hct : c ≠ t) (g : Fin n → Fin 4) :
    CliffordCircuit.sign (cnotStep c t) g = cnotPauliSign (g c) (g t) := by
  rw [cnotStep, dite_eq_right hct]
  simp [CliffordCircuit.sign, CliffordGate.sign, CliffordCircuit.act]

/-- **The CNOT clearing introduces no sign.** Under the hypotheses of `act_cnotFan_collapse`,
`sign (cnotFan c ts) a = 1`: each `CNOT_{c→t}` in the fan conjugates a pair `(X_c, X_t)` (control
and current target both `X`, by the collapse action of the tail), whose CNOT tableau sign is
`cnotPauliSign 1 1 = 1`. Proved by induction on `ts` via `sign_append` and the tail's `act` values
from `act_cnotFan_collapse`. -/
theorem sign_cnotFan_collapse (c : Fin n) :
    ∀ (ts : List (Fin n)), c ∉ ts → ts.Nodup → ∀ (a : Fin n → Fin 4), a c = 1 →
      (∀ t ∈ ts, a t = 1) → CliffordCircuit.sign (cnotFan c ts) a = 1
  | [], _, _, _, _, _ => by simp [cnotFan_nil, CliffordCircuit.sign]
  | t :: ts, hct, hnd, a, hac, hall => by
      rw [List.mem_cons, not_or] at hct
      obtain ⟨hct_t, hct_ts⟩ := hct
      obtain ⟨htnotin, hnd'⟩ := List.nodup_cons.mp hnd
      have hit : c ≠ t := hct_t
      have hall' : ∀ t' ∈ ts, a t' = 1 := fun t' ht' => hall t' (List.mem_cons_of_mem t ht')
      have hac' : CliffordCircuit.act (cnotFan c ts) a c = 1 := by
        rw [act_cnotFan_collapse c ts hct_ts hnd' a hac hall' c]; simp
      have hat' : CliffordCircuit.act (cnotFan c ts) a t = 1 := by
        rw [act_cnotFan_collapse c ts hct_ts hnd' a hac hall' t, ite_eq_right (Ne.symm hit),
          ite_eq_right htnotin]
        exact hall t List.mem_cons_self
      rw [cnotFan_cons, CliffordCircuit.sign_append,
        sign_cnotFan_collapse c ts hct_ts hnd' a hac hall', one_mul,
        sign_cnotStep_of_ne hit, hac', hat']
      rfl

/-! ### Sweep step 2: collapse an all-`X` image to a single `X` generator -/

/-- **CNOT clearing (N&C Exercise 10.40 sweep step 2).** For any all-`X` Pauli string `a`
(`∀ k, a k = 0 ∨ a k = 1`) with a pivot wire `c` in its support (`a c = 1`), there is a Clifford
circuit `C` collapsing `a` to the single `X` generator on wire `c` exactly, with phase `1`:
`act C a = xGenPauli c` and `sign C a = 1`.

The witness is the CNOT fan `cnotFan c ts` controlled on `c` with targets the rest of `a`'s support
`ts = {k | a k = 1, k ≠ c}` (as a `Finset.filter … |>.toList`, so `Nodup` and `c ∉ ts`);
`act_cnotFan_collapse` clears every target's `X`, and `sign_cnotFan_collapse` gives the trivial
phase. Together with the diagonalisation step (`exists_singleQubitLayer_act_diagX`), this
reduces a normalizer's diagonalised generator image `U X₁ U†` to the standard `X₁` — the second
move of the multi-qubit inductive synthesis of Theorem 10.6. -/
theorem exists_cliffordCircuit_cnotClear_toSingleX (a : Fin n → Fin 4) (c : Fin n)
    (hc : a c = 1) (hX : ∀ k, a k = 0 ∨ a k = 1) :
    ∃ C : CliffordCircuit n,
      CliffordCircuit.act C a = xGenPauli c ∧ CliffordCircuit.sign C a = 1 := by
  set ts := (Finset.univ.filter (fun k => a k = 1 ∧ k ≠ c)).toList with hts
  have hmem : ∀ k, k ∈ ts ↔ (a k = 1 ∧ k ≠ c) := by
    intro k
    rw [hts, Finset.mem_toList, Finset.mem_filter]
    simp
  have hnd : ts.Nodup := Finset.nodup_toList _
  have hcnotin : c ∉ ts := fun h => ((hmem c).mp h).2 rfl
  have hall : ∀ t ∈ ts, a t = 1 := fun t ht => ((hmem t).mp ht).1
  refine ⟨cnotFan c ts, ?_, sign_cnotFan_collapse c ts hcnotin hnd a hc hall⟩
  funext k
  rw [act_cnotFan_collapse c ts hcnotin hnd a hc hall k, xGenPauli_apply]
  rcases eq_or_ne k c with rfl | hkc
  · simp
  · simp only [ite_eq_right hkc]
    by_cases hk1 : a k = 1
    · rw [ite_eq_left ((hmem k).mpr ⟨hk1, hkc⟩)]
    · rw [ite_eq_right (fun h => hk1 ((hmem k).mp h).1)]
      exact (hX k).resolve_right hk1

end AxQM.Concrete

end
