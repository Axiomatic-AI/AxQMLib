import AxQM.Concrete.PauliNormalizerPairReduce
import AxQM.Concrete.PauliNormalizerSwap

/-!
# Concrete: the first-wire reduction of a Pauli normalizer (Figure 10.9 setup)

This file continues the formalisation of
Nielsen & Chuang **Theorem 10.6** (the converse — the normalizer `N(Gₙ)` is generated by
Hadamard/phase/CNOT gates, Exercise 10.40) toward the multi-qubit inductive synthesis (parts 2–3,
Figure 10.9).

The inductive step of Exercise 10.40 reduces an `(n+1)`-qubit normalizer to an `n`-qubit one by
**decoupling the first wire**: one composes `U` on the left with a Clifford circuit so that the
composite fixes the first-wire generators `X₀` and `Z₀` under conjugation, after which
the remaining generators are forced to be supported on the last `n` wires and the inductive
hypothesis applies. This file builds that composite from the following pieces:

* `exists_cliffordCircuit_reducePair` — reduce the anticommuting image pair
  `(U X₀ U†, U Z₀ U†)` to the canonical `(X_c, Z_c)` on some pivot wire `c`, exactly (`±1` phases
  pinned to `+1`);
* `swapWires` — swap the pivot wire `c` to the designated first wire `0`;
* `exists_cliffordCircuit_onWire_act_sign` — a single-wire sign gadget on wire `0` correcting
  the two residual `±1` phases `ε(X₀), ε(Z₀)` the normalizer contributes.

Everything is about raw matrix / index data (`Matrix`, `Concrete.pauliString`,
`Concrete.xGenPauli`/`zGenPauli`, `Concrete.CliffordCircuit`, `Concrete.IsPauliNormalizer`).

## What is proved

* `IsPauliNormalizer.mul` — **the normalizer `N(Gₙ)` is closed under matrix multiplication.** If `A`
  and `B` are Pauli normalizers then so is `A * B`: the product is unitary (submonoid closure) and
  conjugation composes — `(A B) p (A B)† = A (B p B†) A† ∈ Gₙ`. This is what makes the composite
  `B.toMatrix * U` of the reduction below itself a normalizer, so the induction can recurse on it.

* `IsPauliNormalizer.exists_cliffordCircuit_fixFirstPair` — **the first-wire reduction.** For any
  `(n+1)`-qubit Pauli normalizer `U`, there is a Clifford circuit `B` such that `B.toMatrix * U` is
  again a normalizer and **fixes the first-wire generators exactly**:

  * `(B U) P_{X₀} (B U)† = P_{X₀}` and `(B U) P_{Z₀} (B U)† = P_{Z₀}`.

  Construction. From `IsPauliNormalizer.exists_signedPerm_symplectic`, `U P_a U† = ε a • P_{σ a}`
  with `σ` symplectic; since `X₀` and `Z₀` anticommute and `σ` preserves the mod-2 symplectic form,
  their images `p = σ X₀`, `q = σ Z₀` anticommute. `exists_cliffordCircuit_reducePair` gives a
  Clifford `E` and pivot `c` reducing `(p, q)` to `(X_c, Z_c)` exactly; `swapWires c 0` prepended to
  `E` relocates the pivot to wire `0` (phase-free), so `A := swapWires c 0 ++ E` maps `p ↦ X₀`,
  `q ↦ Z₀` with `+1` phase. Then `A.toMatrix * U` fixes `X₀, Z₀` up to the residual signs
  `ε(X₀), ε(Z₀)`, which a single-wire sign gadget `G` on wire `0` cancels (each sign squares to
  `1`). `B := G ++ A`.

  This is the setup of Figure 10.9 — the first move of the `n+1` inductive step, after
  which the decoupling of the remaining generators reduces the problem to `n` wires.
-/

open Matrix

noncomputable section

namespace AxQM.Concrete

variable {n : ℕ}

/-! ### The normalizer is closed under multiplication -/

/-- **The Pauli normalizer `N(Gₙ)` is closed under matrix multiplication.** If `A` and `B` are Pauli
normalizers then `A * B` is: the product of two unitaries is unitary (submonoid closure of
`Matrix.unitaryGroup`), and conjugation composes — for a group element `p`, `B p B† = q ∈ Gₙ`
(`B` normalizer) and then `A q A† = r ∈ Gₙ` (`A` normalizer), so `(A B) p (A B)† = r ∈ Gₙ`. This
lets the inductive synthesis of Nielsen & Chuang Exercise 10.40 recurse on the composite
`B.toMatrix * U`
of a Clifford reduction circuit and a normalizer. -/
theorem IsPauliNormalizer.mul {A B : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ}
    (hA : IsPauliNormalizer A) (hB : IsPauliNormalizer B) : IsPauliNormalizer (A * B) := by
  refine ⟨mul_mem hA.1 hB.1, fun p => ?_⟩
  obtain ⟨q, hq⟩ := hB.2 p
  obtain ⟨r, hr⟩ := hA.2 q
  refine ⟨r, ?_⟩
  rw [conjTranspose_mul]
  calc A * B * p.toMat * (Bᴴ * Aᴴ)
      = A * (B * p.toMat * Bᴴ) * Aᴴ := by simp only [Matrix.mul_assoc]
    _ = A * q.toMat * Aᴴ := by rw [hq]
    _ = r.toMat := hr

/-! ### Conjugation plumbing -/

/-- Split a conjugation by a product: `(X Y) P (X Y)† = X (Y P Y†) X†`. Pure matrix associativity
(`conjTranspose_mul` + `mul_assoc`); lets the composite `B.toMatrix * U` be peeled one factor at a
time. Reused by the gate-count companion `exists_cliffordCircuit_fixFirstPair_length_le`. -/
theorem conj_split {N : Type*} [Fintype N]
    (X Y P : Matrix N N ℂ) : (X * Y) * P * (X * Y)ᴴ = X * (Y * P * Yᴴ) * Xᴴ := by
  rw [Matrix.conjTranspose_mul]; simp only [Matrix.mul_assoc]

/-- Conjugating a scaled Pauli string by a Clifford circuit:
`C (z • P_a) C† = z • (sign • P_{act})`, folding `CliffordCircuit.conj_pauliString` through the
scalar. Reused by the gate-count companion `exists_cliffordCircuit_fixFirstPair_length_le`. -/
theorem conj_circuit_smul {m : ℕ} (C : CliffordCircuit m) (z : ℂ) (a : Fin m → Fin 4) :
    C.toMatrix * (z • pauliString a) * C.toMatrixᴴ
      = z • (C.sign a • pauliString (C.act a)) := by
  rw [mul_smul_comm, smul_mul_assoc, CliffordCircuit.conj_pauliString]

/-- The core of the first-wire reduction, applied once for `X₀` and once for `Z₀`. Given a Clifford
circuit `A` reducing the normalizer's generator image `imag` to the generator `gen` exactly
(`A.act imag = gen`, `A.sign imag = 1`), a single-wire sign gadget `G` fixing `gen` with sign `z`
(`G.act gen = gen`, `G.sign gen = z`), the normalizer's conjugation `U P_gen U† = z • P_imag`, and
`z² = 1`, the composite `(G ++ A).toMatrix * U` fixes `gen` under conjugation. The two `z` factors
(one from the normalizer, one from `G`) multiply to `z² = 1`. Reused verbatim by the gate-count
companion `exists_cliffordCircuit_fixFirstPair_length_le`, whose reconstructed `B` fixes `X₀, Z₀`
by the same identity. -/
theorem normalizer_first_fix
    (G A : CliffordCircuit (n + 1)) (U : Matrix (Fin (n + 1) → Fin 2) (Fin (n + 1) → Fin 2) ℂ)
    (gen imag : Fin (n + 1) → Fin 4) (z : ℂ) (hz : z * z = 1)
    (hUconj : U * pauliString gen * Uᴴ = z • pauliString imag)
    (hAact : A.act imag = gen) (hAsign : A.sign imag = 1)
    (hGact : G.act gen = gen) (hGsign : G.sign gen = z) :
    ((G ++ A).toMatrix * U) * pauliString gen * ((G ++ A).toMatrix * U)ᴴ = pauliString gen := by
  rw [CliffordCircuit.toMatrix_append, Matrix.mul_assoc G.toMatrix A.toMatrix U,
    conj_split, conj_split, hUconj, conj_circuit_smul, hAsign, one_smul, hAact,
    conj_circuit_smul, hGsign, hGact, smul_smul, hz, one_smul]

/-! ### The first-wire reduction -/

/-- **The first-wire reduction of a Pauli normalizer (Nielsen & Chuang Exercise 10.40, Figure 10.9
setup).** For any `(n+1)`-qubit Pauli normalizer `U`, there is a Clifford circuit `B` such that
`B.toMatrix * U` is again a Pauli normalizer and **fixes the first-wire generators exactly** under
conjugation:

* `(B U) P_{X₀} (B U)† = P_{X₀}` and `(B U) P_{Z₀} (B U)† = P_{Z₀}`.

The images `p = σ X₀`, `q = σ Z₀` of the first-wire generators under the normalizer's signed
permutation `σ` anticommute (`X₀`, `Z₀` anticommute and `σ` preserves the mod-2 symplectic form,
`exists_signedPerm_symplectic`), so `exists_cliffordCircuit_reducePair` reduces the pair to
`(X_c, Z_c)` on a pivot wire `c` exactly; `swapWires c 0` relocates the pivot to wire `0`. The
composite then fixes `X₀, Z₀` up to the residual `±1` signs `ε(X₀), ε(Z₀)`, cancelled by a
single-wire sign gadget on wire `0` (`exists_cliffordCircuit_onWire_act_sign`, each sign squaring to
`1`). This is the first move of the multi-qubit induction: after it, the remaining generators are
supported on the last `n` wires and the inductive hypothesis applies. -/
theorem IsPauliNormalizer.exists_cliffordCircuit_fixFirstPair
    {U : Matrix (Fin (n + 1) → Fin 2) (Fin (n + 1) → Fin 2) ℂ} (hU : IsPauliNormalizer U) :
    ∃ B : CliffordCircuit (n + 1),
      IsPauliNormalizer (B.toMatrix * U) ∧
        ((B.toMatrix * U) * pauliString (xGenPauli 0) * (B.toMatrix * U)ᴴ
            = pauliString (xGenPauli 0)) ∧
          (B.toMatrix * U) * pauliString (zGenPauli 0) * (B.toMatrix * U)ᴴ
            = pauliString (zGenPauli 0) := by
  obtain ⟨σ, ε, hε, hconj, hsymp⟩ := hU.exists_signedPerm_symplectic
  -- `X₀` and `Z₀` anticommute, hence so do their images `p = σ X₀`, `q = σ Z₀`.
  have hXZ : Odd (pauliAnticommCount (xGenPauli (0 : Fin (n + 1))) (zGenPauli 0)) := by
    rw [odd_pauliAnticommCount_zGenPauli_iff]; left; simp [xGenPauli]
  have hpq : Odd (pauliAnticommCount (σ (xGenPauli 0)) (σ (zGenPauli 0))) := by
    rw [← Nat.not_even_iff_odd]; rw [← Nat.not_even_iff_odd] at hXZ
    exact fun h => hXZ ((hsymp (xGenPauli 0) (zGenPauli 0)).mp h)
  -- Reduce the pair `(p, q)` to `(X_c, Z_c)`, then swap the pivot `c` to wire `0`.
  obtain ⟨E, c, hEp, hEsp, hEq, hEsq⟩ :=
    exists_cliffordCircuit_reducePair (σ (xGenPauli 0)) (σ (zGenPauli 0)) hpq
  set A := swapWires c 0 ++ E with hA
  have hAp : A.act (σ (xGenPauli 0)) = xGenPauli 0 := by
    rw [hA, CliffordCircuit.act_append, hEp, act_swapWires_xGenPauli]
  have hAq : A.act (σ (zGenPauli 0)) = zGenPauli 0 := by
    rw [hA, CliffordCircuit.act_append, hEq, act_swapWires_zGenPauli]
  have hAsp : A.sign (σ (xGenPauli 0)) = 1 := by
    rw [hA, CliffordCircuit.sign_append, hEsp, sign_swapWires, mul_one]
  have hAsq : A.sign (σ (zGenPauli 0)) = 1 := by
    rw [hA, CliffordCircuit.sign_append, hEsq, sign_swapWires, mul_one]
  -- A single-wire sign gadget on wire `0` correcting the residual signs `ε(X₀), ε(Z₀)`.
  obtain ⟨G, hGaX, hGsX, hGaZ, hGsZ, -⟩ :=
    exists_cliffordCircuit_onWire_act_sign (0 : Fin (n + 1)) (aX := 1) (aZ := 3)
      (by decide) (by decide) (by decide) (hε (xGenPauli 0)) (hε (zGenPauli 0))
  have hsq : ∀ a, ε a * ε a = 1 := fun a => by rcases hε a with h | h <;> rw [h] <;> ring
  refine ⟨G ++ A, (cliffordCircuit_isPauliNormalizer (G ++ A)).mul hU, ?_, ?_⟩
  · exact normalizer_first_fix G A U (xGenPauli 0) (σ (xGenPauli 0)) (ε (xGenPauli 0))
      (hsq (xGenPauli 0)) (hconj (xGenPauli 0)) hAp hAsp hGaX hGsX
  · exact normalizer_first_fix G A U (zGenPauli 0) (σ (zGenPauli 0)) (ε (zGenPauli 0))
      (hsq (zGenPauli 0)) (hconj (zGenPauli 0)) hAq hAsq hGaZ hGsZ

end AxQM.Concrete

end
