import AxQM.Concrete.PauliNormalizer
import AxQM.Concrete.PauliStringEncodingPhaseCZLayer

/-!
# Concrete: a unitary is fixed up to a global phase by its conjugation of the generators

This file is part of the formalisation of
Nielsen & Chuang **Theorem 10.6** (the converse — the normalizer `N(Gₙ)` is generated by
Hadamard/phase/CNOT gates, Exercise 10.40). It proves the **multi-qubit generator-determinacy
lemma**: a unitary on `n` qubits is determined, up to a global phase, by how it conjugates the `2n`
single-qubit generators `Xᵢ = xGenPauli i` and `Zᵢ = zGenPauli i`.

This is the multi-qubit generalisation of the single-qubit
`unitary_eq_smul_of_conj_singleQubit_XZ`, and it is exactly the reduction that turns the *inductive
synthesis* of Exercise 10.40 (parts 2–3) from *matching a normalizer's full signed permutation on
all `4ⁿ` Pauli strings* into the finite, combinatorial task of *matching it on the `2n` generators*
— the datum a Clifford circuit is actually built to reproduce. Its Clifford-circuit corollary
`unitary_eq_smul_cliffordCircuit_of_conj_generators` is the direct handle for the synthesis: build a
Clifford circuit whose phase-free action and `±1` sign agree with `U`'s conjugation on every `Xᵢ`
and `Zᵢ`, and `U` equals that circuit up to a unit global phase.

## What is proved

* `pauliString_peel_wire` — **peel one wire off a Pauli string.** `P_a = P_{a'} · P_{b}` where
  `a' = Function.update a i 0` zeroes wire `i` and `b = Function.update 0 i (a i)` is the
  single-wire Pauli on wire `i`. The two factors overlap on no wire, so the Pauli-string product law
  (`pauliString_mul_eq_smul`) contributes index `a` and phase `1`. This is the recursion that
  expresses any Pauli string as a product of single-wire generators.

* `pauliString_yGenPauli_eq_smul_mul` — **`Yᵢ = i · Xᵢ Zᵢ`** on any wire: `P_{Yᵢ} = i • (P_{Xᵢ} ·
  P_{Zᵢ})`. The multi-qubit analogue of `pauliString_two_eq_smul_mul`; it writes the third
  single-wire Pauli through the two generators `Xᵢ, Zᵢ`, so agreement on `X` and `Z` forces
  agreement on `Y`.

* `unitary_eq_smul_of_conj_generators` — **generator-determinacy.** If two unitaries `U, V`
  conjugate every `Xᵢ` and every `Zᵢ` identically, then `U = c • V` with `‖c‖ = 1`. The agreement is
  closed under products (multiplicativity of conjugation by an isometry,
  `conj_mul_conj_of_conjTranspose_mul_self`) and scalars, contains `Xᵢ, Zᵢ`, hence `Yᵢ` and the
  identity; a `Finset.induction` on the support peels the string wire by wire
  (`pauliString_peel_wire`) down to generators, giving agreement on every Pauli string, and
  `unitary_eq_smul_of_conj_pauliString_eq` concludes.

* `unitary_eq_smul_cliffordCircuit_of_conj_generators` — **synthesis reduces to matching on
  generators.** If a unitary `U` conjugates every `Xᵢ` and `Zᵢ` exactly as a Clifford circuit `C`
  does (`U P_{Xᵢ} U† = C.sign (Xᵢ) • P_{C.act (Xᵢ)}`, and likewise for `Zᵢ`), then `U = c •
  C.toMatrix`, `‖c‖ = 1`. Immediate from generator-determinacy once `C`'s conjugation is folded
  through `CliffordCircuit.conj_pauliString`. This is the multi-qubit refinement of
  `unitary_eq_smul_cliffordCircuit_of_conj_eq` (which required matching on *all* Pauli strings): the
  inductive synthesis of Exercise 10.40 need only reproduce the normalizer's action on the `2n`
  generators.
-/

open Matrix

noncomputable section

namespace AxQM.Concrete

variable {n : ℕ}

/-! ### Zero cases of the single-qubit Pauli product tables -/

/-- The identity Pauli is a left unit for the index product: `pauliMul 0 b = b`. -/
private theorem pauliMul_zero_left (b : Fin 4) : pauliMul 0 b = b := by fin_cases b <;> rfl

/-- The identity Pauli is a right unit for the index product: `pauliMul a 0 = a`. -/
private theorem pauliMul_zero_right (a : Fin 4) : pauliMul a 0 = a := by fin_cases a <;> rfl

/-- The identity Pauli contributes trivial phase on the left: `pauliMulPhase 0 b = 1`. -/
private theorem pauliMulPhase_zero_left (b : Fin 4) : pauliMulPhase 0 b = 1 := by
  fin_cases b <;> rfl

/-- The identity Pauli contributes trivial phase on the right: `pauliMulPhase a 0 = 1`. -/
private theorem pauliMulPhase_zero_right (a : Fin 4) : pauliMulPhase a 0 = 1 := by
  fin_cases a <;> rfl

/-! ### Peeling a wire off a Pauli string, and `Y = i X Z` on a wire -/

/-- **Peel one wire off a Pauli string.** For any Pauli string `a : Fin n → Fin 4` and wire `i`,
`P_a = P_{a'} · P_{b}` where `a' = Function.update a i 0` zeroes wire `i` and `b = Function.update 0
i (a i)` is the single-wire Pauli carrying `a`'s letter on wire `i`. The two factors are supported
on disjoint wires (`a'` is `I` on wire `i`; `b` is `I` off wire `i`), so in the Pauli-string product
law (`pauliString_mul_eq_smul`) every per-wire product is with an identity — the product index is
`a` (`pauliMul` has `0` as a unit) and the total phase is `1`. This is the recursion expressing any
Pauli string as a product of single-wire generators. -/
theorem pauliString_peel_wire (a : Fin n → Fin 4) (i : Fin n) :
    pauliString a
      = pauliString (Function.update a i 0)
        * pauliString (Function.update (0 : Fin n → Fin 4) i (a i)) := by
  rw [pauliString_mul_eq_smul]
  have hidx :
      pauliMulIndex (Function.update a i 0) (Function.update (0 : Fin n → Fin 4) i (a i)) = a := by
    funext k
    rcases eq_or_ne k i with hk | hk
    · subst hk
      simp only [pauliMulIndex, Function.update_self, pauliMul_zero_left]
    · simp only [pauliMulIndex, Function.update_of_ne hk, Pi.zero_apply, pauliMul_zero_right]
  have hph :
      (∏ k, pauliMulPhase (Function.update a i 0 k)
          (Function.update (0 : Fin n → Fin 4) i (a i) k)) = 1 := by
    refine Finset.prod_eq_one (fun k _ => ?_)
    rcases eq_or_ne k i with hk | hk
    · subst hk
      simp only [Function.update_self, pauliMulPhase_zero_left]
    · simp only [Function.update_of_ne hk, Pi.zero_apply, pauliMulPhase_zero_right]
  rw [hidx, hph, one_smul]

/-- **`Yᵢ = i · Xᵢ Zᵢ` on any wire.** `P_{yGenPauli i} = i • (P_{xGenPauli i} · P_{zGenPauli i})`.
From the Pauli-string product law, `Xᵢ Zᵢ = (∏ₖ ζ) • P_{idx}` where the only non-trivial factor is
on wire `i` (`ζ(X, Z) = -i`) and the product index is `Yᵢ`; `i · (-i) = 1`. The multi-qubit
analogue of `pauliString_two_eq_smul_mul`, expressing the single-wire `Y` generator through the two
generators `X, Z`. -/
theorem pauliString_yGenPauli_eq_smul_mul (i : Fin n) :
    pauliString (yGenPauli i)
      = Complex.I • (pauliString (xGenPauli i) * pauliString (zGenPauli i)) := by
  rw [pauliString_mul_eq_smul, smul_smul]
  have hidx : pauliMulIndex (xGenPauli i) (zGenPauli i) = yGenPauli i := by
    funext k
    rcases eq_or_ne k i with hk | hk
    · subst hk
      simp only [pauliMulIndex, xGenPauli, zGenPauli, yGenPauli, Function.update_self]
      rfl
    · simp only [pauliMulIndex, xGenPauli, zGenPauli, yGenPauli, Function.update_of_ne hk,
        Pi.zero_apply]
      rfl
  rw [hidx]
  have hprod : (∏ k, pauliMulPhase (xGenPauli i k) (zGenPauli i k)) = -Complex.I := by
    rw [Finset.prod_eq_single i]
    · simp only [xGenPauli, zGenPauli, Function.update_self]; rfl
    · intro k _ hki
      simp only [xGenPauli, zGenPauli, Function.update_of_ne hki, Pi.zero_apply,
        pauliMulPhase_zero_left]
    · intro hi; exact absurd (Finset.mem_univ i) hi
  rw [hprod, mul_neg, Complex.I_mul_I, neg_neg, one_smul]

/-! ### Generator-determinacy up to a global phase -/

/-- **A unitary is determined up to a global phase by how it conjugates the generators `Xᵢ, Zᵢ`.**
If two unitaries `U, V` on `n` qubits agree on conjugating every single-qubit `X` generator
(`U P_{Xᵢ} U† = V P_{Xᵢ} V†`) and every `Z` generator (likewise `Zᵢ`), then `U = c • V` for a unit
scalar `c` (`‖c‖ = 1`). The `2n` generators fix the whole conjugation action: the identity goes to
the identity (unitarity), each `Yᵢ = i Xᵢ Zᵢ` is forced by multiplicativity of conjugation
(`conj_mul_conj_of_conjTranspose_mul_self`, `pauliString_yGenPauli_eq_smul_mul`), and any Pauli
string is peeled wire by wire into single-wire generators (`pauliString_peel_wire`, by
`Finset.induction` on the support); `unitary_eq_smul_of_conj_pauliString_eq` then concludes. This is
the multi-qubit generalisation of `unitary_eq_smul_of_conj_singleQubit_XZ`, and it reduces the
inductive synthesis of Nielsen & Chuang Exercise 10.40 (parts 2–3) from matching the normalizer's
full signed permutation to matching it on the `2n` generators. -/
theorem unitary_eq_smul_of_conj_generators
    {U V : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ}
    (hU : U ∈ Matrix.unitaryGroup (Fin n → Fin 2) ℂ)
    (hV : V ∈ Matrix.unitaryGroup (Fin n → Fin 2) ℂ)
    (hX : ∀ i, U * pauliString (xGenPauli i) * Uᴴ = V * pauliString (xGenPauli i) * Vᴴ)
    (hZ : ∀ i, U * pauliString (zGenPauli i) * Uᴴ = V * pauliString (zGenPauli i) * Vᴴ) :
    ∃ c : ℂ, ‖c‖ = 1 ∧ U = c • V := by
  have hUUH : U * Uᴴ = 1 := by simpa [star_eq_conjTranspose] using mem_unitaryGroup_iff.mp hU
  have hVVH : V * Vᴴ = 1 := by simpa [star_eq_conjTranspose] using mem_unitaryGroup_iff.mp hV
  have hUHU : Uᴴ * U = 1 := by simpa [star_eq_conjTranspose] using mem_unitaryGroup_iff'.mp hU
  have hVHV : Vᴴ * V = 1 := by simpa [star_eq_conjTranspose] using mem_unitaryGroup_iff'.mp hV
  -- agreement on any single-wire Pauli, by cases on the wire's letter
  have hsingle : ∀ (i : Fin n) (c : Fin 4),
      U * pauliString (Function.update 0 i c) * Uᴴ
        = V * pauliString (Function.update 0 i c) * Vᴴ := by
    intro i c
    -- `I` on wire `i` : the whole string is the identity
    have hI : U * pauliString (Function.update (0 : Fin n → Fin 4) i (0 : Fin 4)) * Uᴴ
        = V * pauliString (Function.update (0 : Fin n → Fin 4) i (0 : Fin 4)) * Vᴴ := by
      have hs0 : pauliString (Function.update (0 : Fin n → Fin 4) i (0 : Fin 4)) = 1 := by
        rw [pauliString_eq_one_iff]
        funext k
        rcases eq_or_ne k i with hk | hk
        · subst hk; simp
        · rw [Function.update_of_ne hk]
      rw [hs0, Matrix.mul_one, Matrix.mul_one, hUUH, hVVH]
    -- `Y` on wire `i`, through `Y = i X Z` and multiplicativity of conjugation
    have hY : U * pauliString (yGenPauli i) * Uᴴ = V * pauliString (yGenPauli i) * Vᴴ := by
      rw [pauliString_yGenPauli_eq_smul_mul, mul_smul_comm, smul_mul_assoc, mul_smul_comm,
        smul_mul_assoc]
      refine congrArg (_ • ·) ?_
      rw [← conj_mul_conj_of_conjTranspose_mul_self hUHU,
        ← conj_mul_conj_of_conjTranspose_mul_self hVHV, hX i, hZ i]
    fin_cases c
    · exact hI
    · exact hX i
    · exact hY
    · exact hZ i
  -- agreement on every Pauli string, by induction on the support
  have hall : ∀ a : Fin n → Fin 4, U * pauliString a * Uᴴ = V * pauliString a * Vᴴ := by
    have hind : ∀ (s : Finset (Fin n)) (a : Fin n → Fin 4),
        (∀ k, k ∉ s → a k = 0) → U * pauliString a * Uᴴ = V * pauliString a * Vᴴ := by
      intro s
      induction s using Finset.induction with
      | empty =>
          intro a ha
          have ha0 : a = 0 := by funext k; exact ha k (by simp)
          subst ha0
          rw [(pauliString_eq_one_iff (0 : Fin n → Fin 4)).mpr rfl, Matrix.mul_one, Matrix.mul_one,
            hUUH, hVVH]
      | @insert i s' hi ih =>
          intro a ha
          have ha' : ∀ k, k ∉ s' → Function.update a i 0 k = 0 := by
            intro k hk
            rcases eq_or_ne k i with hki | hki
            · subst hki; simp
            · rw [Function.update_of_ne hki]
              exact ha k (by simp [Finset.mem_insert, hki, hk])
          have hIH := ih (Function.update a i 0) ha'
          rw [pauliString_peel_wire a i, ← conj_mul_conj_of_conjTranspose_mul_self hUHU, hIH,
            hsingle i (a i), conj_mul_conj_of_conjTranspose_mul_self hVHV]
    intro a
    exact hind Finset.univ a (fun k hk => absurd (Finset.mem_univ k) hk)
  exact unitary_eq_smul_of_conj_pauliString_eq hU hV hall

/-- **The converse of Theorem 10.6 reduces to matching a Clifford circuit on the generators.** If a
unitary `U` conjugates every generator `Xᵢ` and `Zᵢ` exactly as a Clifford circuit `C` does —
`U P_{Xᵢ} U† = C.sign (Xᵢ) • P_{C.act (Xᵢ)}` and likewise for `Zᵢ` — then `U` equals `C` up to a
unit global phase: `∃ c, ‖c‖ = 1 ∧ U = c • C.toMatrix`. Immediate from
`unitary_eq_smul_of_conj_generators` once `C`'s conjugation is folded back through
`CliffordCircuit.conj_pauliString`. This is the multi-qubit refinement of
`unitary_eq_smul_cliffordCircuit_of_conj_eq` (which matched on *all* Pauli strings): the inductive
synthesis of Nielsen & Chuang Exercise 10.40 (parts 2–3) need only reproduce the normalizer's action
on the `2n` generators. -/
theorem unitary_eq_smul_cliffordCircuit_of_conj_generators
    {U : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ}
    (hU : U ∈ Matrix.unitaryGroup (Fin n → Fin 2) ℂ) (C : CliffordCircuit n)
    (hX : ∀ i, U * pauliString (xGenPauli i) * Uᴴ
        = CliffordCircuit.sign C (xGenPauli i) • pauliString (CliffordCircuit.act C (xGenPauli i)))
    (hZ : ∀ i, U * pauliString (zGenPauli i) * Uᴴ
        = CliffordCircuit.sign C (zGenPauli i)
          • pauliString (CliffordCircuit.act C (zGenPauli i))) :
    ∃ c : ℂ, ‖c‖ = 1 ∧ U = c • CliffordCircuit.toMatrix C := by
  have hCmem : CliffordCircuit.toMatrix C ∈ Matrix.unitaryGroup (Fin n → Fin 2) ℂ := by
    rw [mem_unitaryGroup_iff, star_eq_conjTranspose]; exact CliffordCircuit.mul_conjTranspose C
  refine unitary_eq_smul_of_conj_generators hU hCmem (fun i => ?_) (fun i => ?_)
  · rw [hX i, ← CliffordCircuit.conj_pauliString C (xGenPauli i)]
  · rw [hZ i, ← CliffordCircuit.conj_pauliString C (zGenPauli i)]

/-! ### Nielsen & Chuang Exercise 10.38 — the two-qubit specialisation

Exercise 10.38 is the two-qubit (`n = 2`) case of `unitary_eq_smul_of_conj_generators`: the four
generators are `X₁ = xGenPauli 0`, `X₂ = xGenPauli 1` (Pauli `X` on wire `0`, resp. `1`) and
`Z₁ = zGenPauli 0`, `Z₂ = zGenPauli 1`. N&C phrase the conclusion as "`U = V`"; taken literally
this is *false* — conjugation is insensitive to a global phase, so `U` and `c • U` (`‖c‖ = 1`)
always act identically — and the honest statement is equality *up to a global phase*, exactly as
N&C's own Theorem 10.6 states one line later on the same page.
`exists_ne_unitary_conj_twoQubitGenerators_eq` records that the phase genuinely cannot be
dropped. -/

/-- **Nielsen & Chuang, Exercise 10.38.** Two unitaries `U, V` on two qubits that conjugate the four
generators `X₁ = X ⊗ I`, `X₂ = I ⊗ X`, `Z₁ = Z ⊗ I`, `Z₂ = I ⊗ Z` — i.e. `pauliString (xGenPauli i)`
and `pauliString (zGenPauli i)` for `i ∈ {0, 1}` — in the same way agree up to a global phase:
`U = c • V` for a unit scalar `c` (`‖c‖ = 1`). N&C write "`U = V`", but the global phase is
unavoidable (see `exists_ne_unitary_conj_twoQubitGenerators_eq`). This is the `n = 2` case of the
multi-qubit generator-determinacy lemma `unitary_eq_smul_of_conj_generators`: the four generators
`Z₁, Z₂, X₁, X₂` fix the whole conjugation action, because the `16` Pauli strings on two qubits are
products of them up to phase. -/
theorem unitary_eq_smul_of_conj_twoQubitGenerators
    {U V : Matrix (Fin 2 → Fin 2) (Fin 2 → Fin 2) ℂ}
    (hU : U ∈ Matrix.unitaryGroup (Fin 2 → Fin 2) ℂ)
    (hV : V ∈ Matrix.unitaryGroup (Fin 2 → Fin 2) ℂ)
    (hX₁ : U * pauliString (xGenPauli 0) * Uᴴ = V * pauliString (xGenPauli 0) * Vᴴ)
    (hX₂ : U * pauliString (xGenPauli 1) * Uᴴ = V * pauliString (xGenPauli 1) * Vᴴ)
    (hZ₁ : U * pauliString (zGenPauli 0) * Uᴴ = V * pauliString (zGenPauli 0) * Vᴴ)
    (hZ₂ : U * pauliString (zGenPauli 1) * Uᴴ = V * pauliString (zGenPauli 1) * Vᴴ) :
    ∃ c : ℂ, ‖c‖ = 1 ∧ U = c • V :=
  unitary_eq_smul_of_conj_generators hU hV
    (Fin.forall_fin_two.mpr ⟨hX₁, hX₂⟩) (Fin.forall_fin_two.mpr ⟨hZ₁, hZ₂⟩)

/-- **The global phase in Exercise 10.38 is necessary.** N&C's literal "`U = V`" fails: the identity
`1` and its negation `-1` are two *distinct* two-qubit unitaries that conjugate every generator
(indeed every operator) identically, since conjugation by a global phase acts trivially. Hence the
conclusion of `unitary_eq_smul_of_conj_twoQubitGenerators` cannot be strengthened from `U = c • V`
to `U = V`. -/
theorem exists_ne_unitary_conj_twoQubitGenerators_eq :
    ∃ U V : Matrix (Fin 2 → Fin 2) (Fin 2 → Fin 2) ℂ,
      U ∈ Matrix.unitaryGroup (Fin 2 → Fin 2) ℂ ∧
      V ∈ Matrix.unitaryGroup (Fin 2 → Fin 2) ℂ ∧
      U * pauliString (xGenPauli 0) * Uᴴ = V * pauliString (xGenPauli 0) * Vᴴ ∧
      U * pauliString (xGenPauli 1) * Uᴴ = V * pauliString (xGenPauli 1) * Vᴴ ∧
      U * pauliString (zGenPauli 0) * Uᴴ = V * pauliString (zGenPauli 0) * Vᴴ ∧
      U * pauliString (zGenPauli 1) * Uᴴ = V * pauliString (zGenPauli 1) * Vᴴ ∧
      U ≠ V := by
  refine ⟨1, -1, Submonoid.one_mem _, ?mem, ?_, ?_, ?_, ?_, ?ne⟩
  case mem => rw [mem_unitaryGroup_iff, star_neg, star_one]; noncomm_ring
  case ne =>
    intro h
    have h00 := congrFun (congrFun h (fun _ => 0)) (fun _ => 0)
    simp only [Matrix.one_apply_eq, Matrix.neg_apply] at h00
    norm_num at h00
  -- the four generator-conjugation goals are all `1 · P · 1ᴴ = -1 · P · (-1)ᴴ`, i.e. `P = P`
  all_goals (rw [conjTranspose_one, conjTranspose_neg, conjTranspose_one]; noncomm_ring)

end AxQM.Concrete

end
