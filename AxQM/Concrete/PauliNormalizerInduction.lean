import AxQM.Concrete.PauliNormalizerRestrictNormalizer
import AxQM.Concrete.PauliNormalizerFirstPair
import AxQM.Concrete.PauliNormalizerGenerators
import AxQM.Concrete.CliffordCircuitInverse

/-!
# Concrete: the multi-qubit inductive synthesis — every normalizer is a phase times a Clifford
circuit (N&C Theorem 10.6, converse; Exercise 10.40, Fig 10.9)

This file completes the *existence* content of Nielsen & Chuang **Theorem 10.6** (the converse —
the normalizer `N(Gₙ)` is generated by Hadamard/phase/CNOT gates), stated over `2ⁿ × 2ⁿ` unitary
matrices.

`isPauliNormalizer_eq_smul_cliffordCircuit` proves: *every* `n`-qubit Pauli normalizer `U` equals a
global phase times a Clifford circuit, `U = c • C.toMatrix` with `‖c‖ = 1`. This is the inductive
synthesis of Exercise 10.40, assembling the machinery of the earlier files. The `O(n²)` gate-count
bound of Theorem 10.6 is in `AxQM/Concrete/PauliNormalizerGateCountSynthesis.lean`.

## The induction (Figure 10.9)

Induction on the qubit count `n`, peeling the sub-register `{1, …, n}` off wire `0` at each step.

* **Base `n = 0`.** The register `Fin 0 → Fin 2` is a singleton, so `U` is a `1×1` unitary — a
  scalar `c` of modulus `1` — and the empty circuit has matrix `1`, giving `U = c • 1`.
* **Step `n + 1`.** Given the inductive hypothesis on `n`-qubit normalizers:
  1. `IsPauliNormalizer.exists_cliffordCircuit_fixFirstPair` produces a Clifford circuit `B`
     with `M := B.toMatrix * U` again a normalizer that **fixes** `X₀` and `Z₀` under conjugation.
  2. `firstWireRestrict_isPauliNormalizer` packages the restriction
     `M' := firstWireRestrict M` as a bona fide `n`-qubit normalizer.
  3. The inductive hypothesis gives an `n`-wire Clifford circuit `C'` and phase `c'` with
     `M' = c' • C'.toMatrix`.
  4. `B' := C'.relabel ⟨Fin.succ, …⟩` embeds `C'` onto the last `n` wires.
  5. `M` and `B'` conjugate **every** generator identically
     (`unitary_eq_smul_cliffordCircuit_of_conj_generators`): `X₀, Z₀` are fixed by both (`B'` never
     touches wire `0`), and for `i = succ j` the
     block-diagonal correspondence `M P_{cons 0 a} M† = I₂ ⊗ (M' P_a M'†)` matches `M`'s
     action on the last-`n`-wire generators to `B'`'s. Hence `M = c • B'.toMatrix`, `‖c‖ = 1`.
  6. Left-cancelling `B` with its inverse (`CliffordCircuit.inverse`) gives
     `U = c • (inverse B ++ B').toMatrix`.

## What is proved

Alongside the headline `isPauliNormalizer_eq_smul_cliffordCircuit`, the file records the small
reusable bridges the step needs:

* `CliffordCircuit.act_const_zero` / `sign_const_zero` — a Clifford circuit fixes the identity Pauli
  string (`act C 0 = 0`, `sign C 0 = 1`): conjugating `1 = P_0` gives `1` with phase `1`.
* `xGenPauli_zero_eq_cons` / `zGenPauli_zero_eq_cons` / `xGenPauli_succ_eq_cons` /
  `zGenPauli_succ_eq_cons` — the standard generators as `Fin.cons` strings (`X₀ = cons 1 0`,
  `Xᵢ₊₁ = cons 0 Xᵢ`, and the `Z` mirrors), so the wire-`0` head is exposed.
* `CliffordCircuit.relabelSucc_act_cons` / `relabelSucc_sign_cons` — the action and `±1` phase of a
  circuit relabeled onto the last `n` wires, on a `Fin.cons` string: `(relabel succ C).act (cons a₀
  h) = cons a₀ (C.act h)` and `(relabel succ C).sign (cons a₀ h) = C.sign h`. Wire `0` is untouched;
  the last `n` wires transform by `C` on the tail.
* `smul_conjTranspose_conj_cancel` — a unit global phase cancels in a conjugation:
  `(c • V) P (c • V)† = V P V†` when `‖c‖ = 1`.
-/

open Matrix

noncomputable section

namespace AxQM.Concrete

variable {n : ℕ}

/-! ### A Clifford circuit fixes the identity Pauli string -/

/-- **A Clifford circuit fixes the identity string's index**: `act C 0 = 0`. Each elementary gate
sends the identity letter to itself (`hadamardPauli 0 = phasePauli 0 = 0`, and `cnotPauliString`
leaves an all-identity string fixed), so the fold does nothing. By induction on the gate list. -/
theorem CliffordCircuit.act_const_zero (C : CliffordCircuit n) :
    CliffordCircuit.act C (0 : Fin n → Fin 4) = 0 := by
  induction C with
  | nil => rfl
  | cons γ C ih =>
      change γ.act (CliffordCircuit.act C (0 : Fin n → Fin 4)) = 0
      rw [ih]
      cases γ with
      | had j => simp [CliffordGate.act, hadamardPauli]
      | phase j => simp [CliffordGate.act, phasePauli]
      | cnot c t h =>
          change cnotPauliString (0 : Fin n → Fin 4) c t = 0
          funext k
          by_cases hkc : k = c
          · subst hkc; rw [cnotPauliString_ctrl]; rfl
          · by_cases hkt : k = t
            · subst hkt; rw [cnotPauliString_tgt _ h]; rfl
            · rw [cnotPauliString_of_ne _ c t hkc hkt]

/-- **A Clifford circuit acquires no phase conjugating the identity string**: `sign C 0 = 1`. Each
elementary gate's phase on the identity letter is `1` (`hadamardPauliSign 0 = phasePauliSign 0 =
cnotPauliSign 0 0 = 1`); the intermediate strings stay all-identity by `act_const_zero`. By
induction on the gate list. -/
theorem CliffordCircuit.sign_const_zero (C : CliffordCircuit n) :
    CliffordCircuit.sign C (0 : Fin n → Fin 4) = 1 := by
  induction C with
  | nil => rfl
  | cons γ C ih =>
      change CliffordCircuit.sign C (0 : Fin n → Fin 4)
        * γ.sign (CliffordCircuit.act C (0 : Fin n → Fin 4)) = 1
      rw [ih, CliffordCircuit.act_const_zero, one_mul]
      cases γ with
      | had j => simp [CliffordGate.sign, hadamardPauliSign]
      | phase j => simp [CliffordGate.sign, phasePauliSign]
      | cnot c t h => rfl

/-! ### The standard generators as `Fin.cons` strings -/

/-- **`X₀ = cons 1 0`**: the first-wire `X` generator on `n+1` wires is `X` on wire `0` and identity
elsewhere. -/
theorem xGenPauli_zero_eq_cons :
    xGenPauli (0 : Fin (n + 1)) = Fin.cons (1 : Fin 4) (0 : Fin n → Fin 4) := by
  funext k
  refine Fin.cases ?_ ?_ k
  · simp [xGenPauli]
  · intro i; simp [xGenPauli, Fin.succ_ne_zero]

/-- **`Z₀ = cons 3 0`**: the first-wire `Z` generator on `n+1` wires is `Z` on wire `0` and identity
elsewhere. -/
theorem zGenPauli_zero_eq_cons :
    zGenPauli (0 : Fin (n + 1)) = Fin.cons (3 : Fin 4) (0 : Fin n → Fin 4) := by
  funext k
  refine Fin.cases ?_ ?_ k
  · simp [zGenPauli]
  · intro i; simp [zGenPauli, Fin.succ_ne_zero]

/-- **`Xᵢ₊₁ = cons 0 Xᵢ`**: the `X` generator on wire `succ i` is identity on wire `0` and the
`n`-wire `X` generator `Xᵢ` on the last `n` wires. -/
theorem xGenPauli_succ_eq_cons (i : Fin n) :
    xGenPauli (Fin.succ i) = Fin.cons (0 : Fin 4) (xGenPauli i) := by
  funext k
  refine Fin.cases ?_ ?_ k
  · simp [xGenPauli, (Fin.succ_ne_zero i).symm]
  · intro j; simp [xGenPauli_apply, Fin.cons_succ, (Fin.succ_injective n).eq_iff]

/-- **`Zᵢ₊₁ = cons 0 Zᵢ`**: the `Z` generator on wire `succ i` is identity on wire `0` and the
`n`-wire `Z` generator `Zᵢ` on the last `n` wires. -/
theorem zGenPauli_succ_eq_cons (i : Fin n) :
    zGenPauli (Fin.succ i) = Fin.cons (0 : Fin 4) (zGenPauli i) := by
  funext k
  refine Fin.cases ?_ ?_ k
  · simp [zGenPauli, (Fin.succ_ne_zero i).symm]
  · intro j; simp [zGenPauli_apply, Fin.cons_succ, (Fin.succ_injective n).eq_iff]

/-! ### A circuit relabeled onto the last `n` wires, on a `Fin.cons` string -/

/-- **The action of a circuit relabeled onto the last `n` wires, on a `Fin.cons` string**:
`(relabel ⟨Fin.succ,·⟩ C).act (cons a₀ h) = cons a₀ (C.act h)`. Wire `0` is outside the range of
`Fin.succ`, so it is left untouched (`act_relabel_of_forall_ne`); on the last `n` wires the
relabeled circuit acts as `C` on the tail `h` (`act_relabel_embed`, `Fin.cons_succ`). -/
theorem CliffordCircuit.relabelSucc_act_cons (C : CliffordCircuit n) (a₀ : Fin 4)
    (h : Fin n → Fin 4) :
    CliffordCircuit.act (C.relabel ⟨Fin.succ, Fin.succ_injective n⟩) (Fin.cons a₀ h)
      = Fin.cons a₀ (CliffordCircuit.act C h) := by
  funext k
  refine Fin.cases ?_ ?_ k
  · rw [CliffordCircuit.act_relabel_of_forall_ne _ _ _ (fun i => Fin.succ_ne_zero i),
      Fin.cons_zero, Fin.cons_zero]
  · intro i
    rw [Fin.cons_succ]
    have h1 := CliffordCircuit.act_relabel_embed ⟨Fin.succ, Fin.succ_injective n⟩ C
      (Fin.cons a₀ h) i
    simp only [Function.Embedding.coeFn_mk, Fin.cons_succ] at h1
    exact h1

/-- **The `±1` phase of a circuit relabeled onto the last `n` wires, on a `Fin.cons` string**:
`(relabel ⟨Fin.succ,·⟩ C).sign (cons a₀ h) = C.sign h`. The phase pulls back along `Fin.succ`
(`sign_relabel`) to the tail `h` (`Fin.cons_succ`). -/
theorem CliffordCircuit.relabelSucc_sign_cons (C : CliffordCircuit n) (a₀ : Fin 4)
    (h : Fin n → Fin 4) :
    CliffordCircuit.sign (C.relabel ⟨Fin.succ, Fin.succ_injective n⟩) (Fin.cons a₀ h)
      = CliffordCircuit.sign C h := by
  simp only [CliffordCircuit.sign_relabel, Function.Embedding.coeFn_mk, Fin.cons_succ]

/-! ### A unit global phase cancels in a conjugation -/

/-- **A unit global phase cancels in a conjugation**: for `‖c‖ = 1`, `(c • V) P (c • V)† = V P V†`.
The scalars collect to `c * star c = ‖c‖² = 1`. -/
theorem smul_conjTranspose_conj_cancel {c : ℂ} (hc : ‖c‖ = 1)
    (V P : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ) :
    (c • V) * P * (c • V)ᴴ = V * P * Vᴴ := by
  have hcc : c * star c = 1 := by simp [RCLike.mul_conj, hc]
  rw [conjTranspose_smul, smul_mul_assoc, smul_mul_smul_comm, hcc, one_smul]

/-! ### The inductive synthesis -/

/-- **Nielsen & Chuang, Theorem 10.6 (converse), the existence content.** Every `n`-qubit Pauli
normalizer `U` equals a global phase times a Clifford (`H`/`S`/`CNOT`) circuit:
`∃ C c, ‖c‖ = 1 ∧ U = c • C.toMatrix`. This is the multi-qubit inductive synthesis of Exercise
10.40 (Figure 10.9), assembled from the earlier files; the `O(n²)` gate-count bound and the headline
packaging are in `PauliNormalizerGateCountSynthesis.lean`. See the module docstring for the step
structure. -/
theorem isPauliNormalizer_eq_smul_cliffordCircuit {n : ℕ}
    {U : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ} (hU : IsPauliNormalizer U) :
    ∃ (C : CliffordCircuit n) (c : ℂ), ‖c‖ = 1 ∧ U = c • CliffordCircuit.toMatrix C := by
  induction n with
  | zero =>
      -- `Fin 0 → Fin 2` is a singleton: `U` is a `1×1` unitary, the empty circuit's matrix is `1`.
      refine ⟨[], U default default, ?_, ?_⟩
      · have hUU : Uᴴ * U = 1 := by
          have h := mem_unitaryGroup_iff'.mp hU.1
          rwa [star_eq_conjTranspose] at h
        have h1 := congrFun (congrFun hUU default) default
        simp only [Matrix.mul_apply, Matrix.one_apply_eq] at h1
        rw [Finset.sum_eq_single default] at h1
        · rw [Matrix.conjTranspose_apply] at h1
          have hnn : ‖U default default‖ * ‖U default default‖ = 1 := by
            have := congrArg norm h1
            rwa [norm_mul, norm_star, norm_one] at this
          nlinarith [norm_nonneg (U default default), hnn]
        · intro b _ hb; exact absurd (Subsingleton.elim b default) hb
        · intro h; exact absurd (Finset.mem_univ default) h
      · funext i j
        rw [Subsingleton.elim i default, Subsingleton.elim j default]
        simp [CliffordCircuit.toMatrix, Matrix.one_apply_eq]
  | succ n ih =>
      -- Step 1: reduce `U` to a normalizer `M = B U` fixing `X₀, Z₀`.
      obtain ⟨B, hM, hMX, hMZ⟩ := hU.exists_cliffordCircuit_fixFirstPair
      set M := B.toMatrix * U with hMdef
      -- Step 2: the restriction `M' = firstWireRestrict M` is an `n`-qubit normalizer.
      have hM' : IsPauliNormalizer (firstWireRestrict M) :=
        firstWireRestrict_isPauliNormalizer hM hMX hMZ
      set M' := firstWireRestrict M with hM'def
      -- Step 3: apply the inductive hypothesis to `M'`.
      obtain ⟨C', c', hc', hC'eq⟩ := ih hM'
      -- Step 4: embed `C'` onto the last `n` wires.
      set B' := C'.relabel ⟨Fin.succ, Fin.succ_injective n⟩ with hB'def
      -- Step 5: `M` matches `B'` on every generator, so `M = c • B'.toMatrix`.
      -- The conjugation of `M'` on a phase-free string is exactly `C'`'s (phase cancels).
      have hM'conj : ∀ g : Fin n → Fin 4,
          M' * pauliString g * M'ᴴ
            = CliffordCircuit.sign C' g • pauliString (CliffordCircuit.act C' g) := by
        intro g
        rw [hC'eq, smul_conjTranspose_conj_cancel hc', CliffordCircuit.conj_pauliString]
      have hgenX : ∀ i, M * pauliString (xGenPauli i) * Mᴴ
          = CliffordCircuit.sign B' (xGenPauli i)
            • pauliString (CliffordCircuit.act B' (xGenPauli i)) := by
        intro i
        refine Fin.cases ?_ ?_ i
        · -- `i = 0`: both fix `X₀`.
          rw [hMX, xGenPauli_zero_eq_cons, hB'def, CliffordCircuit.relabelSucc_act_cons,
            CliffordCircuit.relabelSucc_sign_cons, CliffordCircuit.act_const_zero,
            CliffordCircuit.sign_const_zero, one_smul, ← xGenPauli_zero_eq_cons]
        · -- `i = succ j`: match via the block-diagonal correspondence.
          intro j
          rw [xGenPauli_succ_eq_cons, hM.conj_pauliString_cons hMX hMZ, hM'conj,
            embedLast_smul, ← pauliString_cons_zero, hB'def,
            CliffordCircuit.relabelSucc_act_cons, CliffordCircuit.relabelSucc_sign_cons]
      have hgenZ : ∀ i, M * pauliString (zGenPauli i) * Mᴴ
          = CliffordCircuit.sign B' (zGenPauli i)
            • pauliString (CliffordCircuit.act B' (zGenPauli i)) := by
        intro i
        refine Fin.cases ?_ ?_ i
        · rw [hMZ, zGenPauli_zero_eq_cons, hB'def, CliffordCircuit.relabelSucc_act_cons,
            CliffordCircuit.relabelSucc_sign_cons, CliffordCircuit.act_const_zero,
            CliffordCircuit.sign_const_zero, one_smul, ← zGenPauli_zero_eq_cons]
        · intro j
          rw [zGenPauli_succ_eq_cons, hM.conj_pauliString_cons hMX hMZ, hM'conj,
            embedLast_smul, ← pauliString_cons_zero, hB'def,
            CliffordCircuit.relabelSucc_act_cons, CliffordCircuit.relabelSucc_sign_cons]
      obtain ⟨c, hc, hMeq⟩ :=
        unitary_eq_smul_cliffordCircuit_of_conj_generators hM.1 B' hgenX hgenZ
      -- Step 6: left-cancel `B` with its inverse.
      refine ⟨B.inverse ++ B', c, hc, ?_⟩
      have hUeq : U = B.inverse.toMatrix * M := by
        rw [hMdef, ← Matrix.mul_assoc, CliffordCircuit.toMatrix_inverse_mul, Matrix.one_mul]
      rw [hUeq, hMeq, CliffordCircuit.toMatrix_append, Matrix.mul_smul]

end AxQM.Concrete

end
