import AxQM.Concrete.PauliNormalizerZClear

/-!
# Concrete: exact single-generator reduction — collapse any Pauli string to a standard `X_c`/`Z_c`

This file is part of the formalisation of
Nielsen & Chuang **Theorem 10.6** (the converse — the normalizer `N(Gₙ)` is generated by
Hadamard/phase/CNOT gates, Exercise 10.40) toward the multi-qubit inductive synthesis (parts 2–3).

The Gottesman tableau sweep reduces a normalizer's image of a generator, `U X₁ U†` (a signed Pauli
string), to a *standard single-qubit generator*. The two component moves are:

* **diagonalise** to an all-`X` (resp. all-`Z`) string — a single-qubit layer
  (`exists_singleQubitLayer_act_diagX` / `…diagZ`);
* **CNOT-clear** that all-`X`/`Z` string down to a single generator on a chosen pivot wire `c`
  (`exists_cliffordCircuit_cnotClear_toSingleX` / `…toSingleZ`).

*This file assembles the two into an exact reduction, with the residual `±1` phase corrected.* The
diagonalisation move is phase-free on the *index* level but the assembled circuit carries some `±1`
sign; a single sign-flip gadget on the pivot wire pins it to `+1`. The results:

* `exists_cliffordCircuit_reduceToXGen` — for any Pauli string `a` and any pivot `c` in its support
  (`a c ≠ 0`), a Clifford circuit `C` with `C a C† = X_c` **exactly** (`act C a = xGenPauli c`,
  `sign C a = 1`).
* `exists_cliffordCircuit_reduceToZGen` — the `Z`-basis mirror (`act C a = zGenPauli c`,
  `sign C a = 1`).

## Design notes

*The pivot is a parameter.* A caller reducing a non-identity image `U X₁ U†` picks any wire in its
support as the pivot; the pivot is then moved (with a wire swap if needed) to be wire `1`, the first
move of Exercise 10.40's first-qubit reduction.

*Sign correction without computing the layer's phase.* Rather than track the diagonalising layer's
`±1` phase through `rotateToX`/`rotateToZ` (a per-wire computation), we assemble
`cnotClear ++ layer`, observe that its overall phase on `a` is `±1`
(`CliffordCircuit.sign_eq_one_or_neg_one`), and, in the `-1` case, prepend a sign-flip gadget on the
pivot wire. The gadget (`exists_cliffordCircuit_xGen_signFlip` / `…zGen_signFlip`) is the
specialised `onWire` synthesis: a single-wire Clifford that fixes the generator's index but
negates its phase (`Z_c` conjugation negates `X_c`; `X_c` conjugation negates `Z_c`).

-/

open Matrix

noncomputable section

namespace AxQM.Concrete

variable {n : ℕ}

/-! ### Sign-flip gadgets on a single wire -/

/-- **A Clifford circuit negating the phase of `X_c` while fixing its index** (and fixing `Z_c`):
`act C (xGenPauli c) = xGenPauli c` and `sign C (xGenPauli c) = -1`. It is the single-wire
`onWire` synthesis (`exists_cliffordCircuit_onWire_act_sign`) on wire `c` sending `X ↦ -X`,
`Z ↦ +Z` — concretely a `Z_c` conjugation (`Z X Z = -X`). Used to correct the residual `-1` phase
after the diagonalise-then-clear reduction to `X_c`. -/
theorem exists_cliffordCircuit_xGen_signFlip (c : Fin n) :
    ∃ C : CliffordCircuit n,
      CliffordCircuit.act C (xGenPauli c) = xGenPauli c ∧
        CliffordCircuit.sign C (xGenPauli c) = -1 := by
  obtain ⟨C, hact, hsign, -, -, -⟩ :=
    exists_cliffordCircuit_onWire_act_sign c (aX := 1) (aZ := 3) (zX := -1) (zZ := 1)
      (by decide) (by decide) (by decide) (Or.inr rfl) (Or.inl rfl)
  exact ⟨C, hact, hsign⟩

/-- **A Clifford circuit negating the phase of `Z_c` while fixing its index** (and fixing `X_c`):
`act C (zGenPauli c) = zGenPauli c` and `sign C (zGenPauli c) = -1`. The `Z`-basis mirror of
`exists_cliffordCircuit_xGen_signFlip`: the `onWire` synthesis on wire `c` sending `X ↦ +X`,
`Z ↦ -Z` — concretely an `X_c` conjugation (`X Z X = -Z`). -/
theorem exists_cliffordCircuit_zGen_signFlip (c : Fin n) :
    ∃ C : CliffordCircuit n,
      CliffordCircuit.act C (zGenPauli c) = zGenPauli c ∧
        CliffordCircuit.sign C (zGenPauli c) = -1 := by
  obtain ⟨C, -, -, hact, hsign, -⟩ :=
    exists_cliffordCircuit_onWire_act_sign c (aX := 1) (aZ := 3) (zX := 1) (zZ := -1)
      (by decide) (by decide) (by decide) (Or.inl rfl) (Or.inr rfl)
  exact ⟨C, hact, hsign⟩

/-! ### Exact reduction to a standard `X` generator -/

/-- **Exact reduction to a standard `X` generator (assembling the `X`-sweep).** For any Pauli string
`a : Fin n → Fin 4` and any pivot wire `c` in its support (`a c ≠ 0`), there is a Clifford circuit
`C` collapsing `a` to the single `X` generator on wire `c` *exactly*: `act C a = xGenPauli c` and
`sign C a = 1`.

Construction: diagonalise `a` to its all-`X`-on-support form via a single-qubit layer `L`
(`exists_singleQubitLayer_act_diagX`) — the pivot `c` survives (`act L a c = 1`, from `a c ≠ 0`) —
then CNOT-clear that all-`X` string to `X_c` with trivial phase
(`exists_cliffordCircuit_cnotClear_toSingleX`).
The composite `K ++ L` already realises `a ↦ X_c` on the index; its overall phase on `a` equals the
layer's phase (the clearing is phase-free), which is `±1`. Prepending the sign-flip gadget
`exists_cliffordCircuit_xGen_signFlip` in the `-1` case corrects the phase to `+1`. This reduces a
normalizer's generator image `U X₁ U†` to the standard `X_c`, the first move of the Exercise 10.40
first-qubit reduction. -/
theorem exists_cliffordCircuit_reduceToXGen (a : Fin n → Fin 4) (c : Fin n) (hc : a c ≠ 0) :
    ∃ C : CliffordCircuit n,
      CliffordCircuit.act C a = xGenPauli c ∧ CliffordCircuit.sign C a = 1 := by
  obtain ⟨f, hf⟩ := exists_singleQubitLayer_act_diagX a
  have ha'c : CliffordCircuit.act (CliffordCircuit.singleQubitLayer f) a c = 1 := by
    rw [hf c, ite_eq_right hc]
  have ha'X : ∀ k, CliffordCircuit.act (CliffordCircuit.singleQubitLayer f) a k = 0 ∨
      CliffordCircuit.act (CliffordCircuit.singleQubitLayer f) a k = 1 := by
    intro k; rw [hf k]; split
    · exact Or.inl rfl
    · exact Or.inr rfl
  obtain ⟨K, hKact, hKsign⟩ :=
    exists_cliffordCircuit_cnotClear_toSingleX
      (CliffordCircuit.act (CliffordCircuit.singleQubitLayer f) a) c ha'c ha'X
  set L := CliffordCircuit.singleQubitLayer f with hLdef
  have hrest_act : CliffordCircuit.act (K ++ L) a = xGenPauli c := by
    rw [CliffordCircuit.act_append]; exact hKact
  have hrest_sign : CliffordCircuit.sign (K ++ L) a = CliffordCircuit.sign L a := by
    rw [CliffordCircuit.sign_append, hKsign, mul_one]
  rcases CliffordCircuit.sign_eq_one_or_neg_one L a with hs | hs
  · exact ⟨K ++ L, hrest_act, by rw [hrest_sign]; exact hs⟩
  · obtain ⟨D, hDact, hDsign⟩ := exists_cliffordCircuit_xGen_signFlip c
    refine ⟨D ++ (K ++ L), ?_, ?_⟩
    · rw [CliffordCircuit.act_append, hrest_act, hDact]
    · rw [CliffordCircuit.sign_append, hrest_sign, hs, hrest_act, hDsign]; norm_num

/-! ### Exact reduction to a standard `Z` generator -/

/-- **Exact reduction to a standard `Z` generator (assembling the `Z`-sweep).** For any Pauli string
`a : Fin n → Fin 4` and any pivot wire `c` in its support (`a c ≠ 0`), there is a Clifford circuit
`C` collapsing `a` to the single `Z` generator on wire `c` *exactly*: `act C a = zGenPauli c` and
`sign C a = 1`. The `Z`-basis mirror of `exists_cliffordCircuit_reduceToXGen`: diagonalise to
all-`Z` (`exists_singleQubitLayer_act_diagZ`), reverse-CNOT-clear to `Z_c`
(`exists_cliffordCircuit_cnotClear_toSingleZ`), and correct the residual phase with
`exists_cliffordCircuit_zGen_signFlip`. This reduces a normalizer's second generator image
`U Z₁ U†` to the standard `Z_c`. -/
theorem exists_cliffordCircuit_reduceToZGen (a : Fin n → Fin 4) (c : Fin n) (hc : a c ≠ 0) :
    ∃ C : CliffordCircuit n,
      CliffordCircuit.act C a = zGenPauli c ∧ CliffordCircuit.sign C a = 1 := by
  obtain ⟨f, hf⟩ := exists_singleQubitLayer_act_diagZ a
  have ha'c : CliffordCircuit.act (CliffordCircuit.singleQubitLayer f) a c = 3 := by
    rw [hf c, ite_eq_right hc]
  have ha'Z : ∀ k, CliffordCircuit.act (CliffordCircuit.singleQubitLayer f) a k = 0 ∨
      CliffordCircuit.act (CliffordCircuit.singleQubitLayer f) a k = 3 := by
    intro k; rw [hf k]; split
    · exact Or.inl rfl
    · exact Or.inr rfl
  obtain ⟨K, hKact, hKsign⟩ :=
    exists_cliffordCircuit_cnotClear_toSingleZ
      (CliffordCircuit.act (CliffordCircuit.singleQubitLayer f) a) c ha'c ha'Z
  set L := CliffordCircuit.singleQubitLayer f with hLdef
  have hrest_act : CliffordCircuit.act (K ++ L) a = zGenPauli c := by
    rw [CliffordCircuit.act_append]; exact hKact
  have hrest_sign : CliffordCircuit.sign (K ++ L) a = CliffordCircuit.sign L a := by
    rw [CliffordCircuit.sign_append, hKsign, mul_one]
  rcases CliffordCircuit.sign_eq_one_or_neg_one L a with hs | hs
  · exact ⟨K ++ L, hrest_act, by rw [hrest_sign]; exact hs⟩
  · obtain ⟨D, hDact, hDsign⟩ := exists_cliffordCircuit_zGen_signFlip c
    refine ⟨D ++ (K ++ L), ?_, ?_⟩
    · rw [CliffordCircuit.act_append, hrest_act, hDact]
    · rw [CliffordCircuit.sign_append, hrest_sign, hs, hrest_act, hDsign]; norm_num

end AxQM.Concrete

end
