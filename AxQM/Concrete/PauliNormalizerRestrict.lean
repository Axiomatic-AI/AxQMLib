import AxQM.Concrete.PauliNormalizerGenerators

/-!
# Concrete: restricting a wire-`0`-fixing Pauli normalizer to the last `n` wires (Fig 10.9, part 2)

This file is part of the formalisation of
Nielsen & Chuang **Theorem 10.6** (the converse — the normalizer `N(Gₙ)` is generated by
Hadamard/phase/CNOT gates, **Exercise 10.40**) toward the multi-qubit inductive synthesis (parts
2–3, Figure 10.9).

After the first-wire reduction and pivot-wire decoupling, the inductive step needs
to *recurse* onto the last `n` wires. The datum it recurses on is an `n`-qubit unitary obtained by
**restricting** the `(n+1)`-qubit normalizer to the sub-register `{1, …, n}`. This file supplies
that restriction and the linear-algebraic fact that makes it well-behaved: a unitary that **fixes
the first-wire generators** `X₀` and `Z₀` under conjugation is a genuine *tensor product*
`I₂ ⊗ M'` — it acts as the identity on wire `0` and as an `n`-qubit unitary `M'` on the rest.

The mechanism is elementary matrix algebra with the sparse structure of `X₀` and `Z₀`. Fixing `X₀`
and `Z₀` up to conjugation is, for a unitary, the same as *commuting* with `X₀` and `Z₀`. `Z₀` is
diagonal with a `±1` split according to the wire-`0` bit, so commuting with it kills every matrix
entry mixing the two wire-`0` sectors (`i₀ ≠ j₀`). `X₀` is the wire-`0` bit-flip permutation, so
commuting with it identifies the two diagonal sectors. Together these say the matrix is
block-scalar, `I₂ ⊗ M'`.

## What is proved

* `embedLast` — the **block-scalar embedding** `I₂ ⊗ X` of an `n`-qubit matrix `X` onto the last
  `n` of `n+1` wires (identity on wire `0`), with its algebra: `embedLast_mul`, `embedLast_one`,
  `embedLast_conjTranspose`, and injectivity. This is the tensor-with-identity functor whose image
  is exactly the operators fixing wire `0`.
* `firstWireRestrict` — the **restriction** `M'` of an `(n+1)`-qubit matrix to the last `n` wires,
  the `M'` of a factorisation `M = I₂ ⊗ M'`.
* `pauliString_zGenPauli_zero_eq_diagonal` / `pauliString_xGenPauli_zero_apply` — the sparse entry
  structure of `Z₀` (diagonal, `±1` by the wire-`0` bit) and `X₀` (the wire-`0` bit-flip
  permutation matrix), the two facts the factorisation reads off.
* `eq_embedLast_firstWireRestrict` — **the factorisation.** A unitary `M` fixing `X₀` and `Z₀`
  under conjugation equals `embedLast (firstWireRestrict M) = I₂ ⊗ M'`. This is Figure 10.9's
  "restrict to the last `n` wires": the inductive step's recursion target.
* `firstWireRestrict_mem_unitaryGroup` — the restriction `M'` is again **unitary**, so it is a
  bona fide `n`-qubit operator the inductive hypothesis can consume.
-/

open Matrix

noncomputable section

namespace AxQM.Concrete

variable {n : ℕ}

/-! ### The block-scalar embedding `I₂ ⊗ X` -/

/-- **Block-scalar embedding `I₂ ⊗ X`.** Given an `n`-qubit matrix `X` (index type
`Fin n → Fin 2`), `embedLast X` is the `(n+1)`-qubit matrix acting as the identity on wire `0` and
as `X` on the last `n` wires: its `(i, j)` entry is `X (Fin.tail i) (Fin.tail j)` when the wire-`0`
bits agree (`i 0 = j 0`) and `0` otherwise. This is the tensor product `I₂ ⊗ X`. -/
def embedLast (X : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ) :
    Matrix (Fin (n + 1) → Fin 2) (Fin (n + 1) → Fin 2) ℂ :=
  fun i j => if i 0 = j 0 then X (Fin.tail i) (Fin.tail j) else 0

@[simp] theorem embedLast_apply (X : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ)
    (i j : Fin (n + 1) → Fin 2) :
    embedLast X i j = if i 0 = j 0 then X (Fin.tail i) (Fin.tail j) else 0 := rfl

/-- The `embedLast` entry on `Fin.cons`-form indices: `embedLast X (cons s a) (cons t b)` is
`X a b` when `s = t` and `0` otherwise. -/
theorem embedLast_cons (X : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ) (s t : Fin 2)
    (a b : Fin n → Fin 2) :
    embedLast X (Fin.cons s a) (Fin.cons t b) = if s = t then X a b else 0 := by
  simp only [embedLast_apply, Fin.cons_zero, Fin.tail_cons]

/-- **`embedLast` is injective.** Reading off the wire-`0`-trivial block recovers `X`. -/
theorem embedLast_injective :
    Function.Injective (embedLast : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ → _) := by
  intro X Y h
  ext a b
  have hcons := congrFun (congrFun h (Fin.cons 0 a)) (Fin.cons 0 b)
  rwa [embedLast_cons, embedLast_cons, ite_eq_left rfl, ite_eq_left rfl] at hcons

/-- **`embedLast 1 = 1`.** `I₂ ⊗ I = I`. -/
@[simp] theorem embedLast_one :
    embedLast (1 : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ) = 1 := by
  ext i j
  simp only [embedLast_apply, Matrix.one_apply]
  by_cases hij : i = j
  · subst hij; simp
  · rw [ite_eq_right hij]
    split_ifs with h0 htail
    · exact absurd (by rw [← Fin.cons_self_tail i, ← Fin.cons_self_tail j, h0, htail]) hij
    · rfl
    · rfl

/-- **`embedLast` respects the conjugate transpose**: `(I₂ ⊗ X)ᴴ = I₂ ⊗ Xᴴ`. -/
@[simp] theorem embedLast_conjTranspose (X : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ) :
    (embedLast X)ᴴ = embedLast Xᴴ := by
  ext i j
  rw [Matrix.conjTranspose_apply, embedLast_apply, embedLast_apply, Matrix.conjTranspose_apply]
  by_cases h0 : i 0 = j 0
  · rw [ite_eq_left h0, ite_eq_left h0.symm]
  · rw [ite_eq_right h0, ite_eq_right (fun h => h0 h.symm), star_zero]

/-- **Split a sum over `(n+1)`-bit strings into wire `0` and the tail.** -/
theorem sum_consFirst_split (f : (Fin (n + 1) → Fin 2) → ℂ) :
    ∑ k, f k = ∑ s : Fin 2, ∑ c : Fin n → Fin 2, f (Fin.cons s c) := by
  have h1 : ∑ k, f k = ∑ p : Fin 2 × (Fin n → Fin 2), f (Fin.cons p.1 p.2) :=
    (Equiv.sum_comp (Fin.consEquiv (fun _ => Fin 2)) f).symm
  rw [h1, Fintype.sum_prod_type]

/-- **`embedLast` is multiplicative**: `(I₂ ⊗ X)(I₂ ⊗ Y) = I₂ ⊗ (XY)`. -/
theorem embedLast_mul (X Y : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ) :
    embedLast X * embedLast Y = embedLast (X * Y) := by
  ext i j
  rw [embedLast_apply, Matrix.mul_apply, sum_consFirst_split]
  simp only [embedLast_apply, Fin.cons_zero, Fin.tail_cons]
  by_cases h0 : i 0 = j 0
  · rw [ite_eq_left h0, Matrix.mul_apply, Finset.sum_eq_single (i 0)]
    · simp [h0]
    · intro s _ hs
      exact Finset.sum_eq_zero fun c _ => by rw [ite_eq_right (Ne.symm hs), zero_mul]
    · intro h; exact absurd (Finset.mem_univ _) h
  · rw [ite_eq_right h0]
    refine Finset.sum_eq_zero fun s _ => Finset.sum_eq_zero fun c _ => ?_
    by_cases hs1 : i 0 = s
    · rw [ite_eq_right (fun h : s = j 0 => h0 (hs1.trans h)), mul_zero]
    · rw [ite_eq_right hs1, zero_mul]

/-! ### The restriction `M'` -/

/-- **Restriction to the last `n` wires.** For an `(n+1)`-qubit matrix `M`, `firstWireRestrict M` is
the `n`-qubit matrix whose `(a, b)` entry is `M (cons 0 a) (cons 0 b)` — the wire-`0`-trivial block
of `M`. When `M = I₂ ⊗ M'`, this recovers `M'`. -/
def firstWireRestrict (M : Matrix (Fin (n + 1) → Fin 2) (Fin (n + 1) → Fin 2) ℂ) :
    Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ :=
  fun a b => M (Fin.cons 0 a) (Fin.cons 0 b)

@[simp] theorem firstWireRestrict_apply
    (M : Matrix (Fin (n + 1) → Fin 2) (Fin (n + 1) → Fin 2) ℂ) (a b : Fin n → Fin 2) :
    firstWireRestrict M a b = M (Fin.cons 0 a) (Fin.cons 0 b) := rfl

/-! ### Helper facts on `Fin 2`, single Pauli entries, and the wire-`0` split -/

/-- In `Fin 2`, every element is `0` or `1`. -/
theorem fin2_zero_or_one (x : Fin 2) : x = 0 ∨ x = 1 := by fin_cases x <;> decide

/-- In `Fin 2`, `x + 1 ≠ x`. -/
theorem fin2_add_one_ne (x : Fin 2) : x + 1 ≠ x := by fin_cases x <;> decide

/-- In `Fin 2`, `x + 1 + 1 = x`. -/
theorem fin2_add_one_add_one (x : Fin 2) : x + 1 + 1 = x := by fin_cases x <;> rfl

/-- In `Fin 2`, `a ≠ b` forces `a = b + 1`. -/
theorem fin2_eq_add_one_of_ne {a b : Fin 2} (h : a ≠ b) : a = b + 1 := by
  fin_cases a <;> fin_cases b <;> revert h <;> decide

/-- Entry form of `pauliZ`: diagonal, `+1`/`-1` by the bit. -/
theorem pauliZ_apply' (a b : Fin 2) :
    pauliZ a b = if a = b then (if a = 0 then (1 : ℂ) else -1) else 0 := by
  fin_cases a <;> fin_cases b <;> simp [pauliZ]

/-- Entry form of `pauliX`: the bit-flip permutation, `1` off the diagonal. -/
theorem pauliX_apply' (a b : Fin 2) : pauliX a b = if a = b then (0 : ℂ) else 1 := by
  fin_cases a <;> fin_cases b <;> simp [pauliX]

/-- **Two `(n+1)`-bit strings agree iff their wire-`0` bits and tails agree.** -/
theorem funMap_eq_iff (i j : Fin (n + 1) → Fin 2) :
    i = j ↔ i 0 = j 0 ∧ Fin.tail i = Fin.tail j := by
  constructor
  · rintro rfl; exact ⟨rfl, rfl⟩
  · rintro ⟨h0, ht⟩; rw [← Fin.cons_self_tail i, ← Fin.cons_self_tail j, h0, ht]

/-- **The tail product of identity factors** is `1` when the tails agree, `0` otherwise. -/
theorem prod_pauli_zero_tail (i j : Fin (n + 1) → Fin 2) (g : Fin (n + 1) → Fin 4)
    (hg : ∀ k : Fin n, g k.succ = 0) :
    (∏ k : Fin n, pauli (g k.succ) (i k.succ) (j k.succ))
      = if Fin.tail i = Fin.tail j then (1 : ℂ) else 0 := by
  have hstep : ∀ k : Fin n, pauli (g k.succ) (i k.succ) (j k.succ)
      = if i k.succ = j k.succ then (1 : ℂ) else 0 := by
    intro k; rw [hg k, show pauli (0 : Fin 4) = 1 from rfl, Matrix.one_apply]
  by_cases ht : Fin.tail i = Fin.tail j
  · rw [ite_eq_left ht]
    exact Finset.prod_eq_one fun k _ => by
      rw [hstep k, ite_eq_left (show i k.succ = j k.succ from congrFun ht k)]
  · rw [ite_eq_right ht]
    obtain ⟨k, hk⟩ : ∃ k : Fin n, i k.succ ≠ j k.succ := by
      by_contra hc
      simp only [not_exists, not_ne_iff] at hc
      exact ht (funext hc)
    exact Finset.prod_eq_zero (Finset.mem_univ k) (by rw [hstep k, ite_eq_right hk])

/-- The wire-`0` **bit-flip** on an `(n+1)`-bit string: flips wire `0`, keeps the rest. It is the
permutation `X₀` acts by, and an involution. -/
def flipFirst (i : Fin (n + 1) → Fin 2) : Fin (n + 1) → Fin 2 :=
  Fin.cons (i 0 + 1) (Fin.tail i)

@[simp] theorem flipFirst_apply_zero (i : Fin (n + 1) → Fin 2) : flipFirst i 0 = i 0 + 1 := by
  rw [flipFirst, Fin.cons_zero]

@[simp] theorem tail_flipFirst (i : Fin (n + 1) → Fin 2) : Fin.tail (flipFirst i) = Fin.tail i := by
  rw [flipFirst, Fin.tail_cons]

@[simp] theorem flipFirst_flipFirst (i : Fin (n + 1) → Fin 2) : flipFirst (flipFirst i) = i := by
  rw [funMap_eq_iff, flipFirst_apply_zero, tail_flipFirst, tail_flipFirst, flipFirst_apply_zero]
  exact ⟨fin2_add_one_add_one (i 0), rfl⟩

/-- `a = flipFirst b` is symmetric under swapping `a, b` (the flip is an involution). -/
theorem eq_flipFirst_comm (a b : Fin (n + 1) → Fin 2) : (a = flipFirst b) ↔ (b = flipFirst a) := by
  constructor <;> intro h <;> rw [h, flipFirst_flipFirst]

/-- `i = flipFirst j` exactly when the wire-`0` bit flips and the tails agree. -/
theorem eq_flipFirst_iff (i j : Fin (n + 1) → Fin 2) :
    i = flipFirst j ↔ i 0 = j 0 + 1 ∧ Fin.tail i = Fin.tail j := by
  rw [funMap_eq_iff, flipFirst_apply_zero, tail_flipFirst]

/-- When the wire-`0` bit is `0`, `cons 0 (tail x)` reconstructs `x`. -/
theorem cons_zero_tail_of_apply_zero {x : Fin (n + 1) → Fin 2} (hx : x 0 = 0) :
    Fin.cons (0 : Fin 2) (Fin.tail x) = x := by rw [← hx]; exact Fin.cons_self_tail x

/-- When the wire-`0` bit is `1`, `cons 0 (tail x)` is the bit-flip `flipFirst x`. -/
theorem cons_zero_tail_of_apply_one {x : Fin (n + 1) → Fin 2} (hx : x 0 = 1) :
    Fin.cons (0 : Fin 2) (Fin.tail x) = flipFirst x := by
  have hxx : x 0 + 1 = 0 := by simp [hx]
  unfold flipFirst
  rw [hxx]

/-! ### Sparse entry structure of `Z₀` and `X₀` -/

/-- **`Z₀` is diagonal.** The Pauli string `Z` on wire `0` (identity elsewhere) is the diagonal
matrix whose `i`-th entry is `+1` when the wire-`0` bit is `0` and `-1` when it is `1`. -/
theorem pauliString_zGenPauli_zero_eq_diagonal :
    pauliString (zGenPauli (0 : Fin (n + 1)))
      = Matrix.diagonal (fun i => if i 0 = 0 then (1 : ℂ) else -1) := by
  ext i j
  rw [pauliString_apply, Fin.prod_univ_succ, Matrix.diagonal_apply,
    prod_pauli_zero_tail i j (zGenPauli 0)
      (fun k => by rw [zGenPauli_apply, ite_eq_right (Fin.succ_ne_zero k)]),
    zGenPauli_apply, ite_eq_left rfl, show pauli (3 : Fin 4) = pauliZ from rfl, pauliZ_apply']
  by_cases hij : i = j
  · rw [ite_eq_left hij]
    obtain ⟨h0, ht⟩ := (funMap_eq_iff i j).mp hij
    rw [ite_eq_left h0, ite_eq_left ht, mul_one]
  · rw [ite_eq_right hij]
    by_cases ht : Fin.tail i = Fin.tail j
    · rw [ite_eq_left ht, mul_one]
      by_cases h0 : i 0 = j 0
      · exact absurd ((funMap_eq_iff i j).mpr ⟨h0, ht⟩) hij
      · rw [ite_eq_right h0]
    · rw [ite_eq_right ht, mul_zero]

/-- **`X₀` is the wire-`0` bit-flip permutation matrix.** The Pauli string `X` on wire `0` (identity
elsewhere) has `(i, j)` entry `1` exactly when `i` is `j` with its wire-`0` bit flipped. -/
theorem pauliString_xGenPauli_zero_apply (i j : Fin (n + 1) → Fin 2) :
    pauliString (xGenPauli (0 : Fin (n + 1))) i j = if i = flipFirst j then (1 : ℂ) else 0 := by
  rw [pauliString_apply, Fin.prod_univ_succ,
    prod_pauli_zero_tail i j (xGenPauli 0)
      (fun k => by rw [xGenPauli_apply, ite_eq_right (Fin.succ_ne_zero k)]),
    xGenPauli_apply, ite_eq_left rfl, show pauli (1 : Fin 4) = pauliX from rfl, pauliX_apply']
  by_cases hf : i = flipFirst j
  · obtain ⟨h0, ht⟩ := (eq_flipFirst_iff i j).mp hf
    rw [ite_eq_left hf, ite_eq_left ht, mul_one,
        ite_eq_right (fun he => fin2_add_one_ne (j 0) (h0 ▸ he))]
  · rw [ite_eq_right hf]
    by_cases ht : Fin.tail i = Fin.tail j
    · rw [ite_eq_left ht, mul_one]
      by_cases h0 : i 0 = j 0
      · rw [ite_eq_left h0]
      · exact absurd ((eq_flipFirst_iff i j).mpr ⟨fin2_eq_add_one_of_ne h0, ht⟩) hf
    · rw [ite_eq_right ht, mul_zero]

/-! ### The factorisation -/

/-- **The tensor factorisation `M = I₂ ⊗ M'` (Figure 10.9, restriction to the last `n` wires).**
A unitary `M` on `n+1` qubits that **fixes the first-wire generators** `X₀` and `Z₀` under
conjugation (`M X₀ M† = X₀`, `M Z₀ M† = Z₀` — the output of the first-wire reduction) equals
`embedLast (firstWireRestrict M) = I₂ ⊗ M'`: it acts as the identity on wire `0` and as the
`n`-qubit restriction `M'` on the rest.

Fixing `X₀`, `Z₀` up to conjugation is, for a unitary (`Mᴴ M = 1`), the same as commuting with
`X₀`, `Z₀`. `Z₀` is diagonal with a `±1` split by the wire-`0` bit
(`pauliString_zGenPauli_zero_eq_diagonal`), so commuting with it forces every entry with `i 0 ≠ j 0`
to vanish. `X₀` is the wire-`0` bit-flip permutation
(`pauliString_xGenPauli_zero_apply`), so commuting with it gives `M i j = M (flipFirst i)
(flipFirst j)`, identifying the two diagonal sectors. Together these are exactly the block-scalar
form `I₂ ⊗ M'`. -/
theorem eq_embedLast_firstWireRestrict
    {M : Matrix (Fin (n + 1) → Fin 2) (Fin (n + 1) → Fin 2) ℂ}
    (hM : M ∈ Matrix.unitaryGroup (Fin (n + 1) → Fin 2) ℂ)
    (hX : M * pauliString (xGenPauli 0) * Mᴴ = pauliString (xGenPauli 0))
    (hZ : M * pauliString (zGenPauli 0) * Mᴴ = pauliString (zGenPauli 0)) :
    M = embedLast (firstWireRestrict M) := by
  have hMHM : Mᴴ * M = 1 := by
    simpa [star_eq_conjTranspose] using mem_unitaryGroup_iff'.mp hM
  -- fixing up to conjugation ⟺ commuting, for a unitary
  have hcomm : ∀ g : Fin (n + 1) → Fin 4,
      M * pauliString g * Mᴴ = pauliString g → M * pauliString g = pauliString g * M := by
    intro g hg
    have h2 : M * pauliString g * Mᴴ * M = pauliString g * M := by rw [hg]
    rwa [Matrix.mul_assoc (M * pauliString g) Mᴴ M, hMHM, Matrix.mul_one] at h2
  have hcommZ := hcomm _ hZ
  have hcommX := hcomm _ hX
  -- Z₀-consequence: entries mixing the two wire-0 sectors vanish
  have hzero : ∀ i j : Fin (n + 1) → Fin 2, i 0 ≠ j 0 → M i j = 0 := by
    intro i j hij
    have h := congrFun (congrFun hcommZ i) j
    rw [pauliString_zGenPauli_zero_eq_diagonal, Matrix.mul_diagonal, Matrix.diagonal_mul] at h
    have hdine :
        (if j 0 = 0 then (1 : ℂ) else -1) - (if i 0 = 0 then (1 : ℂ) else -1) ≠ 0 := by
      rcases fin2_zero_or_one (i 0) with hi | hi <;> rcases fin2_zero_or_one (j 0) with hj | hj
      · exact absurd (hi.trans hj.symm) hij
      · rw [hi, hj]; norm_num
      · rw [hi, hj]; norm_num
      · exact absurd (hi.trans hj.symm) hij
    have hz2 : M i j *
        ((if j 0 = 0 then (1 : ℂ) else -1) - (if i 0 = 0 then (1 : ℂ) else -1)) = 0 := by
      linear_combination h
    rcases mul_eq_zero.mp hz2 with h1 | h1
    · exact h1
    · exact absurd h1 hdine
  -- X₀-consequence: the two diagonal sectors are identified
  have hswap : ∀ a b : Fin (n + 1) → Fin 2, M a (flipFirst b) = M (flipFirst a) b := by
    intro a b
    have h := congrFun (congrFun hcommX a) b
    rw [Matrix.mul_apply, Matrix.mul_apply] at h
    simp only [pauliString_xGenPauli_zero_apply, mul_ite, mul_one, mul_zero, ite_mul,
      one_mul, zero_mul] at h
    have hcongr : (∑ k, if a = flipFirst k then M k b else 0)
        = ∑ k, if k = flipFirst a then M k b else 0 :=
      Finset.sum_congr rfl fun k _ => if_congr (eq_flipFirst_comm a k) rfl rfl
    rw [Finset.sum_ite_eq' Finset.univ (flipFirst b) (fun k => M a k), hcongr,
      Finset.sum_ite_eq' Finset.univ (flipFirst a) (fun k => M k b)] at h
    simpa using h
  have hflip : ∀ i j : Fin (n + 1) → Fin 2, M i j = M (flipFirst i) (flipFirst j) := by
    intro i j
    have h := hswap i (flipFirst j)
    rwa [flipFirst_flipFirst] at h
  -- assemble the block-scalar form
  ext i j
  rw [embedLast_apply]
  simp only [firstWireRestrict_apply]
  by_cases h0 : i 0 = j 0
  · rw [ite_eq_left h0]
    rcases eq_or_ne (i 0) 0 with hi0 | hi0
    · rw [cons_zero_tail_of_apply_zero hi0, cons_zero_tail_of_apply_zero (h0 ▸ hi0)]
    · have hi1 : i 0 = 1 := (fin2_eq_add_one_of_ne hi0).trans (by decide)
      rw [cons_zero_tail_of_apply_one hi1, cons_zero_tail_of_apply_one (h0 ▸ hi1), ← hflip]
  · rw [ite_eq_right h0, hzero i j h0]

/-- **The restriction is unitary.** The `M'` of the factorisation `M = I₂ ⊗ M'` (for `M` a unitary
fixing `X₀, Z₀`) is again a unitary, so it is a bona fide `n`-qubit operator the inductive
hypothesis can consume. From `M = embedLast M'` and `Mᴴ M = 1`: `embedLast (M'ᴴ M') = Mᴴ M = 1 =
embedLast 1`, and `embedLast` is injective. -/
theorem firstWireRestrict_mem_unitaryGroup
    {M : Matrix (Fin (n + 1) → Fin 2) (Fin (n + 1) → Fin 2) ℂ}
    (hM : M ∈ Matrix.unitaryGroup (Fin (n + 1) → Fin 2) ℂ)
    (hX : M * pauliString (xGenPauli 0) * Mᴴ = pauliString (xGenPauli 0))
    (hZ : M * pauliString (zGenPauli 0) * Mᴴ = pauliString (zGenPauli 0)) :
    firstWireRestrict M ∈ Matrix.unitaryGroup (Fin n → Fin 2) ℂ := by
  have hfac := eq_embedLast_firstWireRestrict hM hX hZ
  have hMHM : Mᴴ * M = 1 := by
    simpa [star_eq_conjTranspose] using mem_unitaryGroup_iff'.mp hM
  have key : embedLast ((firstWireRestrict M)ᴴ * firstWireRestrict M) = embedLast 1 := by
    rw [← embedLast_mul, ← embedLast_conjTranspose, ← hfac, embedLast_one, hMHM]
  have h1 : (firstWireRestrict M)ᴴ * firstWireRestrict M = 1 := embedLast_injective key
  rw [mem_unitaryGroup_iff', star_eq_conjTranspose]
  exact h1

end AxQM.Concrete

end
