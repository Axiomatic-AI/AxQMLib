import AxQM.Concrete.PauliNormalizerRestrict
import AxQM.Concrete.PauliNormalizerDecouple

/-!
# Concrete: the wire-`0` restriction of a normalizer is an `n`-qubit normalizer (Fig 10.9, part 2)

This file is part of the formalisation of
Nielsen & Chuang **Theorem 10.6** (the converse — the normalizer `N(Gₙ)` is generated by
Hadamard/phase/CNOT gates, **Exercise 10.40**) toward the multi-qubit inductive synthesis (Figure
10.9, part 2).

`AxQM/Concrete/PauliNormalizerRestrict.lean` showed that a unitary `M` on `n+1`
qubits fixing the first-wire generators `X₀` and `Z₀` under conjugation is a genuine tensor product
`M = I₂ ⊗ M'`, with `M' = firstWireRestrict M` an `n`-qubit unitary. The inductive step now needs
`M'` to be a bona fide **`n`-qubit Pauli normalizer**, so the induction can recurse onto the
sub-register `{1, …, n}` and apply the inductive hypothesis to `M'`.

That is what this file supplies. The key algebraic fact is that `M`'s conjugation action on a Pauli
string trivial on wire `0` **block-diagonalises**: `M · P_{cons 0 a} · M† = I₂ ⊗ (M' · P_a · M'†)`.
Combined with the pivot-wire decoupling (the image is again trivial on wire `0`)
and injectivity of `I₂ ⊗ ·`, this pins down `M'`'s conjugation action on every phase-free `n`-qubit
Pauli string to a `±1` multiple of a Pauli string, from which the normalizer property of `M'`
follows by rebuilding the fourth-root-of-unity phase.

## What is proved

* `pauliString_cons_zero` — the identity-on-wire-`0` Pauli string is the block-scalar embedding of
  the tail string: `P_{cons 0 a} = I₂ ⊗ P_a` (`embedLast (pauliString a)`).
* `embedLast_smul` — the embedding `I₂ ⊗ ·` is `ℂ`-linear in the scalar: `I₂ ⊗ (c • X) = c • (I₂ ⊗
  X)`.
* `IsPauliNormalizer.conj_pauliString_cons` — the **block-diagonal intertwining**: for a normalizer
  `M` fixing `X₀, Z₀`, `M · P_{cons 0 a} · M† = I₂ ⊗ (M' · P_a · M'†)` with `M' = firstWireRestrict
  M`. This is the recursion step: `M`'s action on the last-`n`-wire Pauli strings is exactly `M'`'s
  action, wrapped in `I₂ ⊗ ·`.
* `firstWireRestrict_conj_pauliString` — the **`±1` signed action of `M'`**: for every `n`-qubit
  index `a`, `M' · P_a · M'† = z • P_b` with `z ∈ {1, -1}`. From the intertwining, the pivot-wire
  decoupling (`conj_apply_zero_eq_zero`, giving `b 0 = 0` so the image re-embeds), and injectivity
  of `embedLast`.
* `firstWireRestrict_isPauliNormalizer` — **the main result**: `firstWireRestrict M` is an
  `n`-qubit Pauli normalizer. Unitary by `firstWireRestrict_mem_unitaryGroup`; the group condition
  rebuilds the phase —
  a Pauli-group element `⟨s, a⟩` conjugates to `iˢ • (z • P_b) = i^{s + t} • P_b` where `z = iᵗ`
  (`t = 0` for `z = 1`, `t = 2` for `z = -1`), which is again a Pauli-group element `⟨s + t, b⟩`.
  This is the `n`-qubit normalizer the inductive hypothesis of Exercise 10.40 consumes.
-/

open Matrix

noncomputable section

namespace AxQM.Concrete

variable {n : ℕ}

/-! ### The identity-on-wire-`0` Pauli string as a block-scalar embedding -/

/-- **`P_{cons 0 a} = I₂ ⊗ P_a`.** The `(n+1)`-qubit Pauli string that is the identity on wire `0`
and `P_a` on the last `n` wires is exactly the block-scalar embedding `embedLast (pauliString a)`.
Peeling the wire-`0` factor (`Fin.prod_univ_succ`) gives `pauli 0 (i 0) (j 0) = [i 0 = j 0]`
(the identity matrix entry) times the tail product `pauliString a (tail i) (tail j)`, which is the
defining entry of `embedLast (pauliString a)`. -/
theorem pauliString_cons_zero (a : Fin n → Fin 4) :
    pauliString (Fin.cons (0 : Fin 4) a) = embedLast (pauliString a) := by
  ext i j
  rw [embedLast_apply, pauliString_apply, Fin.prod_univ_succ, Fin.cons_zero,
    show pauli (0 : Fin 4) = 1 from rfl, Matrix.one_apply, pauliString_apply]
  simp only [Fin.cons_succ]
  split_ifs with h <;> simp [Fin.tail]

/-- **The embedding `I₂ ⊗ ·` is linear in the scalar**: `I₂ ⊗ (c • X) = c • (I₂ ⊗ X)`. -/
theorem embedLast_smul (c : ℂ) (X : Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ) :
    embedLast (c • X) = c • embedLast X := by
  ext i j
  simp only [Matrix.smul_apply, embedLast_apply, smul_eq_mul, mul_ite, mul_zero]

/-! ### The block-diagonal intertwining and the signed action of `M'` -/

/-- **Block-diagonal intertwining.** For an `(n+1)`-qubit Pauli normalizer `M` fixing the first-wire
generators `X₀` and `Z₀` under conjugation, conjugation of a Pauli string trivial on wire `0`
block-diagonalises: `M · P_{cons 0 a} · M† = I₂ ⊗ (M' · P_a · M'†)`, where `M' = firstWireRestrict
M`. Because `M = I₂ ⊗ M'` (`eq_embedLast_firstWireRestrict`), this is just multiplicativity of
`I₂ ⊗ ·` (`embedLast_mul`) together with `P_{cons 0 a} = I₂ ⊗ P_a` (`pauliString_cons_zero`). -/
theorem IsPauliNormalizer.conj_pauliString_cons
    {M : Matrix (Fin (n + 1) → Fin 2) (Fin (n + 1) → Fin 2) ℂ} (hM : IsPauliNormalizer M)
    (hX : M * pauliString (xGenPauli 0) * Mᴴ = pauliString (xGenPauli 0))
    (hZ : M * pauliString (zGenPauli 0) * Mᴴ = pauliString (zGenPauli 0)) (a : Fin n → Fin 4) :
    M * pauliString (Fin.cons 0 a) * Mᴴ
      = embedLast (firstWireRestrict M * pauliString a * (firstWireRestrict M)ᴴ) := by
  have hfac : M = embedLast (firstWireRestrict M) := eq_embedLast_firstWireRestrict hM.1 hX hZ
  set M' := firstWireRestrict M with hM'
  rw [pauliString_cons_zero, hfac, embedLast_conjTranspose, embedLast_mul, embedLast_mul]

/-- **The `±1` signed action of the restriction `M'`.** For an `(n+1)`-qubit normalizer `M` fixing
`X₀, Z₀`, the restriction `M' = firstWireRestrict M` conjugates every phase-free `n`-qubit Pauli
string to a `±1` multiple of a Pauli string: `M' · P_a · M'† = z • P_b`, `z ∈ {1, -1}`.

The pivot-wire decoupling (`conj_apply_zero_eq_zero`) applied to `cons 0 a` (trivial on wire `0`)
gives `M · P_{cons 0 a} · M† = z • P_{b₀}` with `b₀ 0 = 0` and `z = ±1`. Rewriting the left side by
the block-diagonal intertwining and the right side as `I₂ ⊗ (z • P_{tail b₀})` (using `b₀ 0 = 0`),
injectivity of `I₂ ⊗ ·` strips the embedding, leaving the signed action with `b = tail b₀`. -/
theorem firstWireRestrict_conj_pauliString
    {M : Matrix (Fin (n + 1) → Fin 2) (Fin (n + 1) → Fin 2) ℂ} (hM : IsPauliNormalizer M)
    (hX : M * pauliString (xGenPauli 0) * Mᴴ = pauliString (xGenPauli 0))
    (hZ : M * pauliString (zGenPauli 0) * Mᴴ = pauliString (zGenPauli 0)) (a : Fin n → Fin 4) :
    ∃ (b : Fin n → Fin 4) (z : ℂ), (z = 1 ∨ z = -1) ∧
      firstWireRestrict M * pauliString a * (firstWireRestrict M)ᴴ = z • pauliString b := by
  obtain ⟨b0, z, hz, hconj0, hb0⟩ :=
    hM.conj_apply_zero_eq_zero hX hZ (a := Fin.cons 0 a) (Fin.cons_zero _ _)
  rw [hM.conj_pauliString_cons hX hZ] at hconj0
  refine ⟨Fin.tail b0, z, hz, ?_⟩
  have hcons : Fin.cons (0 : Fin 4) (Fin.tail b0) = b0 := by rw [← hb0]; exact Fin.cons_self_tail b0
  have hb0eq : pauliString b0 = embedLast (pauliString (Fin.tail b0)) := by
    conv_lhs => rw [← hcons]
    rw [pauliString_cons_zero]
  rw [hb0eq, ← embedLast_smul] at hconj0
  exact embedLast_injective hconj0

/-! ### The restriction is an `n`-qubit normalizer -/

/-- **The restriction of a normalizer is a normalizer.** For an `(n+1)`-qubit Pauli normalizer `M`
fixing the first-wire generators `X₀` and `Z₀` under conjugation, the `n`-qubit restriction
`firstWireRestrict M` is again a Pauli normalizer. This is the datum the multi-qubit induction of
Nielsen & Chuang Exercise 10.40 recurses on.

Unitarity is `firstWireRestrict_mem_unitaryGroup`. For the group condition, a Pauli-group element
`p = ⟨s, a⟩` has `p.toMat = iˢ • P_a`; the signed action gives `M' · P_a · M'† = z • P_b` with
`z = ±1`, so `M' · p.toMat · M'† = iˢ • (z • P_b) = i^{s + t} • P_b`, where `z = iᵗ` (`t = 0` if
`z = 1`, `t = 2` if `z = -1`). That is `⟨s + t, b⟩.toMat`, again a Pauli-group element. -/
theorem firstWireRestrict_isPauliNormalizer
    {M : Matrix (Fin (n + 1) → Fin 2) (Fin (n + 1) → Fin 2) ℂ} (hM : IsPauliNormalizer M)
    (hX : M * pauliString (xGenPauli 0) * Mᴴ = pauliString (xGenPauli 0))
    (hZ : M * pauliString (zGenPauli 0) * Mᴴ = pauliString (zGenPauli 0)) :
    IsPauliNormalizer (firstWireRestrict M) := by
  refine ⟨firstWireRestrict_mem_unitaryGroup hM.1 hX hZ, ?_⟩
  intro p
  obtain ⟨b, z, hz, hconj⟩ := firstWireRestrict_conj_pauliString hM hX hZ p.idx
  -- `z = iᵗ` with `t = 0` (for `z = 1`) or `t = 2` (for `z = -1`); rebuild the Pauli-group element
  -- `⟨p.phase + t, b⟩`.
  obtain ⟨t, ht⟩ : ∃ t : ZMod 4, z = zmod4Pow t := by
    rcases hz with h | h
    · exact ⟨0, by rw [h, zmod4Pow_zero]⟩
    · exact ⟨2, by rw [h, zmod4Pow_two]⟩
  refine ⟨⟨p.phase + t, b⟩, ?_⟩
  simp only [PauliGroup.toMat]
  rw [Matrix.mul_smul, Matrix.smul_mul, hconj, ht, smul_smul, ← zmod4Pow_add]

end AxQM.Concrete

end
