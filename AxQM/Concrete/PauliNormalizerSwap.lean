import AxQM.Concrete.PauliStringEncodingLayers

/-!
# Concrete: the wire-swap Clifford circuit — transpose two wires' Pauli letters

This file is part of the formalisation of
Nielsen & Chuang **Theorem 10.6** (the converse — the normalizer `N(Gₙ)` is generated by
Hadamard/phase/CNOT gates, Exercise 10.40) toward the multi-qubit inductive synthesis (parts 2–3).

The inductive step of Exercise 10.40 (Figure 10.9) reduces a normalizer's first anticommuting
generator pair to the standard `(X_c, Z_c)` on some pivot wire `c`
(`exists_cliffordCircuit_reducePair`) and then **swaps the pivot to a designated first wire** so
the remaining `n` wires form a clean sub-register on which the inductive hypothesis runs. A wire
transposition is itself a Clifford operation — the standard three-`CNOT` identity `SWAP_{a,b} =
CNOT_{a→b} CNOT_{b→a} CNOT_{a→b}` — so this file builds it as a `CliffordCircuit` and proves the
two facts the induction needs: its phase-free action **transposes the two wires' Pauli letters**
and it acquires **no `±1` phase**.

## What is proved

* `swapWires a b` — the wire-swap circuit: `[CNOT_{a→b}, CNOT_{b→a}, CNOT_{a→b}]` for `a ≠ b`, and
  the empty circuit for `a = b` (swapping a wire with itself is the identity).

* `act_swapWires` / `act_swapWires_eq` — **the swap transposes the two wires' letters.** Its
  phase-free action precomposes the Pauli string with the transposition of wires `a` and `b`:
  `(swapWires a b).act g k = g (Equiv.swap a b k)`. On the two swapped wires this is a finite
  `Fin 4 × Fin 4` tableau computation (three `CNOT` tableau steps `cnotPauliString`); off them every
  gate leaves the wire untouched.

* `sign_swapWires` — **the swap acquires no phase**: `(swapWires a b).sign g = 1`. `SWAP` is a real
  permutation matrix and only permutes the tensor factors of a Pauli string, so the three `CNOT`
  tableau signs multiply to `+1` on every letter pair.

* `act_swapWires_xGenPauli` / `act_swapWires_zGenPauli` — **the swap moves a standard generator
  between the two wires**: `(swapWires a b).act (xGenPauli a) = xGenPauli b` (and the `Z` mirror),
  the exact use the induction makes of it — relocating the reduced pivot `(X_c, Z_c)` to a chosen
  first wire.
-/

open Matrix

noncomputable section

namespace AxQM.Concrete

variable {n : ℕ}

/-- **The wire-swap Clifford circuit.** For `a ≠ b`, the standard three-`CNOT` swap
`SWAP_{a,b} = CNOT_{a→b} CNOT_{b→a} CNOT_{a→b}` (read right-to-left, so `CNOT_{a→b}` is applied
first); for `a = b` the empty circuit, since swapping a wire with itself is the identity. Used by
the multi-qubit synthesis of Nielsen & Chuang Exercise 10.40 to swap the reduced pivot wire to a
designated first wire (Figure 10.9). -/
def swapWires (a b : Fin n) : CliffordCircuit n :=
  if h : a = b then []
  else [CliffordGate.cnot a b h, CliffordGate.cnot b a (Ne.symm h), CliffordGate.cnot a b h]

/-- The `Fin 4` tableau values of `swapWires a b` at the two swapped wires depend only on `g a` and
`g b`; these four abbreviations name the intermediate string values so `act_swapWires` and
`sign_swapWires` share the reduction. -/
private theorem swapWires_reduce (a b : Fin n) (hab : a ≠ b) (g : Fin n → Fin 4) :
    (cnotPauliString g a b) a = cnotCtrlPauli (g a) (g b) ∧
      (cnotPauliString g a b) b = cnotTgtPauli (g a) (g b) ∧
      (cnotPauliString (cnotPauliString g a b) b a) a
        = cnotTgtPauli ((cnotPauliString g a b) b) ((cnotPauliString g a b) a) ∧
      (cnotPauliString (cnotPauliString g a b) b a) b
        = cnotCtrlPauli ((cnotPauliString g a b) b) ((cnotPauliString g a b) a) :=
  ⟨cnotPauliString_ctrl g a b, cnotPauliString_tgt g hab,
    cnotPauliString_tgt (cnotPauliString g a b) hab.symm,
    cnotPauliString_ctrl (cnotPauliString g a b) b a⟩

/-- **The wire-swap transposes the two wires' Pauli letters (pointwise).** For every wire `k`,
`(swapWires a b).act g k = g (Equiv.swap a b k)`: the phase-free action of the swap circuit reads
the letter of `g` at the swapped wire. On the two swapped wires this is the composition of the three
`CNOT` tableau steps, a finite `Fin 4 × Fin 4` computation; off them each `CNOT` leaves the wire
fixed (`cnotPauliString_of_ne`). -/
theorem act_swapWires (a b : Fin n) (g : Fin n → Fin 4) (k : Fin n) :
    (swapWires a b).act g k = g (Equiv.swap a b k) := by
  rcases eq_or_ne a b with rfl | hab
  · simp [swapWires, Equiv.swap_self, CliffordCircuit.act]
  · rw [swapWires, dite_eq_right hab]
    simp only [CliffordCircuit.act, CliffordGate.act]
    obtain ⟨hNa, hNb, hMa, hMb⟩ := swapWires_reduce a b hab g
    rcases eq_or_ne k a with hka | hka
    · rw [hka, Equiv.swap_apply_left, cnotPauliString_ctrl, hMa, hMb, hNa, hNb]
      generalize g a = α
      generalize g b = β
      fin_cases α <;> fin_cases β <;> decide
    · rcases eq_or_ne k b with hkb | hkb
      · rw [hkb, Equiv.swap_apply_right, cnotPauliString_tgt _ hab, hMa, hMb, hNa, hNb]
        generalize g a = α
        generalize g b = β
        fin_cases α <;> fin_cases β <;> decide
      · rw [Equiv.swap_apply_of_ne_of_ne hka hkb,
          cnotPauliString_of_ne _ a b hka hkb,
          cnotPauliString_of_ne _ b a hkb hka,
          cnotPauliString_of_ne _ a b hka hkb]

/-- **The wire-swap transposes the two wires' Pauli letters (functional form)**:
`(swapWires a b).act g = fun k => g (Equiv.swap a b k)`. The `funext` packaging of `act_swapWires`,
convenient for composing the swap into a larger circuit. -/
theorem act_swapWires_eq (a b : Fin n) (g : Fin n → Fin 4) :
    (swapWires a b).act g = fun k => g (Equiv.swap a b k) :=
  funext (act_swapWires a b g)

/-- **The wire-swap acquires no `±1` phase**: `(swapWires a b).sign g = 1`. `SWAP` is a real
permutation matrix and merely permutes the tensor factors of a Pauli string, so the three `CNOT`
tableau signs multiply to `+1` on every letter pair — a finite `Fin 4 × Fin 4` check. -/
theorem sign_swapWires (a b : Fin n) (g : Fin n → Fin 4) :
    (swapWires a b).sign g = 1 := by
  rcases eq_or_ne a b with rfl | hab
  · simp [swapWires, CliffordCircuit.sign]
  · rw [swapWires, dite_eq_right hab]
    simp only [CliffordCircuit.sign, CliffordCircuit.act, CliffordGate.sign, CliffordGate.act]
    obtain ⟨hNa, hNb, hMa, hMb⟩ := swapWires_reduce a b hab g
    rw [hMa, hMb, hNa, hNb]
    generalize g a = α
    generalize g b = β
    fin_cases α <;> fin_cases β <;> simp [cnotPauliSign, cnotTgtPauli, cnotCtrlPauli]

/-- **The wire-swap moves the standard `X` generator between the two wires**:
`(swapWires a b).act (xGenPauli a) = xGenPauli b`. Immediate from `act_swapWires` and the definition
`xGenPauli x = Function.update 0 x 1`: precomposing with the transposition sends the `X` on wire `a`
to wire `b`. The induction uses it to relocate a reduced pivot generator to a chosen first wire. -/
theorem act_swapWires_xGenPauli (a b : Fin n) :
    (swapWires a b).act (xGenPauli a) = xGenPauli b := by
  funext k; simp [act_swapWires, xGenPauli_apply, Equiv.swap_apply_eq_iff, Equiv.swap_apply_left]

/-- **The wire-swap moves the standard `Z` generator between the two wires**:
`(swapWires a b).act (zGenPauli a) = zGenPauli b`. The `Z` mirror of `act_swapWires_xGenPauli`
(`zGenPauli x = Function.update 0 x 3`). -/
theorem act_swapWires_zGenPauli (a b : Fin n) :
    (swapWires a b).act (zGenPauli a) = zGenPauli b := by
  funext k; simp [act_swapWires, zGenPauli_apply, Equiv.swap_apply_eq_iff, Equiv.swap_apply_left]

end AxQM.Concrete

end
