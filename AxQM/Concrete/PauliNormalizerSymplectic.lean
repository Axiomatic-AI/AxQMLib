import AxQM.Concrete.PauliNormalizerReduceGenerator

/-!
# Concrete: the Clifford action is symplectic — the first move of the pair reduction

This file is part of the formalisation of
Nielsen & Chuang **Theorem 10.6** (the converse — the normalizer `N(Gₙ)` is generated by
Hadamard/phase/CNOT gates, Exercise 10.40) toward the multi-qubit inductive synthesis (parts 2–3),
by establishing the *symplectic structure* of a Clifford circuit's action on Pauli strings.

The single-generator reduction `exists_cliffordCircuit_reduceToXGen`/`…ToZGen` collapses one
generator image `U X₁ U†` to a standard `X_c`/`Z_c`. The Exercise 10.40 first-qubit reduction must
reduce the *anticommuting pair* `U X₁ U†`, `U Z₁ U†` *simultaneously*, to `X_c` and `Z_c` on a
**common** wire. The key structural fact making this possible is that a Clifford circuit's action
preserves commutation — precisely how N&C open part 2: "since `Z₁` and `X₁` anticommute, `U Z₁ U†`
and `U X₁ U†` anticommute". This file records that invariant at the circuit level and derives the
symplectic *first move* of the pair reduction.

## Main results

* `CliffordCircuit.act_pauliAnticommCount_even_iff` — **the Clifford action is symplectic**: for any
  circuit `C`, `Even (pauliAnticommCount (act C g) (act C h)) ↔ Even (pauliAnticommCount g h)`. A
  Clifford circuit's phase-free action on the check matrix preserves the mod-2 symplectic form of
  Exercise 10.33. The circuit-level counterpart of the normalizer-level
  `IsPauliNormalizer.exists_signedPerm_symplectic`, proved the same way: `act C` corresponds
  to conjugation by the unitary `toMatrix C` (`conj_pauliString`), conjugation preserves commutation
  (`unitaryConj_commute_iff`), and `pauliString_commute_iff` (Ex 10.33) turns commutation into the
  parity statement.
* `pauliAnticommCount_xGenPauli` / `…_zGenPauli` — **single-generator positions**: the symplectic
  pairing of a string `h` against a standard generator is a single check bit,
  `pauliAnticommCount h (xGenPauli c) = pauliZBit (h c)` and
  `pauliAnticommCount h (zGenPauli c) = pauliXBit (h c)`.
* `odd_pauliAnticommCount_xGenPauli_iff` / `…_zGenPauli_iff` — the parity reading: `h` anticommutes
  with `X_c` iff its `c`-letter has a `Z` factor (`h c ∈ {Y, Z}`), and with `Z_c` iff it has an `X`
  factor (`h c ∈ {X, Y}`).
* `exists_cliffordCircuit_reduceFirstOfPair` — **the symplectic first move of the pair reduction**:
  for anticommuting `p, q` (`Odd (pauliAnticommCount p q)`) there is a Clifford circuit `C` and a
  pivot wire `c` reducing `p` to the standard `X_c` exactly (`act C p = xGenPauli c`,
  `sign C p = 1`) such that the partner image `act C q` *still anticommutes with `X_c`* — concretely
  `act C q c ∈ {Y, Z}`. This is the starting configuration completed by reducing
  `act C q` to `Z_c` while fixing `X_c`.

-/

open Matrix

noncomputable section

namespace AxQM.Concrete

variable {n : ℕ}

namespace CliffordCircuit

/-- **The Clifford action is symplectic.** A Clifford circuit's phase-free action on Pauli strings
preserves the mod-2 symplectic form of Nielsen & Chuang Exercise 10.33: for any circuit `C` and
Pauli strings `g, h`, `Even (pauliAnticommCount (act C g) (act C h)) ↔ Even (pauliAnticommCount g
h)`.

This is the circuit-level counterpart of the normalizer-level
`IsPauliNormalizer.exists_signedPerm_symplectic`, and is proved the same way: `act C`
corresponds to conjugation by the unitary `toMatrix C`
(`conj_pauliString`: `toMatrix C · P_g · (toMatrix C)ᴴ = sign C g • P_{act C g}`), conjugation by a
unitary preserves commutation (`unitaryConj_commute_iff`) — the `±1` phases `sign C g` cancel — and
`pauliString_commute_iff` translates commutation into the parity statement both ways. It is the
structural invariant the inductive synthesis of Exercise 10.40 must reproduce: a Clifford circuit
maps anticommuting Pauli strings to anticommuting ones. -/
theorem act_pauliAnticommCount_even_iff (C : CliffordCircuit n) (g h : Fin n → Fin 4) :
    Even (pauliAnticommCount (act C g) (act C h)) ↔ Even (pauliAnticommCount g h) := by
  rw [← pauliString_commute_iff, ← pauliString_commute_iff]
  have hUmem : toMatrix C ∈ Matrix.unitaryGroup (Fin n → Fin 2) ℂ := by
    rw [mem_unitaryGroup_iff, star_eq_conjTranspose]; exact mul_conjTranspose C
  -- the `±1` conjugation phases cancel, so the images commute iff the raw conjugates do
  have hstep : Commute (toMatrix C * pauliString g * (toMatrix C)ᴴ)
      (toMatrix C * pauliString h * (toMatrix C)ᴴ)
      ↔ Commute (pauliString (act C g)) (pauliString (act C h)) := by
    rw [conj_pauliString C g, conj_pauliString C h,
      Commute.smul_left_iff₀ (sign_ne_zero C g), Commute.smul_right_iff₀ (sign_ne_zero C h)]
  exact hstep.symm.trans (unitaryConj_commute_iff hUmem (pauliString g) (pauliString h))

end CliffordCircuit

/-! ### Single-generator positions: the symplectic pairing against a standard generator -/

/-- **The symplectic pairing against a standard `X` generator is a single `Z` bit**:
`pauliAnticommCount h (xGenPauli c) = pauliZBit (h c)`. Only wire `c` contributes (`xGenPauli c` is
`I` elsewhere), and against a single `X` the per-qubit symplectic pairing
`singlePauliAnticomm (h c) 1` is exactly the `Z`-bit of `h c`. Hence `h` anticommutes with `X_c`
precisely when its `c`-letter contains a `Z` factor. -/
theorem pauliAnticommCount_xGenPauli (h : Fin n → Fin 4) (c : Fin n) :
    pauliAnticommCount h (xGenPauli c) = pauliZBit (h c) := by
  rw [pauliAnticommCount, Finset.sum_eq_single_of_mem c (Finset.mem_univ c)]
  · simp [singlePauliAnticomm, xGenPauli_apply, pauliXBit, pauliZBit]
  · intro k _ hk
    simp [singlePauliAnticomm, xGenPauli_apply, ite_eq_right hk, pauliXBit, pauliZBit]

/-- **The symplectic pairing against a standard `Z` generator is a single `X` bit**:
`pauliAnticommCount h (zGenPauli c) = pauliXBit (h c)`. The `Z`-basis mirror of
`pauliAnticommCount_xGenPauli`: against a single `Z` the per-qubit symplectic pairing
`singlePauliAnticomm (h c) 3` is the `X`-bit of `h c`, so `h` anticommutes with `Z_c` precisely when
its `c`-letter contains an `X` factor. -/
theorem pauliAnticommCount_zGenPauli (h : Fin n → Fin 4) (c : Fin n) :
    pauliAnticommCount h (zGenPauli c) = pauliXBit (h c) := by
  rw [pauliAnticommCount, Finset.sum_eq_single_of_mem c (Finset.mem_univ c)]
  · simp [singlePauliAnticomm, zGenPauli_apply, pauliXBit, pauliZBit]
  · intro k _ hk
    simp [singlePauliAnticomm, zGenPauli_apply, ite_eq_right hk, pauliXBit, pauliZBit]

/-- **Anticommuting with `X_c` means a `Z` factor on wire `c`.** `h` anticommutes with the standard
generator `X_c` (`Odd (pauliAnticommCount h (xGenPauli c))`) iff its `c`-letter is `Y` or `Z`
(`h c = 2 ∨ h c = 3`), the Paulis carrying a `Z` factor. -/
theorem odd_pauliAnticommCount_xGenPauli_iff (h : Fin n → Fin 4) (c : Fin n) :
    Odd (pauliAnticommCount h (xGenPauli c)) ↔ h c = 2 ∨ h c = 3 := by
  rw [pauliAnticommCount_xGenPauli]
  generalize h c = a
  revert a
  decide

/-- **Anticommuting with `Z_c` means an `X` factor on wire `c`.** `h` anticommutes with the standard
generator `Z_c` (`Odd (pauliAnticommCount h (zGenPauli c))`) iff its `c`-letter is `X` or `Y`
(`h c = 1 ∨ h c = 2`), the Paulis carrying an `X` factor. The mirror of
`odd_pauliAnticommCount_xGenPauli_iff`. -/
theorem odd_pauliAnticommCount_zGenPauli_iff (h : Fin n → Fin 4) (c : Fin n) :
    Odd (pauliAnticommCount h (zGenPauli c)) ↔ h c = 1 ∨ h c = 2 := by
  rw [pauliAnticommCount_zGenPauli]
  generalize h c = a
  revert a
  decide

/-! ### The symplectic first move of the pair reduction -/

/-- **The symplectic first move of the pair reduction (Exercise 10.40, first-qubit reduction).** For
an anticommuting pair of Pauli strings `p, q` (`Odd (pauliAnticommCount p q)`), there is a Clifford
circuit `C` and a pivot wire `c` such that:

* `C` reduces `p` to the standard `X` generator on `c` *exactly* — `act C p = xGenPauli c` and
  `sign C p = 1`; and
* the partner image `act C q` **still anticommutes with `X_c`** — concretely `act C q c = 2 ∨
  act C q c = 3` (a `Y`/`Z` factor on the pivot wire).

Construction: `p` is non-identity (an anticommuting partner cannot be the identity, whose symplectic
form is even), so it has a support wire `c`; `exists_cliffordCircuit_reduceToXGen` reduces
`p` to `X_c`. The Clifford action is symplectic (`act_pauliAnticommCount_even_iff`), so `act C p`
and `act C q` still anticommute; rewriting `act C p = X_c` and reading the position lemma
(`odd_pauliAnticommCount_xGenPauli_iff`) gives the `Y`/`Z` factor of `act C q` on `c`.

This is the starting configuration for the rest of the first-qubit reduction: `act C q` shares the
pivot wire `c` with `X_c` (it has a `Z` factor there), so a subsequent circuit can reduce it to
`Z_c` while fixing `X_c`, bringing the pair to the standard `(X_c, Z_c)`. -/
theorem exists_cliffordCircuit_reduceFirstOfPair (p q : Fin n → Fin 4)
    (hpq : Odd (pauliAnticommCount p q)) :
    ∃ (C : CliffordCircuit n) (c : Fin n),
      CliffordCircuit.act C p = xGenPauli c ∧ CliffordCircuit.sign C p = 1 ∧
        (CliffordCircuit.act C q c = 2 ∨ CliffordCircuit.act C q c = 3) := by
  -- an anticommuting partner is non-identity, hence has a support wire `c`
  obtain ⟨c, hc⟩ : ∃ c, p c ≠ 0 := by
    by_contra hall
    have hp0 : ∀ k, p k = 0 := fun k => by
      by_contra hk; exact hall ⟨k, hk⟩
    have hz : pauliAnticommCount p q = 0 := by
      refine Finset.sum_eq_zero fun k _ => ?_
      rw [hp0 k]
      simp [singlePauliAnticomm, pauliXBit, pauliZBit]
    rw [hz] at hpq
    exact absurd hpq (by decide)
  obtain ⟨C, hCact, hCsign⟩ := exists_cliffordCircuit_reduceToXGen p c hc
  refine ⟨C, c, hCact, hCsign, ?_⟩
  -- the images still anticommute, and `act C p = X_c`, so `act C q` anticommutes with `X_c`
  have hpreserve : Odd (pauliAnticommCount (C.act p) (C.act q)) := by
    rw [← Nat.not_even_iff_odd] at hpq ⊢
    rwa [CliffordCircuit.act_pauliAnticommCount_even_iff]
  rw [← odd_pauliAnticommCount_xGenPauli_iff, pauliAnticommCount_symm, ← hCact]
  exact hpreserve

end AxQM.Concrete

end
