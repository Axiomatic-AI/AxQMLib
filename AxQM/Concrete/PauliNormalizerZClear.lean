import AxQM.Concrete.PauliNormalizerCnotClear

/-!
# Concrete: the `Z`-generator sweep — diagonalise to all-`Z` and collapse to a single `Z`

This file is part of the formalisation of
Nielsen & Chuang **Theorem 10.6** (the converse — the normalizer `N(Gₙ)` is generated by
Hadamard/phase/CNOT gates, Exercise 10.40) toward the multi-qubit inductive synthesis (parts 2–3).

It is the **`Z`-generator companion** of the `X`-generator sweep:

* diagonalise-to-all-`X` (`exists_singleQubitLayer_act_diagX`) and
* CNOT-clear-to-single-`X` (`exists_cliffordCircuit_cnotClear_toSingleX`).

The Gottesman tableau sweep reduces a normalizer's action on the second generator `U Z₁ U†` by the
mirror-image of the first-generator moves, working in the `Z` (rather than `X`) basis:

1. **Diagonalise to all-`Z`** (*this file*, `exists_singleQubitLayer_act_diagZ`): a single-qubit
   layer rotates the image to a string carrying `Z` on its support and `I` elsewhere. The per-wire
   rotation `rotateToZ` uses `H` (`X ↦ Z`) and `H S` (`Y ↦ X ↦ Z`); `Z` and `I` need no gate.
2. **Collapse to a single generator** (*this file*, `exists_cliffordCircuit_cnotClear_toSingleZ`): a
   **fan of CNOTs into** one support wire `c` (that wire the common *target*, every other support
   wire a *control*) clears the `Z` off every other support wire, leaving `Z` on wire `c` alone
   (`zGenPauli c`).

The clearing move is the `Z`-basis mirror of the `X`-clearing. For `X` a single
`CNOT_{c→t}` (control `c`, target `t`) copies the control's `X` onto the target (`x_t += x_c`,
Figure 10.7), so a fan *out of* `c` clears an all-`X` string down to `X_c`. For `Z` the propagation
runs the other way — `CNOT_{t→c}` sends the target's `Z` onto the control (`z_c += z_t`), i.e. a
`CNOT` whose **control** is `t` and **target** is `c` clears `Z` off `t` (`cnotCtrlPauli 3 3 = 0`)
while keeping `Z` on `c` (`cnotTgtPauli 3 3 = 3`). So the `Z`-collapse fan reverses the control/
target roles of the `X`-collapse fan: `cnotFanInto c ts` runs `CNOT_{t→c}` for each `t ∈ ts`.

## What is proved

* `CliffordCircuit.rotateToZ` / `rotateToZ_act` — a single-wire Clifford rotating a Pauli letter to
  `Z` (fixing `I`): `H` for `X`, `H S` for `Y`.
* `exists_singleQubitLayer_act_diagZ` — **sweep step 1 (`Z` basis)**: a single-qubit layer sends any
  Pauli string to its all-`Z`-on-support form, returned as the per-wire family so the layer's action
  on any other string stays available through `CliffordCircuit.singleQubitLayer_act`.
* `cnotFanInto` — the **reverse CNOT fan**: `CNOT_{t→c}` for every `t ∈ ts` (targets folded into the
  single control-collector wire `c`). `act_cnotFanInto_collapse` gives its clearing action on an
  all-`Z` string and `sign_cnotFanInto_collapse` its trivial `±1` phase.
* `exists_cliffordCircuit_cnotClear_toSingleZ` — **sweep step 2 (`Z` basis)**: for
  any all-`Z` string `a` with a pivot `c` in its support, a Clifford circuit realising
  `a ↦ zGenPauli c` exactly, with phase `1`. Together with the diagonalisation step this reduces a
  normalizer's second generator image `U Z₁ U†` to the standard `Z₁`, the `Z`-basis mirror of the
  `X`-generator reduction.
-/

open Matrix

noncomputable section

namespace AxQM.Concrete

variable {n : ℕ}

namespace CliffordCircuit

/-! ### Rotating a single Pauli letter to `Z` -/

/-- **A single-wire Clifford rotating the letter `c` to `Z`.** `Z` needs no gate; `H` sends
`X ↦ Z` (`hadamardPauli`); `H S` sends `Y ↦ X ↦ Z` (`S` first, `phasePauli 2 = 1`; then `H`,
`hadamardPauli 1 = 3`). The identity `I` (`c = 0`) is left as `I`. -/
def rotateToZ (c : Fin 4) : CliffordCircuit 1 :=
  if c = 1 then [CliffordGate.had 0]
  else if c = 2 then [CliffordGate.had 0, CliffordGate.phase 0] else []

/-- **`rotateToZ c` sends the letter `c` to `Z`** (and fixes `I`): `(rotateToZ c).act (fun _ => c) 0
= if c = 0 then 0 else 3`. Verified by cases on `c` (`decide` on the computable single-wire
action; the two-gate `Y` case composes right-to-left, `S` then `H`). -/
theorem rotateToZ_act (c : Fin 4) :
    act (rotateToZ c) (fun _ => c) 0 = if c = 0 then 0 else 3 := by
  fin_cases c <;> decide

end CliffordCircuit

/-! ### Sweep step 1 (`Z` basis): diagonalise a Pauli string to all-`Z` -/

/-- **First move of the `Z`-generator sweep: rotate a Pauli string to all-`Z`.** For any Pauli
string `a : Fin n → Fin 4` there is a single-qubit family `f` whose layer sends `a` to the string
carrying `Z` on every wire of `a`'s support and `I` elsewhere:
`(singleQubitLayer f).act a k = if a k = 0 then 0 else 3`. Take `f k = rotateToZ (a k)` on each wire
and apply `singleQubitLayer_act` and `rotateToZ_act`.

The witness is returned as the *per-wire family* `f` rather than the assembled circuit, so a caller
can read off the same layer's effect on any *other* Pauli string through
`CliffordCircuit.singleQubitLayer_act` — the `Z`-basis mirror of
`exists_singleQubitLayer_act_diagX`,
and what the multi-qubit induction needs while diagonalising the second generator's image
`U Z₁ U†`. -/
theorem exists_singleQubitLayer_act_diagZ (a : Fin n → Fin 4) :
    ∃ f : Fin n → CliffordCircuit 1, ∀ k,
      CliffordCircuit.act (CliffordCircuit.singleQubitLayer f) a k = if a k = 0 then 0 else 3 := by
  refine ⟨fun k => CliffordCircuit.rotateToZ (a k), fun k => ?_⟩
  rw [CliffordCircuit.singleQubitLayer_act]
  exact CliffordCircuit.rotateToZ_act (a k)

/-! ### The reverse CNOT fan: collapsing an all-`Z` string -/

/-- **The reverse CNOT fan into a collector wire `c`.** Runs `CNOT_{t→c}` (control `t`, target `c`)
for each `t ∈ ts` (`ts.flatMap (fun t => cnotStep t c)`). This is the control/target mirror of
`cnotFan` (which fixes a single control and fans onto many targets): here a single target `c`
collects from many controls, so that a fan of `Z`-carrying controls collapses onto the single
target `c` (`z_c += z_t` clears the control's `Z`, keeps the target's). -/
def cnotFanInto (c : Fin n) (ts : List (Fin n)) : CliffordCircuit n :=
  ts.flatMap (fun t => cnotStep t c)

@[simp]
theorem cnotFanInto_nil (c : Fin n) : cnotFanInto c [] = [] := rfl

theorem cnotFanInto_cons (c t : Fin n) (ts : List (Fin n)) :
    cnotFanInto c (t :: ts) = cnotStep t c ++ cnotFanInto c ts := by
  simp [cnotFanInto, List.flatMap_cons]

/-- Peeling the head of a reverse CNOT fan (with `t ≠ c`): the head CNOT `t → c` acts last, on the
result of the rest of the fan. -/
theorem act_cnotFanInto_cons_of_ne {c t : Fin n} (htc : t ≠ c) (ts : List (Fin n))
    (g : Fin n → Fin 4) :
    CliffordCircuit.act (cnotFanInto c (t :: ts)) g
      = cnotPauliString (CliffordCircuit.act (cnotFanInto c ts) g) t c := by
  rw [cnotFanInto_cons, CliffordCircuit.act_append, act_cnotStep_of_ne htc]

/-- **A reverse CNOT fan collapses an all-`Z` string to its collector.** For a string `a` with `Z`
(letter `3`) on wire `c` and on every wire of a distinct list `ts` (`c ∉ ts`, `ts.Nodup`,
`∀ t ∈ ts, a t = 3`), the fan `cnotFanInto c ts` (controls `ts`, target `c`) transforms `a` to:
`act (cnotFanInto c ts) a k = if k = c then 3 else if k ∈ ts then 0 else a k` — `Z` kept on the
collector `c`, `I` on every control, and every other wire unchanged.

This is the `Z`-basis mirror of `act_cnotFan_collapse`: `CNOT_{t→c}` copies the control's `Z` onto
the target (`z_c += z_t`, Figure 10.7), so a control that already carries a `Z` is cleared
(`cnotCtrlPauli 3 3 = 0`) while the target keeps its `Z` (`cnotTgtPauli 3 3 = 3`). Proved by
induction on `ts` via `act_cnotFanInto_cons_of_ne`. -/
theorem act_cnotFanInto_collapse (c : Fin n) :
    ∀ (ts : List (Fin n)), c ∉ ts → ts.Nodup → ∀ (a : Fin n → Fin 4), a c = 3 →
      (∀ t ∈ ts, a t = 3) → ∀ k,
      CliffordCircuit.act (cnotFanInto c ts) a k = if k = c then 3 else if k ∈ ts then 0 else a k
  | [], _, _, a, hac, _, k => by
      simp only [cnotFanInto_nil, CliffordCircuit.act, List.not_mem_nil, ite_false]
      rcases eq_or_ne k c with rfl | hk
      · rw [ite_eq_left rfl]; exact hac
      · rw [ite_eq_right hk]
  | t :: ts, hct, hnd, a, hac, hall, k => by
      rw [List.mem_cons, not_or] at hct
      obtain ⟨hct_t, hct_ts⟩ := hct
      obtain ⟨htnotin, hnd'⟩ := List.nodup_cons.mp hnd
      have htc : t ≠ c := Ne.symm hct_t
      have hall' : ∀ t' ∈ ts, a t' = 3 := fun t' ht' => hall t' (List.mem_cons_of_mem t ht')
      have hIH := act_cnotFanInto_collapse c ts hct_ts hnd' a hac hall'
      have hac' : CliffordCircuit.act (cnotFanInto c ts) a c = 3 := by rw [hIH c]; simp
      have hat' : CliffordCircuit.act (cnotFanInto c ts) a t = 3 := by
        rw [hIH t, ite_eq_right htc, ite_eq_right htnotin]
        exact hall t List.mem_cons_self
      rw [act_cnotFanInto_cons_of_ne htc ts a]
      rcases eq_or_ne k t with rfl | hkt
      · rw [cnotPauliString_ctrl, hat', hac', ite_eq_right htc, ite_eq_left List.mem_cons_self]
        decide
      · rcases eq_or_ne k c with rfl | hkc
        · rw [cnotPauliString_tgt _ htc, hat', hac', ite_eq_left rfl]
          decide
        · rw [cnotPauliString_of_ne _ t c hkt hkc, hIH k]
          have hmem2 : (k ∈ t :: ts) ↔ (k ∈ ts) := by simp [List.mem_cons, hkt]
          simp only [hmem2]

/-- **The reverse CNOT clearing introduces no sign.** Under the hypotheses of
`act_cnotFanInto_collapse`, `sign (cnotFanInto c ts) a = 1`: each `CNOT_{t→c}` in the fan conjugates
a pair `(Z_t, Z_c)` (control and target both `Z`, by the collapse action of the tail), whose CNOT
tableau sign is `cnotPauliSign 3 3 = 1`. Proved by induction on `ts` via `sign_append` and the
tail's `act` values from `act_cnotFanInto_collapse`. -/
theorem sign_cnotFanInto_collapse (c : Fin n) :
    ∀ (ts : List (Fin n)), c ∉ ts → ts.Nodup → ∀ (a : Fin n → Fin 4), a c = 3 →
      (∀ t ∈ ts, a t = 3) → CliffordCircuit.sign (cnotFanInto c ts) a = 1
  | [], _, _, _, _, _ => by simp [cnotFanInto_nil, CliffordCircuit.sign]
  | t :: ts, hct, hnd, a, hac, hall => by
      rw [List.mem_cons, not_or] at hct
      obtain ⟨hct_t, hct_ts⟩ := hct
      obtain ⟨htnotin, hnd'⟩ := List.nodup_cons.mp hnd
      have htc : t ≠ c := Ne.symm hct_t
      have hall' : ∀ t' ∈ ts, a t' = 3 := fun t' ht' => hall t' (List.mem_cons_of_mem t ht')
      have hac' : CliffordCircuit.act (cnotFanInto c ts) a c = 3 := by
        rw [act_cnotFanInto_collapse c ts hct_ts hnd' a hac hall' c]; simp
      have hat' : CliffordCircuit.act (cnotFanInto c ts) a t = 3 := by
        rw [act_cnotFanInto_collapse c ts hct_ts hnd' a hac hall' t, ite_eq_right htc,
            ite_eq_right htnotin]
        exact hall t List.mem_cons_self
      rw [cnotFanInto_cons, CliffordCircuit.sign_append,
        sign_cnotFanInto_collapse c ts hct_ts hnd' a hac hall', one_mul,
        sign_cnotStep_of_ne htc, hat', hac']
      rfl

/-! ### Sweep step 2 (`Z` basis): collapse an all-`Z` image to a single `Z` generator -/

/-- **Reverse CNOT clearing (N&C Exercise 10.40 sweep step 2, `Z` basis).** For any all-`Z` Pauli
string `a` (`∀ k, a k = 0 ∨ a k = 3`) with a pivot wire `c` in its support (`a c = 3`), there is a
Clifford circuit `C` collapsing `a` to the single `Z` generator on wire `c` exactly, with phase `1`:
`act C a = zGenPauli c` and `sign C a = 1`.

The witness is the reverse CNOT fan `cnotFanInto c ts` with collector `c` and controls the rest of
`a`'s support `ts = {k | a k = 3, k ≠ c}` (as a `Finset.filter … |>.toList`, so `Nodup` and
`c ∉ ts`); `act_cnotFanInto_collapse` clears every control's `Z`, and `sign_cnotFanInto_collapse`
gives the trivial phase. Together with the diagonalisation step
(`exists_singleQubitLayer_act_diagZ`) this reduces a normalizer's second generator image `U Z₁ U†`
to the standard `Z₁`, the `Z`-basis
mirror of `exists_cliffordCircuit_cnotClear_toSingleX`. -/
theorem exists_cliffordCircuit_cnotClear_toSingleZ (a : Fin n → Fin 4) (c : Fin n)
    (hc : a c = 3) (hZ : ∀ k, a k = 0 ∨ a k = 3) :
    ∃ C : CliffordCircuit n,
      CliffordCircuit.act C a = zGenPauli c ∧ CliffordCircuit.sign C a = 1 := by
  set ts := (Finset.univ.filter (fun k => a k = 3 ∧ k ≠ c)).toList with hts
  have hmem : ∀ k, k ∈ ts ↔ (a k = 3 ∧ k ≠ c) := by
    intro k
    rw [hts, Finset.mem_toList, Finset.mem_filter]
    simp
  have hnd : ts.Nodup := Finset.nodup_toList _
  have hcnotin : c ∉ ts := fun h => ((hmem c).mp h).2 rfl
  have hall : ∀ t ∈ ts, a t = 3 := fun t ht => ((hmem t).mp ht).1
  refine ⟨cnotFanInto c ts, ?_, sign_cnotFanInto_collapse c ts hcnotin hnd a hc hall⟩
  funext k
  rw [act_cnotFanInto_collapse c ts hcnotin hnd a hc hall k, zGenPauli_apply]
  rcases eq_or_ne k c with rfl | hkc
  · simp
  · simp only [ite_eq_right hkc]
    by_cases hk3 : a k = 3
    · rw [ite_eq_left ((hmem k).mpr ⟨hk3, hkc⟩)]
    · rw [ite_eq_right (fun h => hk3 ((hmem k).mp h).1)]
      exact (hZ k).resolve_right hk3

end AxQM.Concrete

end
