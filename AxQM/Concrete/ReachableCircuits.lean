import AxQM.Concrete.UnitaryToffoliSingleQubitProduct

/-!
# Generic reachable-circuit density over an abstract single-qubit gate set (N&C §4.5/§4.3)

The §4.5/§4.3 universality assembly — every register unitary is a product of `Toffoli`/`CNOT`/`NOT`
and uncontrolled single-qubit wire gates (`exists_isToffoliOrSingleQubit_list_prod_eq`), each
approximated up to a global phase, the phases combining into one global phase — is **generic** in
the reachable single-qubit gate set. This file states it once, parameterised over an abstract set
`S` of
`2 × 2` gates whose per-wire density (up to a global phase) is supplied as a hypothesis, so the two
universality items reuse it rather than re-proving the ~90-line assembly per item:

* Exercise 4.43 (`H, S, CNOT, Toffoli`): `S = reachableRotations θ`, `cos θ = 3/5`
  (`Concrete/FourGateUniversality.lean`);
* Exercise 4.44 (the Deutsch gate `G = C²(iR_x(πα))`): `S = deutschWireGateSubmonoid α`, `α`
  irrational (`Concrete/DeutschReachableCircuits.lean`).

## The construction and results

* `reachableGateSetOf enc S` — the elementary gates the reduction bottoms out in: the `≤ 2`-control
  reversible gates `IsToffoliPermGate enc G` (`Toffoli`/`CNOT`/`NOT`) together with, on every wire
  `j`, the uncontrolled single-qubit gates `singleQubitOnWire enc j g` whose block `g` lies in `S`.
* `reachableCircuitsOf enc S` — the submonoid they generate (finite products of reachable gates).
* `exists_phase_smul_mem_closure_reachableCircuitsOf` — **the generic density**: given the per-wire
  density hypothesis `hS` (for every wire `j` and `U ∈ U(2)`, some global phase makes
  `e^{ia} • singleQubitOnWire enc j U` a limit of `singleQubitOnWire enc j '' S`), an `m`-qubit
  encoding with `m ≥ 1`, and any `U ∈ U(d)`, some global phase `e^{ia}` makes `e^{ia} • U` a limit
  of `reachableCircuitsOf enc S` — the reachable circuits are dense in `U(d)` up to a global phase.
-/

namespace AxQM.Concrete

open Matrix

variable {m d : ℕ}

/-- **The reachable gate set over an abstract single-qubit gate set `S`.** The elementary matrix
gates the §4.5/§4.3 universality reduction bottoms out in: the `≤ 2`-control reversible gates
`IsToffoliPermGate enc G` (`Toffoli`/`CNOT`/`NOT`) together with, on every wire `j`, the
uncontrolled single-qubit gates `singleQubitOnWire enc j g` whose block `g` lies in `S`.
Instantiating `S` gives
Exercise 4.43's `reachableGateSet` (`S = reachableRotations θ`) and Exercise 4.44's
`deutschReachableGateSet` (`S = deutschWireGateSubmonoid α`). -/
noncomputable def reachableGateSetOf (enc : (Fin m → Fin 2) ≃ Fin d)
    (S : Set (Matrix (Fin 2) (Fin 2) ℂ)) : Set (Matrix (Fin d) (Fin d) ℂ) :=
  {G | IsToffoliPermGate enc G} ∪ ⋃ j : Fin m, singleQubitOnWire enc j '' S

/-- **The reachable circuits over an abstract single-qubit gate set `S`.** The submonoid of
`Matrix (Fin d) (Fin d) ℂ` generated by `reachableGateSetOf enc S` — the finite products of
reachable gates. Universality is the statement that its closure fills `U(d)` up to a global phase
(`exists_phase_smul_mem_closure_reachableCircuitsOf`). -/
noncomputable def reachableCircuitsOf (enc : (Fin m → Fin 2) ≃ Fin d)
    (S : Set (Matrix (Fin 2) (Fin 2) ℂ)) : Submonoid (Matrix (Fin d) (Fin d) ℂ) :=
  Submonoid.closure (reachableGateSetOf enc S)

/-- Each `≤ 2`-control reversible gate (`Toffoli`/`CNOT`/`NOT`) is a reachable circuit — one of
the gates that generate `reachableCircuitsOf`. -/
theorem isToffoliPermGate_mem_reachableCircuitsOf (enc : (Fin m → Fin 2) ≃ Fin d)
    (S : Set (Matrix (Fin 2) (Fin 2) ℂ)) {G : Matrix (Fin d) (Fin d) ℂ}
    (hG : IsToffoliPermGate enc G) : G ∈ reachableCircuitsOf enc S :=
  Submonoid.subset_closure (Or.inl hG)

/-- Each uncontrolled single-qubit gate on a wire whose block lies in `S` is a reachable circuit — a
generator of `reachableCircuitsOf`. -/
theorem singleQubitOnWire_mem_reachableCircuitsOf (enc : (Fin m → Fin 2) ≃ Fin d)
    (S : Set (Matrix (Fin 2) (Fin 2) ℂ)) (j : Fin m) {g : Matrix (Fin 2) (Fin 2) ℂ}
    (hg : g ∈ S) : singleQubitOnWire enc j g ∈ reachableCircuitsOf enc S :=
  Submonoid.subset_closure (Or.inr (Set.mem_iUnion.2 ⟨j, Set.mem_image_of_mem _ hg⟩))

/-- **Each terminal gate is, up to a global phase, a limit of reachable circuits.** Given the
per-wire density hypothesis `hS`, for a terminal gate `G` (`IsToffoliOrSingleQubitGate enc G`) there
is a phase `a` with `e^{ia} • G` in the closure of `reachableCircuitsOf enc S`:
* a `Toffoli`/`CNOT`/`NOT` is *exactly* a reachable generator, so the phase is `0`;
* an uncontrolled single-qubit unitary on a wire is a limit of `singleQubitOnWire` applied to `S`,
  up to a global phase — this is exactly the hypothesis `hS`, whose image sits inside the reachable
  circuits (`singleQubitOnWire_mem_reachableCircuitsOf`). -/
theorem exists_phase_smul_mem_closure_reachableCircuitsOf_of_isToffoliOrSingleQubit
    (enc : (Fin m → Fin 2) ≃ Fin d) {S : Set (Matrix (Fin 2) (Fin 2) ℂ)}
    (hS : ∀ (j : Fin m) {U : Matrix (Fin 2) (Fin 2) ℂ}, U ∈ Matrix.unitaryGroup (Fin 2) ℂ →
      ∃ a : ℝ, Complex.exp ((a : ℂ) * Complex.I) • singleQubitOnWire enc j U
        ∈ closure (singleQubitOnWire enc j '' S))
    {G : Matrix (Fin d) (Fin d) ℂ} (hG : IsToffoliOrSingleQubitGate enc G) :
    ∃ a : ℝ, Complex.exp ((a : ℂ) * Complex.I) • G
      ∈ closure (↑(reachableCircuitsOf enc S) : Set (Matrix (Fin d) (Fin d) ℂ)) := by
  rcases hG with h | ⟨j, U, hU, rfl⟩
  · -- `Toffoli`/`CNOT`/`NOT`: exact generator, phase `0`.
    refine ⟨0, ?_⟩
    rw [Complex.ofReal_zero, zero_mul, Complex.exp_zero, one_smul]
    exact subset_closure (isToffoliPermGate_mem_reachableCircuitsOf enc S h)
  · -- Single-qubit gate on a wire: the density hypothesis, image inside the circuits.
    obtain ⟨a, ha⟩ := hS j hU
    refine ⟨a, closure_mono ?_ ha⟩
    rintro _ ⟨g, hg, rfl⟩
    exact singleQubitOnWire_mem_reachableCircuitsOf enc S j hg

/-- **A product of terminal gates is, up to a global phase, a limit of reachable circuits.** Given
the per-wire density hypothesis `hS`, for a list `gates` all of whose members are terminal gates
there is a phase `a` with `e^{ia} • gates.prod` in the closure of `reachableCircuitsOf enc S`. The
closure of the submonoid is again a submonoid (matrix multiplication is continuous), so the per-gate
approximations multiply, and their phases add into one global phase. -/
theorem exists_phase_smul_prod_mem_closure_reachableCircuitsOf
    (enc : (Fin m → Fin 2) ≃ Fin d) {S : Set (Matrix (Fin 2) (Fin 2) ℂ)}
    (hS : ∀ (j : Fin m) {U : Matrix (Fin 2) (Fin 2) ℂ}, U ∈ Matrix.unitaryGroup (Fin 2) ℂ →
      ∃ a : ℝ, Complex.exp ((a : ℂ) * Complex.I) • singleQubitOnWire enc j U
        ∈ closure (singleQubitOnWire enc j '' S))
    {gates : List (Matrix (Fin d) (Fin d) ℂ)}
    (hgates : ∀ g ∈ gates, IsToffoliOrSingleQubitGate enc g) :
    ∃ a : ℝ, Complex.exp ((a : ℂ) * Complex.I) • gates.prod
      ∈ closure (↑(reachableCircuitsOf enc S) : Set (Matrix (Fin d) (Fin d) ℂ)) := by
  induction gates with
  | nil =>
    refine ⟨0, ?_⟩
    rw [List.prod_nil, Complex.ofReal_zero, zero_mul, Complex.exp_zero, one_smul]
    exact subset_closure (one_mem _)
  | cons g gs ih =>
    obtain ⟨ag, hag⟩ :=
      exists_phase_smul_mem_closure_reachableCircuitsOf_of_isToffoliOrSingleQubit enc hS
        (hgates g (List.mem_cons_self ..))
    obtain ⟨as, has⟩ := ih fun x hx => hgates x (List.mem_cons_of_mem _ hx)
    refine ⟨ag + as, ?_⟩
    rw [List.prod_cons, Complex.ofReal_add, add_mul, Complex.exp_add, ← smul_mul_smul_comm]
    exact (reachableCircuitsOf enc S).topologicalClosure.mul_mem hag has

/-- **Generic universality density over an abstract single-qubit gate set `S`.** Given the per-wire
density hypothesis `hS` (for every wire `j` and `U ∈ U(2)`, some global phase makes
`e^{ia} • singleQubitOnWire enc j U` a limit of `singleQubitOnWire enc j '' S`), an encoding
`enc : (Fin m → Fin 2) ≃ Fin d` of an `m`-qubit register with at least one qubit, and *any*
`U ∈ U(d)`, some global phase `e^{ia}` makes `e^{ia} • U ∈ closure ↑(reachableCircuitsOf enc S)`.

In the finite-dimensional product topology on `Matrix (Fin d) (Fin d) ℂ`, closure is approximation
to arbitrary accuracy, so this is exactly: **the reachable circuits are dense in `U(d)` up to a
global phase**. Chains the exact terminal-gate decomposition
`exists_isToffoliOrSingleQubit_list_prod_eq`
with the per-product approximation `exists_phase_smul_prod_mem_closure_reachableCircuitsOf`. The two
universality items — Exercise 4.43 (`reachableRotations θ`) and Exercise 4.44
(`deutschWireGateSubmonoid α`) — obtain their headline by instantiating this with the appropriate
per-wire density for `hS`. -/
theorem exists_phase_smul_mem_closure_reachableCircuitsOf [Nontrivial (Fin m → Fin 2)]
    (enc : (Fin m → Fin 2) ≃ Fin d) {S : Set (Matrix (Fin 2) (Fin 2) ℂ)}
    (hS : ∀ (j : Fin m) {U : Matrix (Fin 2) (Fin 2) ℂ}, U ∈ Matrix.unitaryGroup (Fin 2) ℂ →
      ∃ a : ℝ, Complex.exp ((a : ℂ) * Complex.I) • singleQubitOnWire enc j U
        ∈ closure (singleQubitOnWire enc j '' S))
    {U : Matrix (Fin d) (Fin d) ℂ} (hU : U ∈ Matrix.unitaryGroup (Fin d) ℂ) :
    ∃ a : ℝ, Complex.exp ((a : ℂ) * Complex.I) • U
      ∈ closure (↑(reachableCircuitsOf enc S) : Set (Matrix (Fin d) (Fin d) ℂ)) := by
  obtain ⟨gates, hgates, hprod⟩ := exists_isToffoliOrSingleQubit_list_prod_eq enc hU
  obtain ⟨a, ha⟩ := exists_phase_smul_prod_mem_closure_reachableCircuitsOf enc hS hgates
  exact ⟨a, hprod ▸ ha⟩

end AxQM.Concrete
