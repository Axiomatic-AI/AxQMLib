import AxQM.Concrete.RotationDecompositionXY
import ToMathlib.NumberTheory.CosThreeFifthsIrrational
import Mathlib.Topology.Algebra.Order.ArchimedeanDiscrete
import Mathlib.Analysis.SpecialFunctions.Complex.Circle

/-!
# Concrete: iterating an irrational-angle `z`-rotation densely fills the `z`-rotations

## Mathematical content (the analytic core of Nielsen & Chuang, Exercise 4.43)

Nielsen & Chuang's Exercise 4.43 assembles the "universality of `H, S, CNOT, Toffoli`" from the two
preceding exercises: Exercise 4.41 realises the `z`-rotation `R_z(θ)` with `cos θ = 3/5` from those
gates (a measurement-based circuit), and Exercise 4.42 shows that `θ` is an *irrational* multiple of
`2π`. The step this file formalises is the inference N&C then draw — **repeated application of
`R_z(θ)` approximates any `R_z(α)` to arbitrary accuracy**:

* `rotZ_mem_closure_range_zsmul` — if `θ / (2π)` is irrational then, for every angle `α`, the
  rotation `R_z(α)` lies in the closure of `{R_z(nθ) : n ∈ ℤ}`. Equivalently, the cyclic group of
  `z`-rotations generated by `R_z(θ)` is dense in the one-parameter family of all `z`-rotations.
* `rotZ_mem_closure_range_zsmul_of_cos_eq_three_div_five` — the same conclusion under the exercise's
  hypothesis `cos θ = 3/5`, obtained from the number-theoretic Exercise 4.42
  (`irrational_div_two_pi_of_cos_eq_three_div_five`).
* `rotX_mem_closure_range_zsmul` / `rotX_mem_closure_range_zsmul_of_cos_eq_three_div_five` — the
  corresponding density for the `x`-rotations, transported through the Hadamard conjugation
  `H R_z(θ) H = R_x(θ)` (`hadamardC_mul_rotZ_mul_hadamardC`). Density for both non-commuting axes is
  what feeds — via the Z–Y decomposition (`exists_zy_decomposition`, Theorem 4.1) — the
  approximation of an arbitrary single-qubit unitary.

## Design notes

* **Why the integer powers.** The set `{R_z(nθ) : n ∈ ℤ}` is exactly the cyclic subgroup generated
  by the gate `R_z(θ)` (its inverse `R_z(θ)⁻¹ = R_z(-θ)` is again available). This is the standard
  "operations reachable by iterating the gate" and is the faithful reading of N&C's "repeated
  iteration"; it is not a weakening (the forward `ℕ`-orbit is dense as well, by the same
  equidistribution, but the subgroup statement is the natural group-theoretic one and is all the
  universality argument needs).
* **Period `4π`, not `2π`.** `R_z` has period `4π` (`R_z(θ) = diag(e^{-iθ/2}, e^{iθ/2})`), so
  `R_z(θ + 2π) = -R_z(θ)` differs from `R_z(θ)` by a global phase. To land on `R_z(α)` *on the nose*
  (not merely up to sign) the density is proved through the two-generator subgroup `⟨θ, 4π⟩ ⊆ ℝ`:
  it is dense because `θ / (2π)` is irrational (were `⟨θ, 4π⟩ = ⟨a⟩` cyclic, `θ` and `4π` would be
  integer multiples of a common `a`, forcing `θ / (2π) = 2p/q ∈ ℚ`), and `R_z` is continuous and
  constant on cosets of `4πℤ`, so its image of the dense subgroup is `{R_z(nθ)}` and its closure
  contains the whole continuous image `Set.range rotZ`.
-/

namespace AxQM.Concrete

open Matrix Complex

/-- **`R_z` is continuous** as a function of the rotation angle (each matrix entry is
`θ ↦ e^{±iθ/2}`, continuous). -/
theorem continuous_rotZ : Continuous rotZ := by
  refine continuous_matrix fun i j => ?_
  simp only [rotZ_eq]
  fin_cases i <;> fin_cases j <;>
    simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue, of_apply, cons_val', cons_val_zero,
      cons_val_one, cons_val_fin_one, empty_val'] <;>
    fun_prop

/-- **`R_z` has period `4π`:** shifting the angle by an integer multiple of `4π` leaves the
`z`-rotation unchanged, since `e^{-i(θ + 4πm)/2} = e^{-iθ/2} · e^{-2πi m} = e^{-iθ/2}`. -/
theorem rotZ_add_zsmul_four_pi (θ : ℝ) (m : ℤ) :
    rotZ (θ + m • (4 * Real.pi)) = rotZ θ := by
  rw [rotZ_eq, rotZ_eq]
  have hφ : ((θ + m • (4 * Real.pi) : ℝ) : ℂ) / 2
      = (θ : ℂ) / 2 + (m : ℂ) * (2 * Real.pi) := by
    push_cast [zsmul_eq_mul]; ring
  have e11 : Complex.exp (↑(θ + m • (4 * Real.pi)) / 2 * Complex.I)
      = Complex.exp (↑θ / 2 * Complex.I) := by
    rw [hφ, add_mul, Complex.exp_add,
        show (m : ℂ) * (2 * ↑Real.pi) * Complex.I = (m : ℂ) * (2 * ↑Real.pi * Complex.I) by ring,
        Complex.exp_int_mul_two_pi_mul_I, mul_one]
  have e00 : Complex.exp (-(↑(θ + m • (4 * Real.pi)) / 2) * Complex.I)
      = Complex.exp (-(↑θ / 2) * Complex.I) := by
    rw [hφ,
        show -(↑θ / 2 + (m : ℂ) * (2 * ↑Real.pi)) * Complex.I
          = -(↑θ / 2) * Complex.I + ((-m : ℤ) : ℂ) * (2 * ↑Real.pi * Complex.I) by push_cast; ring,
        Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]
  rw [e00, e11]

/-- **The two-generator subgroup `⟨θ, 4π⟩ ⊆ ℝ` is dense** whenever `θ / (2π)` is irrational. If it
were cyclic, `⟨a⟩`, then `θ = p • a` and `4π = q • a` for integers `p, q` (with `q ≠ 0`), giving the
rational value `θ / (2π) = 2p/q` — contradicting the hypothesis. -/
theorem dense_zmultiples_sup {θ : ℝ} (hθ : Irrational (θ / (2 * Real.pi))) :
    Dense ((AddSubgroup.zmultiples θ ⊔ AddSubgroup.zmultiples (4 * Real.pi) : AddSubgroup ℝ) :
      Set ℝ) := by
  rw [AddSubgroup.dense_iff_not_isAddCyclic, AddSubgroup.isAddCyclic_iff_exists_zmultiples_eq]
  rintro ⟨a, heq⟩
  replace heq := heq.symm
  have hθmem : θ ∈ AddSubgroup.zmultiples a := by
    rw [← heq]; exact AddSubgroup.mem_sup_left (AddSubgroup.mem_zmultiples θ)
  have h4mem : 4 * Real.pi ∈ AddSubgroup.zmultiples a := by
    rw [← heq]; exact AddSubgroup.mem_sup_right (AddSubgroup.mem_zmultiples (4 * Real.pi))
  obtain ⟨p, hp⟩ := AddSubgroup.mem_zmultiples_iff.mp hθmem
  obtain ⟨q, hq⟩ := AddSubgroup.mem_zmultiples_iff.mp h4mem
  rw [zsmul_eq_mul] at hp hq
  have hq0 : (q : ℝ) ≠ 0 := by
    rintro h0
    rw [h0, zero_mul] at hq
    have := Real.pi_pos
    linarith [hq]
  apply hθ
  refine ⟨2 * (p : ℚ) / (q : ℚ), ?_⟩
  have hqℝ : ((2 * (p : ℚ) / (q : ℚ) : ℚ) : ℝ) = 2 * (p : ℝ) / (q : ℝ) := by push_cast; ring
  have ha : a = 4 * Real.pi / (q : ℝ) := by rw [eq_div_iff hq0, mul_comm]; exact hq
  have key : θ / (2 * Real.pi) = 2 * (p : ℝ) / (q : ℝ) := by
    rw [← hp, ha]; field_simp; ring
  rw [hqℝ, key]

/-- **Iterating `R_z(θ)` approximates every `z`-rotation** when `θ / (2π)` is irrational: for every
angle `α`, `R_z(α)` lies in the closure of the integer powers `{R_z(nθ) : n ∈ ℤ}`.

`R_z` is continuous and `4π`-periodic, so it factors through the circle `ℝ / 4πℤ`; the two-generator
subgroup `⟨θ, 4π⟩` is dense in `ℝ` (`dense_zmultiples_sup`) and `R_z` collapses its `4πℤ` part, so
the continuous image of that dense subgroup is `{R_z(nθ)}` and its closure engulfs the entire family
`Set.range rotZ`. -/
theorem rotZ_mem_closure_range_zsmul {θ : ℝ} (hθ : Irrational (θ / (2 * Real.pi))) (α : ℝ) :
    rotZ α ∈ closure (Set.range fun n : ℤ => rotZ (n • θ)) := by
  have hdense := dense_zmultiples_sup hθ
  have hsub : rotZ ''
        ((AddSubgroup.zmultiples θ ⊔ AddSubgroup.zmultiples (4 * Real.pi) : AddSubgroup ℝ) : Set ℝ)
      ⊆ Set.range (fun n : ℤ => rotZ (n • θ)) := by
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨y, hy, z, hz, rfl⟩ := AddSubgroup.mem_sup.mp hx
    obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hy
    obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hz
    exact ⟨k, (rotZ_add_zsmul_four_pi (k • θ) m).symm⟩
  have h1 : rotZ α ∈ rotZ ''
      (closure ((AddSubgroup.zmultiples θ ⊔ AddSubgroup.zmultiples (4 * Real.pi) : AddSubgroup ℝ) :
        Set ℝ)) := by
    rw [hdense.closure_eq]; exact ⟨α, Set.mem_univ α, rfl⟩
  exact closure_mono hsub (image_closure_subset_closure_image continuous_rotZ h1)

/-- **Iterating `R_z(θ)` with `cos θ = 3/5` approximates every `z`-rotation** (Nielsen & Chuang,
Exercise 4.43, `z`-axis half). Combines `rotZ_mem_closure_range_zsmul` with Exercise 4.42
(`irrational_div_two_pi_of_cos_eq_three_div_five`): `cos θ = 3/5` forces `θ / (2π)` irrational. -/
theorem rotZ_mem_closure_range_zsmul_of_cos_eq_three_div_five {θ : ℝ}
    (hθ : Real.cos θ = 3 / 5) (α : ℝ) :
    rotZ α ∈ closure (Set.range fun n : ℤ => rotZ (n • θ)) :=
  rotZ_mem_closure_range_zsmul (irrational_div_two_pi_of_cos_eq_three_div_five hθ) α

/-- **Iterating `R_x(θ)` approximates every `x`-rotation** when `θ / (2π)` is irrational.
Transported from the `z`-axis version through the Hadamard conjugation `H R_z(θ) H = R_x(θ)`
(`hadamardC_mul_rotZ_mul_hadamardC`), whose conjugation map `M ↦ H M H` is continuous. -/
theorem rotX_mem_closure_range_zsmul {θ : ℝ} (hθ : Irrational (θ / (2 * Real.pi))) (α : ℝ) :
    rotX α ∈ closure (Set.range fun n : ℤ => rotX (n • θ)) := by
  have hg : Continuous (fun M : Matrix (Fin 2) (Fin 2) ℂ => hadamardC * M * hadamardC) := by
    fun_prop
  have hconj : ∀ β : ℝ, hadamardC * rotZ β * hadamardC = rotX β := hadamardC_mul_rotZ_mul_hadamardC
  have himg : (fun M : Matrix (Fin 2) (Fin 2) ℂ => hadamardC * M * hadamardC) ''
        (Set.range fun n : ℤ => rotZ (n • θ)) ⊆ Set.range (fun n : ℤ => rotX (n • θ)) := by
    rintro _ ⟨_, ⟨n, rfl⟩, rfl⟩
    exact ⟨n, (hconj (n • θ)).symm⟩
  have hmem : (fun M : Matrix (Fin 2) (Fin 2) ℂ => hadamardC * M * hadamardC) (rotZ α)
      ∈ closure (Set.range fun n : ℤ => rotX (n • θ)) :=
    closure_mono himg
      (image_closure_subset_closure_image hg ⟨rotZ α, rotZ_mem_closure_range_zsmul hθ α, rfl⟩)
  have hmem' : hadamardC * rotZ α * hadamardC ∈ closure (Set.range fun n : ℤ => rotX (n • θ)) :=
    hmem
  rwa [hconj α] at hmem'

/-- **Iterating `R_x(θ)` with `cos θ = 3/5` approximates every `x`-rotation** (Nielsen & Chuang,
Exercise 4.43, `x`-axis half). -/
theorem rotX_mem_closure_range_zsmul_of_cos_eq_three_div_five {θ : ℝ}
    (hθ : Real.cos θ = 3 / 5) (α : ℝ) :
    rotX α ∈ closure (Set.range fun n : ℤ => rotX (n • θ)) :=
  rotX_mem_closure_range_zsmul (irrational_div_two_pi_of_cos_eq_three_div_five hθ) α

end AxQM.Concrete
