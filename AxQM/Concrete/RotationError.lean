import AxQM.Concrete.Rotation
import ToMathlib.Analysis.CStarAlgebra.Matrix
import ToMathlib.Analysis.InnerProductSpace.InvolutionRotation

/-!
# Concrete: the gate-approximation error between two same-axis qubit rotations

Nielsen & Chuang define the error of implementing `V` in place of `U` by
`E(U, V) ≡ max_{‖ψ‖=1} ‖(U − V)ψ‖`  (eq. 4.61) — the L²-operator norm `‖U − V‖`. This file
computes that error for two rotations `R_n̂(α)`, `R_n̂(α+β)` about a fixed unit axis `n̂`, promoting
the concrete `2 × 2` rotation matrix `Concrete.rotAxis n θ` to an operator `rotAxisCLM n θ` on
`EuclideanSpace ℂ (Fin 2)` through the `⋆`-algebra isomorphism `Matrix.toEuclideanCLM`, and applying
the general result `ContinuousLinearMap.norm_sub_rotOfInvol`
(`ToMathlib/Analysis/InnerProductSpace/InvolutionRotation.lean`).

## Main results (Nielsen & Chuang, Exercise 4.40)

* `rotAxis_opNorm_sub` — **eq. (4.77)**: `E(R_n̂(α), R_n̂(α+β)) = ‖1 − exp(iβ/2)‖`. Only the angle
  difference `β` matters, not the base angle `α`.
* `rotAxis_opNorm_sub_le_mod_four_pi` — the **`4π`-periodic** bound
  `E(R_n̂(α), R_n̂(α+β)) ≤ |β − 4π·m|/2` for every integer `m`. Because `E = ‖1 − exp(iβ/2)‖` is a
  function of `β` only modulo `4π`, the error is small exactly when `β` is near a multiple of `4π`.
* `rotAxisCLM_pow` — `R_n̂(θ)^k = R_n̂(kθ)`: an iterate of a rotation is again a rotation about the
  same axis `n̂`.
* `exists_pow_opNorm_sub_lt` — **eq. (4.76)** stated as an actual theorem: given that the angles
  `{kθ mod 4π}` approximate `α` arbitrarily well (the density hypothesis `hdense`, a genuine
  restriction — false, e.g., for `θ` a rational multiple of `2π`), for every `ε > 0` some iterate
  satisfies `‖R_n̂(α) − R_n̂(θ)^k‖ < ε`.

**Why `mod 4π`, not `mod 2π`.** The error `E(R_n̂(α), R_n̂(kθ)) = ‖1 − exp(i(kθ−α)/2)‖` is
`4π`-periodic in the angle (the half-angle halves the frequency), and vanishes iff `kθ ≡ α (mod 4π)`
— indeed `R_n̂(α+2π) = −R_n̂(α)`, so a match only `mod 2π` with an odd `2π`-offset gives
`E = 2`, not `0`. The needed density is therefore that of `{kθ mod 4π}` (equivalently `θ/(4π)`
irrational, i.e. `θ` an irrational multiple of `2π`). The *raw* difference `|kθ − α|` is NOT what
gets small — `{kθ}` is a discrete, unbounded subset of `ℝ` (successive gap `θ`), so `min_k |kθ − α|`
is bounded below; it is only the residue mod `4π` that density controls. This is the content of
`rotAxis_opNorm_sub_le_mod_four_pi` (choose the integer `m` nearest `(kθ−α)/(4π)`), which
`exists_pow_opNorm_sub_lt` then feeds the density hypothesis.
-/

namespace AxQM.Concrete

open ContinuousLinearMap

variable {n : Fin 3 → ℝ}

/-- The **qubit rotation operator** `R_n̂(θ)` as a continuous endomorphism of
`EuclideanSpace ℂ (Fin 2)`: the concrete `2 × 2` matrix `rotAxis n θ` promoted through the
`⋆`-algebra isomorphism `Matrix.toEuclideanCLM`. Naming it lets the gate-error statements below (and
later gate-error items) refer to `R_n̂(θ)` as one operator rather than an inlined promotion. -/
noncomputable def rotAxisCLM (n : Fin 3 → ℝ) (θ : ℝ) :
    EuclideanSpace ℂ (Fin 2) →L[ℂ] EuclideanSpace ℂ (Fin 2) :=
  Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin 2) (rotAxis n θ)

/-- The operator `n · σ` (the Pauli vector matrix promoted through `Matrix.toEuclideanCLM`) is
**self-adjoint**, since `n · σ` is Hermitian and the `⋆`-algebra isomorphism preserves `star`. -/
theorem toEuclideanCLM_pauliDot_isSelfAdjoint (n : Fin 3 → ℝ) :
    IsSelfAdjoint (Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin 2) (pauliDot n)) :=
  (pauliDot_isHermitian n).isSelfAdjoint.map (Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin 2))

/-- For a **unit** axis, the operator `n · σ` is an **involution**: `(n · σ)² = 1`. Transports the
concrete matrix identity `pauliDot_mul_self_of_unit` across `Matrix.toEuclideanCLM` (`map_mul`,
`map_one`). -/
theorem toEuclideanCLM_pauliDot_mul_self (hn : n 0 ^ 2 + n 1 ^ 2 + n 2 ^ 2 = 1) :
    Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin 2) (pauliDot n)
      * Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin 2) (pauliDot n) = 1 := by
  rw [← map_mul, pauliDot_mul_self_of_unit hn, map_one]

/-- The rotation operator `R_n̂(θ) = rotAxisCLM n θ` is exactly the abstract **involution rotation**
`ContinuousLinearMap.rotOfInvol` generated by the self-adjoint involution `n · σ` (for a unit axis
`n̂`). This is the bridge from the concrete matrix to the general `Mathlib` development: applying
the `⋆`-algebra isomorphism to the closed form `R_n̂(θ) = cos(θ/2) I − (sin(θ/2)·i)(n·σ)`
(`rotAxis_eq_of_unit`) commutes with the scalar combination. -/
theorem rotAxisCLM_eq_rotOfInvol (hn : n 0 ^ 2 + n 1 ^ 2 + n 2 ^ 2 = 1) (θ : ℝ) :
    rotAxisCLM n θ = rotOfInvol (Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin 2) (pauliDot n)) θ := by
  rw [rotAxisCLM, rotAxis_eq_of_unit hn, rotOfInvol, map_sub, map_smul, map_one, map_smul]

/-- **Nielsen & Chuang, Exercise 4.40, eq. (4.77).** The gate-approximation error
`E(R_n̂(α), R_n̂(α+β)) = ‖R_n̂(α) − R_n̂(α+β)‖` — the operator norm, i.e. the maximum over
normalized states `ψ` of `‖(R_n̂(α) − R_n̂(α+β))ψ‖` (eq. 4.61) — between two rotations about a
common unit axis
`n̂` equals `‖1 − exp(iβ/2)‖`. It depends only on the angle difference `β`, never on the base angle
`α`. -/
theorem rotAxis_opNorm_sub (hn : n 0 ^ 2 + n 1 ^ 2 + n 2 ^ 2 = 1) (α β : ℝ) :
    ‖rotAxisCLM n α - rotAxisCLM n (α + β)‖
      = ‖(1 : ℂ) - Complex.exp ((β / 2 : ℝ) * Complex.I)‖ := by
  rw [rotAxisCLM_eq_rotOfInvol hn, rotAxisCLM_eq_rotOfInvol hn]
  exact norm_sub_rotOfInvol _ (toEuclideanCLM_pauliDot_isSelfAdjoint n)
    (toEuclideanCLM_pauliDot_mul_self hn) α β

/-- **The `4π`-periodic bound.** For every integer `m`, `E(R_n̂(α), R_n̂(α+β)) ≤ |β − 4π·m|/2`.
Since `E = ‖1 − exp(iβ/2)‖` depends on `β` only modulo `4π`, choosing `m` nearest `β/(4π)` makes the
bound tight; this is the quantitative content that lets eq. (4.77) justify eq. (4.76). -/
theorem rotAxis_opNorm_sub_le_mod_four_pi (hn : n 0 ^ 2 + n 1 ^ 2 + n 2 ^ 2 = 1) (α β : ℝ) (m : ℤ) :
    ‖rotAxisCLM n α - rotAxisCLM n (α + β)‖ ≤ |β - 4 * Real.pi * m| / 2 := by
  rw [rotAxisCLM_eq_rotOfInvol hn, rotAxisCLM_eq_rotOfInvol hn]
  exact norm_sub_rotOfInvol_le_sub_int_mul_four_pi _ (toEuclideanCLM_pauliDot_isSelfAdjoint n)
    (toEuclideanCLM_pauliDot_mul_self hn) α β m

/-- **Iterating a rotation composes the angle** (operator form): `R_n̂(θ)^k = R_n̂(kθ)` as operators
on `EuclideanSpace ℂ (Fin 2)`. Hence the iterate `R_n̂(θ)^n` of eq. (4.76) is again a rotation about
`n̂`, so eq. (4.77) applies to its error. Image of the matrix `rotAxis_pow` under `map_pow`. -/
theorem rotAxisCLM_pow (n : Fin 3 → ℝ) (θ : ℝ) (k : ℕ) :
    rotAxisCLM n θ ^ k = rotAxisCLM n (k * θ) := by
  rw [rotAxisCLM, rotAxisCLM, ← map_pow, rotAxis_pow]

/-- **Nielsen & Chuang, Exercise 4.40, eq. (4.76)** — "use eq. (4.77) to justify (4.76)". Suppose
the iterate angles `{kθ mod 4π}` approximate the target `α` arbitrarily well: `hdense` says that for
every `δ > 0` some `k` and integer `m` have `|kθ − α − 4π·m| < δ`. (A genuine hypothesis — it
holds exactly when `θ` is an irrational multiple of `2π`, i.e. `θ/(4π)` is irrational, by the
pigeonhole/equidistribution argument of §4.5.3; it fails for `θ` a rational multiple of `2π`.) Then
for every `ε > 0` some iterate `R_n̂(θ)^k` approximates the rotation `R_n̂(α)` to operator-norm
distance `< ε`. The bridge is the `4π`-periodic bound: with `m` supplied by `hdense` at `δ = 2ε`,
`‖R_n̂(α) − R_n̂(θ)^k‖ = ‖R_n̂(α) − R_n̂(kθ)‖ ≤ |kθ − α − 4π·m|/2 < ε`. -/
theorem exists_pow_opNorm_sub_lt (hn : n 0 ^ 2 + n 1 ^ 2 + n 2 ^ 2 = 1) (α θ : ℝ)
    (hdense : ∀ δ : ℝ, 0 < δ → ∃ (k : ℕ) (m : ℤ), |(k : ℝ) * θ - α - 4 * Real.pi * m| < δ)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ k : ℕ, ‖rotAxisCLM n α - rotAxisCLM n θ ^ k‖ < ε := by
  obtain ⟨k, m, hkm⟩ := hdense (2 * ε) (by positivity)
  refine ⟨k, ?_⟩
  rw [rotAxisCLM_pow]
  have hle := rotAxis_opNorm_sub_le_mod_four_pi hn α ((k : ℝ) * θ - α) m
  rw [show α + ((k : ℝ) * θ - α) = (k : ℝ) * θ by ring] at hle
  linarith [hle, hkm]

end AxQM.Concrete
