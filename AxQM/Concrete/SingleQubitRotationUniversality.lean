import AxQM.Concrete.RotationDensity
import Mathlib.Topology.Instances.Matrix
import Mathlib.Topology.Algebra.Monoid

/-!
# Concrete: the reachable single-qubit rotations are dense in the single-qubit unitaries

Every statement is about `2 × 2` matrices and the concrete rotations `rotZ`/`rotX`/`rotY`.

## Mathematical content (the single-qubit half of Nielsen & Chuang, Exercise 4.43)

Building on `RotationDensity.lean` (iterating an irrational-angle `R_z(θ)` / `R_x(θ)` densely fills
the one-parameter `z`- / `x`-rotation families) this file assembles the two non-parallel dense axes
into **single-qubit universality up to a global phase**: every single-qubit unitary is a limit of
finite products of the reachable gates `R_z(±θ)`, `R_x(±θ)` (with `cos θ = 3/5`), up to an
irrelevant overall phase.

* `reachableRotations θ` — the submonoid of `Matrix (Fin 2) (Fin 2) ℂ` generated by the four gates
  `R_z(θ), R_z(-θ), R_x(θ), R_x(-θ)`. Its elements are exactly the finite products of `R_z(nθ)` and
  `R_x(mθ)` (`n, m ∈ ℤ`) — the operations reachable by iterating the two gates and their inverses.
* `rotZ_mem_closure_reachableRotations` / `rotX_mem_closure_reachableRotations` — for every angle
  `α`, `R_z(α)` (resp. `R_x(α)`) lies in the topological closure of `reachableRotations θ`. This
  lifts the one-axis density of `RotationDensity.lean` to membership in the two-generator monoid.
* `rotY_eq_rotZ_mul_rotX_mul_rotZ` — the bridge that puts the *third* axis into reach:
  `R_y(γ) = R_z(π/2) · R_x(γ) · R_z(-π/2)` (conjugating `x` by a quarter `z`-turn sends `X ↦ Y`).
  Hence `R_y(γ)` too lies in the closure (`rotY_mem_closure_reachableRotations`).
* `exists_phase_smul_mem_closure_reachableRotations` — **the headline**: for `cos θ = 3/5` and
  every `U ∈ U(2)`, some phase `α` has `e^{iα} U ∈ closure (reachableRotations θ)`. Proof: the Z–Y
  decomposition (`exists_zy_decomposition`, Theorem 4.1) writes `U = e^{iα} R_z(β) R_y(γ) R_z(δ)`;
  each factor is in the closure, and the closure of a submonoid is closed under multiplication
  (`Submonoid.top_closure_mul_self_subset`), so the phase-stripped product `e^{-iα} U` is too.

## Design notes

* **Why a submonoid and its topological closure.** The reachable gates form a submonoid `S`; the set
  of operations *approximable* by them is exactly the topological closure `closure ↑S`. In a
  topological monoid this closure is again a submonoid (`Submonoid.topologicalClosure`), so it is
  closed under products — the one fact the assembly needs to multiply the three closure-membership
  facts for the `R_z`, `R_y`, `R_z` factors of the Z–Y decomposition.
* **Global phase.** `rotZ`/`rotX`/`rotY` all have determinant `1`, so `reachableRotations θ` and its
  closure sit inside `SU(2)`; a general `U ∈ U(2)` has `det U = e^{iφ}` and is reachable only after
  stripping the phase `e^{iα}` (physically irrelevant). This is exactly what N&C's argument delivers
  and is not a weakening.
* **The three-axis bridge.** Density is proved for two axes (`z` via the circuit, `x` via Hadamard
  conjugation); the Z–Y decomposition uses `R_y`. `rotY_eq_rotZ_mul_rotX_mul_rotZ` writes `R_y`
  itself as a `z`-`x`-`z` product, so no separate `R_y` density is needed.
-/

namespace AxQM.Concrete

open Matrix Complex

/-- **Integer orbit of a one-parameter family lands in a generating submonoid.** If `f : ℝ → M`
satisfies `f 0 = 1` and `f a * f b = f (a + b)`, and both `f θ` and `f (-θ)` lie in a submonoid `S`,
then `f (n • θ) ∈ S` for every `n : ℤ` (each is a finite product of the two generators). The
abstract engine behind `rotZ`/`rotX` membership in `reachableRotations`. -/
theorem zsmul_mem_of_one_of_mul {M : Type*} [Monoid M] {S : Submonoid M} {f : ℝ → M} {θ : ℝ}
    (h0 : f 0 = 1) (hmul : ∀ a b : ℝ, f a * f b = f (a + b)) (hp : f θ ∈ S) (hn : f (-θ) ∈ S) :
    ∀ n : ℤ, f (n • θ) ∈ S := by
  intro n
  induction n using Int.induction_on with
  | zero => simp [h0]
  | succ k ih =>
      rw [show ((k : ℤ) + 1) • θ = (k : ℤ) • θ + θ by push_cast [zsmul_eq_mul]; ring,
        ← hmul]
      exact mul_mem ih hp
  | pred k ih =>
      rw [show (-(k : ℤ) - 1) • θ = (-(k : ℤ)) • θ + (-θ) by push_cast [zsmul_eq_mul]; ring,
        ← hmul]
      exact mul_mem ih hn

/-- **The reachable single-qubit rotations.** The submonoid of `2 × 2` matrices generated by the
four gates `R_z(±θ), R_x(±θ)`; its elements are the finite products of `R_z(nθ)` and `R_x(mθ)`
(`n, m ∈ ℤ`). With `cos θ = 3/5` these are the single-qubit operations exactly realisable by the
`H, S, CNOT, Toffoli` gate set (via the Exercise 4.41 circuit for `R_z(θ)` and Hadamard conjugation
for `R_x(θ)`). -/
noncomputable def reachableRotations (θ : ℝ) : Submonoid (Matrix (Fin 2) (Fin 2) ℂ) :=
  Submonoid.closure {rotZ θ, rotZ (-θ), rotX θ, rotX (-θ)}

/-- Every integer power `R_z(nθ)` lies in `reachableRotations θ`. -/
theorem rotZ_zsmul_mem_reachableRotations (θ : ℝ) (n : ℤ) :
    rotZ (n • θ) ∈ reachableRotations θ :=
  zsmul_mem_of_one_of_mul (f := rotZ) (rotAxis_zero _) (fun a b => rotAxis_mul_same _ a b)
    (Submonoid.subset_closure (by simp)) (Submonoid.subset_closure (by simp)) n

/-- Every integer power `R_x(nθ)` lies in `reachableRotations θ`. -/
theorem rotX_zsmul_mem_reachableRotations (θ : ℝ) (n : ℤ) :
    rotX (n • θ) ∈ reachableRotations θ :=
  zsmul_mem_of_one_of_mul (f := rotX) (rotAxis_zero _) (fun a b => rotAxis_mul_same _ a b)
    (Submonoid.subset_closure (by simp)) (Submonoid.subset_closure (by simp)) n

/-- **Every `z`-rotation is reachable** (in the closure) when `cos θ = 3/5`: transports the one-axis
density `rotZ_mem_closure_range_zsmul_of_cos_eq_three_div_five` along
`{R_z(nθ)} ⊆ reachableRotations θ`. -/
theorem rotZ_mem_closure_reachableRotations {θ : ℝ} (hθ : Real.cos θ = 3 / 5) (α : ℝ) :
    rotZ α ∈ closure (reachableRotations θ : Set (Matrix (Fin 2) (Fin 2) ℂ)) := by
  refine closure_mono ?_ (rotZ_mem_closure_range_zsmul_of_cos_eq_three_div_five hθ α)
  rintro _ ⟨n, rfl⟩
  exact rotZ_zsmul_mem_reachableRotations θ n

/-- **Every `x`-rotation is reachable** (in the closure) when `cos θ = 3/5`. -/
theorem rotX_mem_closure_reachableRotations {θ : ℝ} (hθ : Real.cos θ = 3 / 5) (α : ℝ) :
    rotX α ∈ closure (reachableRotations θ : Set (Matrix (Fin 2) (Fin 2) ℂ)) := by
  refine closure_mono ?_ (rotX_mem_closure_range_zsmul_of_cos_eq_three_div_five hθ α)
  rintro _ ⟨n, rfl⟩
  exact rotX_zsmul_mem_reachableRotations θ n

/-- **The reachable closure is closed under multiplication** — the topological closure of a
submonoid is a submonoid (`Submonoid.top_closure_mul_self_subset`). -/
theorem mul_mem_closure_reachableRotations {θ : ℝ} {a b : Matrix (Fin 2) (Fin 2) ℂ}
    (ha : a ∈ closure (reachableRotations θ : Set (Matrix (Fin 2) (Fin 2) ℂ)))
    (hb : b ∈ closure (reachableRotations θ : Set (Matrix (Fin 2) (Fin 2) ℂ))) :
    a * b ∈ closure (reachableRotations θ : Set (Matrix (Fin 2) (Fin 2) ℂ)) :=
  Submonoid.top_closure_mul_self_subset _ (Set.mul_mem_mul ha hb)

/-- **The third axis as a `z`-`x`-`z` product:** `R_y(γ) = R_z(π/2) · R_x(γ) · R_z(-π/2)`.
Conjugating the `x`-rotation by a quarter `z`-turn sends the `X` generator to `Y`; concretely the
outer diagonal phases `e^{∓iπ/4}` cancel on the diagonal and combine to `e^{∓iπ/2} = ∓i` off the
diagonal, turning `R_x(γ)`'s `∓i sin(γ/2)` entries into `R_y(γ)`'s `∓sin(γ/2)`. -/
theorem rotY_eq_rotZ_mul_rotX_mul_rotZ (γ : ℝ) :
    rotY γ = rotZ (Real.pi / 2) * rotX γ * rotZ (-(Real.pi / 2)) := by
  rw [rotY_eq, rotZ_eq, rotX_eq, rotZ_eq]
  simp only [Complex.ofReal_neg, neg_neg, neg_div, Matrix.mul_fin_two]
  set P := Complex.exp (↑(Real.pi / 2) / 2 * Complex.I) with hP
  set N := Complex.exp (-(↑(Real.pi / 2) / 2) * Complex.I) with hN
  have hNP : N * P = 1 := by
    rw [hN, hP, ← Complex.exp_add,
      show (-(↑(Real.pi / 2) / 2) * Complex.I + ↑(Real.pi / 2) / 2 * Complex.I : ℂ) = 0 by ring,
      Complex.exp_zero]
  have hNN : N * N = -Complex.I := by
    rw [hN, ← Complex.exp_add,
      show (-(↑(Real.pi / 2) / 2) * Complex.I + -(↑(Real.pi / 2) / 2) * Complex.I : ℂ)
        = ((-(Real.pi / 2) : ℝ) : ℂ) * Complex.I by push_cast; ring,
      Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_neg, Real.sin_neg,
      Real.cos_pi_div_two, Real.sin_pi_div_two]
    push_cast; ring
  have hPP : P * P = Complex.I := by
    rw [hP, ← Complex.exp_add,
      show (↑(Real.pi / 2) / 2 * Complex.I + ↑(Real.pi / 2) / 2 * Complex.I : ℂ)
        = ((Real.pi / 2 : ℝ) : ℂ) * Complex.I by push_cast; ring,
      Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin,
      Real.cos_pi_div_two, Real.sin_pi_div_two]
    push_cast; ring
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp only [Fin.isValue, Fin.zero_eta, Fin.mk_one, Matrix.of_apply, Matrix.cons_val',
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, Matrix.empty_val',
      mul_zero, zero_mul, add_zero, zero_add]
  · -- (0,0): N * cos * P, with N * P = 1
    rw [show N * (Real.cos (γ / 2) : ℂ) * P = N * P * (Real.cos (γ / 2) : ℂ) by ring, hNP, one_mul]
  · -- (0,1): N * (-sin·i) * N, with N * N = -i
    rw [show N * (-(Real.sin (γ / 2) : ℂ) * Complex.I) * N
          = N * N * (-(Real.sin (γ / 2) : ℂ) * Complex.I) by ring, hNN,
      show (-Complex.I) * (-(Real.sin (γ / 2) : ℂ) * Complex.I)
          = (Real.sin (γ / 2) : ℂ) * (Complex.I * Complex.I) by ring, Complex.I_mul_I]
    ring
  · -- (1,0): P * (-sin·i) * P, with P * P = i
    rw [show P * (-(Real.sin (γ / 2) : ℂ) * Complex.I) * P
          = P * P * (-(Real.sin (γ / 2) : ℂ) * Complex.I) by ring, hPP,
      show Complex.I * (-(Real.sin (γ / 2) : ℂ) * Complex.I)
          = -((Real.sin (γ / 2) : ℂ) * (Complex.I * Complex.I)) by ring, Complex.I_mul_I]
    ring
  · -- (1,1): P * cos * N, with N * P = 1
    rw [show P * (Real.cos (γ / 2) : ℂ) * N = N * P * (Real.cos (γ / 2) : ℂ) by ring, hNP, one_mul]

/-- **Every `y`-rotation is reachable** (in the closure) when `cos θ = 3/5`, via the `z`-`x`-`z`
factorisation `rotY_eq_rotZ_mul_rotX_mul_rotZ` and closure-under-multiplication. -/
theorem rotY_mem_closure_reachableRotations {θ : ℝ} (hθ : Real.cos θ = 3 / 5) (γ : ℝ) :
    rotY γ ∈ closure (reachableRotations θ : Set (Matrix (Fin 2) (Fin 2) ℂ)) := by
  rw [rotY_eq_rotZ_mul_rotX_mul_rotZ]
  exact mul_mem_closure_reachableRotations
    (mul_mem_closure_reachableRotations (rotZ_mem_closure_reachableRotations hθ _)
      (rotX_mem_closure_reachableRotations hθ _))
    (rotZ_mem_closure_reachableRotations hθ _)

/-- **Single-qubit universality up to a global phase** (the single-qubit content of Nielsen &
Chuang, Exercise 4.43). For `cos θ = 3/5` and every single-qubit unitary `U`, some global phase
`e^{iα}` makes `e^{iα} U` a limit of finite products of the reachable gates `R_z(±θ), R_x(±θ)`.

Combining the Z–Y decomposition `U = e^{iα₀} R_z(β) R_y(γ) R_z(δ)` (Theorem 4.1,
`exists_zy_decomposition`) with the reachability of every `z`-, `x`- and `y`-rotation and closure of
`closure (reachableRotations θ)` under products, the phase-stripped `e^{-iα₀} U` lies in that
closure. -/
theorem exists_phase_smul_mem_closure_reachableRotations {θ : ℝ} (hθ : Real.cos θ = 3 / 5)
    (U : Matrix (Fin 2) (Fin 2) ℂ) (hU : U ∈ Matrix.unitaryGroup (Fin 2) ℂ) :
    ∃ α : ℝ, Complex.exp ((α : ℂ) * Complex.I) • U
      ∈ closure (reachableRotations θ : Set (Matrix (Fin 2) (Fin 2) ℂ)) := by
  obtain ⟨a, β, γ, δ, hUeq⟩ := exists_zy_decomposition U hU
  refine ⟨-a, ?_⟩
  have hW : rotZ β * rotY γ * rotZ δ
      ∈ closure (reachableRotations θ : Set (Matrix (Fin 2) (Fin 2) ℂ)) :=
    mul_mem_closure_reachableRotations
      (mul_mem_closure_reachableRotations (rotZ_mem_closure_reachableRotations hθ β)
        (rotY_mem_closure_reachableRotations hθ γ))
      (rotZ_mem_closure_reachableRotations hθ δ)
  rw [hUeq, smul_smul, ← Complex.exp_add,
    show ((-a : ℝ) : ℂ) * Complex.I + (a : ℂ) * Complex.I = 0 by push_cast; ring,
    Complex.exp_zero, one_smul]
  exact hW

end AxQM.Concrete
