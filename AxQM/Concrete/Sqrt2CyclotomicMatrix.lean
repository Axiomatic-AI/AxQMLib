import AxQM.Concrete.Sqrt2IntegerMatrix
import AxQM.Concrete.PiEighthGate
import Mathlib.NumberTheory.Real.Irrational

/-!
# Concrete: the `T`-gate variant of Exercise 4.45 — the cyclotomic ring `ℤ[ζ₈]`

This file formalises the **second half of Nielsen &
Chuang, Exercise 4.45** (p. 198). Having shown (in `AxQM/Concrete/Sqrt2IntegerMatrix.lean`) that a
unitary `U` built from `H, S, CNOT, Toffoli` has the form `2⁻ᵏ⸍² M` with `M` a Gaussian-integer
(`ℤ[i]`) matrix, N&C ask one to *"repeat this exercise with the Toffoli gate replaced by the `π/8`
gate `T`"*.

## The subtlety: the literal `ℤ[i]` reading is *false* for `T`

Taken verbatim — `M` a matrix with *complex-integer* (`ℤ[i]`) entries — the `T`-gate claim is
**false** for `T = diag(1, e^{iπ/4})` itself. If `T = (√2)⁻ᵏ M` with `M ∈ ℤ[i]`, reading off
the
two diagonal entries forces `k` to be *both even and odd*: entry `(0,0) = 1 = (√2)⁻ᵏ · M₀₀` makes
`M₀₀ = (√2)ᵏ` a Gaussian integer, which needs `k` even; entry `(1,1) = e^{iπ/4} = (√2)⁻ᵏ · M₁₁`
makes `M₁₁ = (√2)^{k-1}(1 + i)` a Gaussian integer, which needs `k` odd. Concretely this pins down
`√2 = a / b` for two integers read off the diagonal, contradicting `irrational_sqrt_two`. This
refutation is `not_isSqrt2ScaledIn_gaussian_tMatrix` — we do **not** silently repair the exercise
into something provable (fidelity to the source).

## The honest content: the ring `ℤ[ζ₈]`

The *correct* ring for the `H, S, CNOT, T` gate set is `ℤ[ζ₈]`, the cyclotomic integers generated by
`ζ₈ = e^{iπ/4}` (the entry of `T`). Because `ζ₈² = i` (`zeta8_sq`), this ring *contains* the
Gaussian integers (`gaussianIntSubring_le_cyclotomicIntSubring`), and `ζ₈ = (1 + i)/√2` is the value
whose appearance breaks the `ℤ[i]` reading. Every element is a Gaussian-integer combination of `1`
and `ζ₈`, equivalently a genuine complex-integer combination of the eighth roots of unity
`1, ζ₈, ζ₈² , ζ₈³` (`mem_cyclotomicIntSubring_iff`).

The algebraic engine is entirely reused: `IsSqrt2ScaledIn`, its closure lemmas
(`.mul`/`.kron`/`.submatrix`, `isSqrt2ScaledIn_list_prod`) and the shared gate memberships are
parameterised by an arbitrary subring `R ⊆ ℂ` in `AxQM/Concrete/Sqrt2IntegerMatrix.lean`. Only the
ring and the `T` membership are new here: `H` (`k = 1`), `S`, `CNOT`, `T` (`k = 0`) are all
`√2`-scaled over `ℤ[ζ₈]`, so — via the same product/Kronecker closure — any circuit unitary is
`2⁻ᵏ⸍² M` with `M ∈ ℤ[ζ₈]` (`exists_two_pow_neg_half_smul_cyclotomic`,
`exists_circuit_form_cyclotomic`). (The Toffoli gate, a `0/1` permutation, remains `√2`-scaled over
`ℤ[ζ₈]` too, so the enlarged gate set `{H, S, CNOT, Toffoli, T}` is covered.)

The statement of Exercise 4.45 is in `AxQM/NC/Ch4/Exercise4_45.lean`.
-/

namespace AxQM.Concrete

open Matrix

noncomputable section

variable {m n : Type*}

/-! ### The primitive eighth root of unity `ζ₈ = e^{iπ/4}` -/

/-- **The primitive eighth root of unity** `ζ₈ = e^{iπ/4}`, the nontrivial diagonal entry of the
`π/8` gate `T = diag(1, ζ₈)` (`tMatrix`). It satisfies `ζ₈² = i` (`zeta8_sq`), so `ℤ[ζ₈] ⊇ ℤ[i]`;
and `ζ₈ = (1 + i)/√2` is the value that makes the `ℤ[i]` reading of the `T`-variant fail. -/
def zeta8 : ℂ := Complex.exp ((Real.pi / 4 : ℝ) * Complex.I)

/-- `ζ₈² = i`: squaring `e^{iπ/4}` gives `e^{iπ/2} = i`. Hence `ℤ[ζ₈]` contains `ℤ[i]`. -/
theorem zeta8_sq : zeta8 ^ 2 = Complex.I := by
  rw [sq, zeta8, ← Complex.exp_add,
    show ((Real.pi / 4 : ℝ) : ℂ) * Complex.I + ((Real.pi / 4 : ℝ) : ℂ) * Complex.I
      = (↑Real.pi / 2) * Complex.I from by push_cast; ring]
  exact Complex.exp_pi_div_two_mul_I

/-- The real part of `ζ₈ = e^{iπ/4}` is `cos(π/4) = √2/2`; used in the `ℤ[i]` refutation. -/
theorem zeta8_re : zeta8.re = Real.sqrt 2 / 2 := by
  rw [zeta8, Complex.exp_ofReal_mul_I_re, Real.cos_pi_div_four]

/-! ### The cyclotomic integers `ℤ[ζ₈]` -/

/-- **The cyclotomic integers `ℤ[ζ₈] ⊆ ℂ`** for `ζ₈ = e^{iπ/4}` — the entry ring of the
`H, S, CNOT, T` variant of Exercise 4.45. Because `ζ₈² = i`, every element is uniquely a
Gaussian-integer combination `p + q·ζ₈` of `1` and `ζ₈` (`p, q ∈ ℤ[i]`); equivalently a
complex-integer combination `a + b·ζ₈ + c·ζ₈² + d·ζ₈³` of the eighth roots of unity
(`mem_cyclotomicIntSubring_iff`). Closure under multiplication is immediate from `ζ₈² = i`:
`(p + q ζ₈)(p' + q' ζ₈) = (p p' + i q q') + (p q' + p' q) ζ₈`. -/
def cyclotomicIntSubring : Subring ℂ where
  carrier := {z | ∃ p q : ℂ, p ∈ gaussianIntSubring ∧ q ∈ gaussianIntSubring ∧ z = p + q * zeta8}
  zero_mem' := ⟨0, 0, gaussianIntSubring.zero_mem, gaussianIntSubring.zero_mem, by ring⟩
  one_mem' := ⟨1, 0, gaussianIntSubring.one_mem, gaussianIntSubring.zero_mem, by ring⟩
  add_mem' := by
    rintro x y ⟨p, q, hp, hq, rfl⟩ ⟨p', q', hp', hq', rfl⟩
    exact ⟨p + p', q + q', add_mem hp hp', add_mem hq hq', by ring⟩
  mul_mem' := by
    rintro x y ⟨p, q, hp, hq, rfl⟩ ⟨p', q', hp', hq', rfl⟩
    refine ⟨p * p' + q * q' * Complex.I, p * q' + p' * q, ?_, ?_, ?_⟩
    · exact add_mem (mul_mem hp hp') (mul_mem (mul_mem hq hq') complexI_mem_gaussianIntSubring)
    · exact add_mem (mul_mem hp hq') (mul_mem hp' hq)
    · linear_combination (q * q') * zeta8_sq
  neg_mem' := by
    rintro x ⟨p, q, hp, hq, rfl⟩
    exact ⟨-p, -q, neg_mem hp, neg_mem hq, by ring⟩

/-- Membership in `ℤ[ζ₈]` as a Gaussian-integer combination `p + q·ζ₈` of `1` and `ζ₈`. -/
theorem mem_cyclotomicIntSubring_iff' {z : ℂ} :
    z ∈ cyclotomicIntSubring ↔
      ∃ p q : ℂ, p ∈ gaussianIntSubring ∧ q ∈ gaussianIntSubring ∧ z = p + q * zeta8 :=
  Iff.rfl

/-- **`ℤ[ζ₈]` as complex-integer combinations of the eighth roots of unity.** `z ∈ ℤ[ζ₈]` iff
`z = a + b·ζ₈ + c·ζ₈² + d·ζ₈³` for integers `a, b, c, d` — N&C's "complex integer entries", now over
the eighth roots of unity rather than merely `{1, i}`. (Uses `ζ₈² = i`, so `ζ₈³ = i·ζ₈`.) -/
theorem mem_cyclotomicIntSubring_iff {z : ℂ} :
    z ∈ cyclotomicIntSubring ↔
      ∃ a b c d : ℤ, z = a + b * zeta8 + c * zeta8 ^ 2 + d * zeta8 ^ 3 := by
  rw [mem_cyclotomicIntSubring_iff']
  constructor
  · rintro ⟨p, q, ⟨pa, pb, rfl⟩, ⟨qa, qb, rfl⟩, rfl⟩
    exact ⟨pa, qa, pb, qb, by rw [← zeta8_sq]; ring⟩
  · rintro ⟨a, b, c, d, rfl⟩
    exact ⟨(a : ℂ) + c * Complex.I, (b : ℂ) + d * Complex.I, ⟨a, c, rfl⟩, ⟨b, d, rfl⟩,
      by rw [← zeta8_sq]; ring⟩

/-- `ζ₈ ∈ ℤ[ζ₈]`. -/
theorem zeta8_mem_cyclotomicIntSubring : zeta8 ∈ cyclotomicIntSubring :=
  ⟨0, 1, gaussianIntSubring.zero_mem, gaussianIntSubring.one_mem, by ring⟩

/-- `i ∈ ℤ[ζ₈]` (namely `i = ζ₈²`). -/
theorem complexI_mem_cyclotomicIntSubring : Complex.I ∈ cyclotomicIntSubring :=
  ⟨Complex.I, 0, complexI_mem_gaussianIntSubring, gaussianIntSubring.zero_mem, by ring⟩

/-- **`ℤ[ζ₈]` contains the Gaussian integers `ℤ[i]`.** So enlarging the gate set from
`{H, S, CNOT, Toffoli}` to include `T` only enlarges the entry ring; the original gates stay
`√2`-scaled over `ℤ[ζ₈]`. -/
theorem gaussianIntSubring_le_cyclotomicIntSubring :
    gaussianIntSubring ≤ cyclotomicIntSubring := fun z hz =>
  ⟨z, 0, hz, gaussianIntSubring.zero_mem, by ring⟩

/-! ### The `H, S, CNOT, T` gate set over `ℤ[ζ₈]` -/

/-- `H` is a `√2`-scaled `ℤ[ζ₈]` matrix (`k = 1`). -/
theorem isSqrt2Cyclotomic_hadamardC : IsSqrt2ScaledIn cyclotomicIntSubring hadamardC :=
  isSqrt2ScaledIn_hadamardC _

/-- `S` is a `√2`-scaled `ℤ[ζ₈]` matrix (`k = 0`; needs `i ∈ ℤ[ζ₈]`). -/
theorem isSqrt2Cyclotomic_sMatrix : IsSqrt2ScaledIn cyclotomicIntSubring sMatrix :=
  isSqrt2ScaledIn_sMatrix _ complexI_mem_cyclotomicIntSubring

/-- `CNOT` is a `√2`-scaled `ℤ[ζ₈]` matrix (`k = 0`, a `0/1` permutation). -/
theorem isSqrt2Cyclotomic_cnotMatrix : IsSqrt2ScaledIn cyclotomicIntSubring cnotMatrix :=
  isSqrt2ScaledIn_cnotMatrix _

/-- **The `π/8` gate `T = diag(1, ζ₈)` is a `√2`-scaled `ℤ[ζ₈]` matrix** (`k = 0`): its entries
`1` and `ζ₈` already lie in `ℤ[ζ₈]`. This is the replacement for the Toffoli gate in the `T`-variant
of Exercise 4.45. -/
theorem isSqrt2Cyclotomic_tMatrix : IsSqrt2ScaledIn cyclotomicIntSubring tMatrix :=
  isSqrt2ScaledIn_of_forall_mem _ fun i j => by
    fin_cases i <;> fin_cases j <;>
      simp only [tMatrix, Fin.isValue, Fin.zero_eta, Fin.mk_one, Matrix.of_apply, Matrix.cons_val',
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, Matrix.empty_val']
    · exact cyclotomicIntSubring.one_mem
    · exact cyclotomicIntSubring.zero_mem
    · exact cyclotomicIntSubring.zero_mem
    · exact zeta8_mem_cyclotomicIntSubring

/-- Toffoli remains a `√2`-scaled `ℤ[ζ₈]` matrix, so the union gate set `{H, S, CNOT, Toffoli, T}`
is covered. -/
theorem isSqrt2Cyclotomic_toffoliMatrix : IsSqrt2ScaledIn cyclotomicIntSubring toffoliMatrix :=
  isSqrt2ScaledIn_toffoliMatrix _

/-! ### N&C's explicit `2⁻ᵏ⸍² M` form (cyclotomic variant) -/

/-- **Nielsen & Chuang, Exercise 4.45, `T`-variant, explicit form.** A `√2`-scaled `ℤ[ζ₈]` matrix
`U` is `2⁻ᵏ⸍² M` with `M` a matrix of complex integers over the eighth roots of unity
(`∃ a b c d : ℤ, M i j = a + b·ζ₈ + c·ζ₈² + d·ζ₈³`). -/
theorem exists_two_pow_neg_half_smul_cyclotomic (U : Matrix m n ℂ)
    (hU : IsSqrt2ScaledIn cyclotomicIntSubring U) :
    ∃ (k : ℕ) (M : Matrix m n ℂ),
      (∀ i j, ∃ a b c d : ℤ, M i j = a + b * zeta8 + c * zeta8 ^ 2 + d * zeta8 ^ 3) ∧
        U = (((2 : ℝ) ^ (-(k : ℝ) / 2) : ℝ) : ℂ) • M := by
  obtain ⟨k, M, rfl⟩ := hU
  refine ⟨k, M.map cyclotomicIntSubring.subtype, fun i j => ?_, ?_⟩
  · rw [Matrix.map_apply]
    exact mem_cyclotomicIntSubring_iff.mp (M i j).2
  · rw [sqrt_two_inv_pow_eq_rpow]

/-- **Nielsen & Chuang, Exercise 4.45 (`H, S, CNOT, T`).** The unitary of any circuit — the product
`L.prod` of a list `L` of matrices each of which is a `√2`-scaled `ℤ[ζ₈]` matrix (e.g. an embedded
`H`/`S`/`CNOT`/`T` gate) — has the form `2⁻ᵏ⸍² M` with `M` a `2ⁿ × 2ⁿ` matrix over the cyclotomic
integers `ℤ[ζ₈]`. -/
theorem exists_circuit_form_cyclotomic [Fintype m] [DecidableEq m]
    (L : List (Matrix m m ℂ)) (h : ∀ U ∈ L, IsSqrt2ScaledIn cyclotomicIntSubring U) :
    ∃ (k : ℕ) (M : Matrix m m ℂ),
      (∀ i j, ∃ a b c d : ℤ, M i j = a + b * zeta8 + c * zeta8 ^ 2 + d * zeta8 ^ 3) ∧
        L.prod = (((2 : ℝ) ^ (-(k : ℝ) / 2) : ℝ) : ℂ) • M :=
  exists_two_pow_neg_half_smul_cyclotomic _ (isSqrt2ScaledIn_list_prod _ L h)

/-! ### The literal `ℤ[i]` reading of the `T`-variant is false -/

/-- **Nielsen & Chuang, Exercise 4.45, `T`-variant refutation.** The `π/8` gate
`T = diag(1, e^{iπ/4})` is **not** `√2`-scaled over Gaussian integers `ℤ[i]`: there is no `k` and
no Gaussian-integer
matrix `M` with `T = 2⁻ᵏ⸍² M`. Reading the two diagonal entries of such an `M` yields
`M₀₀ = (√2)ᵏ` and `M₁₁ = (√2)ᵏ · ζ₈`, whose product `M₀₀ · M₁₁ = 2ᵏ · ζ₈` is a Gaussian integer;
taking real parts gives `2ᵏ · (√2/2) = a` for an integer `a`, i.e. `√2 = 2a / 2ᵏ` is rational —
contradicting `irrational_sqrt_two`. So the literal "complex integer entries" reading fails for `T`,
and the honest statement uses `ℤ[ζ₈]` (`isSqrt2Cyclotomic_tMatrix`). -/
theorem not_isSqrt2ScaledIn_gaussian_tMatrix :
    ¬ IsSqrt2ScaledIn gaussianIntSubring tMatrix := by
  rintro ⟨k, M, hM⟩
  have ht : (Real.sqrt 2 : ℂ) ≠ 0 := by
    simp only [ne_eq, Complex.ofReal_eq_zero]; positivity
  have hrsq : (Real.sqrt 2 : ℂ) ^ 2 = 2 := by
    rw [← Complex.ofReal_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]; norm_num
  -- the two diagonal entry equations
  have e00 : (1 : ℂ) = ((Real.sqrt 2 : ℂ))⁻¹ ^ k * (M 0 0 : ℂ) := by
    have h := congrFun (congrFun hM 0) 0
    simpa [tMatrix, Matrix.smul_apply, Matrix.map_apply, smul_eq_mul] using h
  have e11 : zeta8 = ((Real.sqrt 2 : ℂ))⁻¹ ^ k * (M 1 1 : ℂ) := by
    have h := congrFun (congrFun hM 1) 1
    simpa [tMatrix, zeta8, Matrix.smul_apply, Matrix.map_apply, smul_eq_mul] using h
  -- solve for the entries: M₀₀ = (√2)ᵏ, (√2)ᵏ·ζ₈ = M₁₁
  have hmulinv : (Real.sqrt 2 : ℂ) ^ k * ((Real.sqrt 2 : ℂ))⁻¹ ^ k = 1 := by
    rw [← mul_pow, mul_inv_cancel₀ ht, one_pow]
  have hp : (Real.sqrt 2 : ℂ) ^ k = (M 0 0 : ℂ) := by
    rw [← mul_one ((Real.sqrt 2 : ℂ) ^ k), e00, ← mul_assoc, hmulinv, one_mul]
  have hq : (Real.sqrt 2 : ℂ) ^ k * zeta8 = (M 1 1 : ℂ) := by
    rw [e11, ← mul_assoc, hmulinv, one_mul]
  -- their product is 2ᵏ·ζ₈, and is a Gaussian integer
  have hkey : (2 : ℂ) ^ k * zeta8 = (M 0 0 : ℂ) * (M 1 1 : ℂ) := by
    rw [← hp, ← hq, ← mul_assoc, ← pow_add, ← two_mul, pow_mul, hrsq]
  obtain ⟨a, b, hab⟩ :=
    mem_gaussianIntSubring_iff.mp (mul_mem (M 0 0).2 (M 1 1).2)
  -- take real parts: 2ᵏ·(√2/2) = a
  have hre : (2 : ℝ) ^ k * (Real.sqrt 2 / 2) = (a : ℝ) := by
    have h := congrArg Complex.re (hkey.trans hab)
    rw [Complex.mul_re, zeta8_re, show ((2 : ℂ) ^ k) = (((2 : ℝ) ^ k : ℝ) : ℂ) from by
      push_cast; ring, Complex.ofReal_re, Complex.ofReal_im] at h
    simpa [Complex.add_re, Complex.ofReal_re, Complex.mul_I_re, Complex.ofReal_im] using h
  -- hence √2 = 2a / 2ᵏ is rational, contradiction
  refine irrational_sqrt_two.ne_rational (2 * a) (2 ^ k) ?_
  rw [eq_div_iff (by exact_mod_cast pow_ne_zero k (two_ne_zero) : ((2 ^ k : ℤ) : ℝ) ≠ 0)]
  push_cast
  linear_combination 2 * hre

end

end AxQM.Concrete
