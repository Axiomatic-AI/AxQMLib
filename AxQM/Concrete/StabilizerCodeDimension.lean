import AxQM.Concrete.CheckMatrix
import ToMathlib.LinearAlgebra.Trace
import Mathlib.LinearAlgebra.Projection
import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.Algebra.Module.Submodule.EqLocus
import Mathlib.Data.List.OfFn

/-!
# Concrete: Nielsen & Chuang Proposition 10.5 — a stabilizer code space is `2^k`-dimensional

This file formalizes Nielsen & Chuang's
**Proposition 10.5** (§10.5.1, p. 458), the dimension count for stabilizer code spaces.

Proposition 10.5: a stabilizer generated by n − k independent commuting elements with −I ∉ S fixes a
2^k-dimensional subspace.

Here `V_S` is the **stabilized subspace** `{|ψ⟩ : g|ψ⟩ = |ψ⟩ for all g ∈ S}`, the simultaneous
`+1`-eigenspace of the generators.

## Statement shape and faithfulness

We work with the **phase-free** Pauli strings `Concrete.pauliString g` (indexed by `g : Fin n →
Fin 4`), on the `n`-qubit register `(Fin n → Fin 2) → ℂ`. Three design points make the statement
faithful to N&C, matching the conventions used for Propositions 10.3 and 10.4:

* **`-I ∉ S` enters only through `gⱼ² = I`.** N&C's hypothesis `-I ∉ S` forces every generator to
  square to the identity and hence be a Hermitian involution (Exercises 10.34/10.35). Every
  `pauliString g` is unconditionally an involution (`pauliString_mul_self`) and Hermitian
  (`pauliString_isHermitian`), so the phase-free representation supplies exactly the consequence
  of `-I ∉ S` the proof uses, with no `-I ∉ S` hypothesis to carry.
* **"independent generators" ⇔ "check-matrix rows linearly independent".** This is Proposition
  10.3 (in the `-I ∉ S` world). We state independence directly as `LinearIndependent (ZMod 2)
  (fun j ↦ checkRow gⱼ)`, the equivalent (not weaker) form the proof consumes, via the check row
  `checkRow` (`AxQM/Concrete/CheckMatrix.lean`).
* **"commuting generators"** is stated as `∀ i j, Commute (pauliString gᵢ) (pauliString gⱼ)` —
  literally that the operators commute.

The conclusion is the honest linear-algebra statement `Module.finrank ℂ (stabilizedSubspace g) *
2 ^ m = 2 ^ n` for `m` generators (`stabilizedSubspace_finrank_mul`); the `2^k` form of N&C
follows for `m = n - k` and `k ≤ n` (`stabilizedSubspace_finrank`). The multiplicative form avoids
natural subtraction and needs no separate `m ≤ n` hypothesis (that `m ≤ n` is forced is a
*consequence*: the right-hand side `2^n` must be divisible by `2^m`).

## The proof

We follow N&C's projector argument, in the direct trace form. Let

`P_S = 2^{-m} · ∏_{j} (I + gⱼ)`      (`stabilizerProjector`),

the matrix `∏_j (I + gⱼ)/2`. Two matrix facts, each a short induction peeling the leading factor
of the ordered product `∏_j (I + gⱼ)` (`stabilizerProduct`, a `List.ofFn` product), show `P_S` is
an honest projection onto `V_S`:

* `stabilizerProduct_absorb`: each generator absorbs the product, `gᵢ · ∏ = ∏` (commutativity
  slides `gᵢ` to its factor `(I + gᵢ)`, where `gᵢ(I + gᵢ) = I + gᵢ` by the involution). Hence
  `gᵢ P_S = P_S`, so `P_S` maps every vector into `V_S`.
* `stabilizerProduct_mulVec`: if every `gⱼ` fixes `v` then each factor doubles it, `∏ ·ᵥ v =
  2^m v`, so `P_S ·ᵥ v = v`; `P_S` is the identity on `V_S`.

Thus `Matrix.toLin' P_S` is a `LinearMap.IsProj (stabilizedSubspace g)`, and by
`LinearMap.IsProj.trace`, `trace P_S = finrank V_S`. The trace of `P_S` is `2^{n-m}`: expanding the
product, only the empty subproduct `I` survives, because every *nonempty* subproduct `∏_{j ∈ T} gⱼ`
is `± pauliString(⊕_{j∈T} gⱼ)` with a *nonzero* index (independence of the check rows forbids a
nonempty subset summing to `0`), hence traceless (`pauliString_trace`). We realize this without an
explicit power-set expansion, by a "test Pauli" induction:

* `stabilizerProduct_trace_mul_of_notMem`: if `checkRow h` is not in the span of the generators'
  check rows, then `trace(pauliString h · ∏) = 0`. Peeling the leading factor produces two smaller
  instances with test Paulis `h` and `h ⊙ g₀`, both still outside the tail's span.
* `stabilizerProduct_trace`: for independent generators, `trace ∏ = 2^n` (take the trivial test
  Pauli `I`; the leading generator is outside the tail's span by independence).

Combining, `(finrank V_S) · 2^m = 2^n`.

Everything is stated for raw matrix / index data (`Matrix`, `Concrete.pauliString`, `checkRow`,
`ZMod 2`, `Fin n → Fin 4`, `Submodule`, `Module.finrank`).

The statement of N&C Proposition 10.5 (p. 458) is in `AxQM/NC/Ch10/Proposition10_5.lean`.
-/

open Matrix

open scoped BigOperators

namespace AxQM.Concrete

variable {n : ℕ}

/-! ### The ordered product `∏_j (I + gⱼ)` -/

/-- The **ordered product of stabilizer factors** `∏_{j} (I + P_{gⱼ})`, over the generators
`g : Fin m → (Fin n → Fin 4)`. Scaled by `2^{-m}` this is the stabilizer projector
`stabilizerProjector`; the factors commute when the generators do, so the order is immaterial, but
we fix the `List.ofFn` order to make the leading-factor inductions literal. -/
noncomputable def stabilizerProduct {m : ℕ} (g : Fin m → (Fin n → Fin 4)) :
    Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ :=
  (List.ofFn fun j => 1 + pauliString (g j)).prod

/-- The empty stabilizer product (`m = 0` generators) is the identity. -/
theorem stabilizerProduct_zero (g : Fin 0 → (Fin n → Fin 4)) : stabilizerProduct g = 1 := by
  rw [stabilizerProduct, List.ofFn_zero, List.prod_nil]

/-- Peeling the leading factor: `∏_{j < m+1} (I + gⱼ) = (I + g₀) · ∏_{i < m} (I + g_{i+1})`. -/
theorem stabilizerProduct_succ {m : ℕ} (g : Fin (m + 1) → (Fin n → Fin 4)) :
    stabilizerProduct g = (1 + pauliString (g 0)) * stabilizerProduct (fun i => g i.succ) := by
  rw [stabilizerProduct, List.ofFn_succ, List.prod_cons]
  rfl

/-- **Each generator absorbs the stabilizer product**: `P_{gᵢ} · ∏_j (I + P_{gⱼ}) = ∏_j (I +
P_{gⱼ})` for commuting generators. Sliding `P_{gᵢ}` (which commutes with every factor) to its own
factor `(I + P_{gᵢ})`, the involution `P_{gᵢ}(I + P_{gᵢ}) = P_{gᵢ} + I = I + P_{gᵢ}` absorbs it.
This is the matrix fact behind `P_S` mapping every vector into the stabilized subspace. -/
theorem stabilizerProduct_absorb :
    ∀ {m : ℕ} (g : Fin m → (Fin n → Fin 4)),
      (∀ i j, Commute (pauliString (g i)) (pauliString (g j))) → ∀ i : Fin m,
      pauliString (g i) * stabilizerProduct g = stabilizerProduct g := by
  intro m
  induction m with
  | zero => intro g _ i; exact i.elim0
  | succ m ih =>
    intro g hcomm i
    rw [stabilizerProduct_succ]
    refine Fin.cases ?_ ?_ i
    · rw [← mul_assoc, mul_add, mul_one, pauliString_mul_self, add_comm (pauliString (g 0)) 1]
    · intro i'
      have hc : Commute (pauliString (g i'.succ)) (1 + pauliString (g 0)) :=
        (Commute.one_right _).add_right (hcomm i'.succ 0)
      rw [← mul_assoc, hc.eq, mul_assoc]
      congr 1
      exact ih (fun i => g i.succ) (fun a b => hcomm a.succ b.succ) i'

/-- **The stabilizer product doubles a jointly-stabilized vector**: if every generator fixes `v`
(`P_{gⱼ} ·ᵥ v = v`), then `(∏_j (I + P_{gⱼ})) ·ᵥ v = 2^m • v`, since each factor sends
`v ↦ v + v = 2v`. This is the matrix fact behind `P_S` acting as the identity on `V_S`. -/
theorem stabilizerProduct_mulVec :
    ∀ {m : ℕ} (g : Fin m → (Fin n → Fin 4)) (v : (Fin n → Fin 2) → ℂ),
      (∀ i, (pauliString (g i)).mulVec v = v) →
      (stabilizerProduct g).mulVec v = (2 : ℂ) ^ m • v := by
  intro m
  induction m with
  | zero =>
    intro g v _
    rw [stabilizerProduct_zero, Matrix.one_mulVec, pow_zero, one_smul]
  | succ m ih =>
    intro g v hv
    rw [stabilizerProduct_succ, ← Matrix.mulVec_mulVec,
      ih (fun i => g i.succ) v (fun i => hv i.succ), Matrix.add_mulVec, Matrix.one_mulVec,
      Matrix.mulVec_smul, hv 0, ← add_smul, ← two_mul, ← pow_succ']

/-! ### Traces of stabilizer products -/

/-- **Trace of a stabilizer product against an "off-span" test Pauli vanishes.** If `checkRow h` is
not in the `ZMod 2`-span of the generators' check rows, then `tr(P_h · ∏_j (I + P_{gⱼ})) = 0`.
Peeling the leading factor `(I + P_{g₀})` splits the trace into the test Paulis `h` and `h ⊙ g₀`,
both of which stay outside the *tail's* span (for `h ⊙ g₀`: if `checkRow (h ⊙ g₀) = checkRow h +
checkRow g₀` were in the span, then `checkRow h` would be too, since `checkRow g₀` is), so both
sub-traces vanish by induction. This is the engine that kills every nonempty subproduct. -/
theorem stabilizerProduct_trace_mul_of_notMem :
    ∀ {m : ℕ} (g : Fin m → (Fin n → Fin 4)) (h : Fin n → Fin 4),
      checkRow h ∉ Submodule.span (ZMod 2) (Set.range fun j => checkRow (g j)) →
      (pauliString h * stabilizerProduct g).trace = 0 := by
  intro m
  induction m with
  | zero =>
    intro g h hh
    have hne : ¬ h = 0 := by
      rw [← checkRow_eq_zero_iff]
      intro h0
      exact hh (by rw [h0]; exact Submodule.zero_mem _)
    rw [stabilizerProduct_zero, mul_one, pauliString_trace, ite_eq_right hne]
  | succ m ih =>
    intro g h hh
    have hsub : Submodule.span (ZMod 2) (Set.range fun j : Fin m => checkRow (g j.succ))
        ≤ Submodule.span (ZMod 2) (Set.range fun j : Fin (m + 1) => checkRow (g j)) := by
      apply Submodule.span_mono
      rintro _ ⟨i, rfl⟩
      exact ⟨i.succ, rfl⟩
    have hh1 : checkRow h
        ∉ Submodule.span (ZMod 2) (Set.range fun j : Fin m => checkRow (g j.succ)) :=
      fun hc => hh (hsub hc)
    have hg0 : checkRow (g 0)
        ∈ Submodule.span (ZMod 2) (Set.range fun j : Fin (m + 1) => checkRow (g j)) :=
      Submodule.subset_span ⟨0, rfl⟩
    have hh2 : checkRow (pauliMulIndex h (g 0))
        ∉ Submodule.span (ZMod 2) (Set.range fun j : Fin m => checkRow (g j.succ)) := by
      intro hc
      apply hh
      have hrw : checkRow h = checkRow (pauliMulIndex h (g 0)) - checkRow (g 0) := by
        rw [checkRow_pauliMulIndex, add_sub_cancel_right]
      rw [hrw]
      exact Submodule.sub_mem _ (hsub hc) hg0
    rw [stabilizerProduct_succ, ← mul_assoc, mul_add, mul_one, pauliString_mul_eq_smul, add_mul,
      smul_mul_assoc, Matrix.trace_add, Matrix.trace_smul, ih (fun i => g i.succ) h hh1,
      ih (fun i => g i.succ) (pauliMulIndex h (g 0)) hh2, smul_zero, add_zero]

/-- **Trace of the stabilizer product of independent generators is `2^n`.** For check rows that are
`ZMod 2`-linearly independent, `tr(∏_j (I + P_{gⱼ})) = 2^n`. By induction on the number of
generators: the empty product is `I` with trace `2^n`; adding a generator `g₀` splits the trace as
`tr(∏_{tail}) + tr(P_{g₀} · ∏_{tail})`, the first `= 2^n` by induction and the second `= 0` because
`checkRow g₀` lies outside the span of the tail's rows (independence), via
`stabilizerProduct_trace_mul_of_notMem`. -/
theorem stabilizerProduct_trace :
    ∀ {m : ℕ} (g : Fin m → (Fin n → Fin 4)),
      LinearIndependent (ZMod 2) (fun j => checkRow (g j)) →
      (stabilizerProduct g).trace = (2 : ℂ) ^ n := by
  intro m
  induction m with
  | zero =>
    intro g _
    rw [stabilizerProduct_zero, Matrix.trace_one]
    simp only [Fintype.card_fun, Fintype.card_fin]
    push_cast
    ring
  | succ m ih =>
    intro g hindep
    have hnotmem : checkRow (g 0)
        ∉ Submodule.span (ZMod 2) (Set.range fun j : Fin m => checkRow (g j.succ)) := by
      intro hc
      refine hindep.notMem_span 0 ?_
      refine Submodule.span_mono ?_ hc
      rintro _ ⟨i, rfl⟩
      exact ⟨i.succ, Fin.succ_ne_zero i, rfl⟩
    rw [stabilizerProduct_succ, add_mul, one_mul, Matrix.trace_add,
      ih (fun i => g i.succ) (hindep.comp Fin.succ (Fin.succ_injective m)),
      stabilizerProduct_trace_mul_of_notMem (fun i => g i.succ) (g 0) hnotmem, add_zero]

/-! ### The stabilized subspace and its dimension -/

/-- The **stabilized subspace** `V_S = {v : ∀ j, P_{gⱼ} ·ᵥ v = v}`, the simultaneous
`+1`-eigenspace of the (phase-free) generators `g`, as a `ℂ`-submodule of the `n`-qubit register. -/
noncomputable def stabilizedSubspace {m : ℕ} (g : Fin m → (Fin n → Fin 4)) :
    Submodule ℂ ((Fin n → Fin 2) → ℂ) :=
  ⨅ i, LinearMap.eqLocus (Matrix.toLin' (pauliString (g i))) LinearMap.id

/-- Membership in the stabilized subspace: `v ∈ V_S ↔ ∀ i, P_{gᵢ} ·ᵥ v = v`. -/
theorem mem_stabilizedSubspace {m : ℕ} {g : Fin m → (Fin n → Fin 4)}
    {v : (Fin n → Fin 2) → ℂ} :
    v ∈ stabilizedSubspace g ↔ ∀ i, (pauliString (g i)).mulVec v = v := by
  simp only [stabilizedSubspace, Submodule.mem_iInf, LinearMap.mem_eqLocus, Matrix.toLin'_apply,
    LinearMap.id_apply]

/-- The **stabilizer projector** `P_S = 2^{-m} · ∏_j (I + P_{gⱼ}) = ∏_j (I + P_{gⱼ})/2`. For
commuting generators this is the orthogonal projector onto the stabilized subspace `V_S`. -/
noncomputable def stabilizerProjector {m : ℕ} (g : Fin m → (Fin n → Fin 4)) :
    Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ :=
  ((2 : ℂ) ^ m)⁻¹ • stabilizerProduct g

/-- Each generator absorbs the stabilizer projector: `P_{gᵢ} · P_S = P_S` (commuting generators). -/
theorem stabilizerProjector_absorb {m : ℕ} (g : Fin m → (Fin n → Fin 4))
    (hcomm : ∀ i j, Commute (pauliString (g i)) (pauliString (g j))) (i : Fin m) :
    pauliString (g i) * stabilizerProjector g = stabilizerProjector g := by
  rw [stabilizerProjector, mul_smul_comm, stabilizerProduct_absorb g hcomm i]

/-- **The stabilizer projector is a projection onto `V_S`.** For commuting generators,
`Matrix.toLin' P_S` is a `LinearMap.IsProj` onto the stabilized subspace: it maps every vector into
`V_S` (`stabilizerProjector_absorb`) and fixes `V_S` pointwise (`stabilizerProduct_mulVec`). -/
theorem stabilizerProjector_isProj {m : ℕ} (g : Fin m → (Fin n → Fin 4))
    (hcomm : ∀ i j, Commute (pauliString (g i)) (pauliString (g j))) :
    LinearMap.IsProj (stabilizedSubspace g) (Matrix.toLin' (stabilizerProjector g)) := by
  refine ⟨fun v => ?_, fun v hv => ?_⟩
  · rw [mem_stabilizedSubspace]
    intro i
    rw [Matrix.toLin'_apply, Matrix.mulVec_mulVec, stabilizerProjector_absorb g hcomm i]
  · rw [Matrix.toLin'_apply, stabilizerProjector, Matrix.smul_mulVec,
      stabilizerProduct_mulVec g v (mem_stabilizedSubspace.mp hv), smul_smul,
      inv_mul_cancel₀ (pow_ne_zero m two_ne_zero), one_smul]

/-- **Nielsen & Chuang, Proposition 10.5 (multiplicative form).** For `m` phase-free generators
`g : Fin m → (Fin n → Fin 4)` that pairwise commute and whose check-matrix rows are `ZMod
2`-linearly independent (equivalently, by Proposition 10.3, the generators are independent; `-I ∉ S`
is automatic for phase-free strings), the stabilized subspace `V_S` satisfies

`finrank ℂ V_S · 2^m = 2^n`,

i.e. `V_S` has dimension `2^{n-m}`. The stabilizer projector `P_S` is a projection onto `V_S`
(`stabilizerProjector_absorb` gives `P_S ↦ V_S`, `stabilizerProduct_mulVec` gives `P_S = id` on
`V_S`), so `finrank V_S = trace P_S` by `LinearMap.IsProj.trace`; and `trace P_S = 2^{-m} · 2^n` by
`stabilizerProduct_trace`. -/
theorem stabilizedSubspace_finrank_mul {m : ℕ} (g : Fin m → (Fin n → Fin 4))
    (hcomm : ∀ i j, Commute (pauliString (g i)) (pauliString (g j)))
    (hindep : LinearIndependent (ZMod 2) (fun j => checkRow (g j))) :
    Module.finrank ℂ (stabilizedSubspace g) * 2 ^ m = 2 ^ n := by
  have h2m : (2 : ℂ) ^ m ≠ 0 := pow_ne_zero m two_ne_zero
  -- `finrank V_S = trace P_S = 2^{-m} · 2^n`.
  have htrace :
      (stabilizerProjector g).trace = (Module.finrank ℂ (stabilizedSubspace g) : ℂ) := by
    rw [← Matrix.trace_toLin'_eq]; exact (stabilizerProjector_isProj g hcomm).trace
  rw [stabilizerProjector, Matrix.trace_smul, stabilizerProduct_trace g hindep, smul_eq_mul]
    at htrace
  have key : (Module.finrank ℂ (stabilizedSubspace g) : ℂ) * (2 : ℂ) ^ m = (2 : ℂ) ^ n := by
    rw [← htrace, mul_comm (((2 : ℂ) ^ m)⁻¹) ((2 : ℂ) ^ n), mul_assoc, inv_mul_cancel₀ h2m,
      mul_one]
  exact_mod_cast key

/-- **Nielsen & Chuang, Proposition 10.5.** A stabilizer code space stabilized by `n - k`
independent commuting phase-free generators is `2^k`-dimensional: `finrank ℂ V_S = 2^k` (for
`k ≤ n`). Immediate from the multiplicative form `stabilizedSubspace_finrank_mul` by cancelling the
common factor `2^{n-k}` from `finrank V_S · 2^{n-k} = 2^n = 2^k · 2^{n-k}`. -/
theorem stabilizedSubspace_finrank {n k : ℕ} (hk : k ≤ n) (g : Fin (n - k) → (Fin n → Fin 4))
    (hcomm : ∀ i j, Commute (pauliString (g i)) (pauliString (g j)))
    (hindep : LinearIndependent (ZMod 2) (fun j => checkRow (g j))) :
    Module.finrank ℂ (stabilizedSubspace g) = 2 ^ k := by
  have h := stabilizedSubspace_finrank_mul g hcomm hindep
  have hn : (2 : ℕ) ^ n = 2 ^ k * 2 ^ (n - k) := by rw [← pow_add, Nat.add_sub_cancel' hk]
  rw [hn] at h
  exact Nat.eq_of_mul_eq_mul_right (pow_pos (by norm_num : (0 : ℕ) < 2) (n - k)) h

end AxQM.Concrete
