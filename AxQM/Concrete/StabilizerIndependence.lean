import AxQM.Concrete.PauliGroupNegOne
import Mathlib.LinearAlgebra.LinearIndependent.Defs
import Mathlib.Algebra.Field.ZMod

/-!
# Concrete: Nielsen & Chuang Proposition 10.3 — independent generators ↔ linearly independent rows

This file proves Nielsen & Chuang's
**Proposition 10.3** (§10.5.1, p. 457), the bridge between the two notions of "independence" for a
set of stabilizer generators.

Independence of stabilizer generators.

Here **independent** is N&C's eq. (10.82): dropping any single generator strictly shrinks the group
generated, `⟨g₁, …, ĝᵢ, …, g_l⟩ ≠ ⟨g₁, …, g_l⟩`. The **check matrix** is the `l × 2n` matrix whose
rows are the check rows `r(gᵢ) = (x | z)` (`Concrete.checkRow` on the index of each generator, via
the total homomorphism `PauliGroup.checkRowHom`), and "rows linearly independent" is
`LinearIndependent (ZMod 2)` of the family of rows over the field `𝔽₂ = ZMod 2`.

## The abstract core

N&C's proof rests on exactly two facts, both established upstream for the Pauli group:

* the row map is an **additive homomorphism** `r(g g') = r(g) + r(g')`
  (`PauliGroup.checkRowHom_mul`, "addition in the row representation corresponds to multiplication
  of group elements"), and
* `-I ∉ S` forces the row map to have **trivial kernel on `S`**: `r(g) = 0` with `g ∈ S` gives
  `g = I` (`PauliGroup.eq_one_of_checkRowHom_eq_zero_of_negOne_notMem`).

We isolate these into a reusable group-theory lemma
`independent_iff_linearIndependent_of_hom`: for **any** group `G` with an additive map
`φ : G → V` into an `𝔽₂`-module `V` and a family `g : Fin l → G` on which `φ` has trivial kernel
over `S = ⟨range g⟩`, the generators are independent iff `φ ∘ g` is `𝔽₂`-linearly independent. Two
observations make the hypotheses minimal:

* `φ` injective on `S` (the trivial kernel) into an abelian `𝔽₂`-module already forces `S` to be
  elementary abelian (`s² ∈ ker (φ|S) = {1}`); we never need to assume `gᵢ² = I` separately.
* The equivalence factors through the pointwise bridge
  `gᵢ ∈ ⟨rest⟩ ↔ φ(gᵢ) ∈ span 𝔽₂ (φ '' rest)`: the forward direction is `φ` pushing subgroup
  closure into span (`Subgroup.closure_induction`), the backward direction is `φ` reflecting span
  membership back through the trivial kernel (`Submodule.span_induction`, building the witness group
  element as we descend). N&C's "`∑ aᵢ r(gᵢ) = 0 ↔ ∏ gᵢ^{aᵢ} = I`" is precisely this bridge.

The abstract lemma is instantiated at `φ = PauliGroup.checkRowHom` to give the named Proposition
10.3, `stabilizerGenerators_independent_iff_checkRow_linearIndependent`. It is also the natural
home for the "independent generators" predicate `IndependentGenerators`, reused by Propositions
10.4/10.5.

These are the statements of N&C Proposition 10.3.
-/

open scoped BigOperators

namespace AxQM.Concrete

/-! ### Independence of a family of group generators (N&C eq. 10.82) -/

/-- **N&C's notion of independence** (eq. 10.82) for a family of group generators: dropping any one
generator strictly shrinks the subgroup generated, `⟨g₁, …, ĝᵢ, …, g_l⟩ ≠ ⟨g₁, …, g_l⟩`. -/
def IndependentGenerators {G : Type*} [Group G] {l : ℕ} (g : Fin l → G) : Prop :=
  ∀ i, Subgroup.closure (g '' ({i}ᶜ : Set (Fin l))) ≠ Subgroup.closure (Set.range g)

/-- Independence (`IndependentGenerators`) is equivalent to the pointwise statement that no
generator lies in the subgroup generated by the others: `⟨rest⟩ ≠ ⟨all⟩ ↔ gᵢ ∉ ⟨rest⟩`. (If
`gᵢ ∈ ⟨rest⟩` then `⟨rest⟩` already contains `range g`, so it equals `⟨all⟩`; conversely if they are
equal then `gᵢ ∈ range g ⊆ ⟨all⟩ = ⟨rest⟩`.) -/
theorem independentGenerators_iff_forall_notMem {G : Type*} [Group G] {l : ℕ} (g : Fin l → G) :
    IndependentGenerators g ↔
      ∀ i, g i ∉ Subgroup.closure (g '' ({i}ᶜ : Set (Fin l))) := by
  refine forall_congr' fun i => ?_
  constructor
  · intro hne hmem
    apply hne
    refine le_antisymm (Subgroup.closure_mono (Set.image_subset_range g _)) ?_
    refine (Subgroup.closure_le _).mpr ?_
    rintro _ ⟨k, rfl⟩
    rcases eq_or_ne k i with rfl | hk
    · exact hmem
    · exact Subgroup.subset_closure ⟨k, Set.mem_compl_singleton_iff.mpr hk, rfl⟩
  · intro hnm heq
    apply hnm
    rw [heq]
    exact Subgroup.subset_closure (Set.mem_range_self i)

/-! ### The abstract group ↔ `𝔽₂`-linear-independence bridge -/

/-- **Additivity pushes subgroup closure into `𝔽₂`-span.** For an additive map `φ : G → V` into an
`𝔽₂ = ZMod 2`-module and any `T : Set G`, if `x` lies in the subgroup generated by `T` then `φ x`
lies in the `𝔽₂`-span of `φ '' T`. (`φ 1 = 0` and `φ x⁻¹ = -φ x` follow from additivity, so each of
the four `Subgroup.closure` constructors lands in the span.) This is the shared engine behind both
directions of `independent_iff_linearIndependent_of_hom` and of
`independentGenerators_of_linearIndependent_of_hom`. -/
theorem mem_span_image_of_hom {G : Type*} [Group G] {V : Type*} [AddCommGroup V]
    [Module (ZMod 2) V] {φ : G → V} (hφ : ∀ x y, φ (x * y) = φ x + φ y) {T : Set G} {x : G}
    (hx : x ∈ Subgroup.closure T) : φ x ∈ Submodule.span (ZMod 2) (φ '' T) := by
  have hφ1 : φ 1 = 0 := by simpa using hφ 1 1
  have hφinv : ∀ y : G, φ y⁻¹ = -φ y := by
    intro y
    rw [eq_neg_iff_add_eq_zero, ← hφ, inv_mul_cancel, hφ1]
  induction hx using Subgroup.closure_induction with
  | mem y hy => exact Submodule.subset_span ⟨y, hy, rfl⟩
  | one => rw [hφ1]; exact Submodule.zero_mem _
  | mul a b _ _ iha ihb => rw [hφ]; exact Submodule.add_mem _ iha ihb
  | inv a _ iha => rw [hφinv]; exact Submodule.neg_mem _ iha

/-- **The abstract core of Proposition 10.3.** Let `G` be a group, `V` an `𝔽₂ = ZMod 2`-module, and
`φ : G → V` an additive map (`φ (x y) = φ x + φ y`). For a family `g : Fin l → G` on which `φ` has
**trivial kernel over `S = ⟨range g⟩`** (`φ s = 0` and `s ∈ S` imply `s = 1`), the generators are
**independent** (dropping any `gᵢ` shrinks `S`) if and only if `φ ∘ g` is **`𝔽₂`-linearly
independent**.

The proof is N&C's: via the pointwise bridge
`gᵢ ∈ ⟨rest⟩ ↔ φ(gᵢ) ∈ span 𝔽₂ (φ '' rest)` (forward: `φ` maps subgroup closure into span; backward:
`φ` reflects span membership through the trivial kernel), independence is exactly "no `φ(gᵢ)` is a
combination of the others", i.e. `𝔽₂`-linear independence. Reused for Propositions 10.4 and 10.5. -/
theorem independent_iff_linearIndependent_of_hom {G : Type*} [Group G] {l : ℕ} {V : Type*}
    [AddCommGroup V] [Module (ZMod 2) V] (φ : G → V) (hφ : ∀ x y, φ (x * y) = φ x + φ y)
    (g : Fin l → G) (hker : ∀ s ∈ Subgroup.closure (Set.range g), φ s = 0 → s = 1) :
    (∀ i, g i ∉ Subgroup.closure (g '' ({i}ᶜ : Set (Fin l))))
      ↔ LinearIndependent (ZMod 2) (fun i => φ (g i)) := by
  classical
  -- Elementary consequences of additivity of `φ`.
  have hφ1 : φ 1 = 0 := by simpa using hφ 1 1
  have hφinv : ∀ x : G, φ x⁻¹ = -φ x := by
    intro x
    rw [eq_neg_iff_add_eq_zero, ← hφ, inv_mul_cancel, hφ1]
  have hφ_npow : ∀ (k : ℕ) (x : G), φ (x ^ k) = k • φ x := by
    intro k x
    induction k with
    | zero => rw [pow_zero, hφ1, zero_nsmul]
    | succ n ih => rw [pow_succ, hφ, ih, succ_nsmul]
  -- Over `𝔽₂`, the `ℕ`-scalar `(r.val)` and the `ZMod 2`-scalar `r` act identically.
  have hval : ∀ (r : ZMod 2) (w : V), (r.val) • w = r • w := by
    intro r w
    rw [← Nat.cast_smul_eq_nsmul (ZMod 2), ZMod.natCast_val, ZMod.cast_id]
  -- The subgroup generated by all the generators, and its parents.
  set S := Subgroup.closure (Set.range g) with hS
  -- H1: `φ` carries subgroup closure into `𝔽₂`-span (the shared `mem_span_image_of_hom`, with the
  -- span set rewritten via `Set.image_image` from `φ '' (g '' T)` to `(fun k => φ (g k)) '' T`).
  have H1 : ∀ (i : Fin l) {x : G}, x ∈ Subgroup.closure (g '' ({i}ᶜ : Set (Fin l))) →
      φ x ∈ Submodule.span (ZMod 2) ((fun k => φ (g k)) '' ({i}ᶜ : Set (Fin l))) := by
    intro i x hx
    rw [← Set.image_image φ g ({i}ᶜ : Set (Fin l))]
    exact mem_span_image_of_hom hφ hx
  -- H2: `φ` reflects `𝔽₂`-span membership back to subgroup closure (with an explicit witness).
  have H2 : ∀ (i : Fin l) {w : V},
      w ∈ Submodule.span (ZMod 2) ((fun k => φ (g k)) '' ({i}ᶜ : Set (Fin l))) →
      ∃ x ∈ Subgroup.closure (g '' ({i}ᶜ : Set (Fin l))), φ x = w := by
    intro i w hw
    induction hw using Submodule.span_induction with
    | mem y hy => obtain ⟨k, hk, rfl⟩ := hy; exact ⟨g k, Subgroup.subset_closure ⟨k, hk, rfl⟩, rfl⟩
    | zero => exact ⟨1, Subgroup.one_mem _, hφ1⟩
    | add a b _ _ iha ihb =>
        obtain ⟨x, hx, hxφ⟩ := iha; obtain ⟨y, hy, hyφ⟩ := ihb
        exact ⟨x * y, Subgroup.mul_mem _ hx hy, by rw [hφ, hxφ, hyφ]⟩
    | smul r a _ iha =>
        obtain ⟨x, hx, hxφ⟩ := iha
        exact ⟨x ^ r.val, pow_mem hx _, by rw [hφ_npow, hxφ, hval]⟩
  -- The pointwise bridge: `gᵢ ∈ ⟨rest⟩ ↔ φ(gᵢ) ∈ span (φ '' rest)`.
  have hsub : ∀ i : Fin l,
      Subgroup.closure (g '' ({i}ᶜ : Set (Fin l))) ≤ S :=
    fun i => Subgroup.closure_mono (Set.image_subset_range g _)
  have key : ∀ i : Fin l, g i ∈ Subgroup.closure (g '' ({i}ᶜ : Set (Fin l)))
      ↔ φ (g i) ∈ Submodule.span (ZMod 2) ((fun k => φ (g k)) '' ({i}ᶜ : Set (Fin l))) := by
    intro i
    refine ⟨fun h => H1 i h, fun hspan => ?_⟩
    obtain ⟨x, hx, hxφ⟩ := H2 i hspan
    have hmemS : g i * x⁻¹ ∈ S :=
      Subgroup.mul_mem _ (Subgroup.subset_closure (Set.mem_range_self i))
        (Subgroup.inv_mem _ (hsub i hx))
    have hzero : φ (g i * x⁻¹) = 0 := by rw [hφ, hφinv, hxφ, add_neg_cancel]
    have hgx : g i = x := by
      have := hker _ hmemS hzero
      rwa [mul_inv_eq_one] at this
    rw [hgx]; exact hx
  -- Assemble the equivalence from the bridge.
  constructor
  · intro hindep
    by_contra hdep
    obtain ⟨c, hsum, j, hcj⟩ := Fintype.not_linearIndependent_iff.mp hdep
    have hsum' : ∑ i, c i • φ (g i) = 0 := hsum
    apply hindep j
    rw [key j]
    have hcj1 : c j = 1 := by
      have h01 : ∀ x : ZMod 2, x ≠ 0 → x = 1 := by decide
      exact h01 _ hcj
    have hsplit : c j • φ (g j) + ∑ i ∈ Finset.univ.erase j, c i • φ (g i) = 0 := by
      rw [Finset.add_sum_erase Finset.univ (fun i => c i • φ (g i)) (Finset.mem_univ j)]
      exact hsum'
    rw [hcj1, one_smul] at hsplit
    have hvj : φ (g j) = -∑ i ∈ Finset.univ.erase j, c i • φ (g i) :=
      eq_neg_of_add_eq_zero_left hsplit
    rw [hvj]
    refine Submodule.neg_mem _ (Submodule.sum_mem _ fun i hi => ?_)
    exact Submodule.smul_mem _ _
      (Submodule.subset_span
        ⟨i, Set.mem_compl_singleton_iff.mpr (Finset.mem_erase.mp hi).1, rfl⟩)
  · intro hLI i hmem
    rw [key i] at hmem
    exact hLI.notMem_span i hmem

/-- **The "easy" half of Proposition 10.3, for any additive `φ`.** If `φ : G → V` into an
`𝔽₂ = ZMod 2`-module is additive (`φ (x y) = φ x + φ y`) and the family `φ ∘ g` is `𝔽₂`-linearly
independent, then the generators `g` are **independent** (`IndependentGenerators g`).

Unlike the full equivalence `independent_iff_linearIndependent_of_hom`, this one direction needs
**no** trivial-kernel / `-I ∉ S` hypothesis: linear independence of the check rows already forces
independence of the generators, since a dependence `gᵢ ∈ ⟨rest⟩` would push (via additivity of `φ`,
carrying subgroup closure into `𝔽₂`-span — `mem_span_image_of_hom`) to `φ(gᵢ) ∈ span (φ '' rest)`,
contradicting `hLI.notMem_span`. This is the form used to show the encoded `Z` / `X` operators of a
standard-form stabilizer code are independent (N&C Exercises 10.53/10.54), where the check rows
carry an identity block. -/
theorem independentGenerators_of_linearIndependent_of_hom {G : Type*} [Group G] {l : ℕ} {V : Type*}
    [AddCommGroup V] [Module (ZMod 2) V] (φ : G → V) (hφ : ∀ x y, φ (x * y) = φ x + φ y)
    (g : Fin l → G) (hLI : LinearIndependent (ZMod 2) (fun i => φ (g i))) :
    IndependentGenerators g := by
  rw [independentGenerators_iff_forall_notMem]
  intro i hmem
  refine hLI.notMem_span i ?_
  rw [← Set.image_image φ g ({i}ᶜ : Set (Fin l))]
  exact mem_span_image_of_hom hφ hmem

/-! ### Nielsen & Chuang, Proposition 10.3 -/

/-- **Nielsen & Chuang, Proposition 10.3.** Let `g : Fin l → PauliGroup n` generate `S = ⟨range g⟩`
with `-I ∉ S` (`PauliGroup.negOne n ∉ S`). Then the generators are **independent** (in the sense of
eq. 10.82, `IndependentGenerators g`: dropping any `gᵢ` strictly shrinks `S`) **if and only if** the
rows of the corresponding check matrix — the check rows `r(gᵢ) = PauliGroup.checkRowHom (gᵢ)` — are
`𝔽₂ = ZMod 2`-**linearly independent**.

This is the abstract bridge `independent_iff_linearIndependent_of_hom` instantiated at the total
check-row homomorphism `φ = PauliGroup.checkRowHom` (`checkRowHom_mul` supplies additivity), whose
kernel is trivial on `S` because `-I ∉ S`
(`eq_one_of_checkRowHom_eq_zero_of_negOne_notMem`). -/
theorem stabilizerGenerators_independent_iff_checkRow_linearIndependent {n l : ℕ}
    (g : Fin l → PauliGroup n)
    (hneg : PauliGroup.negOne n ∉ Subgroup.closure (Set.range g)) :
    IndependentGenerators g ↔
      LinearIndependent (ZMod 2) (fun i => PauliGroup.checkRowHom (g i)) := by
  rw [independentGenerators_iff_forall_notMem]
  exact independent_iff_linearIndependent_of_hom PauliGroup.checkRowHom
    PauliGroup.checkRowHom_mul g
    (fun _ hs h0 => PauliGroup.eq_one_of_checkRowHom_eq_zero_of_negOne_notMem hneg hs h0)

end AxQM.Concrete
