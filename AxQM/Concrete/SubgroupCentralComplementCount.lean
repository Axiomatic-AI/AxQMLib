import AxQM.Concrete.MonoidHomCyclicCount
import AxQM.Concrete.SubgroupComplementOrbitCount

/-!
# Concrete: the complement count of a *central* minimal normal subgroup

*(Supporting `AxQM/NC/Ch5/Problem5_5.lean`, N&C Prob. 5.5 — Ettinger–Høyer–Knill piece
ii.)*

The chief-series recursion of `Concrete/SubgroupComplementOrbitCount.lean` pins the solvable
maximal-subgroup count on the per-chief-factor cohomological hypothesis
`#{N-conjugacy classes of complements of an abelian minimal normal `N` in `H`} ≤ |H : N|`
(`card_isCoatom_le_two_mul_card_of_isSolvable_of_orbitBound`, the named Wall /
Aschbacher–Guralnick bound `|H¹(H ⧸ N, N)| ≤ |H : N|`). This file **discharges that hypothesis
outright in the central (trivial-action) case** — when the chief factor `N ≤ Z(H)` — completing
the line begun by `Concrete/MonoidHomCyclicCount.lean`.

The key steps, all elementary:

* `card_isComplement'_le_card_monoidHom_of_le_center` — for a **central** normal `N ◁ H`
  (finite `H`), the number of complements of `N` is at most the number of homomorphisms
  `H ⧸ N →* N`:  `#{complements of N} ≤ |Hom(H ⧸ N, N)|`. A complement `K` is normal
  (`normal_of_isComplement'_of_le_center`, since `N` central), so `H ⧸ K ≃* N` gives a
  **retraction** `r_K : H →* N` with `r_K|_N = id` and `ker r_K = K` (`complementRetraction`);
  the difference `r_K · r_{K₀}⁻¹` of two retractions kills `N` (as `N` is central, `Hom(H, N)`
  is a group), hence factors through `H ⧸ N`, and `K ↦ (that factored hom)` injects the
  complements into `Hom(H ⧸ N, N)`.

* `isCyclic_of_le_center_of_minimal` — a **central minimal normal** `N` is **cyclic**: any
  `x ∈ N`, `x ≠ 1` has `⟨x⟩ ≤ N` normal in `H` (central), so `⟨x⟩ = N` by minimality, and `N`
  is generated by one element.

* `card_isComplement'_le_index_of_le_center` — composing the two with the cyclic hom count
  `card_monoidHom_le_card_of_isCyclic` (`|Hom(H ⧸ N, N)| ≤ |H ⧸ N| = |H : N|` for cyclic `N`)
  gives `#{complements of a central minimal normal N} ≤ |H : N|`.

* `card_isComplement'_orbits_le_index_of_le_center` — since the number of `N`-conjugacy classes
  of complements is at most the number of complements, this is exactly the orbit hypothesis
  of `card_isCoatom_le_two_mul_card_of_isSolvable_of_orbitBound`, **in the central case**:
  `#{N-conjugacy classes of complements} ≤ |H : N|`.

This narrows the sole general-`G` residual of Problem 5.5's piece (ii) to the **non-central**
chief factors (nontrivial `H ⧸ N`-action on `N`), where `|H¹(H ⧸ N, N)|` can be nonzero — the
genuinely deep Wall / Aschbacher–Guralnick question. It does **not** by itself unlock a new class
of groups (a nilpotent group's chief factors are all central, and nilpotent groups already have no
non-normal maximals), but it turns the central case of the recursion's hypothesis from a
`∀`-quantified assumption into a theorem.
-/

open Subgroup QuotientGroup MonoidHom

namespace AxQM.Concrete

variable {H : Type*} [Group H]

/-- **A subgroup contained in the center is normal.** For `S ≤ Z(H)`, every element of `S` commutes
with every element of `H`, so `S` is closed under conjugation. -/
theorem normal_of_le_center {S : Subgroup H} (h : S ≤ Subgroup.center H) : S.Normal := by
  constructor
  intro s hs g
  have hcomm : g * s = s * g := Subgroup.mem_center_iff.mp (h hs) g
  rw [hcomm]; simpa using hs

/-- **A complement of a central normal subgroup is itself normal.** If `N ◁ H` with `N ≤ Z(H)` and
`K` is a complement of `N`, then `K.Normal`: writing `h = n · m` with `n ∈ N`, `m ∈ K` (the
complement factorization), conjugation `h · k · h⁻¹ = m · k · m⁻¹ ∈ K` because the central `n`
cancels. -/
theorem normal_of_isComplement'_of_le_center {N K : Subgroup H} [N.Normal]
    (hcompl : N.IsComplement' K) (hcentral : N ≤ Subgroup.center H) : K.Normal := by
  constructor
  intro k hk h
  set n : H := ↑(hcompl.equiv h).1 with hndef
  set m : H := ↑(hcompl.equiv h).2 with hmdef
  have hn : n ∈ N := (hcompl.equiv h).1.2
  have hm : m ∈ K := (hcompl.equiv h).2.2
  have hfac : n * m = h := hcompl.equiv_fst_mul_equiv_snd h
  have hcomm : ∀ x, n * x = x * n := fun x => (Subgroup.mem_center_iff.mp (hcentral hn) x).symm
  have hrw : h * k * h⁻¹ = m * k * m⁻¹ := by
    rw [← hfac, mul_inv_rev]
    calc n * m * k * (m⁻¹ * n⁻¹) = n * (m * k * m⁻¹) * n⁻¹ := by group
      _ = (m * k * m⁻¹) * n * n⁻¹ := by rw [hcomm (m * k * m⁻¹)]
      _ = m * k * m⁻¹ := by group
  rw [hrw]; exact K.mul_mem (K.mul_mem hm hk) (K.inv_mem hm)

/-- **The inclusion `N ↪ H ⧸ K` is a bijection for a complement `K` of a normal `N`.** The
composite `N →* H ⧸ K` (`QuotientGroup.mk' K` restricted to `N`) is injective because
`N ⊓ K = ⊥` and surjective because `N · K = H`. This is the second-isomorphism identification
`N ≃* H ⧸ K` underlying the retraction `complementRetraction`. -/
theorem isComplement'_mk_subtype_bijective {N K : Subgroup H} [N.Normal] [K.Normal]
    (hcompl : N.IsComplement' K) :
    Function.Bijective ((QuotientGroup.mk' K).comp N.subtype) := by
  refine ⟨?_, ?_⟩
  · rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
    intro x hx
    simp only [MonoidHom.mem_ker, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff, coe_subtype] at hx
    have hmem : (x : H) ∈ N ⊓ K := ⟨x.2, hx⟩
    rw [hcompl.disjoint.eq_bot] at hmem
    exact Subtype.ext hmem
  · intro y
    obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective y
    refine ⟨⟨↑(hcompl.equiv h).1, (hcompl.equiv h).1.2⟩, ?_⟩
    change (QuotientGroup.mk (↑(hcompl.equiv h).1) : H ⧸ K) = QuotientGroup.mk h
    conv_rhs => rw [← hcompl.equiv_fst_mul_equiv_snd h]
    exact (QuotientGroup.mk_mul_of_mem _ (hcompl.equiv h).2.2).symm

/-- **The retraction `H →* N` of a complement `K` of a normal subgroup `N`.** Realized as the
composite `H ⧸ K ≃* N` (inverse of `isComplement'_mk_subtype_bijective`) after the quotient map
`H → H ⧸ K`. It satisfies `r_K|_N = id` (`complementRetraction_coe`) and
`ker r_K = K` (`complementRetraction_eq_one_iff`). -/
noncomputable def complementRetraction {N K : Subgroup H} [N.Normal] [K.Normal]
    (hcompl : N.IsComplement' K) : H →* ↥N :=
  (MulEquiv.ofBijective _ (isComplement'_mk_subtype_bijective hcompl)).symm.toMonoidHom.comp
    (QuotientGroup.mk' K)

/-- The retraction `complementRetraction` restricts to the identity on `N`. -/
theorem complementRetraction_coe {N K : Subgroup H} [N.Normal] [K.Normal]
    (hcompl : N.IsComplement' K) (n : ↥N) : complementRetraction hcompl (n : H) = n := by
  unfold complementRetraction
  simp only [MonoidHom.comp_apply, QuotientGroup.mk'_apply, MulEquiv.coe_toMonoidHom]
  rw [MulEquiv.symm_apply_eq]; rfl

/-- The kernel of the retraction `complementRetraction` is the complement `K`:
`r_K h = 1 ↔ h ∈ K`. -/
theorem complementRetraction_eq_one_iff {N K : Subgroup H} [N.Normal] [K.Normal]
    (hcompl : N.IsComplement' K) (h : H) : complementRetraction hcompl h = 1 ↔ h ∈ K := by
  unfold complementRetraction
  simp only [MonoidHom.comp_apply, QuotientGroup.mk'_apply, MulEquiv.coe_toMonoidHom]
  rw [map_eq_one_iff _ (MulEquiv.injective _), QuotientGroup.eq_one_iff]

/-- **The number of complements of a central normal subgroup is at most the hom count**
`|Hom(H ⧸ N, N)|` (Nielsen & Chuang, Problem 5.5 — Ettinger–Høyer–Knill piece ii, central case).
For `N ◁ H` with `N ≤ Z(H)` (finite `H`),
`#{complements of N} ≤ Nat.card (H ⧸ N →* N)`.

`N` being central makes `Hom(H, N)` a group; each complement `K` yields a retraction
`r_K : H →* N` with `r_K|_N = id` and `ker r_K = K` (`complementRetraction`). Fixing a basepoint
complement `K₀`, the difference `r_K · r_{K₀}⁻¹` kills `N` and hence descends to a homomorphism
`H ⧸ N →* N`; the assignment `K ↦ (that hom)` is injective because it determines `r_K`, hence
`K = ker r_K`. (When there are no complements the bound is `0 ≤ _`.) -/
theorem card_isComplement'_le_card_monoidHom_of_le_center [Finite H] {N : Subgroup H} [N.Normal]
    (hcentral : N ≤ Subgroup.center H) :
    Nat.card {K : Subgroup H // N.IsComplement' K} ≤ Nat.card (H ⧸ N →* ↥N) := by
  let : CommGroup ↥N :=
    { (inferInstance : Group ↥N) with
      mul_comm := fun a b => Subtype.ext (by
        simpa using (Subgroup.mem_center_iff.mp (hcentral a.2) b).symm) }
  have : Finite (H ⧸ N) := Quotient.finite _
  have : Finite (H ⧸ N →* ↥N) := by
    have : Fintype (H ⧸ N) := Fintype.ofFinite _
    have : Fintype ↥N := Fintype.ofFinite _
    exact Finite.of_injective (fun f => (f : H ⧸ N → ↥N)) DFunLike.coe_injective
  rcases isEmpty_or_nonempty {K : Subgroup H // N.IsComplement' K} with he | hne
  · have : Nat.card {K : Subgroup H // N.IsComplement' K} = 0 := Nat.card_eq_zero.mpr (Or.inl he)
    omega
  · obtain ⟨⟨K₀, hK₀⟩⟩ := hne
    have hK0n : K₀.Normal := normal_of_isComplement'_of_le_center hK₀ hcentral
    refine Nat.card_le_card_of_injective
      (fun K => letI : (K.1).Normal := normal_of_isComplement'_of_le_center K.2 hcentral
        QuotientGroup.lift N (complementRetraction K.2 * (complementRetraction hK₀)⁻¹)
          (by
            intro x hx
            change (complementRetraction K.2) x * ((complementRetraction hK₀) x)⁻¹ = 1
            rw [show x = ((⟨x, hx⟩ : ↥N) : H) from rfl,
              complementRetraction_coe, complementRetraction_coe, mul_inv_cancel])) ?_
    rintro ⟨K, hK⟩ ⟨K', hK'⟩ hEq
    have hKn : K.Normal := normal_of_isComplement'_of_le_center hK hcentral
    have hK'n : K'.Normal := normal_of_isComplement'_of_le_center hK' hcentral
    have hval : ∀ h : H, complementRetraction hK h = complementRetraction hK' h := by
      intro h
      have h2 := DFunLike.congr_fun hEq (QuotientGroup.mk h)
      simp only [QuotientGroup.lift_mk', MonoidHom.mul_apply, MonoidHom.inv_apply] at h2
      exact mul_right_cancel h2
    apply Subtype.ext
    ext h
    rw [← complementRetraction_eq_one_iff hK, ← complementRetraction_eq_one_iff hK', hval h]

/-- **A central minimal normal subgroup is cyclic** (Nielsen & Chuang, Problem 5.5 —
Ettinger–Høyer–Knill piece ii). If `N ≤ Z(H)` is minimal among nontrivial normal subgroups
(`hmin`), then `IsCyclic ↥N`: any `x ∈ N`, `x ≠ 1` generates a subgroup `⟨x⟩ ≤ N` that is normal
in `H` (central) and nontrivial, hence `= N` by minimality — so `N` is generated by a single
element. (The trivial `N = ⊥` case is cyclic outright.) -/
theorem isCyclic_of_le_center_of_minimal {N : Subgroup H}
    (hcentral : N ≤ Subgroup.center H)
    (hmin : ∀ K : Subgroup H, K.Normal → K ≤ N → K = ⊥ ∨ K = N) :
    IsCyclic ↥N := by
  rcases eq_or_ne N ⊥ with hN | hN
  · subst hN; infer_instance
  · obtain ⟨⟨x, hxN⟩, hx1⟩ := ne_bot_iff_exists_ne_one.mp hN
    have hxc : x ∈ Subgroup.center H := hcentral hxN
    have hzle : Subgroup.zpowers x ≤ N := (Subgroup.zpowers_le).mpr hxN
    have hznorm : (Subgroup.zpowers x).Normal :=
      normal_of_le_center (by rw [Subgroup.zpowers_le]; exact hxc)
    have hne : Subgroup.zpowers x ≠ ⊥ := by
      rw [Ne, Subgroup.zpowers_eq_bot]
      intro hx0; exact hx1 (Subtype.ext hx0)
    have heq : Subgroup.zpowers x = N := (hmin _ hznorm hzle).resolve_left hne
    refine ⟨⟨x, hxN⟩, ?_⟩
    intro ⟨y, hy⟩
    rw [← heq] at hy
    obtain ⟨k, rfl⟩ := hy
    exact ⟨k, by ext; simp⟩

/-- **The complement count of a central minimal normal subgroup is at most its index**
(Nielsen & Chuang, Problem 5.5 — Ettinger–Høyer–Knill piece ii, central case).
For `N ◁ H` central and minimal normal (finite `H`),
`#{complements of N} ≤ |H : N|`.

`N` is cyclic (`isCyclic_of_le_center_of_minimal`), so the cyclic hom count
`card_monoidHom_le_card_of_isCyclic` bounds `|Hom(H ⧸ N, N)| ≤ |H ⧸ N| = |H : N|`; compose with
`card_isComplement'_le_card_monoidHom_of_le_center`. -/
theorem card_isComplement'_le_index_of_le_center [Finite H] {N : Subgroup H} [N.Normal]
    (hcentral : N ≤ Subgroup.center H)
    (hmin : ∀ K : Subgroup H, K.Normal → K ≤ N → K = ⊥ ∨ K = N) :
    Nat.card {K : Subgroup H // N.IsComplement' K} ≤ N.index := by
  have : IsCyclic ↥N := isCyclic_of_le_center_of_minimal hcentral hmin
  have : Finite (H ⧸ N) := Quotient.finite _
  calc Nat.card {K : Subgroup H // N.IsComplement' K}
      ≤ Nat.card (H ⧸ N →* ↥N) := card_isComplement'_le_card_monoidHom_of_le_center hcentral
    _ ≤ Nat.card (H ⧸ N) := card_monoidHom_le_card_of_isCyclic
    _ = N.index := (Subgroup.index_eq_card N).symm

/-- **The central case of the cohomological complement-class bound** (Nielsen & Chuang, Problem 5.5
— Ettinger–Høyer–Knill piece ii). For a **central** minimal normal subgroup `N ◁ H` (finite `H`),
the number of `N`-conjugacy classes of complements is at most `|H : N|`:

`#{N-conjugacy classes of complements of N} ≤ |H : N|`.

This is exactly the per-chief-factor hypothesis of
`card_isCoatom_le_two_mul_card_of_isSolvable_of_orbitBound` (the Wall / Aschbacher–Guralnick bound
`|H¹(H ⧸ N, N)| ≤ |H : N|`), discharged when the chief factor is central (trivial `H ⧸ N`-action):
the number of orbits is at most the number of complements, which is `≤ |H : N|`
(`card_isComplement'_le_index_of_le_center`). The residual for a general solvable `G` is thus
narrowed to the **non-central** chief factors. -/
theorem card_isComplement'_orbits_le_index_of_le_center [Finite H] {N : Subgroup H} [N.Normal]
    (hcentral : N ≤ Subgroup.center H)
    (hmin : ∀ K : Subgroup H, K.Normal → K ≤ N → K = ⊥ ∨ K = N) :
    Nat.card (MulAction.orbitRel.Quotient ↥N {K : Subgroup H // N.IsComplement' K}) ≤ N.index :=
  le_trans (Nat.card_le_card_of_surjective _ Quotient.mk''_surjective)
    (card_isComplement'_le_index_of_le_center hcentral hmin)

end AxQM.Concrete
