import AxQM.Concrete.CosetStateOverlap
import Mathlib.Data.Nat.Log
import Mathlib.GroupTheory.Rank
import Mathlib.Data.Nat.Choose.Bounds
import Mathlib.Data.Nat.Choose.Sum

/-!
# Concrete: how many subgroups a finite group has

This file bounds the **number of subgroups** of a finite group `G` by

`#{subgroups of G} = Nat.card (Subgroup G) ≤ |G| ^ (log₂|G| + 1)`   (`card_subgroup_le`),

i.e. `|G|^{Θ(log|G|)} = 2^{Θ((log|G|)²)}`. The bound is *super-polynomial* — a finite group really
can have that many subgroups, e.g. `(ℤ/2)ⁿ` has `≈ 2^{n²/4}` subgroups of rank `n/2` — but it is
sharp enough for the argument that needs it.

## Why this is here (Nielsen & Chuang, Problem 5.5)

This is the **candidate-count** ingredient of the Ettinger–Høyer–Knill identification bound behind
N&C's Problem 5.5 (the non-Abelian hidden subgroup problem). To identify the hidden subgroup `K`
from the `m`-copy coset reduced state `σ_K^{⊗m}`, one must control a **sum over all candidate hidden
subgroups** `K'` of the pairwise overlap of the reduced states,
`∑_{K'≠K} (|K∩K'|/√(|K||K'|))^m` (see `AxQM.Concrete.CosetStateOverlap` and the
`cosetDensityState_pi_affinity` theorems). That sum splits into a *near* part (the few subgroups
whose reduced state is close to `σ_K`) and a *far* **tail**; the tail is bounded by the number of
candidate subgroups times a per-copy separation raised to the `m`-th power, and `card_subgroup_le`
is exactly the `#candidate subgroups ≤ |G|^{log₂|G|+1}` factor that tail estimate consumes (the
per-copy separation `≤ 1/√2` from `two_mul_card_inf_sq_le` decays fast enough that even this
super-polynomial count is overwhelmed once `m = 4 log₂|G| + 2`).

## Proof

The heart is the classical fact that a finite group has a **small generating set**:

`Group.rank G ≤ log₂|G|`   (`rank_le_log_card`),

i.e. `G` is generated by at most `log₂|G|` elements. Its proof is the doubling principle
(`two_pow_card_le_card_closure_of_independent`): if a finite set `s` is *independent* — no element
lies in the subgroup generated by the others — then adding its elements one at a time at least
doubles the order of the generated subgroup at each step, so `2^{|s|} ≤ |⟨s⟩|`. A
minimum-cardinality generating set (`Group.rank_spec`) is independent, so `2^{rank G} ≤ |G|`, giving
`rank G ≤ log₂|G|`. The single-step doubling `2·|H| ≤ |L|` for a proper finite subgroup `H < L` is
`AxQM.Concrete.two_mul_card_le_of_lt`.

Counting then follows: each subgroup `H` has a generating finset of at most `log₂|G|` elements
(`exists_closure_finset_card_le_log`, `rank_le_log_card` applied to `H`), and a subgroup is
recovered from any of its generating finsets by taking the closure, so
`H ↦ (a generating finset)` injects `Subgroup G` into the finsets of `G` of cardinality `≤ log₂|G|`.
The number of such finsets is `∑_{k≤log₂|G|} \binom{|G|}{k} ≤ (log₂|G| + 1)·|G|^{log₂|G|} ≤
|G|^{log₂|G|+1}` (each `\binom{n}{k} ≤ n^k ≤ n^{log₂|G|}`, and `log₂|G| + 1 ≤ |G|`).

Compare the other finite-group counting lemmas `AxQM.Concrete.two_mul_card_inf_sq_le` and
`natCard_subgroupPi_const`.
-/

namespace AxQM.Concrete

open Finset

variable {G : Type*} [Group G]

/-- **The generated subgroup of an independent finset has order at least `2^{|s|}`.** A finset `s`
is *independent* when no element `g ∈ s` lies in the subgroup generated by the remaining elements
`s \ {g}` (`hs`). Adding the elements of `s` one at a time then strictly enlarges the generated
subgroup at every step, and by Lagrange's theorem a proper finite subgroup has at most half the
order of its overgroup (`two_mul_card_le_of_lt`), so each step at least doubles the order:

`2 ^ |s| ≤ |⟨s⟩|`.

This is the doubling principle behind `rank_le_log_card`: a minimum-size generating set is
independent, so a group generated by `k` elements has order `≥ 2^k`, i.e. it needs `≥ log₂|G|`
generators only if `|G| ≥ 2^{log₂|G|}` — equivalently, `k` generators force `k ≤ log₂|G|`. -/
theorem two_pow_card_le_card_closure_of_independent [Finite G] [DecidableEq G] {s : Finset G}
    (hs : ∀ g ∈ s, g ∉ Subgroup.closure (↑(s.erase g) : Set G)) :
    2 ^ s.card ≤ Nat.card ↥(Subgroup.closure (↑s : Set G)) := by
  induction s using Finset.induction with
  | empty => simp
  | @insert a t ha ih =>
    have hat : (insert a t).erase a = t := Finset.erase_insert ha
    -- `t` inherits independence from `insert a t`.
    have hindt : ∀ g ∈ t, g ∉ Subgroup.closure (↑(t.erase g) : Set G) := by
      intro g hg hmem
      have hne : g ≠ a := fun h => ha (h ▸ hg)
      have herase : (insert a t).erase g = insert a (t.erase g) :=
        Finset.erase_insert_of_ne (Ne.symm hne)
      apply hs g (Finset.mem_insert_of_mem hg)
      rw [herase, Finset.coe_insert]
      exact Subgroup.closure_mono (Set.subset_insert _ _) hmem
    -- `a` is not in the subgroup generated by `t`, so adding it strictly enlarges the closure.
    have hanotin : a ∉ Subgroup.closure (↑t : Set G) := by
      have := hs a (Finset.mem_insert_self a t); rwa [hat] at this
    have hlt : Subgroup.closure (↑t : Set G) < Subgroup.closure (↑(insert a t) : Set G) := by
      rw [Finset.coe_insert]
      refine lt_of_le_of_ne (Subgroup.closure_mono (Set.subset_insert _ _)) ?_
      intro heq
      exact hanotin (heq ▸ Subgroup.subset_closure (Set.mem_insert _ _))
    have hdouble : 2 * Nat.card ↥(Subgroup.closure (↑t : Set G))
        ≤ Nat.card ↥(Subgroup.closure (↑(insert a t) : Set G)) :=
      two_mul_card_le_of_lt _ _ hlt.le hlt.ne
    calc 2 ^ (insert a t).card = 2 * 2 ^ t.card := by
          rw [Finset.card_insert_of_notMem ha, pow_succ, mul_comm]
      _ ≤ 2 * Nat.card ↥(Subgroup.closure (↑t : Set G)) := Nat.mul_le_mul_left 2 (ih hindt)
      _ ≤ _ := hdouble

/-- **A finite group is generated by at most `log₂|G|` elements:** `Group.rank G ≤ log₂|G|`. A
minimum-cardinality generating set `S` (`Group.rank_spec`) is *independent* — if some `g ∈ S` were
in the subgroup generated by `S \ {g}`, then `S \ {g}` would already generate `G`, contradicting
minimality — so the doubling principle `two_pow_card_le_card_closure_of_independent` gives
`2^{rank G} = 2^{|S|} ≤ |G|`, i.e. `rank G ≤ log₂|G|`.

This is the crux of the subgroup-count bound `card_subgroup_le`: it says every subgroup has a
generating set of at most `log₂|G|` elements, so subgroups are determined by short generating
finsets and hence not too numerous. -/
theorem rank_le_log_card [Finite G] : Group.rank G ≤ Nat.log 2 (Nat.card G) := by
  classical
  obtain ⟨S, hcard, hgen⟩ := Group.rank_spec G
  have hind : ∀ g ∈ S, g ∉ Subgroup.closure (↑(S.erase g) : Set G) := by
    intro g hg hmem
    -- `⟨S.erase g⟩` contains `g` and all of `S.erase g`, hence all of `S`, hence is `⊤`.
    have hsub : (↑S : Set G) ⊆ (Subgroup.closure (↑(S.erase g) : Set G) : Set G) := by
      intro x hx
      by_cases hxg : x = g
      · rw [hxg]; exact hmem
      · exact Subgroup.subset_closure (by
          simp only [Finset.coe_erase, Set.mem_sdiff, Set.mem_singleton_iff]; exact ⟨hx, hxg⟩)
    have htop : Subgroup.closure (↑(S.erase g) : Set G) = ⊤ := by
      rw [eq_top_iff, ← hgen]; exact Subgroup.closure_le _ |>.mpr hsub
    -- but then `S.erase g` (one smaller) generates `⊤`, contradicting the minimality `rank = |S|`.
    have hpos : 0 < S.card := Finset.card_pos.mpr ⟨g, hg⟩
    have hle : Group.rank G ≤ (S.erase g).card := Group.rank_le htop
    rw [Finset.card_erase_of_mem hg] at hle; omega
  have h2 := two_pow_card_le_card_closure_of_independent hind
  rw [hgen, Nat.card_congr Subgroup.topEquiv.toEquiv, hcard] at h2
  exact (Nat.le_log_iff_pow_le (by norm_num) Nat.card_pos.ne').mpr h2

/-- **Every subgroup of a finite group has a generating finset of at most `log₂|G|` elements.**
Applying `rank_le_log_card` to the subgroup `H` (itself a finite group) yields a generating set of
`↥H` of size `rank H ≤ log₂|H| ≤ log₂|G|`; pushing it forward along the inclusion `↥H ↪ G` gives a
finset `s ⊆ G` with `⟨s⟩ = H` and `|s| ≤ log₂|G|`. This is what makes the counting injection in
`card_subgroup_le` land in the small finsets. -/
theorem exists_closure_finset_card_le_log [Finite G] (H : Subgroup G) :
    ∃ s : Finset G, Subgroup.closure (↑s : Set G) = H ∧ s.card ≤ Nat.log 2 (Nat.card G) := by
  classical
  obtain ⟨T, hTcard, hTgen⟩ := Group.rank_spec ↥H
  refine ⟨T.image H.subtype, ?_, ?_⟩
  · rw [Finset.coe_image, ← MonoidHom.map_closure, hTgen, ← MonoidHom.range_eq_map,
      Subgroup.range_subtype]
  · calc (T.image H.subtype).card ≤ T.card := Finset.card_image_le
      _ = Group.rank ↥H := hTcard
      _ ≤ Nat.log 2 (Nat.card ↥H) := rank_le_log_card
      _ ≤ Nat.log 2 (Nat.card G) :=
          Nat.log_mono_right (Nat.card_le_card_of_injective _ Subtype.val_injective)

/-- **The number of finsets of `G` of cardinality `≤ L` is at most `|G|^{L+1}`** (given
`L + 1 ≤ |G|`). The finsets of size `≤ L` inject into `⋃_{k ≤ L} \binom{G}{k}`, of which there are
`∑_{k≤L} \binom{|G|}{k} ≤ (L+1)·|G|^L ≤ |G|^{L+1}` (each `\binom{n}{k} ≤ n^k ≤ n^L`, and the
hypothesis `L + 1 ≤ |G|`).

This is the shared small-finset counting tail of the subgroup-count bounds `card_subgroup_le` and
`AxQM.Concrete.card_subgroup_index_le`: each injects its subgroups into short generating
finsets (of size `≤ log₂|G|`, resp. `≤ log₂ d`), then applies this lemma, discharging `L + 1 ≤ |G|`
from its own `Nat.log_lt_self` / `Nat.log_mono_right` bound. -/
theorem card_filter_card_le_pow_le [Fintype G] {L : ℕ} (hL : L + 1 ≤ Nat.card G) :
    (Finset.univ.filter (fun s : Finset G => s.card ≤ L)).card ≤ Nat.card G ^ (L + 1) := by
  classical
  have hn : 0 < Nat.card G := Nat.card_pos
  have hsub : (Finset.univ.filter (fun s : Finset G => s.card ≤ L))
      ⊆ (Finset.range (L + 1)).biUnion (fun k => Finset.univ.powersetCard k) := by
    intro s hs
    rw [Finset.mem_filter] at hs
    simp only [Finset.mem_biUnion, Finset.mem_range]
    exact ⟨s.card, by omega, Finset.mem_powersetCard.mpr ⟨Finset.subset_univ s, rfl⟩⟩
  calc (Finset.univ.filter (fun s : Finset G => s.card ≤ L)).card
      ≤ ((Finset.range (L + 1)).biUnion (fun k => Finset.univ.powersetCard k)).card :=
        Finset.card_le_card hsub
    _ ≤ ∑ k ∈ Finset.range (L + 1), (Finset.univ.powersetCard k).card := Finset.card_biUnion_le
    _ = ∑ k ∈ Finset.range (L + 1), (Nat.card G).choose k := by
        simp only [Finset.card_powersetCard, Finset.card_univ, Nat.card_eq_fintype_card]
    _ ≤ ∑ k ∈ Finset.range (L + 1), (Nat.card G) ^ L := by
        apply Finset.sum_le_sum; intro k hk
        rw [Finset.mem_range] at hk
        exact (Nat.choose_le_pow _ k).trans (Nat.pow_le_pow_right hn (by omega))
    _ = (L + 1) * (Nat.card G) ^ L := by rw [Finset.sum_const, Finset.card_range, Nat.nsmul_eq_mul]
    _ ≤ (Nat.card G) * (Nat.card G) ^ L := by apply Nat.mul_le_mul_right; exact hL
    _ = (Nat.card G) ^ (L + 1) := by rw [pow_succ, mul_comm]

/-- **A type injecting via `f` into the finsets of `G` of cardinality `≤ L` has at most `|G|^{L+1}`
elements** (given `L + 1 ≤ |G|`). Pushing `α` forward along the injection `f` into
`{s : Finset G // s.card ≤ L}` and counting the target with `card_filter_card_le_pow_le`:

`Nat.card α ≤ |G| ^ (L + 1)`.

This is the shared *generating-finset count bridge* of the subgroup-count bounds `card_subgroup_le`
and `AxQM.Concrete.card_subgroup_index_le`: each maps its subgroups injectively to a
generating finset of size `≤ L` (`≤ log₂|G|`, resp. `≤ log₂ d`) and applies this lemma. -/
theorem card_le_pow_of_injective_finset [Finite G] {α : Type*} {L : ℕ}
    (hL : L + 1 ≤ Nat.card G) {f : α → Finset G} (hf : Function.Injective f)
    (hfc : ∀ a, (f a).card ≤ L) : Nat.card α ≤ Nat.card G ^ (L + 1) := by
  classical
  have : Fintype G := Fintype.ofFinite G
  set 𝒮 : Finset (Finset G) := Finset.univ.filter (fun s => s.card ≤ L) with h𝒮
  have hmem : ∀ a, f a ∈ 𝒮 := fun a => by
    rw [h𝒮, Finset.mem_filter]; exact ⟨Finset.mem_univ _, hfc a⟩
  have hcard1 : Nat.card α ≤ 𝒮.card := by
    have hinj' : Function.Injective (fun a => (⟨f a, hmem a⟩ : {s // s ∈ 𝒮})) :=
      fun a b h => hf (Subtype.ext_iff.mp h)
    have hle := Nat.card_le_card_of_injective _ hinj'
    rwa [Nat.card_eq_fintype_card (α := {s // s ∈ 𝒮}), Fintype.card_coe] at hle
  refine hcard1.trans ?_
  rw [h𝒮]
  exact card_filter_card_le_pow_le hL

/-- **The number of subgroups of a finite group is at most `|G|^{log₂|G|+1}`.** Each subgroup `H`
has a generating finset of cardinality `≤ L := log₂|G|` (`exists_closure_finset_card_le_log`), and
`H = ⟨that finset⟩` recovers `H` from it, so `H ↦ (a generating finset)` injects `Subgroup G` into
the finsets of `G` of cardinality `≤ L`. The number of those is
`∑_{k≤L} \binom{|G|}{k} ≤ (L+1)·|G|^L ≤ |G|^{L+1}` (using `\binom{n}{k} ≤ n^k ≤ n^L` and
`L + 1 = log₂|G| + 1 ≤ |G|`):

`Nat.card (Subgroup G) ≤ |G| ^ (log₂|G| + 1)`.

This is the candidate-count factor of the Ettinger–Høyer–Knill tail estimate for N&C's
Problem 5.5 (see the module docstring). -/
theorem card_subgroup_le [Finite G] :
    Nat.card (Subgroup G) ≤ Nat.card G ^ (Nat.log 2 (Nat.card G) + 1) := by
  classical
  have : Fintype G := Fintype.ofFinite G
  set L := Nat.log 2 (Nat.card G) with hL
  have hn : 0 < Nat.card G := Nat.card_pos
  -- Choose a small generating finset for each subgroup; the closure recovers it, hence injective.
  choose gen hgen_cl hgen_card using
    (fun H : Subgroup G => exists_closure_finset_card_le_log H)
  have hinj : Function.Injective gen := by
    intro H₁ H₂ h; rw [← hgen_cl H₁, ← hgen_cl H₂, h]
  -- Inject `Subgroup G` into the small finsets and count via the shared bridge.
  refine card_le_pow_of_injective_finset ?_ hinj hgen_card
  -- `L + 1 = log₂|G| + 1 ≤ |G|`.
  have := Nat.log_lt_self 2 (show Nat.card G ≠ 0 by omega); omega

end AxQM.Concrete
