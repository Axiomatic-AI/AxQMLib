import AxQM.Postulates.API.ControlledZ
import AxQM.Postulates.API.ControlledRotation
import AxQM.Postulates.API.HadamardRotation
import AxQM.Postulates.API.AxisAngleGateValues
import AxQM.Concrete.SingleQubitRotationUniversality

/-!
# The reachable single-qubit rotations are `H, S, CNOT, Toffoli` gates (single-qubit bridge)

*(Nielsen & Chuang, Exercise 4.43 — the four-gate universality bridge, single-qubit stage.)*

The matrix-level universality theorem
`Concrete.exists_phase_smul_mem_closure_reachableCircuits` proves that the *abstract* reachable
gate set is dense in `U(d)` up to a global phase, but it never names the four physical gates. This
file discharges the **single-qubit half** of the bridge that ties the abstract generators to the
grounded `H, S, CNOT, Toffoli` gates: it exhibits the single-qubit reachable rotations — the
submonoid `Concrete.reachableRotations θ` whose members appear (via `singleQubitOnWire`) among the
`reachableGateSet` generators — as gates built from `H, S, CNOT, Toffoli` (with measurement).

## What the four gates realise, at the single qubit

`reachableRotations θ` is generated by the four `2 × 2` matrices `R_z(±θ), R_x(±θ)`. Each is the
operator of a named-gate circuit:

* **`R_z(θ)` with `cos θ = 3/5`** is realised by the Exercise 4.41 measurement circuit
  `rzThreeFifthsCircuit` — the `(H⊗H)·T·(1⊗1⊗S)·T·(H⊗H)` gadget built from `H, S, CNOT, Toffoli`
  — on its measurement-success branch (`rzThreeFifthsCircuit_success_eq_rotZ`). The measurement is
  essential: the pure unitary Clifford+Toffoli group is discrete, so `R_z(θ)` (an irrational
  rotation, Exercise 4.42) is *only* reachable with the aid of the measurement gadget.
* **`R_x(θ) = H · R_z(θ) · H`** by Hadamard conjugation
  (`hadamardGate_comp_rotZGate_comp_hadamardGate`).
* **`R_z(-θ) = X · R_z(θ) · X`** (`pauliXGate_comp_rotZGate_comp_pauliXGate`), with the `NOT` gate
  `X = H · S² · H` itself realised by `{H, S}` (`pauliXGate_eq_hadamardGate_sGateSq`, from `S² = Z`
  and `H · Z · H = X`).
* **`R_x(-θ) = H · R_z(-θ) · H`** by Hadamard conjugation again.

So every reachable rotation is a finite composition of `H, S` gates around the measurement-realised
`R_z(θ)` — the single-qubit operations reachable from `{H, S, CNOT, Toffoli}` with measurement.

## The gate-level submonoid and the matrix bridge

`reachableRotationGates θ` is the `Evolution`-gate counterpart of `reachableRotations θ`: the
submonoid of `Evolution qubit` generated by the four gates `R_z(±θ), R_x(±θ)`. The bridge
`exists_reachableRotationGate_op_eq` shows each reachable-rotation *matrix* is the operator of a
reachable-rotation *gate*, transporting the matrix submonoid onto the gate submonoid through the
`⋆`-algebra isomorphism `Matrix.toEuclideanCLM` (each generator matches by definition;
`Evolution.op` and `toEuclideanCLM` are both multiplicative). This is the object the register lift
(`AxQM/Postulates/API/FourGateReachableWire.lean`) promotes onto a chosen wire.
-/

namespace AxQM

open Matrix

/-- **`S² = Z` at the gate level:** composing the phase gate `S = diag(1, i)` with itself gives the
Pauli-`Z` gate. The gate-level image of `Concrete.sMatrix_mul_self_eq_pauliZ` through
`Matrix.toEuclideanCLM` (`map_mul`); `S²` is the phase flip. -/
theorem sGate_comp_sGate : sGate.comp sGate = pauliZGate := by
  apply Evolution.ext
  change (Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin 2) Concrete.sMatrix).comp
      (Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin 2) Concrete.sMatrix)
    = Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin 2) Concrete.pauliZ
  rw [← ContinuousLinearMap.mul_def, ← map_mul, Concrete.sMatrix_mul_self_eq_pauliZ]

/-- **The `NOT` gate is a `{H, S}` circuit:** `X = H · S² · H`. Composing `S² = Z`
(`sGate_comp_sGate`) with `H · Z · H = X` (`hadamardGate_comp_pauliZGate_comp_hadamardGate`), this
exhibits the Pauli-`X` (`NOT`) gate — not itself one of `{H, S, CNOT, Toffoli}` — as built from the
phase gate `S` and Hadamard gate `H`. -/
theorem pauliXGate_eq_hadamardGate_sGateSq :
    pauliXGate = hadamardGate.comp ((sGate.comp sGate).comp hadamardGate) := by
  rw [sGate_comp_sGate, hadamardGate_comp_pauliZGate_comp_hadamardGate]

/-- **`R_z(-θ)` is a `{H, S}` conjugate of `R_z(θ)`:** `R_z(-θ) = (H·S²·H) · R_z(θ) · (H·S²·H)`.
Conjugating a `z`-rotation by the `NOT` gate negates its angle
(`pauliXGate_comp_rotZGate_comp_pauliXGate`), and the `NOT` gate is the `{H, S}` circuit `H·S²·H`
(`pauliXGate_eq_hadamardGate_sGateSq`), so `R_z(-θ)` is reachable
from `{H, S}` together with `R_z(θ)`. -/
theorem rotZGate_neg_eq_hadamardGate_sGate_conj (θ : ℝ) :
    rotZGate (-θ) =
      (hadamardGate.comp ((sGate.comp sGate).comp hadamardGate)).comp
        ((rotZGate θ).comp (hadamardGate.comp ((sGate.comp sGate).comp hadamardGate))) := by
  rw [← pauliXGate_eq_hadamardGate_sGateSq,
    pauliXGate_comp_rotZGate_comp_pauliXGate]

/-- **The reachable single-qubit rotation gates.** The submonoid of `Evolution qubit` generated by
the four gates `R_z(±θ), R_x(±θ)` — the `Evolution`-level counterpart of the matrix submonoid
`Concrete.reachableRotations θ`. With `cos θ = 3/5` these are exactly the single-qubit operations
reachable from `{H, S, CNOT, Toffoli}` with measurement: `R_z(θ)` via the Exercise 4.41 circuit
`rzThreeFifthsCircuit`, and the remaining three by `{H, S}` conjugation (`sGate_comp_sGate`,
`pauliXGate_eq_hadamardGate_sGateSq`,
`hadamardGate_comp_rotZGate_comp_hadamardGate`, `rotZGate_neg_eq_hadamardGate_sGate_conj`). -/
noncomputable def reachableRotationGates (θ : ℝ) : Submonoid (Evolution qubit) :=
  Submonoid.closure {rotZGate θ, rotZGate (-θ), rotXGate θ, rotXGate (-θ)}

/-- **Matrix-to-gate bridge for the reachable rotations.** Every matrix `g` in the reachable
rotation submonoid `Concrete.reachableRotations θ` is the operator of some reachable rotation gate
`E ∈ reachableRotationGates θ`: `E.op = Matrix.toEuclideanCLM g`. Proved by induction on the
submonoid closure — each of the four generator matrices `R_z(±θ), R_x(±θ)` is the operator of the
corresponding gate (`rotZGate_op` / `rotXGate_op`), the unit maps to the identity gate, and products
are carried by the multiplicativity of both `Evolution.op` (`Evolution.comp_op`) and
`Matrix.toEuclideanCLM`. This transports the density statement over `reachableRotations` onto the
grounded `H, S, CNOT, Toffoli` gate set at the single qubit. -/
theorem exists_reachableRotationGate_op_eq {θ : ℝ} {g : Matrix (Fin 2) (Fin 2) ℂ}
    (hg : g ∈ Concrete.reachableRotations θ) :
    ∃ E ∈ reachableRotationGates θ, E.op = Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin 2) g := by
  induction hg using Submonoid.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl | rfl | rfl
    · exact ⟨rotZGate θ, Submonoid.subset_closure (by simp), rotZGate_op θ⟩
    · exact ⟨rotZGate (-θ), Submonoid.subset_closure (by simp), rotZGate_op (-θ)⟩
    · exact ⟨rotXGate θ, Submonoid.subset_closure (by simp), rotXGate_op θ⟩
    · exact ⟨rotXGate (-θ), Submonoid.subset_closure (by simp), rotXGate_op (-θ)⟩
  | one =>
    refine ⟨1, one_mem _, ?_⟩
    rw [Evolution.one_def, Evolution.id_op]
    exact (map_one Matrix.toEuclideanCLM).symm
  | mul x y _ _ ihx ihy =>
    obtain ⟨Ex, hEx, hExop⟩ := ihx
    obtain ⟨Ey, hEy, hEyop⟩ := ihy
    refine ⟨Ex * Ey, mul_mem hEx hEy, ?_⟩
    rw [Evolution.mul_def, Evolution.comp_op, hExop, hEyop]
    exact (map_mul Matrix.toEuclideanCLM x y).symm

end AxQM
