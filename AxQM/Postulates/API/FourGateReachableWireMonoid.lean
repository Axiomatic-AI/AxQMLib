import AxQM.Postulates.API.FourGateReachableWire
import AxQM.Postulates.API.QuditGate
import AxQM.Concrete.SingleQubitRotationUniversality

/-!
# The reachable single-qubit rotation matrices on a wire ARE the register wire submonoid
(N&C Exercise 4.43, four-gate bridge — matrix→submonoid connection)

The four-gate universality bridge (Exercise 4.43) must exhibit the *abstract* reachable gate set of
`Concrete.exists_phase_smul_mem_closure_reachableCircuits` as circuits of the grounded
`H, S, CNOT, Toffoli` gates. Its rotation half is the reachable single-qubit rotations placed
on a wire: the **matrices** `Concrete.singleQubitOnWire finFunctionFinEquiv t g` for every `g` in
the matrix submonoid `Concrete.reachableRotations θ` (the shape
`⋃ j, singleQubitOnWire enc j '' reachableRotations θ` in which the rotations enter the abstract
`reachableGateSet`). The whole submonoid `reachableRotationWireEvolutions n t θ` of register wire
gates lifts, via `quditPowTower`, to grounded reachable-rotation gates on the tower wire
(`AxQM/Core/FourGateReachableWireSubmonoid.lean`,
`exists_reachableRotationGate_congr_quditPowTower_eq`). This file supplies the **connection** that
feeds that lift: it identifies the `quditGate` promotion of the reachable rotation *matrix* on a
wire with a member of the register wire submonoid.

## What is formalised

* `reachableRotationWireEvolutions n t θ` — the **register-level reachable-rotation wire
  submonoid**: the submonoid of `Evolution (qudit (2ⁿ⁺¹))` generated by the four wire gates
  `rotZWireEvolution (n+1) t (±θ)`, `rotXWireEvolution (n+1) t (±θ)` — the register-gate counterpart
  of `Concrete.reachableRotations θ` placed on wire `t`.
* `exists_reachableRotationWireEvolution_op_eq` — **the matrix→submonoid bridge (operator form)**:
  every matrix `g ∈ Concrete.reachableRotations θ`, placed on wire `t` as
  `singleQubitOnWire finFunctionFinEquiv t g`, is the operator of some member `F` of
  `reachableRotationWireEvolutions n t θ`. Proved by `Submonoid.closure_induction`: each of the four
  generator matrices `R_z(±θ), R_x(±θ)` on wire `t` is the operator of the corresponding named wire
  gate `rotZWireEvolution`/`rotXWireEvolution (n+1) t (±θ)` (by `quditGate_op`), and the `1` /
  product cases are the multiplicativity of `Evolution.op` (`Evolution.comp_op`) and of
  `singleQubitOnWire` on its `2 × 2` block (`singleQubitOnWire_one` / `singleQubitOnWire_mul`),
  carried by `map_one` / `map_mul` of the `⋆`-algebra isomorphism `Matrix.toEuclideanCLM`. The exact
  wire-level analogue of the single-qubit `exists_reachableRotationGate_op_eq`.
* `quditGate_singleQubitOnWire_mem_reachableRotationWireEvolutions` — **the directly usable form**:
  for `g ∈ Concrete.reachableRotations θ` and any unitarity witness `hU`,
  `quditGate hU ∈ reachableRotationWireEvolutions n t θ`. Since `quditGate hU` is determined by its
  operator alone, it equals the member `F` above (`Evolution.ext`), so it too lies in the submonoid.
  This is the object the eventual density transport promotes: the `Evolution` a reachable-rotation
  wire matrix generates is a genuine grounded circuit (composed, via the register lift, of the
  `{H, S}`-conjugated Exercise 4.41 gadget on a tower wire).
-/

open Matrix

namespace AxQM

noncomputable section

open AxQM.Concrete

/-- **The register-level reachable-rotation wire submonoid.** The submonoid of
`Evolution (qudit (2ⁿ⁺¹))` generated by the four reachable rotation wire gates
`rotZWireEvolution (n+1) t (±θ)`, `rotXWireEvolution (n+1) t (±θ)` — the register-gate counterpart
of `Concrete.reachableRotations θ` placed on wire `t`. Its members are exactly the register wire
gates whose transport onto the control tower is a grounded reachable rotation gate on the tower wire
`t.rev` (`exists_reachableRotationGate_congr_quditPowTower_eq`), and exactly the `quditGate`
promotions of the reachable rotation matrices on wire `t`
(`quditGate_singleQubitOnWire_mem_reachableRotationWireEvolutions`). -/
noncomputable def reachableRotationWireEvolutions (n : ℕ) (t : Fin (n + 1)) (θ : ℝ) :
    Submonoid (Evolution (qudit (2 ^ (n + 1)))) :=
  Submonoid.closure {rotZWireEvolution (n + 1) t θ, rotZWireEvolution (n + 1) t (-θ),
    rotXWireEvolution (n + 1) t θ, rotXWireEvolution (n + 1) t (-θ)}

/-- **The reachable rotation matrices on a wire are operators of the register wire submonoid.**
For every matrix `g ∈ Concrete.reachableRotations θ`, its wire-`t` placement
`singleQubitOnWire finFunctionFinEquiv t g` is the operator of some member `F` of the register wire
submonoid `reachableRotationWireEvolutions n t θ`:

  `F.op = Matrix.toEuclideanCLM (singleQubitOnWire finFunctionFinEquiv t g)`.

Proved by `Submonoid.closure_induction`: each generator matrix `R_z(±θ), R_x(±θ)` on wire `t` is the
operator of the named wire gate `rotZWireEvolution`/`rotXWireEvolution (n+1) t (±θ)` (a generator of
the submonoid, `quditGate_op`); the unit maps to `1`; products are carried by the multiplicativity
of both `Evolution.op` (`Evolution.comp_op`) and `singleQubitOnWire` on its block
(`singleQubitOnWire_mul`), transported through `map_mul` of `Matrix.toEuclideanCLM`. The wire-level
analogue of the single-qubit matrix→gate bridge `exists_reachableRotationGate_op_eq`. -/
theorem exists_reachableRotationWireEvolution_op_eq {n : ℕ} {t : Fin (n + 1)} {θ : ℝ}
    {g : Matrix (Fin 2) (Fin 2) ℂ} (hg : g ∈ Concrete.reachableRotations θ) :
    ∃ F ∈ reachableRotationWireEvolutions n t θ,
      F.op = Matrix.toEuclideanCLM (𝕜 := ℂ) (n := Fin (2 ^ (n + 1)))
        (singleQubitOnWire finFunctionFinEquiv t g) := by
  induction hg using Submonoid.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl | rfl | rfl
    · exact ⟨rotZWireEvolution (n + 1) t θ, Submonoid.subset_closure (by simp), rfl⟩
    · exact ⟨rotZWireEvolution (n + 1) t (-θ), Submonoid.subset_closure (by simp), rfl⟩
    · exact ⟨rotXWireEvolution (n + 1) t θ, Submonoid.subset_closure (by simp), rfl⟩
    · exact ⟨rotXWireEvolution (n + 1) t (-θ), Submonoid.subset_closure (by simp), rfl⟩
  | one =>
    refine ⟨1, one_mem _, ?_⟩
    rw [Evolution.one_def, Evolution.id_op, singleQubitOnWire_one]
    exact (map_one Matrix.toEuclideanCLM).symm
  | mul x y _ _ ihx ihy =>
    obtain ⟨Fx, hFx, hFxop⟩ := ihx
    obtain ⟨Fy, hFy, hFyop⟩ := ihy
    refine ⟨Fx * Fy, mul_mem hFx hFy, ?_⟩
    erw [Evolution.mul_def, Evolution.comp_op, hFxop, hFyop, ← ContinuousLinearMap.mul_def,
      ← singleQubitOnWire_mul]
    exact (map_mul Matrix.toEuclideanCLM _ _).symm

/-- **A reachable rotation matrix on a wire promotes into the register wire submonoid.** For
`g ∈ Concrete.reachableRotations θ` and any witness `hU` that its wire-`t` placement
`singleQubitOnWire finFunctionFinEquiv t g` is unitary, the promoted gate
`quditGate hU ∈ reachableRotationWireEvolutions n t θ`. Since `quditGate hU` is determined by its
operator (`Evolution.ext` + `quditGate_op`), it equals the member `F` supplied by the operator-form
bridge `exists_reachableRotationWireEvolution_op_eq`, hence lies in the submonoid. This is the
feed for the whole-submonoid register lift
`exists_reachableRotationGate_congr_quditPowTower_eq`: the `Evolution` a reachable-rotation wire
matrix generates is a grounded reachable-rotation gate (a `{H, S}`-circuit around the Exercise 4.41
measurement gadget `rzThreeFifthsCircuit`) on the corresponding tower wire. -/
theorem quditGate_singleQubitOnWire_mem_reachableRotationWireEvolutions {n : ℕ} {t : Fin (n + 1)}
    {θ : ℝ} {g : Matrix (Fin 2) (Fin 2) ℂ} (hg : g ∈ Concrete.reachableRotations θ)
    (hU : singleQubitOnWire finFunctionFinEquiv t g ∈ Matrix.unitaryGroup (Fin (2 ^ (n + 1))) ℂ) :
    quditGate hU ∈ reachableRotationWireEvolutions n t θ := by
  obtain ⟨F, hF, hFop⟩ := exists_reachableRotationWireEvolution_op_eq (t := t) hg
  have hEq : quditGate hU = F := by
    apply Evolution.ext
    rw [quditGate_op, hFop]
  rwa [hEq]

end

end AxQM
