import AxQM.Postulates.API.Evolution
import ToMathlib.Analysis.Normed.Algebra.ExponentialInvolution

/-!
# AxQM.Postulates.API — Heisenberg conjugation under an involution-generated propagator

Formulas for the **Heisenberg-evolved operator** `U(t)† A U(t)` when
the propagator `U(t) = exp(-iHt)` is generated by a Hamiltonian whose operator is a scalar times an
**involution**: `H.op = c • G` with `G² = 1` (and `G` self-adjoint). This is the algebraic engine
behind the NMR free-induction-decay computations of Nielsen & Chuang §7.7 (Exercise 7.37): the
coupling Hamiltonian `H = J Z₁Z₂` has `H.op = J • (Z ⊗ Z)`, with `Z ⊗ Z` an involution, and the
readout operators `X₁, Y₁, Z₂` either commute or anticommute with it.

Writing `U(t).op = cos(ct) • 1 - i sin(ct) • G` (Nielsen & Chuang Exercise 4.2 / eq. 4.7, via
`NormedSpace.exp_smul_mul_I_of_mul_self_eq_one`) and its adjoint `cos(ct) • 1 + i sin(ct) • G`:

* `Observable.propagator_op_of_op_eq_smul_involution` — `U(t).op = cos(ct) • 1 - (sin(ct) i) • G`.
* `Observable.adjoint_propagator_op_of_op_eq_smul_involution` — the adjoint,
  `cos(ct) • 1 + (sin(ct) i) • G`.
* `Observable.propagator_conj_op_commute` — if `A` **commutes** with `G` then it is fixed by the
  Heisenberg evolution: `U(t)† A U(t) = A`.
* `Observable.propagator_conj_op_anticomm` — if `A` **anticommutes** with `G` then
  `U(t)† A U(t) = cos(2ct) • A - (sin(2ct) i) • (A G)`, the frequency-doubled rotation of `A` into
  `A G` characteristic of J-coupled evolution.

## Design

* **Proof.** No matrix arithmetic and no `cos`/`sin` *values*. `U(t).op` and its adjoint are put in
  the `cos • 1 ± i sin • G` normal form once; then the conjugation is a short operator-algebra
  computation via the span-of-`{1, G}` product law
  `NormedSpace.smul_one_add_smul_mul_of_mul_self_eq_one`. For the anticommuting case the key step is
  `A · U(t).op = U(t).op† · A` (`A` slides through the involution-function `U`, flipping the sign of
  the `G`-part), whence `U(t)† A U(t) = (U(t)†)² A` and `(U(t)†)²` is the double-angle exponential
  `cos(2ct) • 1 + (sin(2ct) i) • G`. The double-angle identities are `Real.cos_two_mul` /
  `Real.sin_two_mul`, and `Complex.I_mul_I` turns `(sin(ct) i)²` into `-sin²(ct)`.
-/

noncomputable section

namespace AxQM

variable {S : QSystem}

/-- The propagator `U(t) = exp(-iHt)` of a Hamiltonian with `H.op = c • G` for an involution
`G` (`G² = 1`) has operator `U(t).op = cos(ct) • 1 - (sin(ct) i) • G` — Nielsen & Chuang eq. (4.7)
applied to `G` at angle `-(ct)`. -/
theorem Observable.propagator_op_of_op_eq_smul_involution (H : Observable S) {c : ℝ}
    {G : S.space →L[ℂ] S.space} (hop : H.op = (c : ℂ) • G) (hG : G * G = 1) (t : ℝ) :
    (H.propagator 1 0 t).op
      = (Real.cos (c * t) : ℂ) • (1 : S.space →L[ℂ] S.space)
        - ((Real.sin (c * t) : ℂ) * Complex.I) • G := by
  rw [Observable.propagator_op, hop, smul_smul,
    show (-Complex.I * ↑(t - 0) / ↑(1 : ℝ)) * (c : ℂ) = ((-(c * t) : ℝ) : ℂ) * Complex.I by
      push_cast; ring,
    NormedSpace.exp_smul_mul_I_of_mul_self_eq_one hG (-(c * t)), Real.cos_neg, Real.sin_neg]
  push_cast
  module

/-- The adjoint of the propagator operator of `H.op = c • G` (`G` a self-adjoint involution):
`U(t).op† = cos(ct) • 1 + (sin(ct) i) • G`, the complex conjugate of the `cos • 1 - i sin • G`
normal form. -/
theorem Observable.adjoint_propagator_op_of_op_eq_smul_involution (H : Observable S) {c : ℝ}
    {G : S.space →L[ℂ] S.space} (hop : H.op = (c : ℂ) • G) (hG : G * G = 1) (hGsa : IsSelfAdjoint G)
    (t : ℝ) :
    ContinuousLinearMap.adjoint (H.propagator 1 0 t).op
      = (Real.cos (c * t) : ℂ) • (1 : S.space →L[ℂ] S.space)
        + ((Real.sin (c * t) : ℂ) * Complex.I) • G := by
  have h1 : star ((Real.cos (c * t) : ℂ)) = (Real.cos (c * t) : ℂ) := Complex.conj_ofReal _
  have h2 : star ((Real.sin (c * t) : ℂ) * Complex.I) = -((Real.sin (c * t) : ℂ) * Complex.I) := by
    rw [star_mul, show star Complex.I = -Complex.I from Complex.conj_I,
      show star ((Real.sin (c * t) : ℂ)) = (Real.sin (c * t) : ℂ) from Complex.conj_ofReal _]
    ring
  rw [← ContinuousLinearMap.star_eq_adjoint,
    H.propagator_op_of_op_eq_smul_involution hop hG t, star_sub, star_smul, star_smul, star_one,
    hGsa.star_eq, h1, h2]
  module

/-- **Heisenberg conjugation, commuting case.** If the observable/operator `A` commutes with the
involution `G` generating `H` (`H.op = c • G`, `G² = 1`), then `A` is invariant under the Heisenberg
evolution generated by `H`: `U(t)† A U(t) = A`, because `A` commutes with the propagator (a function
of `G`) and `U(t)† U(t) = 1`. -/
theorem Observable.propagator_conj_op_commute (H : Observable S) {c : ℝ}
    {G A : S.space →L[ℂ] S.space} (hop : H.op = (c : ℂ) • G) (hG : G * G = 1)
    (hcomm : A * G = G * A) (t : ℝ) :
    ContinuousLinearMap.adjoint (H.propagator 1 0 t).op * A * (H.propagator 1 0 t).op = A := by
  have hQ := H.propagator_op_of_op_eq_smul_involution hop hG t
  -- `A · U = U · A`: A commutes with the involution-function U.
  have hAU : A * (H.propagator 1 0 t).op = (H.propagator 1 0 t).op * A := by
    rw [hQ]
    simp only [mul_sub, sub_mul, mul_smul_comm, smul_mul_assoc, mul_one, one_mul, hcomm]
  -- `U† · U = 1`: the propagator is unitary (`Observable.propagator_op_mem_unitary`), so the
  -- adjoint (= `star`) is a left inverse.
  have hPQ : ContinuousLinearMap.adjoint (H.propagator 1 0 t).op * (H.propagator 1 0 t).op = 1 := by
    have hu := H.propagator_op_mem_unitary 1 0 t
    rw [← H.propagator_op 1 0 t] at hu
    rw [← ContinuousLinearMap.star_eq_adjoint]
    exact (Unitary.mem_iff.mp hu).1
  rw [mul_assoc, hAU, ← mul_assoc, hPQ, one_mul]

/-- **Heisenberg conjugation, anticommuting case.** If the observable/operator `A` anticommutes
with the involution `G` generating `H` (`H.op = c • G`, `G² = 1`), then the Heisenberg evolution
generated by `H` rotates `A` into `A G` at twice the coupling frequency:
`U(t)† A U(t) = cos(2ct) • A - (sin(2ct) i) • (A G)`. This is the operator identity behind J-coupled
NMR precession: `X₁` under `H = J Z₁Z₂` (so `A·G = X₁·Z₁Z₂ = (X Z)⊗Z = -i·Y₁Z₂`) Heisenberg-evolves
to `cos(2Jt) X₁ - sin(2Jt) Y₁Z₂`. -/
theorem Observable.propagator_conj_op_anticomm (H : Observable S) {c : ℝ}
    {G A : S.space →L[ℂ] S.space} (hop : H.op = (c : ℂ) • G) (hG : G * G = 1)
    (hGsa : IsSelfAdjoint G) (hanti : A * G = -(G * A)) (t : ℝ) :
    ContinuousLinearMap.adjoint (H.propagator 1 0 t).op * A * (H.propagator 1 0 t).op
      = (Real.cos (2 * c * t) : ℂ) • A - ((Real.sin (2 * c * t) : ℂ) * Complex.I) • (A * G) := by
  have hQ := H.propagator_op_of_op_eq_smul_involution hop hG t
  have hP := H.adjoint_propagator_op_of_op_eq_smul_involution hop hG hGsa t
  have hGA : G * A = -(A * G) := by rw [hanti, neg_neg]
  -- `A · U = U† · A`: A slides through the involution-function U, flipping the sign of the G-part.
  have hAU : A * (H.propagator 1 0 t).op
      = ContinuousLinearMap.adjoint (H.propagator 1 0 t).op * A := by
    rw [hP, hQ]
    simp only [mul_sub, add_mul, mul_smul_comm, smul_mul_assoc, mul_one, one_mul, hGA, smul_neg]
    module
  -- `(U†)² = cos(2ct) • 1 + (sin(2ct) i) • G` — the double-angle exponential.
  have hc2 : (Real.cos (c * t) : ℂ) * (Real.cos (c * t) : ℂ)
      + ((Real.sin (c * t) : ℂ) * Complex.I) * ((Real.sin (c * t) : ℂ) * Complex.I)
      = (Real.cos (2 * c * t) : ℂ) := by
    have hR : Real.cos (2 * c * t) = Real.cos (c * t) ^ 2 - Real.sin (c * t) ^ 2 := by
      rw [show 2 * c * t = 2 * (c * t) by ring, Real.cos_two_mul]
      nlinarith [Real.sin_sq_add_cos_sq (c * t)]
    rw [show ((Real.sin (c * t) : ℂ) * Complex.I) * ((Real.sin (c * t) : ℂ) * Complex.I)
      = (Real.sin (c * t) : ℂ) ^ 2 * (Complex.I * Complex.I) by ring, Complex.I_mul_I, hR]
    push_cast; ring
  have hs2 : (Real.cos (c * t) : ℂ) * ((Real.sin (c * t) : ℂ) * Complex.I)
      + ((Real.sin (c * t) : ℂ) * Complex.I) * (Real.cos (c * t) : ℂ)
      = (Real.sin (2 * c * t) : ℂ) * Complex.I := by
    have hR : Real.sin (2 * c * t) = 2 * Real.sin (c * t) * Real.cos (c * t) := by
      rw [show 2 * c * t = 2 * (c * t) by ring, Real.sin_two_mul]
    rw [hR]; push_cast; ring
  have hPsq : ContinuousLinearMap.adjoint (H.propagator 1 0 t).op
        * ContinuousLinearMap.adjoint (H.propagator 1 0 t).op
      = (Real.cos (2 * c * t) : ℂ) • (1 : S.space →L[ℂ] S.space)
        + ((Real.sin (2 * c * t) : ℂ) * Complex.I) • G := by
    rw [hP, NormedSpace.smul_one_add_smul_mul_of_mul_self_eq_one hG (Real.cos (c * t) : ℂ)
      ((Real.sin (c * t) : ℂ) * Complex.I) (Real.cos (c * t) : ℂ)
      ((Real.sin (c * t) : ℂ) * Complex.I), hc2, hs2]
  rw [mul_assoc, hAU, ← mul_assoc, hPsq, add_mul, smul_mul_assoc, smul_mul_assoc, one_mul, hGA,
    smul_neg, ← sub_eq_add_neg]

end AxQM
