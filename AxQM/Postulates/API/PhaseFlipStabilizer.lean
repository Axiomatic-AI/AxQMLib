import AxQM.Postulates.API.PhaseFlipCode
import AxQM.Postulates.API.ShorPhaseSyndrome

/-!
# AxQM.Postulates.API — the stabilizer generators of the three-qubit phase-flip code

Infrastructure for Nielsen & Chuang **Exercise 10.46**: the stabilizer of the
three-qubit *phase-flip* code (logical codewords `|0_L⟩ = |+++⟩`, `|1_L⟩ = |−−−⟩`, developed in
`PhaseFlipCode.lean`) is generated by `X₁X₂` and `X₂X₃`. This file builds those
two generators as **observables** on the three-qubit register, together with their product `X₁X₃`
(the third nontrivial stabilizer element), and shows they are involutions that stabilize the code;
the `Observable.HasEigenstate` statements — that the generators and their product fix both
codewords — are in `AxQM/NC/Ch10/Exercise10_46.lean`. `PhaseFlipStabilizerMaximality.lean`
develops the group law `X₁X₂ · X₂X₃ = X₁X₃`, commutativity, and the **maximality** direction (the
code space is exactly the joint `+1`-eigenspace of the two generators, so they generate the *full*
order-`4` stabilizer).

The phase-flip code is the Hadamard conjugate of the bit-flip code: in the `{|+⟩, |−⟩}` basis it is
the bit-flip code with `X` (which reads the `±` sign, `X|+⟩ = |+⟩`, `X|−⟩ = −|−⟩`) playing the role
of `Z`. So the generators here are the `X`-analogues of the bit-flip syndrome observables
`zzIObservable = Z₁Z₂`, `izzObservable = Z₂Z₃` (`BitFlipSyndromeMeasurement.lean`).

## Contents

* `pauliXObservable_op_pmQubit` — `X` reads the `±` sign: `X|σ⟩ = (−1)^σ |σ⟩`.
* `xxIObservable = X ⊗ X ⊗ I` (`X₁X₂`), `ixxObservable = I ⊗ X ⊗ X` (`X₂X₃`), and their product
  `xixObservable = X ⊗ I ⊗ X` (`X₁X₃`) as observables on `bitFlipReg`.
* `xxIObservable_op_pmThreeVec` / `ixxObservable_op_pmThreeVec` / `xixObservable_op_pmThreeVec` —
  each of the three nontrivial stabilizer elements acts on the `±`-basis vector `|σ₁σ₂σ₃⟩` by the
  sign `(−1)^{σᵢ+σⱼ}` (the syndrome it reads); on a codeword `|σσσ⟩` the sign is `+1`.
* `xxIObservable_op_mul_self` / `ixxObservable_op_mul_self` / `xixObservable_op_mul_self` — each is
  a self-adjoint **involution** (`(X₁X₂)² = I`).
* `pmQubitState` / `phaseFlipCodewordState` — the `±` frame and the logical codewords `|+++⟩`,
  `|−−−⟩` as `PureState`s, with `phaseFlipCodewordState_vec` identifying them with the QEC
  codeword vectors `phaseFlipCodeword`.
-/

open scoped InnerProductSpace TensorProduct
open ContinuousLinearMap

noncomputable section

namespace AxQM

/-! ### `X` reads the `±` sign -/

/-- **The Pauli-`X` observable reads the `±` sign:** `X|σ⟩ = (−1)^σ |σ⟩` (`X|+⟩ = |+⟩`,
`X|−⟩ = −|−⟩`). This is the exact analogue, in the `±` basis, of `Z` reading the computational sign
`Z|i⟩ = (−1)^i |i⟩`; it is what makes the phase-flip stabilizer generators diagonal in the `±`
basis. -/
theorem pauliXObservable_op_pmQubit (s : Fin 2) :
    pauliXObservable.op (pmQubit s) = ((-1 : ℂ) ^ (s : ℕ)) • pmQubit s := by
  fin_cases s
  · change pauliXObservable.op qubitPlus.vec = ((-1 : ℂ) ^ (0 : ℕ)) • qubitPlus.vec
    rw [qubitPlus_vec, pauliXObservable_apply_xPlus]
    norm_num
    exact (one_smul ℂ _).symm
  · change pauliXObservable.op qubitMinus.vec = ((-1 : ℂ) ^ (1 : ℕ)) • qubitMinus.vec
    rw [qubitMinus_vec, pauliXObservable_apply_xMinus, pow_one, Complex.ofReal_neg,
      Complex.ofReal_one]; rfl

/-! ### The two stabilizer generators `X₁X₂`, `X₂X₃` -/

/-- **`X₁X₂ = X ⊗ X ⊗ I`**, the first phase-flip stabilizer generator: the `X`-analogue of the
bit-flip syndrome observable `zzIObservable = Z₁Z₂`. -/
def xxIObservable : Observable bitFlipReg :=
  pauliXObservable.tmul (pauliXObservable.tmul (Observable.id qubit))

/-- **`X₂X₃ = I ⊗ X ⊗ X`**, the second phase-flip stabilizer generator (the `X`-analogue of
`izzObservable = Z₂Z₃`). -/
def ixxObservable : Observable bitFlipReg :=
  (Observable.id qubit).tmul (pauliXObservable.tmul pauliXObservable)

/-- **`X₁X₃ = X ⊗ I ⊗ X`**, the product `X₁X₂ · X₂X₃` of the two generators — the third nontrivial
element of the stabilizer group `⟨X₁X₂, X₂X₃⟩ = {I, X₁X₂, X₂X₃, X₁X₃}`. Because the group is
generated by the two commuting involutions `X₁X₂`, `X₂X₃`, this Klein-four group has exactly these
four elements, and `X₁X₃` is the only one not among the identity and the two generators (the
`X`-analogue of the bit-flip `Z₁Z₃`). The group law `X₁X₂ · X₂X₃ = X₁X₃` is
`xxIObservable_op_mul_ixxObservable`. -/
def xixObservable : Observable bitFlipReg :=
  pauliXObservable.tmul ((Observable.id qubit).tmul pauliXObservable)

/-! ### Their action on the `±` basis -/

/-- **`X₁X₂` reads the parity of qubits `1, 2`:** `X₁X₂ |σ₁σ₂σ₃⟩ = (−1)^{σ₁+σ₂} |σ₁σ₂σ₃⟩`. On a
codeword `|σσσ⟩` this sign is `(−1)^{2σ} = +1`, so `X₁X₂` stabilizes the code. -/
theorem xxIObservable_op_pmThreeVec (s : Fin 2 × Fin 2 × Fin 2) :
    xxIObservable.op (pmThreeVec s)
      = ((-1 : ℂ) ^ ((s.1 : ℕ) + (s.2.1 : ℕ))) • pmThreeVec s := by
  obtain ⟨a, b, c⟩ := s
  simp only [xxIObservable, pmThreeVec]
  erw [Observable.tmul_op_tmul, Observable.tmul_op_tmul]
  simp only [Observable.id_op, one_apply_eq_self, pauliXObservable_op_pmQubit]
  rw [← TensorProduct.smul_tmul' _ (pmQubit b)]
  erw [TensorProduct.smul_tmul_smul]
  rw [← pow_add]; rfl

/-- **`X₂X₃` reads the parity of qubits `2, 3`:** `X₂X₃ |σ₁σ₂σ₃⟩ = (−1)^{σ₂+σ₃} |σ₁σ₂σ₃⟩`. On a
codeword `|σσσ⟩` this sign is `+1`, so `X₂X₃` stabilizes the code. -/
theorem ixxObservable_op_pmThreeVec (s : Fin 2 × Fin 2 × Fin 2) :
    ixxObservable.op (pmThreeVec s)
      = ((-1 : ℂ) ^ ((s.2.1 : ℕ) + (s.2.2 : ℕ))) • pmThreeVec s := by
  obtain ⟨a, b, c⟩ := s
  simp only [ixxObservable, pmThreeVec]
  erw [Observable.tmul_op_tmul, Observable.tmul_op_tmul]
  simp only [Observable.id_op, one_apply_eq_self, pauliXObservable_op_pmQubit]
  rw [TensorProduct.smul_tmul_smul]
  erw [TensorProduct.tmul_smul]
  rw [← pow_add]; rfl

/-- **`X₁X₃` reads the parity of qubits `1, 3`:** `X₁X₃ |σ₁σ₂σ₃⟩ = (−1)^{σ₁+σ₃} |σ₁σ₂σ₃⟩`. On a
codeword `|σσσ⟩` this sign is `(−1)^{2σ} = +1`, so the product generator `X₁X₃` stabilizes the code
too — witnessing `⟨X₁X₂, X₂X₃⟩ ⊆ S`. -/
theorem xixObservable_op_pmThreeVec (s : Fin 2 × Fin 2 × Fin 2) :
    xixObservable.op (pmThreeVec s)
      = ((-1 : ℂ) ^ ((s.1 : ℕ) + (s.2.2 : ℕ))) • pmThreeVec s := by
  obtain ⟨a, b, c⟩ := s
  simp only [xixObservable, pmThreeVec]
  erw [Observable.tmul_op_tmul, Observable.tmul_op_tmul, Observable.id_op,
    one_apply_eq_self, pauliXObservable_op_pmQubit, pauliXObservable_op_pmQubit,
    TensorProduct.tmul_smul]
  erw [TensorProduct.smul_tmul_smul]
  rw [← pow_add]; rfl

/-! ### Each generator is a self-adjoint involution -/

/-- **`X₁X₂` is a self-adjoint involution:** `(X₁X₂)² = I`, a tensor of the involutions `X² = I` and
`I² = I`. -/
theorem xxIObservable_op_mul_self : xxIObservable.op * xxIObservable.op = 1 :=
  Observable.tmul_op_mul_self pauliXObservable_op_mul_self
    (Observable.tmul_op_mul_self pauliXObservable_op_mul_self (by rw [Observable.id_op, one_mul]))

/-- **`X₂X₃` is a self-adjoint involution:** `(X₂X₃)² = I`. -/
theorem ixxObservable_op_mul_self : ixxObservable.op * ixxObservable.op = 1 :=
  Observable.tmul_op_mul_self (by rw [Observable.id_op, one_mul])
    (Observable.tmul_op_mul_self pauliXObservable_op_mul_self pauliXObservable_op_mul_self)

/-- **`X₁X₃` is a self-adjoint involution:** `(X₁X₃)² = I` — so every nontrivial element of the
stabilizer group `⟨X₁X₂, X₂X₃⟩` is an involution, and none of them is `-I` (each fixes a nonzero
codeword). -/
theorem xixObservable_op_mul_self : xixObservable.op * xixObservable.op = 1 :=
  Observable.tmul_op_mul_self pauliXObservable_op_mul_self
    (Observable.tmul_op_mul_self (by rw [Observable.id_op, one_mul]) pauliXObservable_op_mul_self)

/-! ### The logical codewords as pure states -/

/-- **The single-qubit `±` frame as pure states** `{|+⟩, |−⟩}` (`0 ↦ |+⟩`, `1 ↦ |−⟩`); the
`PureState` companion of the vector frame `pmQubit`. -/
def pmQubitState : Fin 2 → PureState qubit := ![qubitPlus, qubitMinus]

/-- The `±` pure-state frame realizes the vector frame: `(pmQubitState s).vec = pmQubit s`. -/
theorem pmQubitState_vec (s : Fin 2) : (pmQubitState s).vec = pmQubit s := by
  fin_cases s <;> rfl

/-- **The logical codewords of the three-qubit phase-flip code as pure states:**
`|0_L⟩ = |+++⟩` (`a = 0`) and `|1_L⟩ = |−−−⟩` (`a = 1`), so that "the generators stabilize
the code" is a statement about `Observable.HasEigenstate` on a `PureState`. -/
def phaseFlipCodewordState (a : Fin 2) : PureState bitFlipReg :=
  (pmQubitState a).tmul ((pmQubitState a).tmul (pmQubitState a))

/-- The pure-state codeword `|σσσ⟩` realizes the `±`-basis vector `pmThreeVec (a, a, a)` — which is
exactly the QEC codeword vector `phaseFlipCodeword a`. -/
theorem phaseFlipCodewordState_vec (a : Fin 2) :
    (phaseFlipCodewordState a).vec = pmThreeVec (a, a, a) := by
  simp only [phaseFlipCodewordState, PureState.tmul_vec, pmQubitState_vec, pmThreeVec]
  rfl

end AxQM
