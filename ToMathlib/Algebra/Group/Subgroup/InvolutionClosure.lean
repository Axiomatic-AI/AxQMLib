module

public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Data.ZMod.Basic

/-!
# Subset-product normal form for a closure of commuting involutions

In a commutative group `M`, the subgroup generated by a finite family of pairwise-commuting
involutions `f : Fin l → M` (each `f i ^ 2 = 1`) is an elementary abelian `2`-group: every element
is a *subset product* `∏ i, f i ^ (c i).val` indexed by a vector `c : Fin l → ZMod 2` (each
generator used `0` or `1` times, since `(c i).val ∈ {0, 1}`).

This is the involution-specialised, `ZMod 2`-exponent form of `Subgroup.exists_of_mem_closure_range`
(`∃ a : ι → ℤ, x = ∏ i, f i ^ a i`, with general `ℤ` exponents). It is proved directly by
`Subgroup.closure_induction`: reducing the `ℤ`-exponent form to the parity `ZMod 2` form would
require an `orderOf`-mod reduction on `ℤ`-powers that is heavier than the direct induction, and the
`ZMod 2` exponents let the statement feed `ZMod 2`-linear-independence arguments directly (as in
stabilizer-formalism check-matrix computations).
-/

open scoped BigOperators

public section

/-- For an involution `x` (`x ^ 2 = 1`), the exponent may be reduced modulo `2`: reading
`a b : ZMod 2` as exponents in `{0, 1}` via `ZMod.val`, `x ^ (a.val + b.val) = x ^ (a + b).val`.
This is the fact making `c ↦ ∏ i, f i ^ (c i).val` respect `ZMod 2`-addition. -/
theorem pow_zmod2_val_add {M : Type*} [Monoid M] {x : M} (hx : x ^ 2 = 1) (a b : ZMod 2) :
    x ^ (a.val + b.val) = x ^ (a + b).val := by
  conv_lhs => rw [← Nat.div_add_mod (a.val + b.val) 2]
  rw [pow_add, pow_mul, hx, one_pow, one_mul, ZMod.val_add]

namespace Subgroup

/-- **Normal form for a closure of pairwise-commuting involutions.** In a commutative group `M`, if
each generator `f i` squares to `1`, then every element of `closure (Set.range f)` is a subset
product `∏ i, f i ^ (c i).val` of the generators, indexed by `c : Fin l → ZMod 2` (each generator
used `0` or `1` times). This is the involution-specialised form of
`Subgroup.exists_of_mem_closure_range` (which gives general `ℤ` exponents). The three closure cases
combine `c`-vectors by `𝔽₂`-addition (`pow_zmod2_val_add`); inverses reuse the same `c` because each
such product is itself an involution. -/
theorem exists_zmod2_prod_of_mem_closure {M : Type*} [CommGroup M] {l : ℕ}
    (f : Fin l → M) (hf : ∀ i, f i ^ 2 = 1) {x : M}
    (hx : x ∈ closure (Set.range f)) :
    ∃ c : Fin l → ZMod 2, x = ∏ i, f i ^ (c i).val := by
  induction hx using closure_induction with
  | mem x hx =>
      obtain ⟨j, rfl⟩ := hx
      refine ⟨fun i => if i = j then 1 else 0, ?_⟩
      rw [Finset.prod_eq_single j (fun i _ hij => by simp [ite_eq_right hij])
        (fun h => absurd (Finset.mem_univ j) h)]
      simp [ZMod.val_one]
  | one => exact ⟨0, by simp⟩
  | mul x y _ _ hx hy =>
      obtain ⟨cx, rfl⟩ := hx
      obtain ⟨cy, rfl⟩ := hy
      refine ⟨cx + cy, ?_⟩
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl fun i _ => by
        rw [← pow_add]; exact pow_zmod2_val_add (hf i) (cx i) (cy i)
  | inv x _ hx =>
      obtain ⟨c, rfl⟩ := hx
      refine ⟨c, ?_⟩
      have hsq : (∏ i, f i ^ (c i).val) ^ 2 = 1 := by
        rw [← Finset.prod_pow]
        exact Finset.prod_eq_one fun i _ => by
          rw [← pow_mul, mul_comm, pow_mul, hf i, one_pow]
      exact inv_eq_of_mul_eq_one_right (by rw [← pow_two]; exact hsq)

end Subgroup
