module

public import ToMathlib.Analysis.InnerProductSpace.Adjoint
public import Mathlib.Analysis.SpecialFunctions.Complex.Circle
public import Mathlib.Analysis.SpecialFunctions.Trigonometric.Bounds

/-!
# Rotations generated by a self-adjoint involution and the operator-norm distance between them

Let `A` be a self-adjoint involution on a complex Hilbert space `E` (`star A = A` and `A * A = 1`).
For a real angle `θ` the operator
`rotOfInvol A θ = cos(θ/2) • 1 − (sin(θ/2) · i) • A`
is the closed form of `exp(−i(θ/2)A)`: because `A² = 1`, the exponential series folds into the
cosine/sine of `θ/2`. It is a one-parameter family of unitaries — the abstract shape of a Bloch
rotation `R_n̂(θ)`, whose generator is the self-adjoint involution `n·σ`.

The point of the file is the distance between two such rotations about the *same* axis:

* `ContinuousLinearMap.norm_sub_rotOfInvol` — **the main identity**: on a nontrivial space,
  `‖rotOfInvol A α − rotOfInvol A (α+β)‖ = ‖1 − exp(iβ/2)‖`, where the left-hand norm is the
  operator norm `max_{‖ψ‖=1} ‖(U−V)ψ‖`. The mismatch angle `α` drops out entirely: only the
  *difference* `β` matters. This is Nielsen & Chuang, *Quantum Computation and Quantum
  Information*, Exercise 4.40, eq. (4.77) in maximal generality.
* `ContinuousLinearMap.norm_sub_rotOfInvol_apply` — the pointwise form
  `‖(rotOfInvol A α − rotOfInvol A (α+β)) x‖ = ‖1 − exp(iβ/2)‖ · ‖x‖`: the difference is a scalar
  multiple of an isometry, so *every* unit vector attains the operator norm (the maximiser in
  eq. (4.61) is arbitrary).
* `ContinuousLinearMap.norm_sub_rotOfInvol_le_sub_int_mul_four_pi` — the **`4π`-periodic** bound
  `‖…‖ ≤ |β − 4π·m|/2` for every integer `m`. Because the error is `‖1 − exp(iβ/2)‖`, it is a
  function of `β` **only modulo `4π`** (the half-angle makes the period `4π`, not `2π`); the bound
  records that it is small exactly when `β` is close to a multiple of `4π`. This is the correct
  bridge to eq. (4.76): once an iterate `R_n̂(θ)^n = R_n̂(nθ)` lands within `δ` of the target angle
  `α` **modulo `4π`**, the operator error is `≤ δ/2` and hence arbitrarily small. (The naive raw
  bound `|nθ − α|/2` is useless: `{nθ}` is discrete and unbounded in `ℝ`, so `|nθ − α|` cannot be
  driven to `0`; it is the residue mod `4π` that the density of `{nθ mod 4π}` controls.)

The proof avoids spectral theory: writing `D = rotOfInvol A α − rotOfInvol A (α+β)` as
`p • 1 + q • A` with `p` real and `q` imaginary, self-adjointness kills the cross term and `A² = 1`
collapses the square, giving `star D * D = (2 − 2cos(β/2)) • 1` — a nonnegative scalar times the
identity. Thus `‖D x‖² = (2 − 2cos(β/2)) ‖x‖²` for every `x`, and
`2 − 2cos(β/2) = ‖1 − exp(iβ/2)‖²`.
-/

open Complex

@[expose] public section

namespace Complex

/-- `‖1 − exp(iθ)‖² = 2 − 2cos θ`: the squared chord length between `1` and `exp(iθ)` on the unit
circle, from `Complex.norm_sub_one_sq_eqOn_sphere` and `exp(iθ).re = cos θ`. -/
theorem norm_one_sub_exp_ofReal_mul_I_sq (θ : ℝ) :
    ‖(1 : ℂ) - Complex.exp (θ * Complex.I)‖ ^ 2 = 2 - 2 * Real.cos θ := by
  have hmem : Complex.exp ((θ : ℝ) * Complex.I) ∈ Metric.sphere (0 : ℂ) 1 := by
    simp [Complex.norm_exp_ofReal_mul_I]
  have h := Complex.norm_sub_one_sq_eqOn_sphere hmem
  simp only [Complex.exp_ofReal_mul_I_re] at h
  rw [norm_sub_rev, h]; ring

/-- The chord bound `‖1 − exp(iθ)‖ ≤ |θ|` (a unit-circle arc is at least as long as its chord),
from the library's `Real.norm_exp_I_mul_ofReal_sub_one_le`. -/
theorem norm_one_sub_exp_ofReal_mul_I_le (θ : ℝ) :
    ‖(1 : ℂ) - Complex.exp (θ * Complex.I)‖ ≤ |θ| := by
  rw [norm_sub_rev, mul_comm]
  simpa [Real.norm_eq_abs] using Real.norm_exp_I_mul_ofReal_sub_one_le (x := θ)

/-- **The reverse chord bound** `(2/π)·|θ| ≤ ‖1 − exp(iθ)‖`, valid on the arc `|θ| ≤ π`: there the
chord from `1` to `exp(iθ)` is at least `2/π` times the subtended angle. This is the companion lower
bound to `norm_one_sub_exp_ofReal_mul_I_le` (`‖…‖ ≤ |θ|`); together they pin the chord length
between `2|θ|/π` and `|θ|`. Proved from `‖1 − exp(iθ)‖² = 2 − 2cos θ = 4 sin²(θ/2)` and Jordan's
inequality `(2/π)·|θ/2| ≤ |sin(θ/2)|` (`Real.mul_abs_le_abs_sin`, since `|θ/2| ≤ π/2`). It is the
geometric estimate behind Nielsen & Chuang's phase-estimation accuracy bound (eq. (5.29)): the
read-out amplitude's denominator `1 − exp(iθ)` cannot be too small near a bin. -/
theorem two_div_pi_mul_abs_le_norm_one_sub_exp_ofReal_mul_I {θ : ℝ} (hθ : |θ| ≤ Real.pi) :
    2 / Real.pi * |θ| ≤ ‖(1 : ℂ) - Complex.exp (θ * Complex.I)‖ := by
  have hjordan : |θ| / Real.pi ≤ |Real.sin (θ / 2)| := by
    have hx : |θ / 2| ≤ Real.pi / 2 := by rw [abs_div, abs_two]; linarith
    have hj := Real.mul_abs_le_abs_sin hx
    rw [abs_div, abs_two] at hj
    calc |θ| / Real.pi = 2 / Real.pi * (|θ| / 2) := by ring
      _ ≤ |Real.sin (θ / 2)| := hj
  have hsq : (2 / Real.pi * |θ|) ^ 2 ≤ ‖(1 : ℂ) - Complex.exp (θ * Complex.I)‖ ^ 2 := by
    rw [Complex.norm_one_sub_exp_ofReal_mul_I_sq]
    have hid : (2 : ℝ) - 2 * Real.cos θ = 4 * Real.sin (θ / 2) ^ 2 := by
      have hc2 : Real.cos θ = 2 * Real.cos (θ / 2) ^ 2 - 1 := by
        have h := Real.cos_two_mul (θ / 2)
        rwa [show 2 * (θ / 2) = θ by ring] at h
      have hpyth := Real.sin_sq_add_cos_sq (θ / 2)
      linarith
    have hsin : (|θ| / Real.pi) ^ 2 ≤ Real.sin (θ / 2) ^ 2 := by
      rw [← sq_abs (Real.sin (θ / 2)), pow_two, pow_two]
      exact mul_self_le_mul_self (by positivity) hjordan
    rw [hid, show (2 / Real.pi * |θ|) ^ 2 = 4 * (|θ| / Real.pi) ^ 2 from by ring]
    linarith
  have h0 : (0 : ℝ) ≤ 2 / Real.pi * |θ| := by positivity
  calc 2 / Real.pi * |θ| = Real.sqrt ((2 / Real.pi * |θ|) ^ 2) := (Real.sqrt_sq h0).symm
    _ ≤ Real.sqrt (‖(1 : ℂ) - Complex.exp (θ * Complex.I)‖ ^ 2) := Real.sqrt_le_sqrt hsq
    _ = ‖(1 : ℂ) - Complex.exp (θ * Complex.I)‖ := Real.sqrt_sq (norm_nonneg _)

/-- `exp(iθ)` is `2π`-periodic in `θ`: adding `2π·m` (integer `m`) to the angle leaves it — hence
the chord `‖1 − exp(iθ)‖` — unchanged. -/
theorem exp_ofReal_mul_I_add_int_mul_two_pi (θ : ℝ) (m : ℤ) :
    Complex.exp ((θ + 2 * Real.pi * m : ℝ) * Complex.I) = Complex.exp (θ * Complex.I) := by
  rw [show ((θ + 2 * Real.pi * m : ℝ) : ℂ) * Complex.I
        = (θ : ℝ) * Complex.I + (m : ℂ) * (2 * (Real.pi : ℝ) * Complex.I) by push_cast; ring]
  exact Complex.exp_periodic.int_mul m ((θ : ℝ) * Complex.I)

end Complex

namespace ContinuousLinearMap

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- The **rotation generated by a self-adjoint involution** `A` through angle `θ`:
`rotOfInvol A θ = cos(θ/2) • 1 − (sin(θ/2)·i) • A`. When `A² = 1` this is the closed form of
`exp(−i(θ/2)A)`; the running example is a Bloch rotation `R_n̂(θ)` with `A = n·σ`. -/
noncomputable def rotOfInvol (A : E →L[ℂ] E) (θ : ℝ) : E →L[ℂ] E :=
  (Real.cos (θ / 2) : ℂ) • 1 - ((Real.sin (θ / 2) : ℂ) * Complex.I) • A

omit [CompleteSpace E] in
@[simp]
theorem rotOfInvol_apply (A : E →L[ℂ] E) (θ : ℝ) (x : E) :
    rotOfInvol A θ x = (Real.cos (θ / 2) : ℂ) • x - ((Real.sin (θ / 2) : ℂ) * Complex.I) • A x := by
  simp only [rotOfInvol, _root_.sub_apply, _root_.smul_apply,
    one_apply_eq_self]

omit [CompleteSpace E] in
/-- The zero rotation is the identity: `rotOfInvol A 0 = 1`. -/
@[simp]
theorem rotOfInvol_zero (A : E →L[ℂ] E) : rotOfInvol A 0 = 1 := by
  simp [rotOfInvol]

/-- The key operator identity behind eq. (4.77): for a self-adjoint involution `A`,
`star D * D = (2 − 2cos(β/2)) • 1` where `D = rotOfInvol A α − rotOfInvol A (α+β)`. The angle `α`
cancels; self-adjointness kills the `A`-term and `A² = 1` collapses the `A²`-term. -/
theorem star_sub_rotOfInvol_mul_sub_rotOfInvol (A : E →L[ℂ] E) (hA : IsSelfAdjoint A)
    (hA2 : A * A = 1) (α β : ℝ) :
    star (rotOfInvol A α - rotOfInvol A (α + β)) * (rotOfInvol A α - rotOfInvol A (α + β))
      = ((2 - 2 * Real.cos (β / 2) : ℝ) : ℂ) • (1 : E →L[ℂ] E) := by
  set p : ℂ := (Real.cos (α / 2) : ℂ) - (Real.cos ((α + β) / 2) : ℂ) with hp
  set q : ℂ := ((Real.sin ((α + β) / 2) : ℂ) - (Real.sin (α / 2) : ℂ)) * Complex.I with hq
  have hD : rotOfInvol A α - rotOfInvol A (α + β) = p • 1 + q • A := by
    simp only [rotOfInvol, hp, hq]
    match_scalars <;> ring
  have hsp : star p = p := by
    rw [hp]
    simp only [← starRingEnd_apply, map_sub, Complex.conj_ofReal]
  have hsq : star q = -q := by
    rw [hq]
    simp only [← starRingEnd_apply, map_mul, map_sub, Complex.conj_ofReal, Complex.conj_I]
    ring
  rw [hD, star_add, star_smul, star_smul, star_one, hA.star_eq, hsp, hsq]
  have key : (p • (1 : E →L[ℂ] E) + (-q) • A) * (p • 1 + q • A)
      = (p * p - q * q) • 1 + (p * q - q * p) • A := by
    simp only [add_mul, mul_add, smul_mul_smul_comm, mul_one, one_mul, hA2]
    match_scalars <;> ring
  rw [key]
  have hAcoeff : p * q - q * p = 0 := by ring
  have hreal : (Real.cos (α / 2) - Real.cos ((α + β) / 2)) ^ 2
      + (Real.sin ((α + β) / 2) - Real.sin (α / 2)) ^ 2 = 2 - 2 * Real.cos (β / 2) := by
    have hcos : Real.cos (α / 2) * Real.cos ((α + β) / 2)
        + Real.sin (α / 2) * Real.sin ((α + β) / 2) = Real.cos (β / 2) := by
      rw [← Real.cos_sub, show α / 2 - (α + β) / 2 = -(β / 2) by ring, Real.cos_neg]
    nlinarith [hcos, Real.sin_sq_add_cos_sq (α / 2), Real.sin_sq_add_cos_sq ((α + β) / 2)]
  have hpp : p * p = (((Real.cos (α / 2) - Real.cos ((α + β) / 2)) ^ 2 : ℝ) : ℂ) := by
    rw [hp]; push_cast [-Complex.ofReal_cos]; ring
  have hqq : q * q = -(((Real.sin ((α + β) / 2) - Real.sin (α / 2)) ^ 2 : ℝ) : ℂ) := by
    rw [hq, mul_mul_mul_comm, Complex.I_mul_I]; push_cast [-Complex.ofReal_sin]; ring
  rw [hAcoeff, zero_smul, add_zero, hpp, hqq, sub_neg_eq_add, ← Complex.ofReal_add, hreal]

/-- A homothety criterion: if `star D * D = c • 1` with `c ≥ 0` real, then `D` scales every vector
by `√c`, i.e. `‖D x‖ = √c · ‖x‖`. (When `c > 0`, `D` is `√c` times a unitary.) -/
theorem norm_apply_of_star_mul_self_eq_smul_one {D : E →L[ℂ] E} {c : ℝ} (hc : 0 ≤ c)
    (h : star D * D = (c : ℂ) • 1) (x : E) : ‖D x‖ = Real.sqrt c * ‖x‖ := by
  have hi : inner ℂ (D x) (D x) = (c : ℂ) * inner ℂ x x := by
    rw [← ContinuousLinearMap.adjoint_inner_right, ← mul_apply_eq_comp,
      ← ContinuousLinearMap.star_eq_adjoint, h, _root_.smul_apply,
      one_apply_eq_self, inner_smul_right]
  have hsq : ‖D x‖ ^ 2 = c * ‖x‖ ^ 2 := by
    rw [← inner_self_eq_norm_sq (𝕜 := ℂ) (D x), ← inner_self_eq_norm_sq (𝕜 := ℂ) x, hi]
    simp
  have hnn : 0 ≤ Real.sqrt c * ‖x‖ := by positivity
  calc ‖D x‖ = Real.sqrt (‖D x‖ ^ 2) := (Real.sqrt_sq (norm_nonneg _)).symm
    _ = Real.sqrt ((Real.sqrt c * ‖x‖) ^ 2) := by
        rw [hsq]; rw [mul_pow, Real.sq_sqrt hc]
    _ = Real.sqrt c * ‖x‖ := Real.sqrt_sq hnn

/-- **Pointwise form of eq. (4.77).** For a self-adjoint involution `A`, the difference of two
rotations about its axis is a homothety: `‖(rotOfInvol A α − rotOfInvol A (α+β)) x‖ =
‖1 − exp(iβ/2)‖ · ‖x‖` for every `x`. Only the angle difference `β` matters. -/
theorem norm_sub_rotOfInvol_apply (A : E →L[ℂ] E) (hA : IsSelfAdjoint A) (hA2 : A * A = 1)
    (α β : ℝ) (x : E) :
    ‖(rotOfInvol A α - rotOfInvol A (α + β)) x‖
      = ‖(1 : ℂ) - Complex.exp ((β / 2 : ℝ) * Complex.I)‖ * ‖x‖ := by
  have hc : (0 : ℝ) ≤ 2 - 2 * Real.cos (β / 2) := by nlinarith [Real.cos_le_one (β / 2)]
  rw [norm_apply_of_star_mul_self_eq_smul_one hc
      (star_sub_rotOfInvol_mul_sub_rotOfInvol A hA hA2 α β) x]
  congr 1
  rw [← Complex.norm_one_sub_exp_ofReal_mul_I_sq (β / 2), Real.sqrt_sq (norm_nonneg _)]

/-- **Nielsen & Chuang, Exercise 4.40, eq. (4.77), general form.** On a nontrivial complex Hilbert
space, the operator-norm distance (the error `E(U,V) = max_{‖ψ‖=1} ‖(U−V)ψ‖` of eq. (4.61)) between
two rotations `rotOfInvol A α` and `rotOfInvol A (α+β)` about a self-adjoint-involution axis `A` is
`‖1 − exp(iβ/2)‖`, depending only on the angle difference `β`. -/
theorem norm_sub_rotOfInvol [Nontrivial E] (A : E →L[ℂ] E) (hA : IsSelfAdjoint A) (hA2 : A * A = 1)
    (α β : ℝ) :
    ‖rotOfInvol A α - rotOfInvol A (α + β)‖
      = ‖(1 : ℂ) - Complex.exp ((β / 2 : ℝ) * Complex.I)‖ := by
  refine le_antisymm (opNorm_le_bound _ (norm_nonneg _) fun x => ?_) ?_
  · exact le_of_eq (norm_sub_rotOfInvol_apply A hA hA2 α β x)
  · obtain ⟨x, hx⟩ := exists_ne (0 : E)
    have hxp : 0 < ‖x‖ := norm_pos_iff.mpr hx
    have hle := ContinuousLinearMap.le_opNorm (rotOfInvol A α - rotOfInvol A (α + β)) x
    rw [norm_sub_rotOfInvol_apply A hA hA2 α β x] at hle
    exact le_of_mul_le_mul_right hle hxp

/-- **The vanishing bound.** The operator error between rotations whose angles differ by `β` is at
most `|β|/2`, so it can be driven below any `ε > 0` by making the angle mismatch small. -/
theorem norm_sub_rotOfInvol_le [Nontrivial E] (A : E →L[ℂ] E) (hA : IsSelfAdjoint A)
    (hA2 : A * A = 1) (α β : ℝ) : ‖rotOfInvol A α - rotOfInvol A (α + β)‖ ≤ |β| / 2 := by
  rw [norm_sub_rotOfInvol A hA hA2 α β]
  calc ‖(1 : ℂ) - Complex.exp ((β / 2 : ℝ) * Complex.I)‖
      ≤ |β / 2| := Complex.norm_one_sub_exp_ofReal_mul_I_le (β / 2)
    _ = |β| / 2 := by rw [abs_div]; norm_num

/-- **The `4π`-periodic bound justifying eq. (4.76).** Because the error is `‖1 − exp(iβ/2)‖`, a
function of `β` only modulo `4π`, the operator distance is `≤ |β − 4π·m|/2` for *every* integer `m`.
Choosing `m` to minimise `|β − 4π·m|` shows the error is small exactly when `β` is near a multiple
of `4π` — what the density of `{nθ mod 4π}` supplies in eq. (4.76), unlike the raw `|β|`. -/
theorem norm_sub_rotOfInvol_le_sub_int_mul_four_pi [Nontrivial E] (A : E →L[ℂ] E)
    (hA : IsSelfAdjoint A) (hA2 : A * A = 1) (α β : ℝ) (m : ℤ) :
    ‖rotOfInvol A α - rotOfInvol A (α + β)‖ ≤ |β - 4 * Real.pi * m| / 2 := by
  rw [norm_sub_rotOfInvol A hA hA2 α β]
  have hper : Complex.exp ((β / 2 : ℝ) * Complex.I)
      = Complex.exp (((β - 4 * Real.pi * m) / 2 : ℝ) * Complex.I) := by
    rw [← Complex.exp_ofReal_mul_I_add_int_mul_two_pi ((β - 4 * Real.pi * m) / 2) m]
    congr 1
    push_cast; ring
  rw [hper]
  calc ‖(1 : ℂ) - Complex.exp (((β - 4 * Real.pi * m) / 2 : ℝ) * Complex.I)‖
      ≤ |(β - 4 * Real.pi * m) / 2| :=
        Complex.norm_one_sub_exp_ofReal_mul_I_le ((β - 4 * Real.pi * m) / 2)
    _ = |β - 4 * Real.pi * m| / 2 := by rw [abs_div]; norm_num

end ContinuousLinearMap
