module

public import ToMathlib.Analysis.InnerProductSpace.LinearMap
public import ToMathlib.Analysis.InnerProductSpace.Adjoint
public import ToMathlib.Analysis.InnerProductSpace.PiL2
public import ToMathlib.Analysis.InnerProductSpace.Positive
public import Mathlib.LinearAlgebra.UnitaryGroup

/-! # The synthesis operator of a finite family of vectors and its sum of rank-one projectors

Given a finite family of vectors `ψ : ι → H` in an inner product space, this file introduces the
**synthesis operator** `synthesisMap ψ : EuclideanSpace 𝕜 ι →L[𝕜] H`, the continuous linear map
sending the `i`-th standard basis vector to `ψ i` (equivalently `x ↦ ∑ i, x i • ψ i`), and records
the identity that relates it to the sum of rank-one projectors of the family:

* `InnerProductSpace.sum_rankOne_self_eq_synthesisMap_comp_adjoint`:
  `∑ i, |ψ i⟩⟨ψ i| = (synthesisMap ψ) ∘L (synthesisMap ψ)†`.

This is the operator reformulation at the heart of the "unitary freedom in the ensemble" theorem
(Nielsen & Chuang, *Quantum Computation and Quantum Information*, Theorem 2.6): a family of vectors
`ψ` generates the operator `∑ i, |ψ i⟩⟨ψ i|`, and this operator is exactly `T T†` for the synthesis
operator `T = synthesisMap ψ`. Two families generate the same operator iff their synthesis operators
have equal `T T†`, which happens iff they differ by a unitary on the coefficient space
`EuclideanSpace 𝕜 ι` — the source of the "unitary freedom".

This file also records the *forward* (easy) direction of that theorem:

* `InnerProductSpace.sum_rankOne_self_eq_of_mem_unitaryGroup`: if the coefficient matrix relating
  two families is unitary, the two families generate the same operator, i.e.
  `∑ i, |∑ⱼ uᵢⱼ φⱼ⟩⟨∑ⱼ uᵢⱼ φⱼ| = ∑ j, |φ j⟩⟨φ j|` (N&C eqs. (2.168)–(2.171)).

Finally it records the **dimension reduction** counterpart of the unitary freedom: while a unitary
mixing keeps the number of terms fixed, the number of *essential* terms is capped by the dimension.

* `ContinuousLinearMap.IsPositive.exists_sum_rankOne_fin_finrank`: a positive operator is a sum of
  `finrank`-many rank-one projectors — the `finrank`-explicit refinement of
  `ContinuousLinearMap.isPositive_iff_eq_sum_rankOne`.
* `InnerProductSpace.exists_sum_rankOne_self_eq_fin_finrank`: any sum `∑ᵢ |vᵢ⟩⟨vᵢ|` over an
  arbitrarily large finite family equals a sum `∑ₖ |wₖ⟩⟨wₖ|` of at most `finrank` rank-one
  projectors. This is the linear-algebra core of the minimal operator-sum representation bound
  (Nielsen & Chuang Theorem 8.3: at most `d²` operation elements, via the Choi vectors on `H ⊗ H`).
-/

@[expose] public section

open scoped InnerProductSpace
open Finset

namespace InnerProductSpace

variable {𝕜 : Type*} {H : Type*} {ι : Type*}
  [RCLike 𝕜] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [Fintype ι]

/-- The **synthesis operator** of a finite family of vectors `ψ : ι → H`: the continuous linear map
`EuclideanSpace 𝕜 ι →L[𝕜] H` sending the `i`-th standard basis vector to `ψ i`, so that
`synthesisMap ψ x = ∑ i, x i • ψ i`. Written as the sum of rank-one operators
`∑ i, |ψ i⟩⟨eᵢ|` where `eᵢ` is the `i`-th standard basis vector of `EuclideanSpace 𝕜 ι`.

The composition `(synthesisMap ψ) ∘L (synthesisMap ψ)†` equals the sum of rank-one projectors
`∑ i, |ψ i⟩⟨ψ i|` (`sum_rankOne_self_eq_synthesisMap_comp_adjoint`): the operator "generated" by the
family in the sense of Nielsen & Chuang §2.4.1. -/
noncomputable def synthesisMap (ψ : ι → H) : EuclideanSpace 𝕜 ι →L[𝕜] H :=
  ∑ i, rankOne 𝕜 (ψ i) (EuclideanSpace.basisFun ι 𝕜 i)

@[simp]
theorem synthesisMap_apply (ψ : ι → H) (x : EuclideanSpace 𝕜 ι) :
    synthesisMap ψ x = ∑ i, x i • ψ i := by
  simp only [synthesisMap, _root_.sum_apply, rankOne_apply,
    EuclideanSpace.basisFun_inner]

/-- **The operator generated by a family is `T T†` for the synthesis operator `T`.** The sum of
rank-one projectors `∑ i, |ψ i⟩⟨ψ i|` of a finite family `ψ` equals `(synthesisMap ψ) ∘L
(synthesisMap ψ)†`. This is the operator reformulation underlying Nielsen & Chuang Theorem 2.6:
the family `ψ` "generates" the operator `∑ i, |ψ i⟩⟨ψ i|`, and that operator is the Gram-type
product `T T†` of the synthesis operator. -/
theorem sum_rankOne_self_eq_synthesisMap_comp_adjoint [CompleteSpace H] (ψ : ι → H) :
    ∑ i, rankOne 𝕜 (ψ i) (ψ i)
      = (synthesisMap ψ).comp (ContinuousLinearMap.adjoint (synthesisMap ψ)) := by
  classical
  have hb : ∀ i j : ι,
      (inner 𝕜 (EuclideanSpace.basisFun ι 𝕜 i) (EuclideanSpace.basisFun ι 𝕜 j) : 𝕜)
        = if i = j then (1 : 𝕜) else 0 :=
    fun i j => orthonormal_iff_ite.mp (EuclideanSpace.basisFun ι 𝕜).orthonormal i j
  simp only [synthesisMap, map_sum, adjoint_rankOne, ContinuousLinearMap.finsetSum_comp,
    ContinuousLinearMap.comp_finsetSum, rankOne_comp_rankOne, hb, ite_smul, one_smul, zero_smul,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true]

/-- **Forward direction of unitary freedom in the ensemble** (Nielsen & Chuang, Theorem 2.6,
eqs. (2.168)–(2.171)). If two finite families of vectors are related by a unitary coefficient
matrix `u`, i.e. `ψ i = ∑ⱼ uᵢⱼ • φⱼ`, then they generate the same operator:
`∑ i, |ψ i⟩⟨ψ i| = ∑ j, |φ j⟩⟨φ j|`.

Concretely, expanding each `|ψ i⟩⟨ψ i|` bilinearly gives `∑ⱼ∑ₖ (uᵢⱼ conj uᵢₖ) |φⱼ⟩⟨φₖ|`; summing
over `i` collapses the coefficient `∑ᵢ uᵢⱼ conj uᵢₖ = (u⋆ u)ₖⱼ = δₖⱼ` by unitarity, leaving
`∑ⱼ |φⱼ⟩⟨φⱼ|`. -/
theorem sum_rankOne_self_eq_of_mem_unitaryGroup [DecidableEq ι] {u : Matrix ι ι 𝕜}
    (hu : u ∈ Matrix.unitaryGroup ι 𝕜) (φ : ι → H) :
    ∑ i, rankOne 𝕜 (∑ j, u i j • φ j) (∑ j, u i j • φ j) = ∑ i, rankOne 𝕜 (φ i) (φ i) := by
  have key : ∀ j k : ι,
      (∑ i, u i j * (starRingEnd 𝕜) (u i k)) = if k = j then (1 : 𝕜) else 0 := by
    intro j k
    have h1 : (star u * u : Matrix ι ι 𝕜) = 1 := Matrix.mem_unitaryGroup_iff'.mp hu
    have h2 := congrFun (congrFun h1 k) j
    rw [Matrix.mul_apply, Matrix.one_apply] at h2
    rw [← h2]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Matrix.star_apply, starRingEnd_apply]
    exact mul_comm _ _
  calc ∑ i, rankOne 𝕜 (∑ j, u i j • φ j) (∑ j, u i j • φ j)
      = ∑ i, ∑ j, ∑ k, (u i j * (starRingEnd 𝕜) (u i k)) • rankOne 𝕜 (φ j) (φ k) := by
        simp only [rankOne_sum_smul_sum_smul]
    _ = ∑ j, ∑ k, ∑ i, (u i j * (starRingEnd 𝕜) (u i k)) • rankOne 𝕜 (φ j) (φ k) := by
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl fun j _ => Finset.sum_comm
    _ = ∑ j, ∑ k, (∑ i, u i j * (starRingEnd 𝕜) (u i k)) • rankOne 𝕜 (φ j) (φ k) := by
        simp only [Finset.sum_smul]
    _ = ∑ j, ∑ k, (if k = j then (1 : 𝕜) else 0) • rankOne 𝕜 (φ j) (φ k) := by
        simp only [key]
    _ = ∑ i, rankOne 𝕜 (φ i) (φ i) := by
        simp only [ite_smul, one_smul, zero_smul, Finset.sum_ite_eq', Finset.mem_univ, ite_true]

end InnerProductSpace

namespace ContinuousLinearMap

open InnerProductSpace

variable {𝕜 : Type*} [RCLike 𝕜]

/-- **Rectangular operator crux of unitary freedom in the ensemble.** For continuous linear maps
`S T : K →L[𝕜] H` from a finite-dimensional inner product space `K` to a complete inner product
space `H`, if `T ∘L T† = S ∘L S†` then there is a *unitary* `W` on `K` with `T = S ∘L W`.

This is the operator statement at the heart of Nielsen & Chuang, *Quantum Computation and Quantum
Information*, Theorem 2.6: two finite families of vectors generate the same operator
(`∑ i, |ψ i⟩⟨ψ i| = ∑ i, |φ i⟩⟨φ i|`) iff their synthesis operators `T`, `S`
(`InnerProductSpace.synthesisMap`) satisfy `T T† = S S†`, and this crux produces the unitary
relating them (whose matrix is the unitary coefficient matrix of the theorem). Only the coefficient
space `K` need be finite-dimensional; `H` may be infinite-dimensional.

The converse of the trivial forward direction (`T = S ∘L W`, `W` unitary, gives
`T T† = S W W† S† = S S†`), its proof mirrors
`ContinuousLinearMap.exists_mem_unitary_eq_comp_absoluteValue`: from `T T† = S S†` the adjoints are
equinorm, `‖T† y‖ = ‖S† y‖` (both squares equal `re ⟪y, (A A†) y⟫`), so `S† y ↦ T† y` is a
well-defined linear isometry `L` on the submodule `range S† ⊆ K`. Extending `L` to a full isometry
of `K` (`LinearIsometry.extend`) and upgrading to a `LinearIsometryEquiv` (equal dimension) yields a
unitary `V` with `V (S† y) = T† y`; taking adjoints gives `T = S ∘L V†`, so `W = V† = star V`. -/
theorem exists_unitary_comp_of_comp_adjoint_eq {K H : Type*}
    [NormedAddCommGroup K] [InnerProductSpace 𝕜 K] [FiniteDimensional 𝕜 K] [CompleteSpace K]
    [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
    {S T : K →L[𝕜] H} (hST : T.comp (adjoint T) = S.comp (adjoint S)) :
    ∃ W ∈ unitary (K →L[𝕜] K), T = S.comp W := by
  classical
  -- The adjoints are equinorm on `H`: `‖T† y‖ = ‖S† y‖`.
  have hnorm : ∀ y : H, ‖(adjoint T) y‖ = ‖(adjoint S) y‖ := by
    intro y
    have hEq : ⟪(adjoint T) y, (adjoint T) y⟫_𝕜 = ⟪(adjoint S) y, (adjoint S) y⟫_𝕜 := by
      rw [adjoint_inner_left, ← comp_apply, hST, comp_apply, ← adjoint_inner_left]
    have hre := congrArg RCLike.re hEq
    rwa [inner_self_eq_norm_sq, inner_self_eq_norm_sq,
      sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)] at hre
  -- `S† y` determines `T† y`: the assignment is well-defined.
  have hwd : ∀ y₁ y₂ : H, (adjoint S) y₁ = (adjoint S) y₂ → (adjoint T) y₁ = (adjoint T) y₂ := by
    intro y₁ y₂ he
    have h0 : (adjoint S) (y₁ - y₂) = 0 := by rw [map_sub, he, sub_self]
    have hn : ‖(adjoint T) (y₁ - y₂)‖ = 0 := by rw [hnorm, h0, norm_zero]
    have hz : (adjoint T) (y₁ - y₂) = 0 := norm_eq_zero.mp hn
    rwa [map_sub, sub_eq_zero] at hz
  -- The linear isometry `L : range S† →ₗᵢ K`, `S† y ↦ T† y`.
  set P : Submodule 𝕜 K := LinearMap.range (adjoint S : H →ₗ[𝕜] K) with hPdef
  have hspec : ∀ v : ↥P, (adjoint S) (Classical.choose v.2) = (v : K) :=
    fun v => Classical.choose_spec v.2
  let L₀ : ↥P →ₗ[𝕜] K :=
    { toFun := fun v => (adjoint T) (Classical.choose v.2)
      map_add' := fun v w => by
        have hkey : (adjoint T) (Classical.choose (v + w).2)
            = (adjoint T) (Classical.choose v.2 + Classical.choose w.2) := by
          refine hwd _ _ ?_
          rw [map_add, hspec (v + w), hspec v, hspec w, Submodule.coe_add]
        rw [hkey, map_add]
      map_smul' := fun c v => by
        have hkey : (adjoint T) (Classical.choose (c • v).2)
            = (adjoint T) (c • Classical.choose v.2) := by
          refine hwd _ _ ?_
          rw [map_smul, hspec (c • v), hspec v, Submodule.coe_smul]
        rw [hkey, map_smul]
        rfl }
  let L : ↥P →ₗᵢ[𝕜] K :=
    { toLinearMap := L₀
      norm_map' := fun v => by
        change ‖(adjoint T) (Classical.choose v.2)‖ = ‖(v : K)‖
        rw [hnorm, hspec v] }
  -- Extend to a unitary `V` on `K` with `V (S† y) = T† y`.
  set V : K ≃ₗᵢ[𝕜] K := (L.extend).toLinearIsometryEquiv rfl with hVdef
  have hVspec : ∀ y : H, V ((adjoint S) y) = (adjoint T) y := by
    intro y
    have hmem : (adjoint S) y ∈ P := ⟨y, rfl⟩
    have hVL : V ((adjoint S) y) = L ⟨(adjoint S) y, hmem⟩ := by
      rw [hVdef, LinearIsometry.coe_toLinearIsometryEquiv]
      exact LinearIsometry.extend_apply L ⟨(adjoint S) y, hmem⟩
    rw [hVL]
    exact hwd _ _ (Classical.choose_spec hmem)
  -- Package `V` as a unitary and read off `W = V†`.
  set Vu : ↥(unitary (K →L[𝕜] K)) := Unitary.linearIsometryEquiv.symm V with hVu
  have hcomp : (Vu : K →L[𝕜] K).comp (adjoint S) = adjoint T := by
    ext y
    simp only [comp_apply]
    rw [hVu, Unitary.coe_symm_linearIsometryEquiv_apply]
    exact hVspec y
  refine ⟨adjoint (Vu : K →L[𝕜] K), ?_, ?_⟩
  · rw [← star_eq_adjoint]
    exact Unitary.star_mem Vu.2
  · have hadj := congrArg adjoint hcomp
    rw [adjoint_comp, adjoint_adjoint, adjoint_adjoint] at hadj
    exact hadj.symm

/-- **A positive operator is a sum of at most `finrank` rank-one projectors.** On a
finite-dimensional inner product space `E`, every positive operator `T` equals `∑ᵢ |uᵢ⟩⟨uᵢ|` for a
family `u` indexed by `Fin (finrank 𝕜 E)`. This is the `finrank`-explicit refinement of
`ContinuousLinearMap.isPositive_iff_eq_sum_rankOne`, which only asserts the existence of *some*
finite number of summands; here the number is pinned to the dimension. The witnesses are
`uᵢ = √λᵢ • eᵢ` for the spectral eigenbasis `eᵢ` and (nonnegative) eigenvalues `λᵢ` of `T`: the
spectral decomposition `T = ∑ᵢ λᵢ |eᵢ⟩⟨eᵢ|` (`IsSelfAdjoint.spectral_sum`) rewrites each summand as
`λᵢ |eᵢ⟩⟨eᵢ| = |√λᵢ eᵢ⟩⟨√λᵢ eᵢ|` via `InnerProductSpace.rankOne_real_sqrt_smul_self` (using
`λᵢ ≥ 0`, `LinearMap.IsPositive.nonneg_eigenvalues`). -/
theorem IsPositive.exists_sum_rankOne_fin_finrank {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace 𝕜 E] [FiniteDimensional 𝕜 E] {T : E →L[𝕜] E} (hT : T.IsPositive) :
    ∃ u : Fin (Module.finrank 𝕜 E) → E, T = ∑ i, rankOne 𝕜 (u i) (u i) := by
  have := FiniteDimensional.completeSpace 𝕜 E
  refine ⟨fun i ↦ ((hT.isSymmetric.eigenvalues rfl i).sqrt : 𝕜) •
      hT.isSymmetric.eigenvectorBasis rfl i, ?_⟩
  conv_lhs => rw [hT.isSelfAdjoint.spectral_sum rfl]
  exact Finset.sum_congr rfl fun i _ ↦
    (rankOne_real_sqrt_smul_self (hT.toLinearMap.nonneg_eigenvalues rfl i) _).symm

end ContinuousLinearMap

namespace InnerProductSpace

open Finset

variable {𝕜 : Type*} {H : Type*} {ι : Type*}
  [RCLike 𝕜] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [Fintype ι]

/-- The synthesis operator sends the `i`-th standard basis vector of `EuclideanSpace 𝕜 ι` to the
`i`-th family member: `synthesisMap χ eᵢ = χ i`. -/
theorem synthesisMap_basisFun (χ : ι → H) (i : ι) :
    synthesisMap χ (EuclideanSpace.basisFun ι 𝕜 i) = χ i := by
  classical
  rw [synthesisMap, _root_.sum_apply]
  simp only [rankOne_apply, orthonormal_iff_ite.mp (EuclideanSpace.basisFun ι 𝕜).orthonormal,
    ite_smul, one_smul, zero_smul, Finset.sum_ite_eq', Finset.mem_univ, ite_true]

/-- **Unitary freedom in the ensemble** (Nielsen & Chuang, *Quantum Computation and Quantum
Information*, Theorem 2.6), vector-family form. Two finite families `ψ φ : ι → H` (over a common
finite index `ι`, the equal-size "padded" form of the theorem) generate the same operator
`∑ i, |ψ i⟩⟨ψ i| = ∑ i, |φ i⟩⟨φ i|` **iff** they are related by a unitary coefficient matrix
`u ∈ Matrix.unitaryGroup ι 𝕜`: `ψ i = ∑ j, u i j • φ j`.

The `⟸` direction is `sum_rankOne_self_eq_of_mem_unitaryGroup` (the forward direction, expanding the
sum bilinearly and collapsing `∑ᵢ uᵢⱼ conj uᵢₖ = δⱼₖ`). The `⟹` direction is the crux: the equal
rank-one sums say the synthesis operators satisfy `T T† = S S†`
(`sum_rankOne_self_eq_synthesisMap_comp_adjoint`), whence `ContinuousLinearMap.
exists_unitary_comp_of_comp_adjoint_eq` gives a unitary `W` on `EuclideanSpace 𝕜 ι` with
`synthesisMap ψ = (synthesisMap φ) ∘L W`; reading off its coefficients `u i j = W eᵢ j` and
evaluating at basis vectors (`synthesisMap_basisFun`) gives `ψ i = ∑ j, u i j • φ j`, with `u`
unitary because `W` maps the orthonormal basis `{eᵢ}` to an orthonormal family. -/
theorem sum_rankOne_self_eq_iff_exists_mem_unitaryGroup [CompleteSpace H] [DecidableEq ι]
    (ψ φ : ι → H) :
    (∑ i, rankOne 𝕜 (ψ i) (ψ i) = ∑ i, rankOne 𝕜 (φ i) (φ i)) ↔
      ∃ u : Matrix ι ι 𝕜, u ∈ Matrix.unitaryGroup ι 𝕜 ∧ ∀ i, ψ i = ∑ j, u i j • φ j := by
  constructor
  · intro h
    have e1 := sum_rankOne_self_eq_synthesisMap_comp_adjoint (𝕜 := 𝕜) ψ
    have e2 := sum_rankOne_self_eq_synthesisMap_comp_adjoint (𝕜 := 𝕜) φ
    obtain ⟨W, hWmem, hW⟩ :=
      ContinuousLinearMap.exists_unitary_comp_of_comp_adjoint_eq (e1.symm.trans (h.trans e2))
    -- `W` preserves the inner product (it is unitary): `W† ∘ W = 1`, so by
    -- `inner_map_map_iff_adjoint_comp_self`, `⟪W a, W b⟫ = ⟪a, b⟫`.
    have h1 : (ContinuousLinearMap.adjoint W).comp W = 1 := by
      have hs := Unitary.coe_star_mul_self ⟨W, hWmem⟩
      rw [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.mul_def] at hs
      exact hs
    have hWisom : ∀ a b : EuclideanSpace 𝕜 ι, inner 𝕜 (W a) (W b) = inner 𝕜 a b :=
      fun a b => (ContinuousLinearMap.inner_map_map_iff_adjoint_comp_self W).mpr h1 a b
    refine ⟨Matrix.of (fun i j => W (EuclideanSpace.basisFun ι 𝕜 i) j), ?_, ?_⟩
    · refine Matrix.mem_unitaryGroup_iff.mpr ?_
      ext i k
      simp only [Matrix.mul_apply, Matrix.one_apply, Matrix.star_apply, Matrix.of_apply]
      have hpar : (∑ j, W (EuclideanSpace.basisFun ι 𝕜 i) j
            * star (W (EuclideanSpace.basisFun ι 𝕜 k) j))
          = inner 𝕜 (W (EuclideanSpace.basisFun ι 𝕜 k)) (W (EuclideanSpace.basisFun ι 𝕜 i)) := by
        rw [PiLp.inner_apply]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [RCLike.inner_apply, starRingEnd_apply]
      rw [hpar, hWisom,
        orthonormal_iff_ite.mp (EuclideanSpace.basisFun ι 𝕜).orthonormal k i]
      simp only [eq_comm]
    · intro i
      have key : ψ i = synthesisMap (𝕜 := 𝕜) φ (W (EuclideanSpace.basisFun ι 𝕜 i)) := by
        rw [← synthesisMap_basisFun (𝕜 := 𝕜) ψ i, hW]; rfl
      rw [key, synthesisMap_apply]
      simp [Matrix.of_apply]
  · rintro ⟨u, hu, hrel⟩
    calc ∑ i, rankOne 𝕜 (ψ i) (ψ i)
        = ∑ i, rankOne 𝕜 (∑ j, u i j • φ j) (∑ j, u i j • φ j) :=
          Finset.sum_congr rfl fun i _ => by rw [hrel]
      _ = ∑ i, rankOne 𝕜 (φ i) (φ i) := sum_rankOne_self_eq_of_mem_unitaryGroup hu φ

/-- **Reduction of a rank-one sum to at most `finrank` terms.** Any finite sum of rank-one
projectors `∑ᵢ |vᵢ⟩⟨vᵢ|` over an *arbitrary* finite index `ι` equals a sum `∑ₖ |wₖ⟩⟨wₖ|` of at most
`finrank 𝕜 H` rank-one projectors — `k` ranging over `Fin (finrank 𝕜 H)`, with no bound on the size
of `ι`. The operator `∑ᵢ |vᵢ⟩⟨vᵢ|` is positive (`ContinuousLinearMap.isPositive_sum` of
`isPositive_rankOne_self`), so `ContinuousLinearMap.IsPositive.exists_sum_rankOne_fin_finrank`
re-expresses it over its spectral eigenbasis, whose size is `finrank 𝕜 H`.

This is the linear-algebra core of the **minimal operator-sum representation** bound. Applied to the
vectorized operation elements of a quantum operation on a `d`-dimensional space — the Choi vectors
`vec Eᵢ ∈ H ⊗ H`, where `finrank ℂ (H ⊗ H) = d²` — it yields an operator-sum representation with at
most `d²` elements: Nielsen & Chuang, *Quantum Computation and Quantum Information*, **Theorem 8.3**
(and, for a `d`-to-`d′` operation, the `d d′` bound of Exercise 8.11, via `H ⊗ G`). The reduction is
size-agnostic in `ι`, matching N&C's "append zero operators" padding: the input family may be
arbitrarily large, the output is capped by the dimension. -/
theorem exists_sum_rankOne_self_eq_fin_finrank [FiniteDimensional 𝕜 H] (v : ι → H) :
    ∃ w : Fin (Module.finrank 𝕜 H) → H,
      ∑ i, rankOne 𝕜 (v i) (v i) = ∑ k, rankOne 𝕜 (w k) (w k) := by
  have hpos : (∑ i, rankOne 𝕜 (v i) (v i)).IsPositive :=
    ContinuousLinearMap.isPositive_sum _ fun i _ ↦ isPositive_rankOne_self (v i)
  exact hpos.exists_sum_rankOne_fin_finrank

end InnerProductSpace

namespace EuclideanSpace

/-- **Any unit vector of `EuclideanSpace 𝕜 (Fin n)` is the first row of a unitary matrix.** Given a
vector `w` with `‖w‖ = 1`, extend it to an orthonormal basis `c` with `c 0 = w`
(`Orthonormal.exists_orthonormalBasis_extension_of_card_eq`, orthonormal on the singleton `{0}`);
the coordinate matrix `uᵢⱼ = (c i).ofLp j` has orthonormal rows, hence is unitary, and its zeroth
row is `w`. This is the completion of a single unit vector to a unitary matrix — the ingredient
behind building a family of vectors with a prescribed member in the unitary-freedom form of
Nielsen & Chuang Theorem 2.6 (`InnerProductSpace.sum_rankOne_self_eq_of_mem_unitaryGroup`). -/
theorem exists_mem_unitaryGroup_row_zero_eq {𝕜 : Type*} [RCLike 𝕜] {n : ℕ} [NeZero n]
    (w : EuclideanSpace 𝕜 (Fin n)) (hw : ‖w‖ = 1) :
    ∃ u ∈ Matrix.unitaryGroup (Fin n) 𝕜, ∀ j, u 0 j = w.ofLp j := by
  classical
  have hcard : Module.finrank 𝕜 (EuclideanSpace 𝕜 (Fin n)) = Fintype.card (Fin n) :=
    finrank_euclideanSpace
  have horth : Orthonormal 𝕜 (({0} : Set (Fin n)).domRestrict (fun _ => w)) := by
    rw [orthonormal_iff_ite]
    rintro ⟨i, hi⟩ ⟨j, hj⟩
    simp only [Set.mem_singleton_iff] at hi hj
    subst hi; subst hj
    change ⟪w, w⟫_𝕜 = if (⟨(0 : Fin n), hi⟩ : ({0} : Set (Fin n))) = ⟨0, hj⟩ then 1 else 0
    rw [ite_eq_left rfl, inner_self_eq_norm_sq_to_K, hw]
    norm_num
  obtain ⟨c, hc⟩ := Orthonormal.exists_orthonormalBasis_extension_of_card_eq hcard horth
  have hcw : c 0 = w := hc 0 rfl
  refine ⟨Matrix.of fun a b => (c a).ofLp b, ?_, fun j => by rw [Matrix.of_apply, hcw]⟩
  rw [Matrix.mem_unitaryGroup_iff]
  ext i j
  rw [Matrix.mul_apply, Matrix.one_apply]
  have hkey : ∑ k, (Matrix.of fun a b => (c a).ofLp b) i k *
      star (Matrix.of fun a b => (c a).ofLp b) k j = inner 𝕜 (c j) (c i) := by
    rw [PiLp.inner_apply]
    refine Finset.sum_congr rfl fun k _ => ?_
    simp only [Matrix.of_apply, Matrix.star_apply, RCLike.inner_apply, RCLike.star_def]
  rw [hkey, orthonormal_iff_ite.mp c.orthonormal j i]
  by_cases hij : i = j
  · subst hij; simp
  · rw [ite_eq_right fun hji => hij hji.symm, ite_eq_right hij]

end EuclideanSpace
