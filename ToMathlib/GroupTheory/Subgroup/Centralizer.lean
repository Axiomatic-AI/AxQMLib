module

public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# `closure` is commutative iff its generators commute

Extends `Mathlib.GroupTheory.Subgroup.Centralizer` with the iff-strengthening of
`Subgroup.isMulCommutative_closure`.
-/

public section

namespace Subgroup

variable {G : Type*} [Group G]

/-- The subgroup `closure k` generated by `k` is commutative if and only if every pair of
generators (elements of `k`) commutes. The forward direction strengthens
`isMulCommutative_closure` to an equivalence: generators lie in the subgroup, so if all of its
elements commute then in particular so do the generators. -/
@[to_additive /-- The additive subgroup `closure k` generated by `k` is commutative if and only if
every pair of generators (elements of `k`) commutes additively. -/]
theorem isMulCommutative_closure_iff {k : Set G} :
    IsMulCommutative (closure k) ↔ ∀ x ∈ k, ∀ y ∈ k, x * y = y * x := by
  refine ⟨fun h x hx y hy => ?_,
    fun h => isMulCommutative_closure fun x hx y hy _ => h x hx y hy⟩
  have := h
  exact setLike_mul_comm (subset_closure hx) (subset_closure hy)

end Subgroup
